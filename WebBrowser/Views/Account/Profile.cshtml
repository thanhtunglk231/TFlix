@model IReadOnlyList<CoreLib.Dtos.Favorite.FavoriteMovieDto>
@{
    ViewData["Title"] = "Hồ sơ tài khoản";
    var user = ViewBag.CurrentUser as WebBrowser.Models.AuthModels.UserInfo;
    const string fallback = "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600&auto=format&fit=crop";
}

<div class="container py-5 text-light">
    <section class="rounded-4 p-4 mb-5" style="background:linear-gradient(135deg,#182436,#111318);border:1px solid rgba(255,255,255,.1)">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:72px;height:72px;background:linear-gradient(135deg,#1683ff,#19d3c5)">
                <i class="bi bi-person-fill fs-1 text-dark"></i>
            </div>
            <div>
                <h1 class="h3 mb-1">@(string.IsNullOrWhiteSpace(user?.fullName) ? "Thành viên TFlix" : user.fullName)</h1>
                <div class="text-secondary">@user?.email</div>
            </div>
        </div>
    </section>

    <section id="favoriteMovies">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="h4 mb-0"><i class="bi bi-heart-fill text-danger me-2"></i>Phim yêu thích</h2>
            <span class="badge rounded-pill bg-secondary">@Model.Count phim</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="text-center rounded-4 p-5" style="background:#17191f;border:1px solid rgba(255,255,255,.08)">
                <i class="bi bi-heart fs-1 text-secondary"></i>
                <h3 class="h5 mt-3">Bạn chưa có phim yêu thích</h3>
                <p class="text-secondary">Nhấn biểu tượng trái tim trên một bộ phim để lưu tại đây.</p>
                <a class="btn btn-primary rounded-pill px-4" asp-controller="Movies" asp-action="Index">Khám phá phim</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var movie in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3 favorite-card" data-movie-id="@movie.MovieId">
                        <div class="card h-100 bg-dark text-light border-secondary overflow-hidden">
                            <a asp-controller="Preview" asp-action="Details" asp-route-id="@movie.MovieId" asp-route-kind="MOVIE">
                                <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? fallback : movie.PosterUrl)" class="card-img-top" style="aspect-ratio:2/3;object-fit:cover" alt="@movie.Title" />
                            </a>
                            <div class="card-body">
                                <h3 class="h6 text-truncate">@movie.Title</h3>
                                <div class="small text-secondary mb-3">@(movie.ReleaseDate?.Year.ToString() ?? "TFlix") · @(movie.DurationMin.HasValue ? $"{movie.DurationMin} phút" : "Phim")</div>
                                <button class="btn btn-outline-danger btn-sm w-100 js-remove-favorite" data-movie-id="@movie.MovieId"><i class="bi bi-heartbreak me-1"></i>Bỏ yêu thích</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<form id="favoriteTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
@section Scripts {
<script>
document.querySelectorAll('.js-remove-favorite').forEach(button => button.addEventListener('click', async () => {
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý';
    const token = document.querySelector('#favoriteTokenForm input[name="__RequestVerificationToken"]')?.value;
    const body = new URLSearchParams({ movieId: button.dataset.movieId, __RequestVerificationToken: token || '' });
    const response = await fetch('@Url.Action("ToggleMovie", "Favorite")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
    if (response.ok) button.closest('.favorite-card')?.remove(); else { button.disabled = false; button.textContent = 'Thử lại'; }
}));
</script>
}
