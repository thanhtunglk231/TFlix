@model IReadOnlyList<CoreLib.Dtos.Favorite.FavoriteMovieDto>
@{
    ViewData["Title"] = "Hồ sơ tài khoản";
    var user = ViewBag.CurrentUser as WebBrowser.Models.AuthModels.UserInfo;
    var subscriptionStatus = ViewBag.SubscriptionStatus as CoreLib.Dtos.Payment.SubscriptionStatusDto ?? new CoreLib.Dtos.Payment.SubscriptionStatusDto();
    var activeSubscriptions = ViewBag.ActiveSubscriptions as List<CoreLib.Dtos.Payment.SubscriptionStatusDto> ?? [];
    var subscriptionLoadError = ViewBag.SubscriptionLoadError as string;
    var isPremium = subscriptionStatus.IsActive;
    var planName = string.IsNullOrWhiteSpace(subscriptionStatus.PlanName) ? "Gói thường" : subscriptionStatus.PlanName;
    const string fallback = "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=600&auto=format&fit=crop";
}

<div class="container py-5 text-light">
    <section class="rounded-4 p-4 mb-5" style="background:linear-gradient(135deg,#182436,#111318);border:1px solid rgba(255,255,255,.1)">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:72px;height:72px;background:linear-gradient(135deg,#1683ff,#19d3c5)">
                    <i class="bi bi-person-fill fs-1 text-dark"></i>
                </div>
                <div>
                    <h1 class="h3 mb-1">@(string.IsNullOrWhiteSpace(user?.fullName) ? "Thành viên TFlix" : user.fullName)</h1>
                    <div class="text-secondary">@user?.email</div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @(isPremium ? "bg-warning text-dark" : "bg-secondary") rounded-pill px-3 py-2">
                    <i class="bi @(isPremium ? "bi-star-fill" : "bi-person") me-1"></i>
                    @(isPremium ? "Premium" : "Thường")
                </span>
                @if (isPremium)
                {
                    <span class="badge bg-success-subtle text-success rounded-pill px-3 py-2">
                        <i class="bi bi-shield-check me-1"></i>@planName
                    </span>
                }
            </div>
        </div>
    </section>

    <section class="mb-5">
        <div class="rounded-4 p-4" style="background:#17191f;border:1px solid rgba(255,255,255,.08)">
            @if (isPremium)
            {
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <div class="text-uppercase text-secondary small mb-2">Trạng thái tài khoản</div>
                        <h2 class="h4 mb-1">Bạn đang sử dụng gói @planName</h2>
                        @if (subscriptionStatus.EndAt.HasValue)
                        {
                            <div class="text-secondary">Hết hạn: @subscriptionStatus.EndAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</div>
                        }
                    </div>
                    <a asp-controller="Payment" asp-action="Index" asp-route-returnUrl="@Url.Action("Profile", "Account")" class="btn btn-outline-light rounded-pill px-4">
                        <i class="bi bi-arrow-repeat me-1"></i>Đổi gói
                    </a>
                </div>
            }
            else
            {
                <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                    <div>
                        <div class="text-uppercase text-secondary small mb-2">Tài khoản thường</div>
                        <h2 class="h4 mb-1">Nâng cấp để xem nội dung Premium</h2>
                        <div class="text-secondary">Mở khóa phim VIP, chất lượng cao và trải nghiệm không quảng cáo.</div>
                    </div>
                    <a asp-controller="Payment" asp-action="Index" asp-route-returnUrl="@Url.Action("Profile", "Account")" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-crown me-1"></i>Nâng cấp ngay
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="mb-5" aria-labelledby="activeSubscriptionsTitle">
        <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
            <h2 id="activeSubscriptionsTitle" class="h4 mb-0"><i class="bi bi-gem text-info me-2"></i>Các gói đang có</h2>
            <span class="badge rounded-pill bg-secondary">@activeSubscriptions.Count gói</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(subscriptionLoadError))
        {
            <div class="alert alert-warning" role="alert">@subscriptionLoadError</div>
        }
        else if (activeSubscriptions.Count == 0)
        {
            <div class="rounded-4 p-4 text-secondary" style="background:#17191f;border:1px solid rgba(255,255,255,.08)">
                Tài khoản hiện chưa có gói Premium đang hoạt động.
            </div>
        }
        else
        {
            <div class="row g-3">
                @foreach (var subscription in activeSubscriptions)
                {
                    <div class="col-12 col-md-6 col-xl-4">
                        <article class="h-100 rounded-4 p-4" style="background:#17191f;border:1px solid rgba(25,211,197,.25)">
                            <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                                <div>
                                    <div class="small text-secondary">@subscription.PlanCode</div>
                                    <h3 class="h5 mb-0">@subscription.PlanName</h3>
                                </div>
                                <span class="badge bg-success-subtle text-success">Đang hoạt động</span>
                            </div>
                            @if (subscription.Price.HasValue)
                            {
                                <div class="fs-5 fw-bold mb-3">@subscription.Price.Value.ToString("N0") @(subscription.Currency ?? "VND")</div>
                            }
                            <dl class="row small mb-0">
                                @if (subscription.StartAt.HasValue)
                                {
                                    <dt class="col-6 text-secondary">Bắt đầu</dt>
                                    <dd class="col-6 text-end">@subscription.StartAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                                }
                                @if (subscription.EndAt.HasValue)
                                {
                                    <dt class="col-6 text-secondary">Hết hạn</dt>
                                    <dd class="col-6 text-end">@subscription.EndAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                                }
                                @if (subscription.MaxDevices.HasValue)
                                {
                                    <dt class="col-6 text-secondary">Thiết bị</dt>
                                    <dd class="col-6 text-end">@subscription.MaxDevices</dd>
                                }
                                @if (!string.IsNullOrWhiteSpace(subscription.QualityCap))
                                {
                                    <dt class="col-6 text-secondary">Chất lượng</dt>
                                    <dd class="col-6 text-end">@subscription.QualityCap</dd>
                                }
                            </dl>
                        </article>
                    </div>
                }
            </div>
        }
    </section>

    <section id="favoriteMovies">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="h4 mb-0"><i class="bi bi-heart-fill text-danger me-2"></i>Phim yêu thích</h2>
            <span class="badge rounded-pill bg-secondary">@Model.Count phim</span>
        </div>
        @if (Model.Count == 0)
        {
            <div class="text-center rounded-4 p-5" style="background:#17191f;border:1px solid rgba(255,255,255,.08)">
                <i class="bi bi-heart fs-1 text-secondary"></i>
                <h3 class="h5 mt-3">Bạn chưa có phim yêu thích</h3>
                <p class="text-secondary">Nhấn biểu tượng trái tim trên một bộ phim để lưu tại đây.</p>
                <a class="btn btn-primary rounded-pill px-4" asp-controller="Movies" asp-action="Index">Khám phá phim</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var movie in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3 favorite-card" data-movie-id="@movie.MovieId">
                        <div class="card h-100 bg-dark text-light border-secondary overflow-hidden">
                            <a asp-controller="Preview" asp-action="Details" asp-route-id="@movie.MovieId" asp-route-kind="MOVIE">
                                <img src="@(string.IsNullOrWhiteSpace(movie.PosterUrl) ? fallback : movie.PosterUrl)" class="card-img-top" style="aspect-ratio:2/3;object-fit:cover" alt="@movie.Title" />
                            </a>
                            <div class="card-body">
                                <h3 class="h6 text-truncate">@movie.Title</h3>
                                <div class="small text-secondary mb-3">@(movie.ReleaseDate?.Year.ToString() ?? "TFlix") · @(movie.DurationMin.HasValue ? $"{movie.DurationMin} phút" : "Phim")</div>
                                <button class="btn btn-outline-danger btn-sm w-100 js-remove-favorite" data-movie-id="@movie.MovieId"><i class="bi bi-heartbreak me-1"></i>Bỏ yêu thích</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
</div>

<form id="favoriteTokenForm" class="d-none">@Html.AntiForgeryToken()</form>
@section Scripts {
<script>
document.querySelectorAll('.js-remove-favorite').forEach(button => button.addEventListener('click', async () => {
    button.disabled = true;
    button.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý';
    const token = document.querySelector('#favoriteTokenForm input[name="__RequestVerificationToken"]')?.value;
    const body = new URLSearchParams({ movieId: button.dataset.movieId, __RequestVerificationToken: token || '' });
    const response = await fetch('@Url.Action("ToggleMovie", "Favorite")', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
    if (response.ok) button.closest('.favorite-card')?.remove(); else { button.disabled = false; button.textContent = 'Thử lại'; }
}));
</script>
}
