<!-- ========================================================
     TFLIX AI CHATBOT - TRỢ LÝ TƯ VẤN PHIM THÔNG MINH
     Google Gemini API & Database TFlix
     ======================================================== -->

<style>
    /* Trigger Button */
    .tflix-ai-trigger {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed 0%, #2563eb 50%, #06b6d4 100%);
        box-shadow: 0 8px 28px rgba(124, 58, 237, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        cursor: pointer;
        z-index: 1040;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        border: 2px solid rgba(255, 255, 255, 0.25);
    }
    .tflix-ai-trigger:hover {
        transform: scale(1.08) translateY(-3px);
        box-shadow: 0 12px 32px rgba(6, 182, 212, 0.55);
        color: #ffffff;
    }
    .tflix-ai-trigger .ai-pulse {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 14px;
        height: 14px;
        background-color: #10b981;
        border: 2px solid #111318;
        border-radius: 50%;
    }
    .tflix-ai-trigger .ai-pulse::after {
        content: '';
        position: absolute;
        inset: -2px;
        border-radius: 50%;
        background-color: #10b981;
        opacity: 0.7;
        animation: ai-pulse-ring 2s infinite;
    }
    @@keyframes ai-pulse-ring {
        0% { transform: scale(1); opacity: 0.8; }
        100% { transform: scale(2.2); opacity: 0; }
    }

    /* Chatbox Container */
    .tflix-ai-box {
        position: fixed;
        bottom: 95px;
        right: 24px;
        width: 410px;
        max-width: calc(100vw - 32px);
        height: 580px;
        max-height: calc(100vh - 120px);
        background: #14171f;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 20px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.75), 0 0 30px rgba(124, 58, 237, 0.15);
        display: flex;
        flex-direction: column;
        z-index: 1040;
        overflow: hidden;
        backdrop-filter: blur(16px);
        opacity: 0;
        pointer-events: none;
        transform: translateY(20px) scale(0.96);
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .tflix-ai-box.open {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0) scale(1);
    }

    /* Header */
    .tflix-ai-header {
        padding: 14px 18px;
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.2) 0%, rgba(6, 182, 212, 0.15) 100%), #1c1f28;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .tflix-ai-header .ai-avatar {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: bold;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.3);
    }

    /* Body */
    .tflix-ai-body {
        flex: 1;
        padding: 16px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 14px;
        background: #0f1218;
    }

    /* Bubbles */
    .ai-bubble-row {
        display: flex;
        gap: 10px;
        max-width: 90%;
    }
    .ai-bubble-row.user-row {
        align-self: flex-end;
        flex-direction: row-reverse;
    }
    .ai-bubble-row.ai-row {
        align-self: flex-start;
    }

    .ai-bubble {
        padding: 11px 15px;
        border-radius: 16px;
        font-size: 0.88rem;
        line-height: 1.55;
        word-break: break-word;
    }
    .ai-bubble-row.ai-row .ai-bubble {
        background: #1b1f2a;
        color: #f1f5f9;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-top-left-radius: 4px;
    }
    .ai-bubble-row.user-row .ai-bubble {
        background: linear-gradient(135deg, #2563eb 0%, #0284c7 100%);
        color: #ffffff;
        border-top-right-radius: 4px;
    }
    .ai-msg-time {
        font-size: 0.68rem;
        opacity: 0.65;
        margin-top: 4px;
        text-align: right;
    }

    /* Movie Cards Container */
    .ai-movie-cards {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 8px 2px 4px 2px;
        margin-top: 8px;
        scrollbar-width: thin;
        scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
    }
    .ai-movie-cards::-webkit-scrollbar {
        height: 6px;
    }
    .ai-movie-cards::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 6px;
    }
    .ai-movie-card {
        flex: 0 0 155px;
        background: #151922;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
        text-decoration: none;
        color: #fff;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }
    .ai-movie-card:hover {
        transform: translateY(-3px);
        border-color: #06b6d4;
        box-shadow: 0 6px 18px rgba(6, 182, 212, 0.25);
        color: #fff;
    }
    .ai-movie-card img {
        width: 100%;
        height: 195px;
        object-fit: cover;
        background-color: #0d1017;
    }
    .ai-card-content {
        padding: 8px 10px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .ai-card-title {
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1.3;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-bottom: 2px;
    }
    .ai-card-meta {
        font-size: 0.7rem;
        color: #94a3b8;
        margin-bottom: 4px;
    }
    .ai-card-btn {
        margin-top: auto;
        padding: 4px 8px;
        font-size: 0.72rem;
        font-weight: 700;
        background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
        border-radius: 6px;
        text-align: center;
        color: #fff;
        border: none;
    }

    /* Quick Chips */
    .ai-quick-chips {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding: 8px 14px;
        background: #171b24;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        white-space: nowrap;
        scrollbar-width: none;
    }
    .ai-quick-chips::-webkit-scrollbar {
        display: none;
    }
    .ai-chip {
        font-size: 0.75rem;
        padding: 4px 11px;
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #cbd5e1;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .ai-chip:hover {
        background: rgba(124, 58, 237, 0.2);
        border-color: #8b5cf6;
        color: #ffffff;
    }

    /* Typing Dots */
    .ai-typing-bar {
        display: flex;
        align-items: center;
        gap: 5px;
        padding: 8px 12px;
        background: #1b1f2a;
        border-radius: 14px;
        width: fit-content;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    .ai-typing-dot {
        width: 6px;
        height: 6px;
        background: #a78bfa;
        border-radius: 50%;
        animation: aiTypingBounce 1.4s infinite ease-in-out;
    }
    .ai-typing-dot:nth-child(1) { animation-delay: 0s; }
    .ai-typing-dot:nth-child(2) { animation-delay: 0.2s; }
    .ai-typing-dot:nth-child(3) { animation-delay: 0.4s; }
    @@keyframes aiTypingBounce {
        0%, 60%, 100% { transform: translateY(0); }
        30% { transform: translateY(-4px); }
    }

    /* Footer */
    .tflix-ai-footer {
        padding: 10px 14px;
        background: #1c1f28;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ai-input {
        flex: 1;
        background: #10131a;
        border: 1px solid rgba(255, 255, 255, 0.12);
        color: #fff;
        padding: 9px 14px;
        border-radius: 20px;
        font-size: 0.88rem;
        outline: none;
        transition: border-color 0.2s;
    }
    .ai-input:focus {
        border-color: #8b5cf6;
    }
    .ai-send-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7c3aed 0%, #06b6d4 100%);
        border: none;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .ai-send-btn:hover {
        transform: scale(1.06);
    }
    .ai-send-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
</style>

<!-- Floating Action Button -->
<div id="tflixAiTrigger" class="tflix-ai-trigger" title="Nhấn để trò chuyện cùng TFlix AI tư vấn phim">
    <div class="ai-pulse"></div>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"></path>
        <rect x="4" y="8" width="16" height="12" rx="3"></rect>
        <path d="M9 13v2"></path>
        <path d="M15 13v2"></path>
    </svg>
</div>

<!-- AI Chatbox Window -->
<div id="tflixAiBox" class="tflix-ai-box" aria-live="polite">
    <!-- Header -->
    <div class="tflix-ai-header">
        <div class="d-flex align-items-center gap-2.5">
            <div class="ai-avatar">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
                </svg>
            </div>
            <div>
                <div class="fw-bold text-white fs-6 d-flex align-items-center gap-1.5">
                    <span>TFlix AI – Tư Vấn Phim</span>
                    <span class="badge rounded-pill" style="background: rgba(124, 58, 237, 0.25); color: #c4b5fd; font-size: 0.65rem;">Gemini Flash</span>
                </div>
                <div class="text-muted small" style="font-size: 0.72rem;">Gợi ý phim đúng sở thích từ TFlix Database</div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-1">
            <button id="btnAiClearHistory" class="btn btn-sm btn-link text-muted p-1" title="Xóa lịch sử hội thoại">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
            <button id="btnAiMinimize" class="btn btn-sm btn-link text-muted p-1" title="Thu nhỏ">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            </button>
            <button id="btnAiClose" class="btn btn-sm btn-link text-muted p-1" title="Đóng chatbox">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
    </div>

    <!-- Quick FAQ Chips -->
    <div class="ai-quick-chips">
        <button class="ai-chip" data-prompt="Gợi ý phim hot hôm nay trên TFlix">🔥 Phim hot hôm nay</button>
        <button class="ai-chip" data-prompt="Gợi ý 3 phim hành động kịch tính đỉnh cao">💥 Phim hành động</button>
        <button class="ai-chip" data-prompt="Tìm phim kinh dị Hàn Quốc rùng rợn">👻 Kinh dị Hàn Quốc</button>
        <button class="ai-chip" data-prompt="Gợi ý phim tình cảm lãng mạn nhẹ nhàng">❤️ Phim tình cảm</button>
        <button class="ai-chip" data-prompt="Gợi ý phim gia đình ý nghĩa, cảm động">👨‍👩‍👧 Phim gia đình</button>
    </div>

    <!-- Messages List -->
    <div id="aiChatMessages" class="tflix-ai-body">
        <!-- Messages rendered dynamically -->
    </div>

    <!-- Typing Indicator -->
    <div id="aiTypingIndicator" class="px-3 py-1 d-none" style="background: #0f1218;">
        <div class="ai-typing-bar">
            <span class="ai-typing-dot"></span>
            <span class="ai-typing-dot"></span>
            <span class="ai-typing-dot"></span>
            <span class="text-muted small ms-1" style="font-size: 0.72rem;">TFlix AI đang suy nghĩ và tìm phim...</span>
        </div>
    </div>

    <!-- Input Footer -->
    <form id="aiChatForm" class="tflix-ai-footer" onsubmit="return false;">
        <input type="text" id="aiChatInput" class="ai-input" placeholder="Hỏi phim theo thể loại, tâm trạng, diễn viên..." maxlength="500" autocomplete="off" />
        <button type="submit" id="aiChatSendBtn" class="ai-send-btn" title="Gửi câu hỏi">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
            </svg>
        </button>
    </form>
</div>

<script>
    (function () {
        const trigger = document.getElementById('tflixAiTrigger');
        const box = document.getElementById('tflixAiBox');
        const btnClose = document.getElementById('btnAiClose');
        const btnMinimize = document.getElementById('btnAiMinimize');
        const btnClear = document.getElementById('btnAiClearHistory');
        const messagesList = document.getElementById('aiChatMessages');
        const form = document.getElementById('aiChatForm');
        const input = document.getElementById('aiChatInput');
        const sendBtn = document.getElementById('aiChatSendBtn');
        const typingIndicator = document.getElementById('aiTypingIndicator');

        // Quản lý Conversation ID
        let conversationId = localStorage.getItem('tflix_ai_conversation_id');
        if (!conversationId) {
            conversationId = 'conv_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now();
            localStorage.setItem('tflix_ai_conversation_id', conversationId);
        }

        const getCacheKey = (cid) => 'tflix_ai_msgs_' + cid;
        const KEY_DRAFT = 'tflix_ai_draft_input';
        const KEY_IS_OPEN = 'tflix_ai_isOpen';

        // Mảng tin nhắn trong bộ nhớ
        let chatMessages = [];

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function formatMarkdown(text) {
            if (!text) return '';
            let html = escapeHtml(text);
            html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
            html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
            html = html.replace(/_(.*?)_/g, '<em>$1</em>');
            html = html.replace(/\n/g, '<br/>');
            return html;
        }

        function renderMovieCards(movies) {
            if (!movies || movies.length === 0) return '';

            let cardsHtml = '<div class="ai-movie-cards">';
            movies.forEach(m => {
                const poster = m.posterUrl || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop';
                const rating = m.rating ? `★ ${m.rating}` : '★ 8.5';
                const year = m.year ? `${m.year}` : '';
                const genres = m.genres ? (m.genres.length > 22 ? m.genres.substring(0, 20) + '...' : m.genres) : 'Phim hay';
                const meta = year ? `${year} • ${genres}` : genres;

                cardsHtml += `
                    <a href="${m.detailUrl || '#'}" class="ai-movie-card">
                        <img src="${poster}" alt="${escapeHtml(m.title)}" loading="lazy" />
                        <div class="ai-card-content">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; font-size: 0.65rem;">${rating}</span>
                                <span class="badge" style="background: rgba(124, 58, 237, 0.2); color: #c4b5fd; font-size: 0.62rem;">${m.kind === 'series' ? 'SERIES' : 'PHIM'}</span>
                            </div>
                            <div class="ai-card-title" title="${escapeHtml(m.title)}">${escapeHtml(m.title)}</div>
                            <div class="ai-card-meta">${escapeHtml(meta)}</div>
                            <button type="button" class="ai-card-btn">Xem ngay</button>
                        </div>
                    </a>
                `;
            });
            cardsHtml += '</div>';
            return cardsHtml;
        }

        function appendMessageToDOM(role, content, movies = [], time = null) {
            if (!messagesList) return;
            const isUser = role === 'user';
            const displayTime = time || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

            const row = document.createElement('div');
            row.className = `ai-bubble-row ${isUser ? 'user-row' : 'ai-row'}`;

            let html = `
                <div class="ai-bubble">
                    <div>${formatMarkdown(content)}</div>
                    ${!isUser && movies && movies.length > 0 ? renderMovieCards(movies) : ''}
                    <div class="ai-msg-time">${displayTime}</div>
                </div>
            `;
            row.innerHTML = html;
            messagesList.appendChild(row);
        }

        function renderAllMessages(messages) {
            if (!messagesList) return;
            messagesList.innerHTML = '';
            if (!messages || messages.length === 0) {
                showWelcome();
                return;
            }
            messages.forEach(m => {
                const time = m.timestamp ? new Date(m.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : null;
                appendMessageToDOM(m.role, m.content, m.movies, time);
            });
            messagesList.scrollTop = messagesList.scrollHeight;
        }

        function saveMessagesToCache() {
            try {
                localStorage.setItem(getCacheKey(conversationId), JSON.stringify(chatMessages));
            } catch (e) {
                console.warn('Lỗi lưu cache tin nhắn chatbot:', e);
            }
        }

        function showWelcome() {
            if (!messagesList) return;
            messagesList.innerHTML = '';
            const welcomeText = 'Xin chào! Tôi là **TFlix AI**, trợ lý tư vấn phim thông minh của nền tảng xem phim TFlix.\n\nTôi có thể giúp bạn tìm phim theo **thể loại**, **quốc gia**, **tâm trạng** hoặc **gợi ý phim hot**. Bạn muốn xem gì hôm nay?';
            appendMessageToDOM('model', welcomeText);
        }

        // Tải tức thì từ LocalStorage để không bị reload/nhấp nháy nội dung khi chuyển trang
        function restoreLocalState() {
            try {
                const cachedRaw = localStorage.getItem(getCacheKey(conversationId));
                if (cachedRaw) {
                    const parsed = JSON.parse(cachedRaw);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        chatMessages = parsed;
                        renderAllMessages(chatMessages);
                    } else {
                        showWelcome();
                    }
                } else {
                    showWelcome();
                }
            } catch {
                showWelcome();
            }

            // Khôi phục nội dung nháp đang gõ dở
            if (input) {
                const draft = localStorage.getItem(KEY_DRAFT);
                if (draft) input.value = draft;
            }

            // Khôi phục trạng thái mở của chatbox
            if (localStorage.getItem(KEY_IS_OPEN) === 'true') {
                toggleBox(true, false);
            }
        }

        // Đồng bộ ngầm với Backend qua AJAX (Background Sync)
        async function syncHistoryBackground() {
            if (!conversationId) return;
            try {
                const res = await fetch(`/Chat/GetHistory?conversationId=${encodeURIComponent(conversationId)}`);
                const json = await res.json();
                if (json && json.success && json.data && json.data.messages) {
                    const serverMsgs = json.data.messages;
                    // Nếu dữ liệu server nhiều hơn hoặc khác với local, cập nhật lại
                    if (serverMsgs.length > chatMessages.length || (chatMessages.length === 0 && serverMsgs.length > 0)) {
                        chatMessages = serverMsgs;
                        saveMessagesToCache();
                        renderAllMessages(chatMessages);
                    }
                }
            } catch (err) {
                console.warn('Đồng bộ ngầm TFlix AI:', err);
            }
        }

        function toggleBox(show, smooth = true) {
            if (!box) return;
            const willOpen = show !== undefined ? show : !box.classList.contains('open');
            if (willOpen) {
                box.classList.add('open');
                localStorage.setItem(KEY_IS_OPEN, 'true');
                if (input) input.focus();
                if (messagesList) {
                    if (smooth) {
                        messagesList.scrollTo({ top: messagesList.scrollHeight, behavior: 'smooth' });
                    } else {
                        messagesList.scrollTop = messagesList.scrollHeight;
                    }
                }
            } else {
                box.classList.remove('open');
                localStorage.setItem(KEY_IS_OPEN, 'false');
            }
        }

        trigger?.addEventListener('click', () => toggleBox());
        btnClose?.addEventListener('click', () => toggleBox(false));
        btnMinimize?.addEventListener('click', () => toggleBox(false));

        btnClear?.addEventListener('click', async () => {
            if (confirm('Bạn có chắc muốn xóa toàn bộ lịch sử tư vấn này?')) {
                const oldCid = conversationId;
                try {
                    await fetch(`/Chat/ClearHistory?conversationId=${encodeURIComponent(oldCid)}`, { method: 'POST' });
                } catch { }
                localStorage.removeItem(getCacheKey(oldCid));
                localStorage.removeItem(KEY_DRAFT);
                conversationId = 'conv_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now();
                localStorage.setItem('tflix_ai_conversation_id', conversationId);
                chatMessages = [];
                showWelcome();
            }
        });

        // Xử lý gửi tin nhắn
        async function sendMessage(text) {
            const cleanText = (text || '').trim();
            if (!cleanText) return;

            if (input) input.value = '';
            localStorage.removeItem(KEY_DRAFT);
            if (sendBtn) sendBtn.disabled = true;

            const nowIso = new Date().toISOString();
            // Lưu tin nhắn user vào trạng thái & cache
            const userMsg = { role: 'user', content: cleanText, movies: [], timestamp: nowIso };
            chatMessages.push(userMsg);
            saveMessagesToCache();

            // Hiển thị tin nhắn người dùng lên DOM
            appendMessageToDOM('user', cleanText);
            if (messagesList) messagesList.scrollTop = messagesList.scrollHeight;

            // Bật typing indicator
            if (typingIndicator) {
                typingIndicator.classList.remove('d-none');
                if (messagesList) messagesList.scrollTop = messagesList.scrollHeight;
            }

            try {
                const res = await fetch('/Chat/SendMessage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        conversationId: conversationId,
                        message: cleanText
                    })
                });

                const json = await res.json();
                if (json && json.success && json.data) {
                    const data = json.data;
                    const botMsg = {
                        role: 'model',
                        content: data.reply,
                        movies: data.movies || [],
                        timestamp: new Date().toISOString()
                    };
                    chatMessages.push(botMsg);
                    saveMessagesToCache();
                    appendMessageToDOM('model', data.reply, data.movies);
                } else {
                    const errorMsg = json.message || 'Xin lỗi bạn, TFlix AI tạm thời không thể xử lý yêu cầu lúc này. Bạn vui lòng thử lại sau giây lát nhé!';
                    appendMessageToDOM('model', errorMsg);
                }
            } catch (err) {
                console.error('Lỗi gửi tin nhắn TFlix AI:', err);
                appendMessageToDOM('model', 'Đã xảy ra sự cố kết nối tới máy chủ TFlix AI. Bạn vui lòng kiểm tra mạng và thử lại nhé!');
            } finally {
                if (typingIndicator) typingIndicator.classList.add('d-none');
                if (sendBtn) sendBtn.disabled = false;
                if (input) input.focus();
                if (messagesList) messagesList.scrollTop = messagesList.scrollHeight;
            }
        }

        form?.addEventListener('submit', (e) => {
            e.preventDefault();
            if (input) sendMessage(input.value);
        });

        // Lưu bản nháp khi người dùng nhập dở
        input?.addEventListener('input', () => {
            localStorage.setItem(KEY_DRAFT, input.value);
        });

        // Quick FAQ chips
        document.querySelectorAll('.ai-chip').forEach(chip => {
            chip.addEventListener('click', () => {
                const prompt = chip.getAttribute('data-prompt');
                if (prompt) sendMessage(prompt);
            });
        });

        // Khôi phục trạng thái tức thì ngay khi nạp component
        restoreLocalState();
        // Đồng bộ ngầm với backend
        syncHistoryBackground();
    })();
</script>
