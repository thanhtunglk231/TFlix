@* Views/Shared/_Footer.cshtml *@
<footer class="tflix-footer">
    <div class="container footer-top">
        <div class="row g-4 g-lg-5">
            <!-- Cột 1: Brand, Giới thiệu ngắn & Mạng xã hội -->
            <div class="col-12 col-md-6 col-lg-4">
                <a class="brand-wrapper mb-3" asp-controller="Home" asp-action="Index" aria-label="TFlix Trang chủ">
                    <div class="brand-icon-box" aria-hidden="true">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 3.5L19 12L5 20.5V3.5Z" fill="currentColor"/>
                        </svg>
                    </div>
                    <span class="brand-text">T<span>Flix</span></span>
                </a>
                <p class="text-muted small pe-lg-4 mb-3" style="line-height: 1.65;">
                    TFlix là nền tảng streaming phim trực tuyến chất lượng cao, cung cấp hàng ngàn bộ phim bom tấn, phim bộ đặc sắc và chương trình giải trí đỉnh cao với trải nghiệm âm thanh và hình ảnh chuẩn rạp.
                </p>
                <div class="social-links-wrap" aria-label="Liên kết mạng xã hội">
                    <a class="social-btn" href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook TFlix"><i class="bi bi-facebook"></i></a>
                    <a class="social-btn" href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube TFlix"><i class="bi bi-youtube"></i></a>
                    <a class="social-btn" href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram TFlix"><i class="bi bi-instagram"></i></a>
                    <a class="social-btn" href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok TFlix"><i class="bi bi-tiktok"></i></a>
                </div>
            </div>

            <!-- Cột 2: Giới thiệu -->
            <div class="col-6 col-md-3 col-lg-2">
                <h6 class="footer-heading">Giới thiệu</h6>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="About">Về TFlix</a></li>
                    <li><a asp-controller="Movies" asp-action="Index">Danh mục phim</a></li>
                    <li><a asp-controller="News" asp-action="Index">Tin tức & Sự kiện</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Điều khoản sử dụng</a></li>
                </ul>
            </div>

            <!-- Cột 3: Hỗ trợ -->
            <div class="col-6 col-md-3 col-lg-2">
                <h6 class="footer-heading">Hỗ trợ</h6>
                <ul class="footer-links">
                    <li><a href="#supportHelp" onclick="alert('Trung tâm hỗ trợ khách hàng 24/7 qua email: support@tflix.vn'); return false;">Trung tâm trợ giúp</a></li>
                    <li><a href="#supportContact" onclick="alert('Hotline liên hệ đối tác: 1900 8888 (8h - 22h)'); return false;">Liên hệ hỗ trợ</a></li>
                    <li><a href="#supportFeedback" onclick="alert('Cảm ơn bạn đã đóng góp ý kiến nâng cấp TFlix!'); return false;">Góp ý & Báo lỗi</a></li>
                    <li><a href="#supportDevices" onclick="alert('TFlix hỗ trợ xem trên SmartTV, Smartphone, Tablet và Web Browser.'); return false;">Thiết bị hỗ trợ</a></li>
                </ul>
            </div>

            <!-- Cột 4: Đăng ký nhận thông báo -->
            <div class="col-12 col-md-12 col-lg-4">
                <h6 class="footer-heading">Đăng ký nhận thông báo</h6>
                <p class="text-muted small mb-3">
                    Đăng ký để không bỏ lỡ các tập phim mới nhất, phim bom tấn chiếu rạp và ưu đãi VIP hàng tuần.
                </p>
                <form id="footerNewsletterForm" onsubmit="handleNewsletterSubmit(event)" autocomplete="off">
                    <div class="footer-subscribe-input-group">
                        <input type="email" id="newsletterEmailInput" class="footer-subscribe-input" placeholder="Nhập email của bạn..." required aria-label="Địa chỉ email đăng ký" />
                        <button class="footer-subscribe-btn" type="submit" aria-label="Gửi đăng ký">
                            <i class="bi bi-send-fill me-1"></i> Gửi
                        </button>
                    </div>
                </form>
                <small class="text-muted d-block mt-2" style="font-size: 0.78rem;">
                    <i class="bi bi-shield-check me-1 text-info"></i> Chúng tôi cam kết bảo mật thông tin cá nhân của bạn.
                </small>
            </div>
        </div>
    </div>

    <!-- Bản quyền ở giữa -->
    <div class="footer-bottom">
        <div class="container text-center">
            <p class="mb-0">
                © @DateTime.Now.Year <span class="fw-semibold text-white">TFlix OTT Platform</span>. All rights reserved. Thiết kế hiện đại trải nghiệm điện ảnh chuẩn rạp.
            </p>
        </div>
    </div>
</footer>

<script>
    function handleNewsletterSubmit(e) {
        e.preventDefault();
        const input = document.getElementById('newsletterEmailInput');
        if (!input || !input.value.trim()) return;
        const email = input.value.trim();
        input.value = '';
        if (window.showTFlixToast) {
            window.showTFlixToast(`Cảm ơn bạn! Email ${email} đã được đăng ký nhận ưu đãi thành công.`);
        } else {
            alert(`Cảm ơn bạn! Email ${email} đã được đăng ký nhận ưu đãi thành công.`);
        }
    }
</script>
