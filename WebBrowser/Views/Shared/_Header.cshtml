@using Microsoft.AspNetCore.Http

@{
    // Lấy route hiện tại
    var routeCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var routeAct = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    Func<string, string, string> isActive = (c, a) =>
    {
        bool matchCtrl = string.Equals(routeCtrl, c, StringComparison.OrdinalIgnoreCase);
        bool matchAct = string.IsNullOrEmpty(a) || string.Equals(routeAct, a, StringComparison.OrdinalIgnoreCase);
        return (matchCtrl && matchAct) ? "active" : "";
    };

    // Lấy giá trị q từ query string
    var q = Context?.Request?.Query["q"].ToString() ?? "";

    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var userName = Context.Session.GetString("Username") ?? "Tài khoản";

}

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top border-bottom border-black">
    <div class="container">
        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
            <img class="brand-logo"
                 src="https://khgcepyhcwfblvflclvp.supabase.co/storage/v1/object/public/images/TFlix/ChatGPT%20Image%20Aug%2020,%202025,%2006_24_22%20PM.png"
                 alt="TFlix Logo" />
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Mở menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link @isActive("Home", "Index")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @isActive("Movies", "Index")" asp-controller="Movies" asp-action="Index">Kho phim</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @isActive("Series", "Index")" asp-controller="Series" asp-action="Index">Phim bộ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @isActive("Single", "Index")" asp-controller="Single" asp-action="Index">Phim lẻ</a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle @isActive("News", "Index")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Tin tức
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Index">Tất cả</a></li>
                        <li><a class="dropdown-item" asp-controller="News" asp-action="Promotions">Khuyến mãi</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Home" asp-action="About">Giới thiệu</a></li>
                    </ul>
                </li>
            </ul>

            <!-- Search -->
            <form id="movieSearchForm" class="d-flex me-3 position-relative" method="get" asp-controller="Home" asp-action="Index" role="search" autocomplete="off">
                <input id="movieSearchInput" class="form-control me-2" type="search" name="q" placeholder="Tìm phim, diễn viên…" value="@q" aria-label="Tìm phim" aria-autocomplete="list" aria-controls="movieSearchSuggestions" />
                <button class="btn btn-outline-light" type="submit">
                    <i class="bi bi-search"></i>
                </button>
                <div id="movieSearchSuggestions" class="movie-search-suggestions d-none" role="listbox"></div>
            </form>

            <!-- User area -->
            @if (isLoggedIn)
            {
                <div class="dropdown">
                    <a class="btn btn-primary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle me-1"></i> @userName
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-gear me-2"></i> Hồ sơ
                            </a>
                        </li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-controller="auth" asp-action="Logout" method="post" class="px-3">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link dropdown-item text-danger p-0">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Auth" asp-action="Index">
                    <i class="bi bi-person-circle me-1"></i> Đăng nhập
                </a>
            }
        </div>
    </div>
</nav>

<style>
    .navbar-brand .brand-logo {
        max-height: 64px;
        width: auto;
        object-fit: contain;
        display: block;
    }

    .nav-link {
        position: relative;
    }

        .nav-link::after {
            content: "";
            position: absolute;
            left: .75rem;
            right: .75rem;
            bottom: .25rem;
            height: 2px;
            background: #27d3c3;
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .25s;
        }

        .nav-link:hover::after,
        .nav-link.active::after {
            transform: scaleX(1);
        }

        .movie-search-suggestions {
            position: absolute;
            z-index: 1050;
            top: calc(100% + .35rem);
            left: 0;
            right: 2.75rem;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,.12);
            border-radius: .5rem;
            background: #212529;
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.35);
        }

        .movie-search-suggestion {
            display: flex;
            width: 100%;
            gap: .65rem;
            align-items: center;
            padding: .55rem .7rem;
            border: 0;
            border-bottom: 1px solid rgba(255,255,255,.08);
            color: #f8f9fa;
            background: transparent;
            text-align: left;
        }

        .movie-search-suggestion:last-child {
            border-bottom: 0;
        }

        .movie-search-suggestion:hover,
        .movie-search-suggestion:focus {
            color: #fff;
            background: rgba(39,211,195,.16);
            outline: 0;
        }

        .movie-search-suggestion img {
            width: 2.25rem;
            height: 3rem;
            flex: 0 0 auto;
            border-radius: .25rem;
            object-fit: cover;
        }

        .movie-search-suggestion small {
            display: block;
            color: #adb5bd;
        }

    @@media (max-width: 991.98px) {
        .navbar-brand .brand-logo {
            max-height: 34px;
        }

        .navbar .dropdown-menu {
            margin-top: .25rem;
        }
    }
</style>

<script>
    (() => {
        const initializeMovieSearch = () => {
        const form = document.getElementById('movieSearchForm');
        const input = document.getElementById('movieSearchInput');
        const suggestions = document.getElementById('movieSearchSuggestions');
        const endpoint = '@Url.Action("MovieAutocomplete", "Home")';
        let timer;
        let request;

        if (!form || !input || !suggestions) return;

        const hideSuggestions = () => {
            suggestions.replaceChildren();
            suggestions.classList.add('d-none');
        };

        const goToMovie = movie => {
            window.location.href = `/Preview/Details?id=${encodeURIComponent(movie.movieId)}&kind=${encodeURIComponent(movie.kind || 'MOVIE')}`;
        };

        const renderSuggestions = movies => {
            suggestions.replaceChildren();
            movies.forEach(movie => {
                const button = document.createElement('button');
                button.type = 'button';
                button.className = 'movie-search-suggestion';
                button.setAttribute('role', 'option');

                if (movie.posterUrl) {
                    const image = document.createElement('img');
                    image.src = movie.posterUrl;
                    image.alt = '';
                    button.appendChild(image);
                }

                const text = document.createElement('span');
                const title = document.createElement('strong');
                title.textContent = movie.title || movie.originalTitle || 'Không có tiêu đề';
                text.appendChild(title);

                if (movie.originalTitle && movie.originalTitle !== movie.title) {
                    const original = document.createElement('small');
                    original.textContent = movie.originalTitle;
                    text.appendChild(original);
                }

                if (movie.producerName) {
                    const producer = document.createElement('small');
                    producer.textContent = `Producer: ${movie.producerName}`;
                    text.appendChild(producer);
                }

                button.appendChild(text);
                button.addEventListener('click', () => goToMovie(movie));
                suggestions.appendChild(button);
            });

            suggestions.classList.toggle('d-none', movies.length === 0);
        };

        const search = async () => {
            const query = input.value.trim();
            if (query.length < 1) {
                hideSuggestions();
                return;
            }

            if (request) request.abort();
            request = new AbortController();

            try {
                const response = await fetch(`${endpoint}?q=${encodeURIComponent(query)}&limit=8`, { signal: request.signal });
                if (!response.ok) throw new Error(`Autocomplete failed: ${response.status}`);
                const payload = await response.json();
                renderSuggestions(payload.data || payload.Data || []);
            } catch (error) {
                if (error.name !== 'AbortError') hideSuggestions();
            }
        };

        input.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(search, 250);
        });

        input.addEventListener('keydown', event => {
            if (event.key === 'Escape') hideSuggestions();
        });

        document.addEventListener('click', event => {
            if (!form.contains(event.target)) hideSuggestions();
        });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeMovieSearch, { once: true });
        } else {
            initializeMovieSearch();
        }
    })();
</script>
