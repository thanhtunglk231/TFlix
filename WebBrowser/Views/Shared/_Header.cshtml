@using Microsoft.AspNetCore.Http

@{
    var routeCtrl = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "");
    var routeAct = (ViewContext.RouteData.Values["action"]?.ToString() ?? "");

    Func<string, string, string> isActive = (c, a) =>
    {
        bool matchCtrl = string.Equals(routeCtrl, c, StringComparison.OrdinalIgnoreCase);
        bool matchAct = string.IsNullOrEmpty(a) || string.Equals(routeAct, a, StringComparison.OrdinalIgnoreCase);
        return (matchCtrl && matchAct) ? "active" : "";
    };

    var q = Context?.Request?.Query["q"].ToString() ?? "";
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var userName = Context.Session.GetString("Username") ?? "Tài khoản";
}

<header>
    <nav class="navbar navbar-expand-lg tflix-navbar" id="mainHeader">
        <div class="container">
            <!-- Brand Logo with Crisp SVG & Fallback Support -->
            <a class="brand-wrapper" asp-controller="Home" asp-action="Index" aria-label="TFlix Trang chủ">
                <div class="brand-icon-box" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 3.5L19 12L5 20.5V3.5Z" fill="currentColor"/>
                    </svg>
                </div>
                <span class="brand-text">T<span>Flix</span></span>
            </a>

            <!-- Mobile Hamburger Toggle -->
            <button class="navbar-toggler border-0 p-2 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#tflixNavContent"
                    aria-controls="tflixNavContent" aria-expanded="false" aria-label="Mở bảng điều hướng">
                <i class="bi bi-list fs-2"></i>
            </button>

            <!-- Navbar Links & Controls -->
            <div class="collapse navbar-collapse" id="tflixNavContent">
                <ul class="navbar-nav tflix-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                    <li class="nav-item">
                        <a class="nav-link @isActive("Home", "Index")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Movies", "Index")" asp-controller="Movies" asp-action="Index">Kho phim</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Series", "Index")" asp-controller="Series" asp-action="Index">Phim bộ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Single", "Index")" asp-controller="Single" asp-action="Index">Phim lẻ</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle @isActive("News", "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Tin tức
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark bg-dark border-secondary shadow-lg">
                            <li><a class="dropdown-item py-2" asp-controller="News" asp-action="Index"><i class="bi bi-newspaper me-2 text-info"></i>Tất cả bài viết</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="News" asp-action="Promotions"><i class="bi bi-tag-fill me-2 text-warning"></i>Khuyến mãi HOT</a></li>
                            <li><hr class="dropdown-divider border-secondary" /></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle me-2 text-primary"></i>Về TFlix</a></li>
                        </ul>
                    </li>
                </ul>

                <!-- Real-Time Autocomplete Search Form -->
                <form id="movieSearchForm" class="header-search-wrap me-lg-3 my-2 my-lg-0" method="get" asp-controller="Home" asp-action="Index" role="search" autocomplete="off">
                    <i class="bi bi-search search-icon-left" aria-hidden="true"></i>
                    <input id="movieSearchInput" class="header-search-input" type="search" name="q" placeholder="Tìm phim, diễn viên, thể loại…" value="@q" aria-label="Tìm kiếm phim" aria-autocomplete="list" aria-controls="movieSearchSuggestions" />
                    <button type="button" id="searchClearBtn" class="search-clear-btn" aria-label="Xóa từ khóa"><i class="bi bi-x-circle-fill"></i></button>
                    <div id="movieSearchSuggestions" class="search-suggestions-dropdown d-none" role="listbox"></div>
                </form>

                <!-- User Account Actions -->
                <div class="d-flex align-items-center mt-3 mt-lg-0">
                    @if (isLoggedIn)
                    {
                        <div class="dropdown">
                            <button class="user-avatar-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar-img">
                                    <i class="bi bi-person-fill"></i>
                                </div>
                                <span class="d-inline-block text-truncate" style="max-width: 130px;">@userName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark bg-dark border-secondary shadow-lg mt-2">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile">
                                        <i class="bi bi-person-gear me-2 text-info"></i> Hồ sơ tài khoản
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" href="#watchlistSection" onclick="window.scrollToWatchlist && window.scrollToWatchlist()">
                                        <i class="bi bi-heart-fill me-2 text-danger"></i> Phim yêu thích
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider border-secondary" /></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 py-1">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-link dropdown-item text-danger p-0 d-flex align-items-center">
                                            <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn-tflix-primary" asp-controller="Auth" asp-action="Index">
                            <i class="bi bi-person-fill"></i>
                            <span>Đăng nhập</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Sticky Header scroll styling
        const header = document.getElementById('mainHeader');
        if (header) {
            const handleScroll = () => {
                if (window.scrollY > 40) {
                    header.classList.add('scrolled');
                } else {
                    header.classList.remove('scrolled');
                }
            };
            window.addEventListener('scroll', handleScroll, { passive: true });
            handleScroll();
        }

        // Search Autocomplete Logic
        const form = document.getElementById('movieSearchForm');
        const input = document.getElementById('movieSearchInput');
        const clearBtn = document.getElementById('searchClearBtn');
        const suggestions = document.getElementById('movieSearchSuggestions');
        const endpoint = '@Url.Action("MovieAutocomplete", "Home")';
        let timer = null;
        let abortController = null;

        if (form && input && suggestions) {
            const updateClearBtn = () => {
                if (clearBtn) {
                    clearBtn.style.display = input.value.trim().length > 0 ? 'block' : 'none';
                }
            };

            input.addEventListener('input', updateClearBtn);
            if (clearBtn) {
                clearBtn.addEventListener('click', () => {
                    input.value = '';
                    updateClearBtn();
                    hideSuggestions();
                    input.focus();
                });
            }

            const hideSuggestions = () => {
                suggestions.replaceChildren();
                suggestions.classList.add('d-none');
            };

            const goToMovie = (movie) => {
                const movieId = movie.movieId ?? movie.MovieId ?? movie.moviE_ID;
                const kind = movie.kind || 'MOVIE';
                window.location.href = `/Preview/Details?id=${encodeURIComponent(movieId)}&kind=${encodeURIComponent(kind)}`;
            };

            const renderSuggestions = (movies) => {
                suggestions.replaceChildren();
                if (!movies || movies.length === 0) {
                    const emptyItem = document.createElement('div');
                    emptyItem.className = 'p-3 text-center text-muted small';
                    emptyItem.textContent = 'Không tìm thấy phim phù hợp.';
                    suggestions.appendChild(emptyItem);
                    suggestions.classList.remove('d-none');
                    return;
                }

                movies.forEach(movie => {
                    const item = document.createElement('button');
                    item.type = 'button';
                    item.className = 'search-suggestion-item';
                    item.setAttribute('role', 'option');

                    const thumb = document.createElement('img');
                    thumb.className = 'search-suggestion-thumb';
                    thumb.src = movie.posterUrl || 'https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?w=100&auto=format&fit=crop';
                    thumb.alt = movie.title || '';
                    thumb.loading = 'lazy';
                    thumb.onerror = () => { thumb.src = 'https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?w=100&auto=format&fit=crop'; };

                    const info = document.createElement('div');
                    info.className = 'search-suggestion-info';

                    const title = document.createElement('div');
                    title.className = 'search-suggestion-title';
                    title.textContent = movie.title || movie.originalTitle || 'Phim TFlix';

                    const meta = document.createElement('div');
                    meta.className = 'search-suggestion-meta';
                    const parts = [];
                    if (movie.originalTitle && movie.originalTitle !== movie.title) parts.push(movie.originalTitle);
                    if (movie.genres) parts.push(movie.genres);
                    meta.textContent = parts.join(' • ') || 'Chất lượng cao';

                    info.appendChild(title);
                    info.appendChild(meta);
                    item.appendChild(thumb);
                    item.appendChild(info);

                    item.addEventListener('click', () => goToMovie(movie));
                    suggestions.appendChild(item);
                });

                suggestions.classList.remove('d-none');
            };

            const doSearch = async () => {
                const query = input.value.trim();
                if (query.length < 1) {
                    hideSuggestions();
                    return;
                }

                if (abortController) abortController.abort();
                abortController = new AbortController();

                try {
                    const response = await fetch(`${endpoint}?q=${encodeURIComponent(query)}&limit=6`, { signal: abortController.signal });
                    if (!response.ok) return;
                    const res = await response.json();
                    const list = res?.data || res?.Data || [];
                    renderSuggestions(list);
                } catch (err) {
                    if (err.name !== 'AbortError') hideSuggestions();
                }
            };

            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(doSearch, 220);
            });

            input.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') hideSuggestions();
            });

            document.addEventListener('click', (e) => {
                if (!form.contains(e.target)) hideSuggestions();
            });
        }
    });
</script>
