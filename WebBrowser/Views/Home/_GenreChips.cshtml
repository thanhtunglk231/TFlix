@model WebBrowser.Models.Home.HomeViewModel

<section class="tflix-section" id="exploreSection" aria-labelledby="exploreTitle">
    <div class="section-header">
        <div class="section-title-wrap">
            <div class="section-icon-badge">
                <i class="bi bi-compass-fill" aria-hidden="true"></i>
            </div>
            <h2 class="section-title" id="exploreTitle">Khám phá theo thể loại</h2>
        </div>
        <div class="section-divider-line d-none d-md-block"></div>
        <a class="btn-view-all" asp-controller="Movies" asp-action="Index">
            <span>Tất cả thể loại</span>
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
    </div>

    @if (Model.Genres.Count > 0)
    {
        <nav class="genre-chips-scroll" aria-label="Danh sách thể loại phim">
            <a class="genre-chip active"
               asp-controller="Movies"
               asp-action="Index"
               aria-label="Xem tất cả phim">
                <i class="bi bi-grid-fill" aria-hidden="true"></i>
                <span>#TấtCả</span>
            </a>

            @foreach (var genre in Model.Genres)
            {
                var genreName = genre.GenreName!.Trim();
                var hashtag = string.Concat(genreName.Where(character => !char.IsWhiteSpace(character)));
                <a class="genre-chip"
                   asp-controller="Movies"
                   asp-action="Index"
                   asp-route-genreId="@genre.GenreId"
                   title="Xem phim thể loại @genreName"
                   aria-label="Xem phim thể loại @genreName">
                    <i class="bi bi-hash" aria-hidden="true"></i>
                    <span>#@hashtag</span>
                </a>
            }
        </nav>
    }
    else
    {
        <div class="genre-chips-empty py-4 text-center text-secondary" role="status">
            <i class="bi bi-tags fs-3" aria-hidden="true"></i>
            <p class="mb-2 mt-2">@(Model.GenresErrorMessage ?? "Chưa có thể loại phim để hiển thị.")</p>
            <a class="btn btn-outline-light btn-sm rounded-pill"
               asp-controller="Home"
               asp-action="Index">
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Thử lại
            </a>
        </div>
    }
</section>
