@* Views/Home/_QuickViewModal.cshtml *@
<div class="modal fade tflix-modal" id="quickViewModal" tabindex="-1" aria-labelledby="quickViewTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <span class="badge badge-vip me-2" id="modalVipBadge">VIP</span>
                <span class="badge badge-quality" id="modalQualityBadge">4K ULTRA HD</span>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4 align-items-center">
                    <div class="col-12 col-md-4">
                        <div class="rounded-3 overflow-hidden shadow-lg border border-secondary" style="aspect-ratio: 2/3;">
                            <img id="modalPoster" src="" alt="Poster" class="w-100 h-100 object-fit-cover" />
                        </div>
                    </div>
                    <div class="col-12 col-md-8">
                        <h3 id="quickViewTitle" class="fw-bold mb-1">Tên phim</h3>
                        <div id="modalOriginalTitle" class="text-muted small mb-2 fst-italic">Original Title</div>

                        <div class="d-flex align-items-center flex-wrap gap-2 mb-2 small">
                            <span class="card-rating-tag" id="modalRatingTag" title="Nhấn để đánh giá sao"><i class="bi bi-star-fill text-warning"></i> <span id="modalRating">8.5</span></span>
                            <span>•</span>
                            <span id="modalYear">2024</span>
                            <span>•</span>
                            <span id="modalDuration">120 phút</span>
                            <span>•</span>
                            <span id="modalCountry">Mỹ</span>
                        </div>

                        <!-- 5-Star Interactive Rating Widget in Modal -->
                        <div class="d-flex align-items-center gap-2 p-2 mb-3 rounded-3" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
                            <span class="text-white-50 small">Đánh giá sao:</span>
                            <div class="card-stars-widget" id="modalStarWidget" data-movie-id="">
                                <button type="button" class="btn-card-star" data-star="1" title="1 sao" onclick="window.rateMovieFromCard(document.getElementById('modalStarWidget').dataset.movieId, 1, event, this)"><i class="bi bi-star"></i></button>
                                <button type="button" class="btn-card-star" data-star="2" title="2 sao" onclick="window.rateMovieFromCard(document.getElementById('modalStarWidget').dataset.movieId, 2, event, this)"><i class="bi bi-star"></i></button>
                                <button type="button" class="btn-card-star" data-star="3" title="3 sao" onclick="window.rateMovieFromCard(document.getElementById('modalStarWidget').dataset.movieId, 3, event, this)"><i class="bi bi-star"></i></button>
                                <button type="button" class="btn-card-star" data-star="4" title="4 sao" onclick="window.rateMovieFromCard(document.getElementById('modalStarWidget').dataset.movieId, 4, event, this)"><i class="bi bi-star"></i></button>
                                <button type="button" class="btn-card-star" data-star="5" title="5 sao" onclick="window.rateMovieFromCard(document.getElementById('modalStarWidget').dataset.movieId, 5, event, this)"><i class="bi bi-star"></i></button>
                            </div>
                            <span class="small ms-auto text-warning" id="modalRatingFeedback"></span>
                        </div>

                        <div class="mb-3">
                            <span class="text-muted small d-block mb-1">Thể loại:</span>
                            <div id="modalGenres" class="d-flex flex-wrap gap-1"></div>
                        </div>

                        <p id="modalDescription" class="text-muted small" style="line-height: 1.6;">
                            Thưởng thức phim bom tấn với chất lượng hình ảnh sắc nét, âm thanh vòm sống động và không quảng cáo trên nền tảng TFlix.
                        </p>

                        <div class="d-flex align-items-center gap-2 mt-4 flex-wrap">
                            <a id="modalWatchBtn" href="#" class="btn-tflix-primary">
                                <i class="bi bi-play-fill fs-5"></i>
                                <span>Xem phim ngay</span>
                            </a>
                            <a id="modalDetailBtn" href="#" class="btn-tflix-glass">
                                <i class="bi bi-info-circle"></i>
                                <span>Trang chi tiết</span>
                            </a>
                            <button type="button" id="modalFavBtn" class="btn-card-fav ms-1" style="width: 42px; height: 42px;" aria-label="Yêu thích">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
