<!-- LOGIN REQUIRED MODAL -->
<div class="modal fade tflix-modal" id="loginRequiredModal" tabindex="-1" aria-labelledby="loginModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title d-flex align-items-center gap-2" id="loginModalTitle">
                    <i class="bi bi-shield-lock-fill text-warning fs-4"></i>
                    <span>Yêu cầu đăng nhập</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-muted mb-0">
                    Bạn cần đăng nhập tài khoản TFlix để thưởng thức bộ phim này với chất lượng cao nhất và lưu vào danh sách xem sau.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn-tflix-glass" data-bs-dismiss="modal">Để sau</button>
                <a class="btn-tflix-primary" asp-controller="Auth" asp-action="Index">
                    <i class="bi bi-person-fill"></i> Đăng nhập ngay
                </a>
            </div>
        </div>
    </div>
</div>

<!-- TOAST NOTIFICATION CONTAINER -->
<div class="tflix-toast-container" id="toastContainer" aria-live="polite"></div>
<form id="favoriteTokenForm" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script>
        const isLoggedIn = @isLoggedIn.ToString().ToLower();
        const urlMoviesLatest = '@Url.Action("MoviesLatest", "Home")';
        const fallbackPoster = '@fallbackImage';

        // Toast notifications
        window.showTFlixToast = function(message, iconClass = 'bi-check-circle-fill') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            toast.className = 'tflix-toast';
            toast.innerHTML = `<i class="bi ${iconClass}"></i><span>${message}</span>`;
            container.appendChild(toast);
            
            setTimeout(() => toast.classList.add('show'), 20);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 350);
            }, 3200);
        };

        // Modal triggers
        function showLoginModal() {
            const modalEl = document.getElementById('loginRequiredModal');
            if (modalEl) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
            }
        }

        // Movie Card Click -> Navigate to Watch / Details
        function handleMovieCardClick(el) {
            const id = el.dataset.id;
            if (!id) return;
            if (!isLoggedIn) {
                showLoginModal();
                return;
            }
            window.location.href = `/Preview/Details?id=${encodeURIComponent(id)}&kind=MOVIE`;
        }

        // Quick View Modal
        function openQuickViewFromCard(card) {
            if (!card) return;
            const id = card.dataset.id;
            const title = card.dataset.title || 'Phim TFlix';
            const originalTitle = card.dataset.originalTitle || '';
            const poster = card.dataset.poster || fallbackPoster;
            const year = card.dataset.year || '2024';
            const genres = card.dataset.genres || 'Kịch tính';
            const rating = card.dataset.rating || '8.5';
            const country = card.dataset.country || 'Mỹ';
            const duration = card.dataset.duration || '120 phút';
            const quality = card.dataset.quality || 'FULL HD';
            const isPremium = card.dataset.premium === 'Y';

            document.getElementById('quickViewTitle').textContent = title;
            document.getElementById('modalOriginalTitle').textContent = originalTitle;
            document.getElementById('modalPoster').src = poster;
            document.getElementById('modalRating').textContent = rating;
            document.getElementById('modalYear').textContent = year;
            document.getElementById('modalCountry').textContent = country;
            document.getElementById('modalDuration').textContent = duration;
            document.getElementById('modalQualityBadge').textContent = quality;
            document.getElementById('modalVipBadge').style.display = isPremium ? 'inline-block' : 'none';

            // Genres badges
            const genresWrap = document.getElementById('modalGenres');
            genresWrap.innerHTML = '';
            genres.split('•').forEach(g => {
                const s = g.trim();
                if (s) {
                    const span = document.createElement('span');
                    span.className = 'badge bg-dark border border-secondary text-light';
                    span.textContent = s;
                    genresWrap.appendChild(span);
                }
            });

            // Action buttons
            document.getElementById('modalWatchBtn').href = `/Film/Watch?id=${encodeURIComponent(id)}&kind=MOVIE`;
            document.getElementById('modalDetailBtn').href = `/Preview/Details?id=${encodeURIComponent(id)}&kind=MOVIE`;
            
            const favBtn = document.getElementById('modalFavBtn');
            const isFav = localStorage.getItem(`tflix_fav_${id}`) === 'true';
            favBtn.classList.toggle('active', isFav);
            favBtn.onclick = () => window.toggleFavoriteMovie(id, title, favBtn);

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('quickViewModal'));
            modal.show();
        }

        window.toggleFavoriteMovie = async function(id, title, btn) {
            if (btn?.disabled) return;
            const oldHtml = btn?.innerHTML;
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>'; }
            try {
                const token = document.querySelector('#favoriteTokenForm input[name="__RequestVerificationToken"]')?.value || '';
                const body = new URLSearchParams({ movieId: id, __RequestVerificationToken: token });
                const response = await fetch('@Url.Action("ToggleMovie", "Favorite")', {
                    method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body
                });
                const result = await response.json();
                if (response.status === 401) {
                    window.location.href = result.loginUrl || '@Url.Action("Index", "Auth")';
                    return;
                }
                if (!response.ok || !result.success) throw new Error(result.message || 'Không thể cập nhật yêu thích.');
                const active = result.data?.isFavorite ?? result.data?.IsFavorite ?? false;
                document.querySelectorAll(`.movie-card-item[data-id="${id}"] .btn-card-fav`).forEach(b => b.classList.toggle('active', active));
                if (btn) btn.classList.toggle('active', active);
                window.showTFlixToast(active ? `Đã thêm "${title}" vào phim yêu thích!` : `Đã xóa "${title}" khỏi phim yêu thích.`, active ? 'bi-heart-fill text-danger' : 'bi-heartbreak');
            } catch (error) {
                window.showTFlixToast(error.message || 'Có lỗi xảy ra.', 'bi-exclamation-circle');
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = oldHtml; }
            }
        };

        async function syncFavoriteButtons() {
            try {
                const response = await fetch('@Url.Action("MovieIds", "Favorite")');
                if (!response.ok) return;
                const result = await response.json();
                const ids = new Set((result.data || []).map(String));
                document.querySelectorAll('.movie-card-item').forEach(card => {
                    card.querySelector('.btn-card-fav')?.classList.toggle('active', ids.has(card.dataset.id));
                });
            } catch { }
        }

        // Render Phim lẻ mới nhất with error retry
        function renderMoviesLatest(list) {
            const wrap = $('#moviesLatestWrap');
            if (!list || list.length === 0) {
                wrap.html('<div class="col-12 p-4 text-center text-muted bg-dark rounded-3 border border-secondary">Chưa có danh sách phim lẻ mới nhất.</div>');
                return;
            }

            wrap.html(list.map(x => {
                const id = x.movieId ?? x.movie_id ?? x.MovieId ?? x.moviE_ID;
                const title = x.title ?? x.Title ?? 'Chưa có tên';
                const originalTitle = x.originalTitle ?? x.original_title ?? x.OriginalTitle ?? '';
                const poster = x.posterUrl ?? x.poster_url ?? x.PosterUrl ?? fallbackPoster;
                const genres = x.genres ?? x.Genres ?? 'Phim lẻ chất lượng';
                const year = (x.releaseDate || x.ReleaseDate) ? new Date(x.releaseDate ?? x.ReleaseDate).getFullYear() : '2024';
                const country = x.countryCode ?? x.country_code ?? x.CountryCode ?? 'VN';
                const isPremium = (x.isPremium === 'Y' || x.is_premium === 'Y' || x.IsPremium === true);
                const quality = isPremium ? '4K VIP' : 'FULL HD';
                const rating = '8.6';

                return `
                <div class="movie-card-item"
                     data-id="${id}"
                     data-title="${title}"
                     data-original-title="${originalTitle}"
                     data-poster="${poster}"
                     data-year="${year}"
                     data-genres="${genres}"
                     data-rating="${rating}"
                     data-country="${country}"
                     data-quality="${quality}"
                     data-duration="120 phút"
                     data-premium="${isPremium ? 'Y' : 'N'}"
                     onclick="handleMovieCardClick(this)">
                    
                    <div class="movie-poster-wrap">
                        <div class="card-badge-top-left">
                            ${isPremium ? '<span class="badge-vip">VIP</span>' : ''}
                            <span class="badge-quality">${quality}</span>
                        </div>
                        <div class="card-badge-top-right">
                            <button type="button" class="btn-card-fav" aria-label="Yêu thích" onclick="event.stopPropagation(); window.toggleFavoriteMovie(${id}, '${title.replace(/'/g, "\\'")}', this)">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>
                        <img class="movie-poster-img" src="${poster}" alt="Poster ${title}" loading="lazy" onerror="this.src='${fallbackPoster}'" />
                        <div class="card-hover-overlay">
                            <div class="btn-play-circle" title="Xem ngay"><i class="bi bi-play-fill"></i></div>
                            <div class="card-quick-actions">
                                <button type="button" class="btn-quick-info" onclick="event.stopPropagation(); openQuickViewFromCard(this.closest('.movie-card-item'))">
                                    <i class="bi bi-info-circle"></i> Xem nhanh
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="movie-card-body">
                        <div class="movie-card-title">${title}</div>
                        <div class="movie-card-original-title">${genres}</div>
                        <div class="movie-card-meta">
                            <span>${year} • ${country}</span>
                            <span class="card-rating-tag"><i class="bi bi-star-fill"></i> ${rating}</span>
                        </div>
                    </div>
                </div>`;
            }).join(''));

            syncFavoriteButtons();
        }

        function loadMoviesLatest() {
            $.get(urlMoviesLatest, function (res) {
                const list = res?.data?.table ?? res?.Data?.table ?? res?.table ?? res?.items ?? res?.Items ?? [];
                renderMoviesLatest(Array.isArray(list) ? list : []);
            }).fail(() => {
                $('#moviesLatestWrap').html(`
                    <div class="col-12 p-4 text-center bg-dark rounded-3 border border-secondary text-muted">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-3 mb-2 d-block"></i>
                        <p class="mb-2">Không thể tải danh sách phim lẻ mới nhất do sự cố kết nối.</p>
                        <button type="button" class="btn-tflix-glass btn-sm" onclick="loadMoviesLatest()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Thử lại
                        </button>
                    </div>
                `);
            });
        }

        // Client-side quick filter via Genre Chips
        window.handleGenreChipFilter = function(genreKey) {
            if (genreKey === 'all') {
                document.querySelectorAll('.movie-card-item').forEach(c => c.style.display = '');
                return;
            }

            const genreMap = {
                'action': 'hành động',
                'cinema': 'chiếu rạp',
                'scifi': 'khoa học',
                'anime': 'anime',
                'historical': 'cổ trang',
                'horror': 'kinh dị',
                'romance': 'tình cảm',
                'comedy': 'hài'
            };

            const term = genreMap[genreKey] || genreKey;
            let count = 0;

            document.querySelectorAll('#hotMoviesGrid .movie-card-item').forEach(card => {
                const genres = (card.dataset.genres || '').toLowerCase();
                const title = (card.dataset.title || '').toLowerCase();
                if (genres.includes(term) || title.includes(term)) {
                    card.style.display = '';
                    count++;
                } else {
                    card.style.display = 'none';
                }
            });

            if (window.showTFlixToast) {
                window.showTFlixToast(`Đang lọc theo thể loại: ${term.toUpperCase()}`);
            }
        };

        $(document).ready(function () {
            loadMoviesLatest();
            syncFavoriteButtons();
        });
    </script>
}
