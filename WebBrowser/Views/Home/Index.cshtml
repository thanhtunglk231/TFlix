@model WebBrowser.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "TFlix - Xem Phim Trực Tuyến Đỉnh Cao";
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
    
    var allMovies = Model?.Movies ?? new List<WebBrowser.Models.Movie.MovieItem>();
    
    // Phân chia dữ liệu phim hợp lý không bị trùng lặp khó chịu
    var hotMovies = allMovies.Take(5).ToList();
    var top5Movies = allMovies.OrderByDescending(m => m.AvgRating ?? (decimal)(7.5 + (m.MovieId % 20) / 10.0)).Take(5).ToList();
    var mostViewedMovies = allMovies.OrderByDescending(m => m.SourceCount).ThenBy(m => m.MovieId).Skip(1).Take(5).ToList();
    if (mostViewedMovies.Count == 0 && allMovies.Count > 0)
    {
        mostViewedMovies = allMovies.Take(5).ToList();
    }
    
    var recentlyUpdatedMovies = allMovies.OrderByDescending(m => m.UpdatedAt ?? m.CreatedAt ?? m.ReleaseDate).Take(5).ToList();
    var upcomingList = allMovies.OrderByDescending(m => m.ReleaseDate).Take(3).ToList();
    
    var fallbackImage = "https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?q=80&w=800&auto=format&fit=crop";
}

<div class="container py-3">
    <!-- 1. HERO BANNER CINEMATIC (21:9 ratio, multi-stop gradient, auto-slide) -->
    @await Html.PartialAsync("_HeroBanner", allMovies)

    <!-- 2. KHÁM PHÁ THEO THỂ LOẠI (Chip Buttons) -->
    @await Html.PartialAsync("_GenreChips")

    <!-- 3. SECTION: PHIM HOT -->
    <section class="tflix-section" id="hotMoviesSection">
        <div class="section-header">
            <div class="section-title-wrap">
                <div class="section-icon-badge" style="background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.35); color: #f87171;">
                    <i class="bi bi-fire"></i>
                </div>
                <h2 class="section-title">Phim hot thịnh hành</h2>
            </div>
            <div class="section-divider-line d-none d-md-block"></div>
            <a class="btn-view-all" asp-controller="Movies" asp-action="Index">
                <span>Xem tất cả</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="movie-grid" id="hotMoviesGrid">
            @foreach (var movie in hotMovies)
            {
                var year = movie.ReleaseDate?.Year.ToString() ?? "2024";
                var genres = !string.IsNullOrEmpty(movie.Genres) ? movie.Genres : "Hành động • Kịch tính";
                var rating = movie.AvgRating.HasValue ? movie.AvgRating.Value.ToString("0.0") : (7.8 + (movie.MovieId % 15) / 10.0).ToString("0.0");
                var poster = !string.IsNullOrEmpty(movie.PosterUrl) ? movie.PosterUrl : fallbackImage;
                var country = !string.IsNullOrEmpty(movie.CountryCode) ? movie.CountryCode : "US";
                var quality = movie.IsPremium ? "4K VIP" : "FULL HD";
                var subType = (movie.MovieId % 2 == 0) ? "Vietsub" : "Thuyết minh";

                <div class="movie-card-item"
                     data-id="@movie.MovieId"
                     data-title="@movie.Title"
                     data-original-title="@(movie.OriginalTitle ?? "")"
                     data-poster="@poster"
                     data-year="@year"
                     data-genres="@genres"
                     data-rating="@rating"
                     data-country="@country"
                     data-quality="@quality"
                     data-duration="@(movie.DurationMin.HasValue ? $"{movie.DurationMin} phút" : "115 phút")"
                     data-premium="@(movie.IsPremium ? "Y" : "N")"
                     onclick="handleMovieCardClick(this)">
                    
                    <div class="movie-poster-wrap">
                        <div class="card-badge-top-left">
                            @if (movie.IsPremium)
                            {
                                <span class="badge-vip">VIP</span>
                            }
                            <span class="badge-quality">@quality</span>
                        </div>

                        <div class="card-badge-top-right">
                            <button type="button"
                                    class="btn-card-fav"
                                    aria-label="Thêm vào yêu thích"
                                    onclick="event.stopPropagation(); window.toggleFavoriteMovie(@movie.MovieId, '@Html.Raw(movie.Title.Replace("'", "\\'"))', this)">
                                <i class="bi bi-heart"></i>
                            </button>
                        </div>

                        <img class="movie-poster-img"
                             src="@poster"
                             alt="Poster phim @movie.Title"
                             loading="lazy"
                             onerror="this.src='@fallbackImage'" />

                        <div class="card-hover-overlay">
                            <div class="btn-play-circle" title="Xem phim ngay">
                                <i class="bi bi-play-fill"></i>
                            </div>
                            <div class="card-quick-actions">
                                <button type="button"
                                        class="btn-quick-info"
                                        onclick="event.stopPropagation(); openQuickViewFromCard(this.closest('.movie-card-item'))">
                                    <i class="bi bi-info-circle"></i> Xem nhanh
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="movie-card-body">
                        <div class="movie-card-title" title="@movie.Title">@movie.Title</div>
                        @if (!string.IsNullOrEmpty(movie.OriginalTitle) && movie.OriginalTitle != movie.Title)
                        {
                            <div class="movie-card-original-title">@movie.OriginalTitle</div>
                        }
                        else
                        {
                            <div class="movie-card-original-title">@genres</div>
                        }

                        <div class="movie-card-meta">
                            <div class="d-flex align-items-center gap-1">
                                <span>@year</span>
                                <span>•</span>
                                <span>@country</span>
                                <span>•</span>
                                <span class="text-info">@subType</span>
                            </div>
                            <span class="card-rating-tag">
                                <i class="bi bi-star-fill"></i> @rating
                            </span>
                        </div>
                    </div>
                </div>
            }

            @if (hotMovies.Count == 0)
            {
                <div class="col-12 p-4 text-center text-muted bg-dark rounded-3 border border-secondary">
                    Chưa có danh sách phim hot. Vui lòng quay lại sau!
                </div>
            }
        </div>
    </section>

    <!-- 4. SECTION: PHIM LẺ MỚI NHẤT (Loaded via AJAX from /Home/MoviesLatest with skeleton shimmer) -->
    <section class="tflix-section" id="movies-latest-section">
        <div class="section-header">
            <div class="section-title-wrap">
                <div class="section-icon-badge" style="background: rgba(22, 131, 255, 0.15); border-color: rgba(22, 131, 255, 0.35); color: #60a5fa;">
                    <i class="bi bi-film"></i>
                </div>
                <h2 class="section-title">Phim lẻ mới nhất</h2>
            </div>
            <div class="section-divider-line d-none d-md-block"></div>
            <a class="btn-view-all" asp-controller="Single" asp-action="Index">
                <span>Xem tất cả</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <!-- Skeleton loaders while loading AJAX -->
        <div class="movie-grid" id="moviesLatestWrap">
            @for (int i = 0; i < 5; i++)
            {
                <div class="skeleton-card">
                    <div class="skeleton-poster"></div>
                    <div class="skeleton-body">
                        <div class="skeleton-line title"></div>
                        <div class="skeleton-line meta"></div>
                    </div>
                </div>
            }
