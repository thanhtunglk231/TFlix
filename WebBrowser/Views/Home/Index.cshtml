@model WebBrowser.Models.Home.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var movies = Model?.Movies ?? new();
    var featuredMovie = movies.FirstOrDefault();
    var hotMovies = movies.Take(4).ToList();
    var topMovies = movies.Take(5).ToList();
    var comingMovies = movies.OrderByDescending(movie => movie.ReleaseDate).Take(3).ToList();
    var fallbackImage = "https://images.unsplash.com/photo-1524985069026-dd778a71c7b4?q=80&w=1600&auto=format&fit=crop";
}

@section Styles {
    <style>
        :root { --brand: #27d3c3; --brand2: #19b3a5; }
        .hero { min-height: 52vh; border-radius: 18px; overflow: hidden; position: relative; background-color: #0e1114; background-position: center; background-size: cover; }
        .hero::before { content: ""; position: absolute; inset: 0; background: linear-gradient(120deg, rgba(0,0,0,.78), rgba(0,0,0,.35) 55%, rgba(0,0,0,.78)); }
        .hero .inner { position: relative; z-index: 2; max-width: 720px; }
        .badge-brand { background: linear-gradient(135deg, var(--brand), var(--brand2)); }
        .movie-card { border: none; border-radius: 16px; overflow: hidden; background: #12161a; box-shadow: 0 2px 16px rgba(0,0,0,.25); transition: transform .28s, box-shadow .28s; }
        .movie-card:hover { transform: translateY(-6px); box-shadow: 0 10px 30px rgba(0,0,0,.35); }
        .poster { aspect-ratio: 16/9; width: 100%; object-fit: cover; transition: transform .4s; }
        .movie-card:hover .poster { transform: scale(1.06); }
        .movie-overlay { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: linear-gradient(to top, rgba(0,0,0,.65), transparent 45%); opacity: 0; transition: .25s; }
        .movie-card:hover .movie-overlay { opacity: 1; }
        .play-btn { width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; color: #001014; background: linear-gradient(135deg, var(--brand), #39f); }
        .movie-meta { font-size: .875rem; color: #9fb1bd; }
        .section-title { display: flex; align-items: center; gap: .75rem; margin: 2rem 0 1rem; font-weight: 700; }
        .section-title::after { content: ""; height: 2px; flex: 1; background: linear-gradient(90deg, var(--brand), transparent); }
        .chips-wrap { display: flex; flex-wrap: wrap; gap: .75rem; }
        .chip { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem .85rem; border-radius: 14px; background: #14181c; border: 1px solid rgba(255,255,255,.06); color: #dbe6ee; text-decoration: none; }
        .chip i { color: var(--brand); }
        .scrollbar-hidden::-webkit-scrollbar { display: none; }
    </style>
}

<div class="container my-4">
    <div id="hero" class="hero p-4 p-md-5" style="background-image: url('@(featuredMovie?.PosterUrl ?? fallbackImage)');">
        <div class="inner">
            <span class="badge badge-brand mb-3">Phim đề xuất</span>
            <h1 class="display-5 fw-bold">@(featuredMovie?.Title ?? "TFlix")</h1>
            <p class="lead text-secondary">@(featuredMovie?.Genres ?? "Khám phá kho phim mới nhất trên TFlix.")</p>
            @if (featuredMovie is not null)
            {
                <a asp-controller="Preview" asp-action="Details" asp-route-id="@featuredMovie.MovieId" asp-route-kind="MOVIE" class="btn btn-primary btn-lg"><i class="bi bi-play-fill me-1"></i>Xem ngay</a>
            }
        </div>
    </div>

    <section class="my-5">
        <div class="section-title">Phim hot</div>
        <div class="row g-3">
            @foreach (var movie in hotMovies)
            {
                <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                    <div class="card movie-card position-relative" data-id="@movie.MovieId" data-kind="MOVIE">
                        <img class="poster" src="@(movie.PosterUrl ?? fallbackImage)" alt="@movie.Title" loading="lazy">
                        <div class="movie-overlay"><div class="play-btn"><i class="bi bi-play-fill fs-3"></i></div></div>
                        <div class="card-body"><h6 class="card-title mb-1">@movie.Title</h6><div class="movie-meta">@(movie.ReleaseDate?.Year.ToString() ?? "") • @(movie.Genres ?? "Không rõ thể loại")</div></div>
                    </div>
                </div>
            }
            @if (hotMovies.Count == 0) { <div class="col-12 text-secondary">Chưa có dữ liệu phim.</div> }
        </div>
    </section>

    <section class="my-5" id="movies-latest-section">
        <div class="section-title">Phim lẻ mới nhất</div>
        <div class="row g-3" id="moviesLatestWrap"></div>
    </section>

    <section class="my-5">
        <div class="section-title">Top 5 phim hôm nay</div>
        <div class="d-flex gap-3 overflow-auto scrollbar-hidden pb-1">
            @foreach (var movie in topMovies)
            {
                <div class="card movie-card position-relative" style="min-width:220px;" data-id="@movie.MovieId" data-kind="MOVIE">
                    <img class="poster" src="@(movie.PosterUrl ?? fallbackImage)" alt="@movie.Title" loading="lazy">
                    <div class="movie-overlay"><div class="play-btn"><i class="bi bi-play-fill fs-3"></i></div></div>
                    <div class="card-body"><h6 class="card-title mb-0">@movie.Title</h6></div>
                </div>
            }
            @if (topMovies.Count == 0) { <div class="text-secondary">Chưa có dữ liệu phim.</div> }
        </div>
    </section>

    <section class="my-5">
        <div class="section-title">Khám phá</div>
        <div class="chips-wrap">
            <a class="chip" asp-controller="Movies" asp-action="Index" asp-route-genre="cinema"><i class="bi bi-gift-fill"></i>Phim chiếu rạp</a>
            <a class="chip" asp-controller="Movies" asp-action="Index" asp-route-genre="historical"><i class="bi bi-brush-fill"></i>Phim cổ trang</a>
            <a class="chip" asp-controller="Movies" asp-action="Index" asp-route-genre="action"><i class="bi bi-lightning-charge-fill"></i>Phim hành động</a>
            <a class="chip" asp-controller="Movies" asp-action="Index" asp-route-genre="scifi"><i class="bi bi-rocket-takeoff-fill"></i>Khoa học - Viễn tưởng</a>
            <a class="chip" asp-controller="Movies" asp-action="Index" asp-route-genre="anime"><i class="bi bi-emoji-sunglasses-fill"></i>Anime</a>
        </div>
    </section>

    <section class="my-5">
        <div class="section-title">Phim sắp chiếu</div>
        <div id="coming" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner rounded-4 overflow-hidden">
                @foreach (var movie in comingMovies)
                {
                    <div class="carousel-item @(movie == comingMovies.First() ? "active" : "")">
                        <img src="@(movie.PosterUrl ?? fallbackImage)" class="d-block w-100" alt="@movie.Title">
                        <div class="carousel-caption text-start"><span class="badge badge-brand">@(movie.ReleaseDate?.ToString("dd/MM/yyyy") ?? "Sắp ra mắt")</span><h5 class="fw-bold">@movie.Title</h5><p class="small">@movie.Genres</p></div>
                    </div>
                }
                @if (comingMovies.Count == 0) { <div class="p-5 text-secondary">Chưa có dữ liệu phim.</div> }
            </div>
            @if (comingMovies.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#coming" data-bs-slide="prev"><span class="carousel-control-prev-icon"></span></button>
                <button class="carousel-control-next" type="button" data-bs-target="#coming" data-bs-slide="next"><span class="carousel-control-next-icon"></span></button>
            }
        </div>
    </section>
</div>

<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content bg-dark text-light border border-secondary"><div class="modal-header border-0"><h5 class="modal-title"><i class="bi bi-shield-lock-fill me-2 text-warning"></i>Cần đăng nhập</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body">Bạn cần đăng nhập để xem nội dung phim này.</div><div class="modal-footer border-0"><a class="btn btn-primary" asp-controller="Auth" asp-action="Index">Đăng nhập ngay</a><button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Để sau</button></div></div></div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script>
        const isLoggedIn = @isLoggedIn.ToString().ToLower();
        const urlMoviesLatest = '@Url.Action("MoviesLatest", "Home")';
        function showLoginModal() { bootstrap.Modal.getOrCreateInstance(document.getElementById('loginRequiredModal')).show(); }
        $(document).on('click', '.movie-card', function (e) {
            const id = this.dataset.id;
            if (!id) return;
            if (!isLoggedIn) { e.preventDefault(); showLoginModal(); return; }
            window.location.href = `/Preview/Details?id=${encodeURIComponent(id)}&kind=MOVIE`;
        });
        function renderMoviesLatest(list) {
            const wrap = $('#moviesLatestWrap');
            if (!list?.length) { wrap.html('<div class="col-12 text-secondary">Chưa có dữ liệu.</div>'); return; }
            wrap.html(list.map(x => {
                const id = x.movieId ?? x.movie_id ?? x.MovieId ?? x.moviE_ID;
                const title = x.title ?? x.Title ?? 'Chưa có tên';
                const poster = x.posterUrl ?? x.poster_url ?? x.PosterUrl ?? '@fallbackImage';
                const genres = x.genres ?? x.Genres ?? 'Không rõ thể loại';
                const year = (x.releaseDate || x.ReleaseDate) ? new Date(x.releaseDate ?? x.ReleaseDate).getFullYear() : '';
                return `<div class="col-12 col-sm-6 col-lg-4 col-xl-3"><div class="card movie-card position-relative" data-id="${id}" data-kind="MOVIE"><img class="poster" src="${poster}" alt="${title}" loading="lazy"><div class="movie-overlay"><div class="play-btn"><i class="bi bi-play-fill fs-3"></i></div></div><div class="card-body"><h6 class="card-title mb-1">${title}</h6><div class="movie-meta">${year ? year + ' • ' : ''}${genres}</div></div></div></div>`;
            }).join(''));
        }
        $.get(urlMoviesLatest, function (res) {
            const list = res?.data?.table ?? res?.Data?.table ?? res?.table ?? res?.items ?? res?.Items ?? [];
            renderMoviesLatest(Array.isArray(list) ? list : []);
        }).fail(() => $('#moviesLatestWrap').html('<div class="col-12 text-danger">Lỗi tải danh sách phim.</div>'));
    </script>
}
