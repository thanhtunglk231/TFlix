            <span class="text-muted small d-none d-md-inline">Cập nhật mỗi ngày</span>
        </div>

        <div class="top-ranking-row" role="region" aria-label="Top 5 phim hôm nay">
            @for (int i = 0; i < top5Movies.Count; i++)
            {
                var movie = top5Movies[i];
                var year = movie.ReleaseDate?.Year.ToString() ?? "2024";
                var genres = !string.IsNullOrEmpty(movie.Genres) ? movie.Genres : "Kịch tính • Xuất sắc";
                var rating = movie.AvgRating.HasValue ? movie.AvgRating.Value.ToString("0.0") : (8.9 - i * 0.2).ToString("0.0");
                var poster = !string.IsNullOrEmpty(movie.PosterUrl) ? movie.PosterUrl : fallbackImage;
                var country = !string.IsNullOrEmpty(movie.CountryCode) ? movie.CountryCode : "VN";
                var quality = movie.IsPremium ? "4K VIP" : "FULL HD";
                var rank = i + 1;

                <div class="top-ranking-item">
                    <span class="rank-number">@rank</span>
                    <div class="movie-card-item"
                         data-id="@movie.MovieId"
                         data-title="@movie.Title"
                         data-original-title="@(movie.OriginalTitle ?? "")"
                         data-poster="@poster"
                         data-year="@year"
                         data-genres="@genres"
                         data-rating="@rating"
                         data-country="@country"
                         data-quality="@quality"
                         data-duration="@(movie.DurationMin.HasValue ? $"{movie.DurationMin} phút" : "125 phút")"
