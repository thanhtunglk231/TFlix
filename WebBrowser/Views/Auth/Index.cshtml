@{
    ViewData["Title"] = "Đăng nhập";
    var returnUrl = Context?.Request?.Query["returnUrl"].ToString() ?? "/";
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
}

@section Styles {
    <style>
        .auth-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }
        .login-card {
            width: 100%;
            max-width: 440px;
            background: rgba(18, 22, 26, 0.92);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 25px rgba(39, 211, 195, 0.08);
        }
        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 600;
            background: rgba(39, 211, 195, 0.15);
            color: #27d3c3;
            border: 1px solid rgba(39, 211, 195, 0.3);
        }
        .form-floating > .form-control {
            background-color: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #fff;
            border-radius: 12px;
        }
        .form-floating > .form-control:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: #27d3c3;
            box-shadow: 0 0 0 0.25rem rgba(39, 211, 195, 0.2);
            color: #fff;
        }
        .form-floating > label {
            color: #9fb1bd;
        }
        .btn-brand {
            background: linear-gradient(135deg, #27d3c3, #19b3a5);
            color: #001014;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 12px;
            transition: all 0.25s ease;
        }
        .btn-brand:hover {
            background: linear-gradient(135deg, #2de6d4, #1fc9ba);
            color: #000;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(39, 211, 195, 0.3);
        }
        .demo-chip {
            background: rgba(255, 255, 255, 0.06);
            border: 1px dashed rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            padding: 8px 12px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.85rem;
            color: #9fb1bd;
        }
        .demo-chip:hover {
            background: rgba(39, 211, 195, 0.12);
            border-color: #27d3c3;
            color: #27d3c3;
        }
    </style>
}

<div class="auth-container">
    <div class="card login-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="brand-badge mb-2"><i class="bi bi-shield-lock-fill"></i> TFlix Security</span>
                <h3 class="fw-bold text-white mb-1">Đăng nhập tài khoản</h3>
                <p class="text-secondary small">Trải nghiệm rạp chiếu phim trực tuyến đỉnh cao</p>
            </div>

            <div id="msgBox" class="alert d-none" role="alert"></div>

            <form id="loginForm" autocomplete="on">
                @Html.AntiForgeryToken()

                <div class="form-floating mb-3">
                    <input type="email" class="form-control" id="username" placeholder="name@example.com" value="thanhtung230323@gmail.com" required>
                    <label for="username"><i class="bi bi-envelope me-1"></i> Email</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" class="form-control" id="password" placeholder="••••••••" value="string" required>
                    <label for="password"><i class="bi bi-key me-1"></i> Mật khẩu</label>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="showPass">
                        <label class="form-check-label text-secondary small" for="showPass" style="cursor:pointer;">Hiện mật khẩu</label>
                    </div>
                    <a class="small text-decoration-none" style="color: #27d3c3;" href="#">Quên mật khẩu?</a>
                </div>

                <div class="d-grid mb-3">
                    <button id="btnLogin" type="submit" class="btn btn-brand">
                        <span class="spinner-border spinner-border-sm me-2 d-none" id="btnSpinner" role="status" aria-hidden="true"></span>
                        Đăng nhập ngay
                    </button>
                </div>

                <!-- Quick Test Credentials -->
                <div class="demo-chip text-center mb-2" id="fillDemoUser" title="Nhấn để tự động điền tài khoản mẫu">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i>
                    Tài khoản demo: <strong>thanhtung230323@gmail.com</strong>
                </div>
            </form>

            <div class="text-center mt-4 pt-2 border-top border-secondary border-opacity-25">
                <span class="text-secondary small">Chưa có tài khoản TFlix?</span>
                <a href="#" class="small fw-semibold ms-1" style="color: #27d3c3;">Đăng ký miễn phí</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        (function () {
            const $form = $("#loginForm");
            const $btn = $("#btnLogin");
            const $spin = $("#btnSpinner");
            const $msg = $("#msgBox");
            const returnUrl = "@returnUrl";

            // Toggle show password
            $("#showPass").on("change", function () {
                $("#password").attr("type", this.checked ? "text" : "password");
            });

            // Quick Fill demo credentials
            $("#fillDemoUser").on("click", function () {
                $("#username").val("thanhtung230323@gmail.com");
                $("#password").val("string");
            });

            function showMsg(text, type) {
                $msg.removeClass("d-none alert-success alert-danger alert-warning")
                    .addClass("alert-" + type).text(text);
            }
            function resetMsg() {
                $msg.addClass("d-none").text("");
            }
            function setBusy(busy) {
                $btn.prop("disabled", busy);
                $spin.toggleClass("d-none", !busy);
            }

            $form.on("submit", function (e) {
                e.preventDefault();
                resetMsg();

                const username = $("#username").val().trim();
                const password = $("#password").val();

                if (!username || !password) {
                    showMsg("Vui lòng nhập đầy đủ email và mật khẩu.", "warning");
                    return;
                }

                setBusy(true);

                const anti = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: "/auth/login",
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    headers: anti ? { "RequestVerificationToken": anti } : {},
                    data: JSON.stringify({ username, password }),
                    success: function (res) {
                        const ok = res && (res.success === true || res.code === "200");
                        if (ok) {
                            showMsg("Đăng nhập thành công! Đang chuyển trang...", "success");
                            setTimeout(function () {
                                window.location.href = returnUrl || "/";
                            }, 500);
                        } else {
                            showMsg(res?.message || "Đăng nhập thất bại. Vui lòng kiểm tra lại tài khoản.", "danger");
                        }
                    },
                    error: function (xhr) {
                        const text = xhr?.responseJSON?.message || xhr?.responseText || "Lỗi đăng nhập. Vui lòng thử lại.";
                        showMsg(text, "danger");
                    },
                    complete: function () {
                        setBusy(false);
                    }
                });
            });
        })();
    </script>
}
