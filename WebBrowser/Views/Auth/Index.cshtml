@{
    ViewData["Title"] = "Đăng nhập hoặc đăng ký";
    var returnUrl = Context?.Request?.Query["returnUrl"].ToString() ?? "/";
}

@section Styles {
    <style>
        .auth-container {
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .auth-card {
            width: 100%;
            max-width: 460px;
            background: rgba(18, 22, 26, .94);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, .1);
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, .5), 0 0 25px rgba(39, 211, 195, .08);
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: .8rem;
            font-weight: 600;
            background: rgba(39, 211, 195, .15);
            color: #27d3c3;
            border: 1px solid rgba(39, 211, 195, .3);
        }

        .auth-tabs {
            padding: 5px;
            background: rgba(255, 255, 255, .05);
            border-radius: 12px;
        }

        .auth-tabs .nav-link {
            color: #9fb1bd;
            border-radius: 9px;
            font-weight: 600;
        }

        .auth-tabs .nav-link.active {
            color: #001014;
            background: #27d3c3;
        }

        .form-floating > .form-control {
            background-color: rgba(255, 255, 255, .05);
            border: 1px solid rgba(255, 255, 255, .12);
            color: #fff;
            border-radius: 12px;
        }

        .form-floating > .form-control:focus {
            background-color: rgba(255, 255, 255, .08);
            border-color: #27d3c3;
            box-shadow: 0 0 0 .25rem rgba(39, 211, 195, .2);
            color: #fff;
        }

        .form-floating > label { color: #9fb1bd; }

        .btn-brand {
            background: linear-gradient(135deg, #27d3c3, #19b3a5);
            color: #001014;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 12px;
        }

        .btn-brand:hover { color: #000; background: linear-gradient(135deg, #2de6d4, #1fc9ba); }
        .btn-google { background:#fff;color:#202124;border:1px solid #dadce0;border-radius:12px;padding:11px;font-weight:600; }
        .btn-google:hover { background:#f8f9fa;color:#111;box-shadow:0 2px 8px rgba(0,0,0,.25); }
    </style>
}

<div class="auth-container">
    <div class="card auth-card">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="brand-badge mb-2"><i class="bi bi-shield-lock-fill"></i> TFlix Security</span>
                <h3 class="fw-bold text-white mb-1">Tài khoản TFlix</h3>
                <p class="text-secondary small">Đăng nhập để tiếp tục xem phim hoặc tạo tài khoản miễn phí</p>
            </div>

            <ul class="nav nav-pills nav-fill auth-tabs mb-4" role="tablist">
                <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#loginPane" type="button">Đăng nhập</button></li>
                <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#registerPane" type="button"><i class="bi bi-shield-check me-1"></i>Đăng ký OTP</button></li>
            </ul>

            <div id="msgBox" class="alert d-none" role="alert"></div>
            @Html.AntiForgeryToken()

            <div class="d-grid mb-3">
                <a class="btn btn-google d-flex align-items-center justify-content-center gap-2" href="@Url.Action("GoogleLogin", "Auth", new { returnUrl })">
                    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path fill="#4285F4" d="M17.64 9.205c0-.638-.057-1.252-.164-1.841H9v3.482h4.844a4.14 4.14 0 0 1-1.797 2.716v2.258h2.909c1.702-1.567 2.684-3.875 2.684-6.615Z"/><path fill="#34A853" d="M9 18c2.43 0 4.468-.806 5.956-2.18l-2.909-2.258c-.806.54-1.835.86-3.047.86-2.344 0-4.328-1.585-5.037-3.714H.956v2.332A9 9 0 0 0 9 18Z"/><path fill="#FBBC05" d="M3.963 10.708A5.41 5.41 0 0 1 3.682 9c0-.592.102-1.168.281-1.708V4.96H.956A9 9 0 0 0 0 9c0 1.452.347 2.827.956 4.04l3.007-2.332Z"/><path fill="#EA4335" d="M9 3.578c1.322 0 2.508.454 3.441 1.346l2.582-2.582C13.464.89 11.426 0 9 0A9 9 0 0 0 .956 4.96l3.007 2.332C4.672 5.163 6.656 3.578 9 3.578Z"/></svg>
                    Tiếp tục với Google
                </a>
            </div>
            <div class="d-flex align-items-center gap-2 mb-3"><hr class="flex-grow-1 border-secondary"><span class="small text-secondary">hoặc</span><hr class="flex-grow-1 border-secondary"></div>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="loginPane">
                    <ul class="nav nav-pills nav-fill auth-tabs mb-3" role="tablist" aria-label="Chọn hình thức đăng nhập">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#userPasswordPane" type="button"><i class="bi bi-key me-1"></i>Mật khẩu</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#userOtpPane" type="button"><i class="bi bi-shield-check me-1"></i>OTP</button></li>
                    </ul>
                    <div class="tab-content">
                    <div class="tab-pane fade show active" id="userPasswordPane">
                    <form id="loginForm" autocomplete="on">
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="username" placeholder="name@example.com" required>
                            <label for="username"><i class="bi bi-envelope me-1"></i>Email</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="password" placeholder="Mật khẩu" required>
                            <label for="password"><i class="bi bi-key me-1"></i>Mật khẩu</label>
                        </div>
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="showLoginPassword">
                            <label class="form-check-label text-secondary small" for="showLoginPassword">Hiện mật khẩu</label>
                        </div>
                        <div class="d-grid">
                            <button id="btnLogin" type="submit" class="btn btn-brand">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>Đăng nhập ngay
                            </button>
                        </div>
                    </form>
                    </div>
                    <div class="tab-pane fade" id="userOtpPane">
                        <form id="loginOtpForm" autocomplete="on">
                            <div class="input-group mb-3">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="loginOtpEmail" placeholder="name@example.com" required>
                                    <label for="loginOtpEmail"><i class="bi bi-envelope me-1"></i>Email</label>
                                </div>
                                <button type="button" id="btnLoginSendOtp" class="btn btn-outline-info">Gửi OTP</button>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" inputmode="numeric" class="form-control" id="loginOtp" placeholder="OTP" maxlength="6" required>
                                <label for="loginOtp"><i class="bi bi-shield-check me-1"></i>Mã OTP</label>
                            </div>
                            <div class="d-grid">
                                <button id="btnLoginOtp" type="submit" class="btn btn-brand">
                                    <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>Đăng nhập bằng OTP
                                </button>
                            </div>
                        </form>
                    </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="registerPane">
                    <form id="registerForm" autocomplete="on">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="registerFullName" placeholder="Họ và tên" maxlength="200" required>
                            <label for="registerFullName"><i class="bi bi-person me-1"></i>Họ và tên</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="registerEmail" placeholder="name@example.com" maxlength="320" required>
                            <label for="registerEmail"><i class="bi bi-envelope me-1"></i>Email</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="registerPassword" placeholder="Mật khẩu" minlength="8" required>
                            <label for="registerPassword"><i class="bi bi-key me-1"></i>Mật khẩu (ít nhất 8 ký tự)</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="confirmPassword" placeholder="Xác nhận mật khẩu" minlength="8" required>
                            <label for="confirmPassword"><i class="bi bi-key-fill me-1"></i>Xác nhận mật khẩu</label>
                        </div>
                        <div class="input-group mb-3">
                            <div class="form-floating">
                                <input type="text" inputmode="numeric" class="form-control" id="registerOtp" placeholder="OTP" maxlength="6" required>
                                <label for="registerOtp"><i class="bi bi-shield-check me-1"></i>Mã OTP email</label>
                            </div>
                            <button type="button" id="btnRegisterOtp" class="btn btn-outline-info">Gửi mã</button>
                        </div>
                        <p class="small text-secondary"><i class="bi bi-info-circle me-1"></i>Tài khoản đăng ký tại đây chỉ có quyền người xem, không thể truy cập trang Admin.</p>
                        <div class="d-grid">
                            <button id="btnRegister" type="submit" class="btn btn-brand">
                                <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>Tạo tài khoản
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        (() => {
            const messageBox = $("#msgBox");
            const returnUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(returnUrl));
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            const showMessage = (message, type) => {
                messageBox.removeClass("d-none alert-success alert-danger alert-warning")
                    .addClass(`alert-${type}`).text(message);
            };

            const setBusy = (button, busy) => {
                button.prop("disabled", busy);
                button.find(".spinner-border").toggleClass("d-none", !busy);
            };

            const showOtpSending = button => {
                button.prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Đang gửi...');
            };

            const startOtpCountdown = (button, label, seconds = 60) => {
                clearInterval(button.data("otpTimer"));
                let remaining = seconds;
                button.prop("disabled", true).text(`${label} (${remaining}s)`);
                const timer = setInterval(() => {
                    remaining -= 1;
                    if (remaining <= 0) {
                        clearInterval(timer);
                        button.removeData("otpTimer").prop("disabled", false).text(label);
                        return;
                    }
                    button.text(`${label} (${remaining}s)`);
                }, 1000);
                button.data("otpTimer", timer);
            };

            $("#showLoginPassword").on("change", function () {
                $("#password").attr("type", this.checked ? "text" : "password");
            });

            $("#loginForm").on("submit", function (event) {
                event.preventDefault();
                const button = $("#btnLogin");
                setBusy(button, true);

                $.ajax({
                    url: "/Auth/Login",
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ username: $("#username").val().trim(), password: $("#password").val() }),
                    success: response => {
                        showMessage(response.message || "Đăng nhập thành công.", "success");
                        setTimeout(() => window.location.href = returnUrl || "/", 500);
                    },
                    error: xhr => showMessage(xhr.responseJSON?.message || "Đăng nhập thất bại.", "danger"),
                    complete: () => setBusy(button, false)
                });
            });

            $("#btnLoginSendOtp").on("click", function () {
                const email = $("#loginOtpEmail").val().trim();
                if (!email) { showMessage("Vui lòng nhập email trước khi gửi OTP.", "warning"); return; }
                const button = $(this);
                let sent = false;
                showOtpSending(button);
                $.ajax({
                    url: "/Auth/RequestLoginOtp",
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    headers: { "RequestVerificationToken": antiForgeryToken },
                    data: JSON.stringify({ email }),
                    success: response => {
                        sent = true;
                        showMessage(response.message || "Đã gửi mã OTP.", "success");
                        startOtpCountdown(button, "Gửi lại OTP");
                    },
                    error: xhr => showMessage(xhr.responseJSON?.message || "Không thể gửi OTP.", "danger"),
                    complete: () => { if (!sent) button.prop("disabled", false).text("Gửi OTP"); }
                });
            });

            $("#loginOtpForm").on("submit", function (event) {
                event.preventDefault();
                const button = $("#btnLoginOtp");
                setBusy(button, true);
                $.ajax({
                    url: "/Auth/LoginWithOtp",
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    headers: { "RequestVerificationToken": antiForgeryToken },
                    data: JSON.stringify({ email: $("#loginOtpEmail").val().trim(), otp: $("#loginOtp").val().trim() }),
                    success: response => {
                        showMessage(response.message || "Đăng nhập OTP thành công.", "success");
                        setTimeout(() => window.location.href = returnUrl || "/", 500);
                    },
                    error: xhr => showMessage(xhr.responseJSON?.message || "Đăng nhập OTP thất bại.", "danger"),
                    complete: () => setBusy(button, false)
                });
            });

            $("#registerForm").on("submit", function (event) {
                event.preventDefault();
                const password = $("#registerPassword").val();
                const confirmPassword = $("#confirmPassword").val();

                if (password.length < 8) {
                    showMessage("Mật khẩu phải có ít nhất 8 ký tự.", "warning");
                    return;
                }
                if (password !== confirmPassword) {
                    showMessage("Mật khẩu xác nhận không khớp.", "warning");
                    return;
                }

                const button = $("#btnRegister");
                setBusy(button, true);
                $.ajax({
                    url: "/Auth/Register",
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    headers: { "RequestVerificationToken": antiForgeryToken },
                    data: JSON.stringify({
                        fullName: $("#registerFullName").val().trim(),
                        email: $("#registerEmail").val().trim(),
                        password,
                        otp: $("#registerOtp").val().trim()
                    }),
                    success: response => {
                        showMessage(response.message || "Đăng ký thành công. Bạn có thể đăng nhập ngay.", "success");
                        $("#username").val($("#registerEmail").val().trim());
                        $("#password").val("");
                        bootstrap.Tab.getOrCreateInstance(document.querySelector('[data-bs-target="#loginPane"]')).show();
                        $("#registerForm")[0].reset();
                    },
                    error: xhr => showMessage(xhr.responseJSON?.message || "Đăng ký thất bại.", "danger"),
                    complete: () => setBusy(button, false)
                });
            });

            $("#btnRegisterOtp").on("click", function () {
                const email = $("#registerEmail").val().trim();
                if (!email) { showMessage("Vui lòng nhập email trước khi gửi OTP.", "warning"); return; }
                const button = $(this);
                let sent = false;
                showOtpSending(button);
                $.ajax({
                    url: "/Auth/RequestRegisterOtp",
                    method: "POST",
                    contentType: "application/json; charset=utf-8",
                    headers: { "RequestVerificationToken": antiForgeryToken },
                    data: JSON.stringify({ email }),
                    success: response => {
                        sent = true;
                        showMessage(response.message || "Đã gửi mã OTP.", "success");
                        startOtpCountdown(button, "Gửi lại mã");
                    },
                    error: xhr => showMessage(xhr.responseJSON?.message || "Không thể gửi OTP.", "danger"),
                    complete: () => { if (!sent) button.prop("disabled", false).text("Gửi mã"); }
                });
            });
        })();
    </script>
}
