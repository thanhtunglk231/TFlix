@{
    ViewData["Title"] = "Test Convert Word";
}

<h2>Test Convert Word sang HTML</h2>

<form asp-controller="TestWord"
      asp-action="ConvertWord"
      method="post"
      enctype="multipart/form-data">

    <input type="file" name="wordFile" accept=".docx" />

    <button type="submit">Convert</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red">@ViewBag.Error</p>
}

@if (ViewBag.Html != null)
{
    <hr />

    <h3>Preview HTML</h3>

    <iframe style="width:100%; height:900px; border:1px solid #ccc;"
            srcdoc="@Html.Raw(ViewBag.Html)">
    </iframe>

    <h3>HTML Source</h3>

    <textarea style="width:100%; height:500px;">@ViewBag.Html</textarea>
}