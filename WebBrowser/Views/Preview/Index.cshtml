@using WebBrowser.Models.Preview
@model PreviewDetailsViewModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Preview · Trang phim";

    // Trạng thái đăng nhập (ví dụ đọc từ Session)
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);

    var item = Model?.Movie;

    // ===== MAP TỪ MODEL =====
    var poster = item?.PrimaryPosterUrl
                 ?? item?.PrimaryThumbUrl
                 ?? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop";
    
    var title = item?.title ?? "Đang cập nhật";
    var original = item?.OriginalTitle;
    var year = item?.ReleaseOrAirDate?.Year;

    var country = !string.IsNullOrWhiteSpace(item?.CountryName) 
                  ? item.CountryName 
                  : (!string.IsNullOrWhiteSpace(item?.CountryCode) ? item.CountryCode : "Đang cập nhật");

    var genres = !string.IsNullOrWhiteSpace(item?.genres) ? item.genres : "Đang cập nhật";

    var lang = !string.IsNullOrWhiteSpace(item?.LanguageName) 
               ? item.LanguageName 
               : (!string.IsNullOrWhiteSpace(item?.LanguageCode) ? item.LanguageCode : "Đang cập nhật");

    var duration = item?.DurationMin != null
        ? $"{item.DurationMin} phút"
        : "Đang cập nhật";

    var episodes = Model?.Episodes ?? new List<WebBrowser.Models.Episode.EpisodeItem>();
    var episodeCount = episodes.Any() ? episodes.Count : 1;

    var status = !string.IsNullOrWhiteSpace(item?.status) ? item.status : "Đang cập nhật";

    var rating = "8.5";
    var casts = "Đang cập nhật";

    var description = !string.IsNullOrWhiteSpace(item?.OverviewText) ? item.OverviewText : "Chưa có nội dung mô tả.";

    var tags = genres
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var schedule = "";

    var watchId = (item?.ContentId > 0) ? (long)item.ContentId : ((item?.Id > 0) ? item.Id : (item?.MovieId ?? 0));
    var watchKind = !string.IsNullOrWhiteSpace(item?.kind) ? item.kind : "MOVIE";
    var watchUrl = Url.Action("Watch", "Film", new { id = watchId, kind = watchKind }) ?? $"/Film/Watch?id={watchId}&kind={watchKind}";
}

@section Styles {
    <style>
        :root {
            --brand: #27d3c3;
            --brand2: #19b3a5;
            --panel: #12161a;
            --muted: #a9b7c4;
        }

        .wrap {
            background: #0e1114;
        }

        .crumb a {
            color: #cfdbe6;
            text-decoration: none
        }

            .crumb a:hover {
                color: #fff;
                text-decoration: underline
            }

        .panel {
            background: var(--panel);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
        }

        .panel-h {
            padding: .8rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.06);
            font-weight: 600
        }

        .panel-b {
            padding: 1rem;
        }

        .meta dt {
            color: #cfe7f6;
            width: 120px
        }

        .meta dd {
            color: #e8f3fb;
            margin-bottom: .4rem;
        }

        .star {
            color: #ffc107
        }

        .btn-grad {
            background: linear-gradient(135deg,var(--brand),var(--brand2));
            border: none
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .4rem .7rem;
            border-radius: 14px;
            background: #14181c;
            border: 1px solid rgba(255,255,255,.08);
            color: #dbe6ee;
            text-decoration: none
        }

            .chip i {
                color: var(--brand)
            }

            .chip:hover {
                border-color: var(--brand);
                color: #fff
            }

        .pill {
            background: #14181c;
            color: #e6f0f7;
            border: 1px solid rgba(255,255,255,.08);
            padding: .35rem .7rem;
            border-radius: 10px;
            text-decoration: none;
        }

            .pill:hover {
                border-color: var(--brand);
                color: #fff;
            }

        .slist .item {
            display: flex;
            gap: .6rem;
            padding: .5rem;
            border-radius: 10px
        }

            .slist .item:hover {
                background: #14181c
            }

        .thumb {
            width: 62px;
            height: 86px;
            border-radius: 8px;
            object-fit: cover
        }

        .cmt-head {
            display: flex;
            align-items: center;
            gap: .5rem
        }

            .cmt-head img {
                width: 36px;
                height: 36px;
                border-radius: 50%
            }

        .label {
            color: var(--muted)
        }
    </style>
}

<div class="wrap py-3">
    <div class="container">

        <!-- Breadcrumb -->
        <nav class="crumb small mb-3">
            <a asp-controller="Home" asp-action="Index">TFLIX</a> /
            <a href="#">@genres</a> /
            <span class="text-secondary" id="bcTitle">@title</span>
        </nav>

        <div class="row g-4">
            <!-- LEFT -->
            <div class="col-12 col-lg-8">
                <div class="panel p-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <img id="poster" src="@poster" alt="@title" class="w-100 rounded-3" />
                            <div class="d-grid gap-2 mt-3">
                                <a href="@watchUrl" class="btn btn-grad btn-lg btnWatch">
                                    <i class="bi bi-play-fill me-1"></i>Xem phim
                                </a>
                                <a href="#" class="btn btn-outline-light btn-lg">
                                    <i class="bi bi-download me-1"></i>Tải phim
                                </a>
                            </div>
                        </div>
                        <div class="col-12 col-md-8">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h1 id="title" class="h4 mb-0">@title</h1>
                                @if (!string.IsNullOrEmpty(original))
                                {
                                    <span id="original" class="text-secondary">(@original)</span>
                                }
                            </div>

                            <div id="yearGenres" class="label mt-1">
                                @if (year.HasValue)
                                {
                                    @year.Value
                                    @: • @genres
                                }
                                else
                                {
                                    @genres
                                }
                            </div>

                            <!-- Meta -->
                            <dl class="row meta mt-3">
                                <dt class="col-sm-4">Thời lượng</dt>
                                <dd id="duration" class="col-sm-8">@duration</dd>

                                <dt class="col-sm-4">Số tập</dt>
                                <dd id="episodeCount" class="col-sm-8">@episodeCount tập</dd>

                                <dt class="col-sm-4">Tình trạng</dt>
                                <dd id="status" class="col-sm-8">@status</dd>

                                <dt class="col-sm-4">Ngôn ngữ</dt>
                                <dd id="lang" class="col-sm-8">@lang</dd>

                                <dt class="col-sm-4">Quốc gia</dt>
                                <dd id="country" class="col-sm-8">@country</dd>

                                <dt class="col-sm-4">Thể loại</dt>
                                <dd id="genresText" class="col-sm-8">@genres</dd>

                                <dt class="col-sm-4">Diễn viên</dt>
                                <dd id="casts" class="col-sm-8">@casts</dd>

                                <dt class="col-sm-4">Đánh giá</dt>
                                <dd class="col-sm-8">
                                    <span class="star"><i class="bi bi-star-fill"></i></span>
                                    <b id="rating">@rating</b> (điểm)
                                </dd>
                            </dl>

                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm vào danh sách
                                </button>
                                <button class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-flag me-1"></i>Báo lỗi
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Latest episodes -->
                    <div class="mt-3">
                        <div class="panel-h">DANH SÁCH TẬP :</div>
                        <div id="latestWrap" class="panel-b d-flex flex-wrap gap-2">
                            @if (episodes.Any())
                            {
                                foreach (var ep in episodes)
                                {
                                    var epUrl = Url.Action("Watch", "Film", new { id = watchId, kind = watchKind, episodeId = ep.EpisodeId }) ?? watchUrl;
                                    <a href="@epUrl" class="pill btnEp">Tập @ep.EpisodeNo</a>
                                }
                            }
                            else
                            {
                                <a href="@watchUrl" class="pill btnEp">Tập 1</a>
                            }
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mt-3">
                        <div class="panel-h">NỘI DUNG PHIM</div>
                        <div class="panel-b">
                            <p class="mb-2" id="description">@description</p>
                            <ul class="mb-0" id="descLinks">
                                @if (episodes.Any())
                                {
                                    foreach (var ep in episodes)
                                    {
                                        var epUrl = Url.Action("Watch", "Film", new { id = watchId, kind = watchKind, episodeId = ep.EpisodeId }) ?? watchUrl;
                                        <li><a href="@epUrl" class="btnEp text-decoration-none text-light">- @title - Tập @ep.EpisodeNo</a></li>
                                    }
                                }
                                else
                                {
                                    <li><a href="@watchUrl" class="btnEp text-decoration-none text-light">- @title Tập 1</a></li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Tags -->
                    <div class="mt-3">
                        <div class="panel-h">Tags</div>
                        <div class="panel-b d-flex flex-wrap gap-2" id="tagsWrap">
                            @if (tags.Any())
                            {
                                foreach (var t in tags)
                                {
                                    <a href="#" class="chip"><i class="bi bi-hash"></i>@t</a>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">Chưa có tag.</span>
                            }
                        </div>
                    </div>

                    <!-- Schedule + comments -->
                    <div class="mt-3">
                        <div class="panel-h">
                            LỊCH CHIẾU:
                            <span class="text-warning" id="schedule">
                                @(string.IsNullOrEmpty(schedule) ? "Đang cập nhật" : schedule)
                            </span>
                        </div>
                        <div class="panel-b">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="fw-semibold">Bình luận</div>
                                <div>
                                    <span class="me-2 label">Sắp xếp theo</span>
                                    <select class="form-select form-select-sm d-inline-block" style="width:auto">
                                        <option>Mới nhất</option>
                                        <option>Cũ nhất</option>
                                        <option>Thích nhiều</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mt-3">
                                <textarea class="form-control mb-3" rows="3" placeholder="Bình luận..."></textarea>

                                <div class="mt-3 small label">
                                    Hệ thống bình luận người dùng TFlix.
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="col-12 col-lg-4">
                <!-- PHIM SẮP CHIẾU / GỢI Ý -->
                <div class="panel mb-3">
                    <div class="panel-h">PHIM SẮP CHIẾU</div>
                    <div class="panel-b slist">
                        @if (Model?.UpcomingMovies != null && Model.UpcomingMovies.Any())
                        {
                            foreach (var mItem in Model.UpcomingMovies)
                            {
                                var mPoster = !string.IsNullOrEmpty(mItem.PosterUrl) ? mItem.PosterUrl : "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop";
                                var mYear = mItem.ReleaseDate?.Year;
                                var mRating = mItem.AvgRating.HasValue ? mItem.AvgRating.Value.ToString("0.0") : "8.5";
                                <a class="item text-decoration-none text-light" href="@Url.Action("Details", "Preview", new { id = mItem.MovieId, kind = "movie" })">
                                    <img class="thumb" src="@mPoster" alt="@mItem.Title" />
                                    <div>
                                        <div class="fw-semibold text-truncate" style="max-width: 180px;">@mItem.Title</div>
                                        <div class="small label">@(mYear.HasValue ? mYear.Value.ToString() : "2025")</div>
                                        <div class="small"><span class="star"><i class="bi bi-star-fill"></i></span> @mRating</div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="small text-muted">Chưa có thông tin phim sắp chiếu.</div>
                        }
                    </div>
                </div>

                <!-- TRENDING -->
                <div class="panel mb-3">
                    <div class="panel-h">TRENDING</div>
                    <div class="panel-b">
                        @if (Model?.TrendingMovies != null && Model.TrendingMovies.Any())
                        {
                            <ol class="mb-0 small ps-3">
                                @foreach (var mItem in Model.TrendingMovies)
                                {
                                    <li class="mb-2">
                                        <a href="@Url.Action("Details", "Preview", new { id = mItem.MovieId, kind = "movie" })" class="text-decoration-none text-light fw-medium">
                                            @mItem.Title
                                        </a>
                                        <span class="label ms-1">(phim hot)</span>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <div class="small text-muted">Đang cập nhật danh sách trending.</div>
                        }
                    </div>
                </div>

                <!-- TỪ KHOÁ NỔI BẬT -->
                <div class="panel">
                    <div class="panel-h">TỪ KHOÁ NỔI BẬT</div>
                    <div class="panel-b d-flex flex-wrap gap-2" id="hotTags">
                        @if (Model?.HotTags != null && Model.HotTags.Any())
                        {
                            foreach (var tagItem in Model.HotTags)
                            {
                                <a href="/Movies?genreId=@tagItem.GenreId" class="chip"><i class="bi bi-hash"></i>@tagItem.GenreName</a>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">Đang cập nhật thể loại.</span>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal yêu cầu đăng nhập -->
<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-secondary">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <i class="bi bi-shield-lock-fill me-2 text-warning"></i>Cần đăng nhập
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Bạn cần đăng nhập để xem nội dung phim này.</div>
            <div class="modal-footer border-0">
                <a class="btn btn-primary" asp-controller="Auth" asp-action="Index">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập ngay
                </a>
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Để sau</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        // Kiểm tra trạng thái đăng nhập
        const isLoggedIn = @isLoggedIn.ToString().ToLower();

        function showLoginModal() {
            const el = document.getElementById('loginRequiredModal');
            if (!el) return;
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(el).show();
            } else {
                el.style.display = 'block';
            }
        }

        // Chặn truy cập nếu chưa đăng nhập khi nhấn vào nút "Xem phim" / "Tập phim"
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btnWatch, .btnEp');
            if (!btn) return;

            if (!isLoggedIn) {
                e.preventDefault();
                e.stopPropagation();
                showLoginModal();
            }
        });
    </script>
}
