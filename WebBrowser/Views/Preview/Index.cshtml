@using WebBrowser.Models.Preview
@model PreviewDetailsViewModel

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Preview · Trang phim";

    // Trạng thái đăng nhập (ví dụ đọc từ Session)
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var currentUserJson = Context.Session.GetString("CurrentUser");
    WebBrowser.Models.AuthModels.UserInfo? currentUser = null;
    if (!string.IsNullOrEmpty(currentUserJson))
    {
        try { currentUser = Newtonsoft.Json.JsonConvert.DeserializeObject<WebBrowser.Models.AuthModels.UserInfo>(currentUserJson); }
        catch {}
    }
    var currentUserName = currentUser?.fullName ?? "Người dùng TFlix";
    var currentUserAvatar = !string.IsNullOrEmpty(currentUser?.avatarUrl) ? currentUser.avatarUrl : $"https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80";
    var currentUserId = currentUser?.userId ?? 0;

    var item = Model?.Movie;

    // ===== MAP TỪ MODEL =====
    var poster = item?.PrimaryPosterUrl
                 ?? item?.PrimaryThumbUrl
                 ?? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop";
    
    var title = item?.title ?? "Đang cập nhật";
    var original = item?.OriginalTitle;
    var year = item?.ReleaseOrAirDate?.Year;

    var country = !string.IsNullOrWhiteSpace(item?.CountryName) 
                  ? item.CountryName 
                  : (!string.IsNullOrWhiteSpace(item?.CountryCode) ? item.CountryCode : "Đang cập nhật");

    var genres = !string.IsNullOrWhiteSpace(item?.genres) ? item.genres : "Đang cập nhật";

    var lang = !string.IsNullOrWhiteSpace(item?.LanguageName) 
               ? item.LanguageName 
               : (!string.IsNullOrWhiteSpace(item?.LanguageCode) ? item.LanguageCode : "Đang cập nhật");

    var duration = item?.DurationMin != null
        ? $"{item.DurationMin} phút"
        : "Đang cập nhật";

    var episodes = Model?.Episodes ?? new List<WebBrowser.Models.Episode.EpisodeItem>();
    var episodeCount = episodes.Any() ? episodes.Count : 1;

    var status = !string.IsNullOrWhiteSpace(item?.status) ? item.status : "Đang cập nhật";

    var ratingInfo = Model?.RatingInfo;
    var avgRating = ratingInfo != null && ratingInfo.AverageRating > 0
        ? ratingInfo.AverageRating
        : (decimal)(item != null && item.Rating.HasValue && item.Rating.Value > 0 ? item.Rating.Value : 4.5);
    var avgRatingText = avgRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    var ratingCount = ratingInfo?.RatingCount ?? 0;
    var userRatingVal = ratingInfo?.UserRating ?? 0;
    var rating = avgRatingText;
    var casts = "Đang cập nhật";

    var description = !string.IsNullOrWhiteSpace(item?.OverviewText) ? item.OverviewText : "Chưa có nội dung mô tả.";

    var tags = genres
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    var schedule = "";

    var watchId = (item?.ContentId > 0) ? (long)item.ContentId : ((item?.Id > 0) ? item.Id : (item?.MovieId ?? 0));
    var watchKind = !string.IsNullOrWhiteSpace(item?.kind) ? item.kind : "MOVIE";
    var watchUrl = Url.Action("Watch", "Film", new { id = watchId, kind = watchKind }) ?? $"/Film/Watch?id={watchId}&kind={watchKind}";
}

@section Styles {
    <style>
        :root {
            --brand: #27d3c3;
            --brand2: #19b3a5;
            --panel: #12161a;
            --muted: #a9b7c4;
        }

        .wrap {
            background: #0e1114;
        }

        .crumb a {
            color: #cfdbe6;
            text-decoration: none
        }

            .crumb a:hover {
                color: #fff;
                text-decoration: underline
            }

        .panel {
            background: var(--panel);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
        }

        .panel-h {
            padding: .8rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,.06);
            font-weight: 600
        }

        .panel-b {
            padding: 1rem;
        }

        .meta dt {
            color: #cfe7f6;
            width: 120px
        }

        .star-btn-sm {
            background: transparent;
            border: none;
            padding: 1px 3px;
            font-size: 1.2rem;
            color: #475569;
            cursor: pointer;
            transition: color 0.18s ease, transform 0.18s ease;
            outline: none;
            display: inline-flex;
            align-items: center;
        }
        .star-btn-sm:hover,
        .star-btn-sm.hovered {
            color: #fbbf24 !important;
            transform: scale(1.22);
        }
        .star-btn-sm.active {
            color: #f59e0b;
        }

        .meta dd {
            color: #e8f3fb;
            margin-bottom: .4rem;
        }

        .star {
            color: #ffc107
        }

        .btn-grad {
            background: linear-gradient(135deg,var(--brand),var(--brand2));
            border: none
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .4rem .7rem;
            border-radius: 14px;
            background: #14181c;
            border: 1px solid rgba(255,255,255,.08);
            color: #dbe6ee;
            text-decoration: none
        }

            .chip i {
                color: var(--brand)
            }

            .chip:hover {
                border-color: var(--brand);
                color: #fff
            }

        .pill {
            background: #14181c;
            color: #e6f0f7;
            border: 1px solid rgba(255,255,255,.08);
            padding: .35rem .7rem;
            border-radius: 10px;
            text-decoration: none;
        }

            .pill:hover {
                border-color: var(--brand);
                color: #fff;
            }

        .slist .item {
            display: flex;
            gap: .6rem;
            padding: .5rem;
            border-radius: 10px
        }

            .slist .item:hover {
                background: #14181c
            }

        .thumb {
            width: 62px;
            height: 86px;
            border-radius: 8px;
            object-fit: cover
        }

        .cmt-head {
            display: flex;
            align-items: center;
            gap: .5rem
        }

            .cmt-head img {
                width: 36px;
                height: 36px;
                border-radius: 50%
            }

        .label {
            color: var(--muted)
        }

        /* SignalR Live Pulse */
        .signalr-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: signalr-pulse 1.8s infinite;
        }

        @@keyframes signalr-pulse {
            0% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            }
            70% {
                transform: scale(1);
                box-shadow: 0 0 0 6px rgba(16, 185, 129, 0);
            }
            100% {
                transform: scale(0.95);
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        .emoji-pill {
            cursor: pointer;
            font-size: 1.1rem;
            padding: 3px 7px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease;
            user-select: none;
        }
        .emoji-pill:hover {
            background: rgba(255, 255, 255, 0.15);
            transform: scale(1.15);
        }

        .cmt-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 1rem;
            transition: all 0.3s ease;
        }
        .cmt-item:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: rgba(39, 211, 195, 0.25);
        }
        .cmt-item.new-arrival {
            animation: cmt-glow 2s ease-out;
        }
        @@keyframes cmt-glow {
            0% {
                background: rgba(39, 211, 195, 0.2);
                border-color: #27d3c3;
                transform: translateY(-4px);
            }
            100% {
                background: rgba(255, 255, 255, 0.03);
                border-color: rgba(255, 255, 255, 0.06);
                transform: translateY(0);
            }
        }
    </style>
}

<div class="wrap py-3">
    <div class="container">

        <!-- Breadcrumb -->
        <nav class="crumb small mb-3">
            <a asp-controller="Home" asp-action="Index">TFLIX</a> /
            <a href="#">@genres</a> /
            <span class="text-secondary" id="bcTitle">@title</span>
        </nav>

        <div class="row g-4">
            <!-- LEFT -->
            <div class="col-12 col-lg-8">
                <div class="panel p-3">
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            <img id="poster" src="@poster" alt="@title" class="w-100 rounded-3" />
                            <div class="d-grid gap-2 mt-3">
                                <a href="@watchUrl" class="btn btn-grad btn-lg btnWatch">
                                    <i class="bi bi-play-fill me-1"></i>Xem phim
                                </a>
                                <a href="#" class="btn btn-outline-light btn-lg">
                                    <i class="bi bi-download me-1"></i>Tải phim
                                </a>
                            </div>
                        </div>
                        <div class="col-12 col-md-8">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <h1 id="title" class="h4 mb-0">@title</h1>
                                @if (!string.IsNullOrEmpty(original))
                                {
                                    <span id="original" class="text-secondary">(@original)</span>
                                }
                            </div>

                            <div id="yearGenres" class="label mt-1">
                                @if (year.HasValue)
                                {
                                    @year.Value
                                    @: • @genres
                                }
                                else
                                {
                                    @genres
                                }
                            </div>

                            <!-- Meta -->
                            <dl class="row meta mt-3">
                                <dt class="col-sm-4">Thời lượng</dt>
                                <dd id="duration" class="col-sm-8">@duration</dd>

                                <dt class="col-sm-4">Số tập</dt>
                                <dd id="episodeCount" class="col-sm-8">@episodeCount tập</dd>

                                <dt class="col-sm-4">Tình trạng</dt>
                                <dd id="status" class="col-sm-8">@status</dd>

                                <dt class="col-sm-4">Ngôn ngữ</dt>
                                <dd id="lang" class="col-sm-8">@lang</dd>

                                <dt class="col-sm-4">Quốc gia</dt>
                                <dd id="country" class="col-sm-8">@country</dd>

                                <dt class="col-sm-4">Thể loại</dt>
                                <dd id="genresText" class="col-sm-8">@genres</dd>

                                <dt class="col-sm-4">Diễn viên</dt>
                                <dd id="casts" class="col-sm-8">@casts</dd>

                                <dt class="col-sm-4">Đánh giá</dt>
                                <dd class="col-sm-8">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="text-warning fw-bold fs-5" id="previewAvgRating">@avgRatingText</span>
                                        <span class="text-white-50">/ 5 (<span id="previewRatingCount">@ratingCount</span> đánh giá)</span>
                                        <div class="d-inline-flex align-items-center gap-1 ms-2" id="previewStarRating" data-movie-id="@watchId" data-user-rating="@userRatingVal">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                var isFilled = s <= userRatingVal;
                                                <button type="button" class="star-btn-sm @(isFilled ? "active" : "")" data-star="@s" title="@s sao" aria-label="Đánh giá @s sao">
                                                    <i class="bi @(isFilled ? "bi-star-fill" : "bi-star")"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="small text-muted mt-1" id="previewRatingFeedback">
                                        @if (userRatingVal > 0)
                                        {
                                            <span class="text-warning"><i class="bi bi-check-circle-fill me-1"></i>Bạn đã đánh giá @userRatingVal sao</span>
                                        }
                                        else
                                        {
                                            <span>Bấm sao để đánh giá phim</span>
                                        }
                                    </div>
                                </dd>
                            </dl>

                            <div class="d-flex flex-wrap gap-2 mt-2">
                                <button class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-plus-circle me-1"></i>Thêm vào danh sách
                                </button>
                                <button class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-flag me-1"></i>Báo lỗi
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Latest episodes -->
                    <div class="mt-3">
                        <div class="panel-h">DANH SÁCH TẬP :</div>
                        <div id="latestWrap" class="panel-b d-flex flex-wrap gap-2">
                            @if (episodes.Any())
                            {
                                foreach (var ep in episodes)
                                {
                                    var epUrl = Url.Action("Watch", "Film", new { id = watchId, kind = watchKind, episodeId = ep.EpisodeId }) ?? watchUrl;
                                    <a href="@epUrl" class="pill btnEp">Tập @ep.EpisodeNo</a>
                                }
                            }
                            else
                            {
                                <a href="@watchUrl" class="pill btnEp">Tập 1</a>
                            }
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mt-3">
                        <div class="panel-h">NỘI DUNG PHIM</div>
                        <div class="panel-b">
                            <p class="mb-2" id="description">@description</p>
                            <ul class="mb-0" id="descLinks">
                                @if (episodes.Any())
                                {
                                    foreach (var ep in episodes)
                                    {
                                        var epUrl = Url.Action("Watch", "Film", new { id = watchId, kind = watchKind, episodeId = ep.EpisodeId }) ?? watchUrl;
                                        <li><a href="@epUrl" class="btnEp text-decoration-none text-light">- @title - Tập @ep.EpisodeNo</a></li>
                                    }
                                }
                                else
                                {
                                    <li><a href="@watchUrl" class="btnEp text-decoration-none text-light">- @title Tập 1</a></li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Tags -->
                    <div class="mt-3">
                        <div class="panel-h">Tags</div>
                        <div class="panel-b d-flex flex-wrap gap-2" id="tagsWrap">
                            @if (tags.Any())
                            {
                                foreach (var t in tags)
                                {
                                    <a href="#" class="chip"><i class="bi bi-hash"></i>@t</a>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">Chưa có tag.</span>
                            }
                        </div>
                    </div>

                    <!-- Lịch chiếu -->
                    <div class="mt-3">
                        <div class="panel-h">
                            LỊCH CHIẾU:
                            <span class="text-warning" id="schedule">
                                @(string.IsNullOrEmpty(schedule) ? "Đang cập nhật" : schedule)
                            </span>
                        </div>
                    </div>

                    <!-- Bình luận Realtime với SignalR -->
                    <div class="mt-4 panel">
                        <div class="panel-h d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#27d3c3" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                <span>BÌNH LUẬN TRỰC TIẾP</span>
                                <span class="badge rounded-pill bg-dark border border-secondary text-info px-2 py-1" id="cmtCount">0</span>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge d-inline-flex align-items-center gap-2 px-2.5 py-1.5 rounded-pill" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.75rem;">
                                    <span class="signalr-dot"></span> Realtime SignalR
                                </span>
                            </div>
                        </div>

                        <div class="panel-b">
                            @if (!isLoggedIn)
                            {
                                <div class="alert border-0 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 rounded-3" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25) !important;">
                                    <div class="d-flex align-items-center gap-2.5 text-warning">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                        <span>Bạn cần đăng nhập để gửi bình luận và tương tác cùng cộng đồng TFlix.</span>
                                    </div>
                                    <a asp-controller="Auth" asp-action="Index" class="btn btn-sm btn-grad fw-bold rounded-pill px-3" style="color: #061219;">
                                        Đăng nhập ngay
                                    </a>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-3 mb-4">
                                    <img src="@currentUserAvatar" class="rounded-circle" width="44" height="44" style="object-fit:cover; border: 2px solid var(--brand);" />
                                    <div class="flex-grow-1">
                                        <div class="d-flex align-items-center justify-content-between mb-1.5">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="text-white small fw-bold">@currentUserName</span>
                                                <span class="badge" style="background: rgba(39, 211, 195, 0.2); color: #27d3c3; font-size: 0.68rem;">THÀNH VIÊN</span>
                                            </div>
                                            <span class="text-muted small" id="cmtCharCount">0 / 500</span>
                                        </div>
                                        <textarea id="cmt" class="form-control mb-2 text-white shadow-none" rows="3" maxlength="500" placeholder="Viết cảm nghĩ của bạn về phim (Ctrl + Enter để gửi nhanh)..." style="background: #14181c; border: 1px solid rgba(255,255,255,.1); border-radius: 12px; font-size: 0.92rem;"></textarea>

                                        <!-- Quick Reactions Emoji Bar -->
                                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                            <div class="d-flex align-items-center gap-1.5">
                                                <span class="text-muted small me-1">Cảm xúc:</span>
                                                <span class="emoji-pill" onclick="insertEmoji('❤️')">❤️</span>
                                                <span class="emoji-pill" onclick="insertEmoji('🔥')">🔥</span>
                                                <span class="emoji-pill" onclick="insertEmoji('🍿')">🍿</span>
                                                <span class="emoji-pill" onclick="insertEmoji('👏')">👏</span>
                                                <span class="emoji-pill" onclick="insertEmoji('⭐')">⭐</span>
                                                <span class="emoji-pill" onclick="insertEmoji('😭')">😭</span>
                                                <span class="emoji-pill" onclick="insertEmoji('😂')">😂</span>
                                            </div>
                                            <button class="btn btn-sm btn-grad px-4 py-2 rounded-pill fw-bold d-inline-flex align-items-center gap-2" id="btnCmt" style="color: #081119;">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path></svg>
                                                <span>Gửi bình luận</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Danh sách bình luận -->
                            <div id="cmtList" class="vstack gap-3">
                                <div class="text-center py-4 text-muted" id="cmtLoading">
                                    <div class="spinner-border spinner-border-sm text-info mb-2" role="status"></div>
                                    <div>Đang kết nối luồng bình luận...</div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- RIGHT SIDEBAR -->
            <div class="col-12 col-lg-4">
                <!-- PHIM SẮP CHIẾU / GỢI Ý -->
                <div class="panel mb-3">
                    <div class="panel-h">PHIM SẮP CHIẾU</div>
                    <div class="panel-b slist">
                        @if (Model?.UpcomingMovies != null && Model.UpcomingMovies.Any())
                        {
                            foreach (var mItem in Model.UpcomingMovies)
                            {
                                var mPoster = !string.IsNullOrEmpty(mItem.PosterUrl) ? mItem.PosterUrl : "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop";
                                var mYear = mItem.ReleaseDate?.Year;
                                var mRating = mItem.AvgRating.HasValue ? mItem.AvgRating.Value.ToString("0.0") : "8.5";
                                <a class="item text-decoration-none text-light" href="@Url.Action("Details", "Preview", new { id = mItem.MovieId, kind = "movie" })">
                                    <img class="thumb" src="@mPoster" alt="@mItem.Title" />
                                    <div>
                                        <div class="fw-semibold text-truncate" style="max-width: 180px;">@mItem.Title</div>
                                        <div class="small label">@(mYear.HasValue ? mYear.Value.ToString() : "2025")</div>
                                        <div class="small"><span class="star"><i class="bi bi-star-fill"></i></span> @mRating</div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="small text-muted">Chưa có thông tin phim sắp chiếu.</div>
                        }
                    </div>
                </div>

                <!-- TRENDING -->
                <div class="panel mb-3">
                    <div class="panel-h">TRENDING</div>
                    <div class="panel-b">
                        @if (Model?.TrendingMovies != null && Model.TrendingMovies.Any())
                        {
                            <ol class="mb-0 small ps-3">
                                @foreach (var mItem in Model.TrendingMovies)
                                {
                                    <li class="mb-2">
                                        <a href="@Url.Action("Details", "Preview", new { id = mItem.MovieId, kind = "movie" })" class="text-decoration-none text-light fw-medium">
                                            @mItem.Title
                                        </a>
                                        <span class="label ms-1">(phim hot)</span>
                                    </li>
                                }
                            </ol>
                        }
                        else
                        {
                            <div class="small text-muted">Đang cập nhật danh sách trending.</div>
                        }
                    </div>
                </div>

                <!-- TỪ KHOÁ NỔI BẬT -->
                <div class="panel">
                    <div class="panel-h">TỪ KHOÁ NỔI BẬT</div>
                    <div class="panel-b d-flex flex-wrap gap-2" id="hotTags">
                        @if (Model?.HotTags != null && Model.HotTags.Any())
                        {
                            foreach (var tagItem in Model.HotTags)
                            {
                                <a href="/Movies?genreId=@tagItem.GenreId" class="chip"><i class="bi bi-hash"></i>@tagItem.GenreName</a>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">Đang cập nhật thể loại.</span>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal yêu cầu đăng nhập -->
<div class="modal fade" id="loginRequiredModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-light border border-secondary">
            <div class="modal-header border-0">
                <h5 class="modal-title">
                    <i class="bi bi-shield-lock-fill me-2 text-warning"></i>Cần đăng nhập
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">Bạn cần đăng nhập để xem nội dung phim này.</div>
            <div class="modal-footer border-0">
                <a class="btn btn-primary" asp-controller="Auth" asp-action="Index">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập ngay
                </a>
                <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Để sau</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- Microsoft SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    <script>
        const isLoggedIn = @isLoggedIn.ToString().ToLower();
        const movieId = @watchId;
        const currentUserId = @currentUserId;
        const currentUserName = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(currentUserName));
        const currentUserAvatar = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(currentUserAvatar));

        function showLoginModal() {
            const el = document.getElementById('loginRequiredModal');
            if (!el) return;
            if (window.bootstrap && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(el).show();
            } else {
                el.style.display = 'block';
            }
        }

        // Chặn truy cập nếu chưa đăng nhập khi nhấn vào nút "Xem phim" / "Tập phim"
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btnWatch, .btnEp');
            if (!btn) return;

            if (!isLoggedIn) {
                e.preventDefault();
                e.stopPropagation();
                showLoginModal();
            }
        });

        // ==========================================
        // REALTIME COMMENTS WITH SIGNALR
        // ==========================================
        let signalrConn = null;
        const activeGroupKey = "movie_" + movieId;

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function renderCommentItem(cmt, isNew = false) {
            const avatar = cmt.userAvatar || `https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80`;
            const timeAgo = cmt.formattedTime || 'Vừa xong';
            const author = escapeHtml(cmt.userName || 'Người dùng TFlix');
            const text = escapeHtml(cmt.content || '');
            const isMe = cmt.userId && cmt.userId === currentUserId;

            return `
                <div class="cmt-item ${isNew ? 'new-arrival' : ''}" id="cmt-${cmt.commentId || Date.now()}">
                    <div class="d-flex gap-3">
                        <img src="${avatar}" class="rounded-circle" width="40" height="40" style="object-fit:cover; border: 2px solid rgba(39, 211, 195, 0.4);" />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-white small">${author}</span>
                                    ${isMe ? '<span class="badge" style="background: rgba(39, 211, 195, 0.2); color: #27d3c3; font-size: 0.65rem;">Bạn</span>' : ''}
                                    <span class="text-muted small">• ${timeAgo}</span>
                                </div>
                            </div>
                            <div class="text-light" style="white-space: pre-wrap; font-size: 0.92rem; line-height: 1.55;">${text}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function updateCommentCountBadge(increment = 0, setCount = null) {
            const el = document.getElementById('cmtCount');
            if (!el) return;
            let current = parseInt(el.textContent) || 0;
            if (setCount !== null) {
                current = setCount;
            } else {
                current += increment;
            }
            el.textContent = Math.max(0, current);
        }

        function addCommentToUI(comment, isNew = true) {
            const listEl = document.getElementById('cmtList');
            if (!listEl) return;

            const emptyEl = document.getElementById('cmtEmpty');
            if (emptyEl) emptyEl.remove();

            const cmtHtml = renderCommentItem(comment, isNew);
            listEl.insertAdjacentHTML('afterbegin', cmtHtml);
            updateCommentCountBadge(1);
        }

        function loadComments() {
            const listEl = document.getElementById('cmtList');
            if (!listEl) return;

            fetch(`/Preview/GetComments?movieId=${movieId}`)
                .then(res => res.json())
                .then(res => {
                    listEl.innerHTML = '';
                    if (res && res.success && Array.isArray(res.data) && res.data.length > 0) {
                        res.data.forEach(item => {
                            listEl.insertAdjacentHTML('beforeend', renderCommentItem(item, false));
                        });
                        updateCommentCountBadge(0, res.data.length);
                    } else {
                        updateCommentCountBadge(0, 0);
                        listEl.innerHTML = `
                            <div class="text-center py-4 text-muted" id="cmtEmpty">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="d-block mx-auto mb-2 opacity-50"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                <span>Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ về bộ phim!</span>
                            </div>
                        `;
                    }
                })
                .catch(err => {
                    console.error('Lỗi tải bình luận:', err);
                    listEl.innerHTML = `
                        <div class="text-center py-4 text-muted" id="cmtEmpty">
                            <span>Chưa có bình luận nào. Hãy là người đầu tiên bình luận về bộ phim này!</span>
                        </div>
                    `;
                });
        }

        function initSignalRConnection() {
            if (typeof signalR === 'undefined') return;

            signalrConn = new signalR.HubConnectionBuilder()
                .withUrl('/commentHub')
                .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                .build();

            signalrConn.on('ReceiveComment', function (comment) {
                addCommentToUI(comment, true);
            });

            signalrConn.start().then(() => {
                signalrConn.invoke('JoinContentGroup', activeGroupKey).then(() => {
                    console.log('✅ Đã tham gia phòng SignalR Preview:', activeGroupKey);
                }).catch(console.error);
            }).catch(err => {
                console.warn('SignalR Hub kết nối:', err);
            });

            signalrConn.onreconnected(() => {
                signalrConn.invoke('JoinContentGroup', activeGroupKey).catch(console.error);
            });
        }

        initSignalRConnection();
        loadComments();

        // Emoji insertion helper
        window.insertEmoji = function(emoji) {
            const textarea = document.getElementById('cmt');
            if (!textarea) return;
            const start = textarea.selectionStart || textarea.value.length;
            const end = textarea.selectionEnd || textarea.value.length;
            textarea.value = textarea.value.substring(0, start) + emoji + textarea.value.substring(end);
            textarea.focus();
            textarea.selectionStart = textarea.selectionEnd = start + emoji.length;
            const charCountEl = document.getElementById('cmtCharCount');
            if (charCountEl) charCountEl.textContent = `${textarea.value.length} / 500`;
        };

        // Gửi bình luận
        const btnCmt = document.getElementById('btnCmt');
        const cmtTextarea = document.getElementById('cmt');
        const cmtCharCount = document.getElementById('cmtCharCount');

        if (cmtTextarea && cmtCharCount) {
            cmtTextarea.addEventListener('input', () => {
                cmtCharCount.textContent = `${cmtTextarea.value.length} / 500`;
            });
            cmtTextarea.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'Enter') {
                    btnCmt?.click();
                }
            });
        }

        if (btnCmt && cmtTextarea) {
            btnCmt.addEventListener('click', async () => {
                if (!isLoggedIn) {
                    showLoginModal();
                    return;
                }

                const content = cmtTextarea.value.trim();
                if (!content) {
                    cmtTextarea.focus();
                    return;
                }

                btnCmt.disabled = true;
                const originalHtml = btnCmt.innerHTML;
                btnCmt.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

                const payload = {
                    movieId: movieId,
                    episodeId: null,
                    userId: currentUserId,
                    userName: currentUserName,
                    userAvatar: currentUserAvatar,
                    content: content
                };

                try {
                    let savedComment = null;
                    if (signalrConn && signalrConn.state === signalR.HubConnectionState.Connected) {
                        savedComment = await signalrConn.invoke('SendComment', activeGroupKey, payload);
                    } else {
                        const res = await fetch('/Preview/PostComment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json().catch(() => null);
                        if (!res.ok || !data?.success || !data?.data) {
                            throw new Error(data?.message || 'Không thể lưu bình luận.');
                        }
                        savedComment = data.data;
                    }

                    if (!savedComment || !savedComment.commentId) {
                        throw new Error('Server không trả về ID bình luận đã lưu.');
                    }

                    addCommentToUI(savedComment, true);

                    cmtTextarea.value = '';
                    if (cmtCharCount) cmtCharCount.textContent = '0 / 500';
                } catch (err) {
                    console.error('Lỗi gửi bình luận:', err);
                    alert(err.message || 'Gửi bình luận thất bại. Vui lòng thử lại!');
                } finally {
                    btnCmt.disabled = false;
                    btnCmt.innerHTML = originalHtml;
                }
            });
        }

        // ==========================================
        // STAR RATING ON PREVIEW PAGE
        // ==========================================
        const pStarContainer = document.getElementById('previewStarRating');
        if (pStarContainer) {
            const pStars = pStarContainer.querySelectorAll('.star-btn-sm');
            const pFeedback = document.getElementById('previewRatingFeedback');
            const pAvg = document.getElementById('previewAvgRating');
            const pCount = document.getElementById('previewRatingCount');
            const pLabels = { 1: '1 sao - Rất tệ', 2: '2 sao - Tệ', 3: '3 sao - Bình thường', 4: '4 sao - Hay', 5: '5 sao - Tuyệt đỉnh!' };

            function highlightPStars(val) {
                pStars.forEach(btn => {
                    const s = parseInt(btn.dataset.star, 10);
                    const icon = btn.querySelector('i');
                    if (s <= val) {
                        btn.classList.add('hovered');
                        if (icon) { icon.classList.remove('bi-star'); icon.classList.add('bi-star-fill'); }
                    } else {
                        btn.classList.remove('hovered');
                        if (icon && !btn.classList.contains('active')) { icon.classList.remove('bi-star-fill'); icon.classList.add('bi-star'); }
                    }
                });
            }

            function resetPStars() {
                const cur = parseInt(pStarContainer.dataset.userRating, 10) || 0;
                pStars.forEach(btn => {
                    btn.classList.remove('hovered');
                    const s = parseInt(btn.dataset.star, 10);
                    const icon = btn.querySelector('i');
                    if (s <= cur) {
                        btn.classList.add('active');
                        if (icon) { icon.classList.remove('bi-star'); icon.classList.add('bi-star-fill'); }
                    } else {
                        btn.classList.remove('active');
                        if (icon) { icon.classList.remove('bi-star-fill'); icon.classList.add('bi-star'); }
                    }
                });
                if (cur > 0) {
                    pFeedback.innerHTML = `<span class="text-warning"><i class="bi bi-check-circle-fill me-1"></i>Bạn đã đánh giá ${cur} sao</span>`;
                } else {
                    pFeedback.textContent = 'Bấm sao để đánh giá phim';
                }
            }

            pStars.forEach(btn => {
                btn.addEventListener('mouseenter', () => {
                    const val = parseInt(btn.dataset.star, 10);
                    highlightPStars(val);
                    if (pFeedback) pFeedback.textContent = pLabels[val] || `${val} sao`;
                });

                btn.addEventListener('click', async () => {
                    if (!isLoggedIn) {
                        alert('Vui lòng đăng nhập để đánh giá phim.');
                        window.location.href = '/Auth/Index?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                        return;
                    }

                    const ratingVal = parseInt(btn.dataset.star, 10);
                    const targetMovieId = parseInt(pStarContainer.dataset.movieId, 10) || @watchId;
                    pFeedback.innerHTML = `<span class="text-info"><i class="bi bi-hourglass-split me-1"></i>Đang lưu...</span>`;

                    try {
                        const resp = await fetch('@Url.Action("RateMovie", "Preview")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ movieId: targetMovieId, rating: ratingVal })
                        });
                        const data = await resp.json();
                        if (!resp.ok || !data.success) throw new Error(data.message || 'Lỗi khi lưu.');

                        pStarContainer.dataset.userRating = ratingVal;
                        if (data.data) {
                            const newAvg = parseFloat(data.data.averageRating || data.data.AverageRating || 0).toFixed(1);
                            const newCount = data.data.ratingCount || data.data.RatingCount || 0;
                            if (pAvg) pAvg.textContent = newAvg;
                            if (pCount) pCount.textContent = newCount;
                        }
                        resetPStars();
                        pFeedback.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã đánh giá ${ratingVal} sao thành công!</span>`;
                    } catch (err) {
                        pFeedback.innerHTML = `<span class="text-danger">${err.message}</span>`;
                        resetPStars();
                    }
                });
            });

            pStarContainer.addEventListener('mouseleave', resetPStars);
        }
    </script>
}
