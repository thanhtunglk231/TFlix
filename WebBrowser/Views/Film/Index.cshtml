@using WebBrowser.Models.Film
@using WebBrowser.Models.VideoSoure
@model WatchViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = (Model.Content.OriginalTitle ?? Model.Content.title ?? "Xem phim") + " · TFlix Streaming";

    // Lấy token đăng nhập & user
    var token = Context.Session.GetString("JWToken") ?? Context.Session.GetString("AdminJWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token);
    var currentUserJson = Context.Session.GetString("CurrentUser") ?? Context.Session.GetString("AdminCurrentUser");
    WebBrowser.Models.AuthModels.UserInfo? currentUser = null;
    if (!string.IsNullOrEmpty(currentUserJson))
    {
        try { currentUser = Newtonsoft.Json.JsonConvert.DeserializeObject<WebBrowser.Models.AuthModels.UserInfo>(currentUserJson); }
        catch {}
    }
    var currentUserName = currentUser?.fullName ?? "Người dùng TFlix";
    var currentUserAvatar = !string.IsNullOrEmpty(currentUser?.avatarUrl) ? currentUser.avatarUrl : $"https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80";
    var currentUserId = currentUser?.userId ?? 0;
    var currentUserRoles = currentUser?.roles ?? new List<string>();

    var content = Model.Content;
    var isSeries = string.Equals(content.kind, "SERIES", StringComparison.OrdinalIgnoreCase);
    var contentId = Model.ContentId > 0
        ? Model.ContentId
        : content.MovieId > 0 ? content.MovieId : (long)content.ContentId;
    var movieTitle = content.title ?? content.OriginalTitle ?? "Đang cập nhật";
    var contentSlug = SeoUrlHelper.ToSlug(movieTitle);
    var originalTitle = content.OriginalTitle ?? content.title ?? "";
    var movieYear = content.ReleaseOrAirDate?.Year ?? 2024;
    var movieGenres = content.genres ?? "Hành động, Phiêu lưu";
    var countryCode = content.CountryCode ?? "VN";
    var ratingInfo = Model.RatingInfo;
    var avgRating = ratingInfo != null && ratingInfo.AverageRating > 0
        ? ratingInfo.AverageRating
        : (decimal)(content.Rating.HasValue && content.Rating.Value > 0 ? content.Rating.Value : 4.5);
    var avgRatingText = avgRating.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture);
    var ratingCount = ratingInfo?.RatingCount ?? 0;
    var userRatingVal = ratingInfo?.UserRating ?? 0;
    var poster = content.PrimaryPosterUrl ?? "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=1200&auto=format&fit=crop";
    var description = content.OverviewText ?? "Theo dõi những diễn biến kịch tính và hấp dẫn nhất trong tác phẩm điện ảnh đỉnh cao, được phát sóng độc quyền với chất lượng chuẩn 4K Ultra HD trên nền tảng TFlix.";

    var currentEpisodeId = Model.CurrentEpisodeId;
    var watchRouteName = isSeries
        ? (currentEpisodeId.HasValue ? "series-watch-episode" : "series-watch")
        : "movie-watch";
    var canonicalPath = Url.RouteUrl(watchRouteName, new { slug = contentSlug, id = contentId, episodeId = currentEpisodeId });
    if (!string.IsNullOrWhiteSpace(canonicalPath))
        ViewData["CanonicalUrl"] = $"{Context.Request.Scheme}://{Context.Request.Host}{canonicalPath}";
    var currentEpisode = Model.Episodes.FirstOrDefault(x => x.EpisodeId == currentEpisodeId);
    var currentEpisodeMovieId = currentEpisode?.MovieId;
    var currentSources = Model.Sources
        .Where(x => currentEpisodeId.HasValue
            ? (x.EpisodeId == currentEpisodeId || (currentEpisodeMovieId.HasValue && x.MovieId == currentEpisodeMovieId.Value))
            : x.MovieId == contentId)
        .ToList();

    bool IsHlsSource(SourceItem source)
    {
        if (string.Equals(source.Format, "HLS", StringComparison.OrdinalIgnoreCase))
            return true;

        var sourcePath = Uri.TryCreate(source.StreamUrl, UriKind.Absolute, out var sourceUri)
            ? sourceUri.AbsolutePath
            : source.StreamUrl?.Split('?', '#')[0];
        return sourcePath?.EndsWith(".m3u8", StringComparison.OrdinalIgnoreCase) == true;
    }

    var sources = currentSources
        .OrderByDescending(IsHlsSource)
        .ThenByDescending(x => x.IsPrimary)
        .Select(x => (label: $"{x.ServerName ?? x.Provider ?? "Cloudflare CDN"} • {x.Quality ?? "Auto"}", url: x.StreamUrl, quality: x.Quality ?? "Auto"))
        .Where(x => !string.IsNullOrWhiteSpace(x.url))
        .ToList();

    var isPremiumLocked = Model.IsPremiumContent && !Model.HasActiveSubscription;
    var currentSource = isPremiumLocked ? "" : (sources.FirstOrDefault().url ?? content.PrimaryStreamUrl ?? "");
    var hasSource = !string.IsNullOrWhiteSpace(currentSource);

    var episodes = Model.Episodes;
    var currentEp = currentEpisode?.EpisodeId ?? 0;
    var speeds = new[] { 0.75, 1.0, 1.25, 1.5, 2.0 };
}

@section Styles {
    <style>
        :root {
            --brand-primary: #1683ff;
            --brand-cyan: #19d3c5;
            --brand-gradient: linear-gradient(135deg, #1683ff 0%, #19d3c5 100%);
            --bg-dark: #111318;
            --panel-bg: #17191f;
            --card-surface: #1c1f26;
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(25, 211, 197, 0.35);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-main);
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        }

        /* Ambient Glow behind player */
        .ambient-glow-wrapper {
            position: relative;
        }
        .ambient-glow {
            position: absolute;
            inset: -20px;
            background: radial-gradient(circle at 50% 40%, rgba(22, 131, 255, 0.22) 0%, rgba(25, 211, 197, 0.12) 45%, transparent 70%);
            filter: blur(40px);
            z-index: 0;
            pointer-events: none;
            opacity: 0.85;
            transition: opacity 0.5s ease;
        }

        /* Watch Hero & Breadcrumb */
        .watch-breadcrumb {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }
        .watch-breadcrumb a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }
        .watch-breadcrumb a:hover {
            color: var(--brand-cyan);
        }

        .watch-hero-banner {
            position: relative;
            background: linear-gradient(180deg, rgba(23, 25, 31, 0.75) 0%, rgba(17, 19, 24, 0.95) 100%), url('@poster') center/cover no-repeat;
            border: 1px solid var(--border-subtle);
            border-radius: 20px;
            padding: 2rem 2.5rem;
            overflow: hidden;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.45);
        }

        .badge-brand-pill {
            background: var(--brand-gradient);
            color: #081119;
            font-weight: 700;
            font-size: 0.78rem;
            letter-spacing: 0.04em;
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .meta-tag {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            font-size: 0.76rem;
            font-weight: 600;
            padding: 0.25rem 0.65rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .action-pill-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #f1f5f9;
            padding: 0.45rem 1rem;
            border-radius: 9999px;
            font-size: 0.84rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .action-pill-btn:hover {
            background: rgba(25, 211, 197, 0.12);
            border-color: var(--brand-cyan);
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(25, 211, 197, 0.2);
        }
        .action-pill-btn.active {
            background: var(--brand-gradient);
            color: #071118;
            border-color: transparent;
            font-weight: 700;
        }

        /* Player Shell */
        .player-wrap {
            position: relative;
            background: #000;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 16px 45px rgba(0, 0, 0, 0.7);
            border: 1px solid var(--border-subtle);
            z-index: 1;
        }

        .video-el {
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #000;
            display: block;
        }

        .player-status-overlay {
            position: absolute;
            inset: 0;
            z-index: 14;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background: rgba(5, 8, 13, 0.72);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
        }

        .player-status-overlay.d-none { display: none; }

        .player-loading-spinner {
            width: 3.25rem;
            height: 3.25rem;
            border: 4px solid rgba(255, 255, 255, 0.2);
            border-top-color: var(--brand-cyan);
            border-right-color: var(--brand-primary);
            border-radius: 50%;
            animation: player-loading-spin 0.85s linear infinite;
            box-shadow: 0 0 24px rgba(25, 211, 197, 0.25);
        }

        @@keyframes player-loading-spin { to { transform: rotate(360deg); } }

        @@media (prefers-reduced-motion: reduce) {
            .player-loading-spinner { animation-duration: 1.8s; }
        }

        .premium-player-gate {
            z-index: 16;
            background: radial-gradient(circle at center, rgba(38, 31, 18, 0.97) 0%, rgba(8, 11, 16, 0.98) 72%);
        }

        .player-controls {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(10, 13, 18, 0.75) 40%, rgba(10, 13, 18, 0.98) 100%);
            padding: 1rem 1.25rem;
            padding-bottom: max(1rem, env(safe-area-inset-bottom, 1rem));
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.28s cubic-bezier(0.4, 0, 0.2, 1), transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.28s ease;
            z-index: 20;
            user-select: none;
            -webkit-user-select: none;
        }
        .player-wrap.hide-ui {
            cursor: none;
        }
        .player-wrap.hide-ui .player-controls {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(16px);
        }

        /* Ẩn nút chế độ rạp phim khi đang mở toàn màn hình */
        :fullscreen #btnTheater,
        :-webkit-full-screen #btnTheater,
        #playerBox:fullscreen #btnTheater,
        #playerBox.mobile-fullscreen-active #btnTheater {
            display: none !important;
        }

        @@media (max-width: 576px) {
            .player-controls {
                padding: 0.65rem 0.75rem max(0.65rem, env(safe-area-inset-bottom, 0.65rem));
            }
            .control-btn {
                width: 36px;
                height: 36px;
                border-radius: 8px;
            }
            .time-label {
                font-size: 0.75rem;
            }
            #vol {
                width: 60px !important;
            }
        }

        .control-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.08);
            color: #f1f5f9;
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .control-btn:hover {
            transform: translateY(-2px);
            background: rgba(25, 211, 197, 0.2);
            border-color: var(--brand-cyan);
            color: #ffffff;
            box-shadow: 0 4px 14px rgba(25, 211, 197, 0.3);
        }

        .progress-wrap {
            position: relative;
            height: 6px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 999px;
            cursor: pointer;
            transition: height 0.15s ease;
            overflow: visible;
        }
        .progress-wrap:hover {
            height: 8px;
        }

        /* Thanh đệm đã tải (buffered): hiển thị 1 phần mờ hơn */
        .progress-buffer {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 0;
            background: rgba(255, 255, 255, 0.45);
            border-radius: 999px;
            z-index: 1;
            pointer-events: none;
            transition: width 0.15s linear;
        }

        /* Thanh đã phát (played): hiển thị sáng và rực rỡ hơn */
        .progress-bar {
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 0;
            background: var(--brand-gradient);
            border-radius: 999px;
            z-index: 2;
            pointer-events: none;
        }
        .progress-bar::after {
            content: "";
            position: absolute;
            right: -6px;
            top: 50%;
            transform: translateY(-50%);
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 0 10px rgba(25, 211, 197, 0.9), 0 0 4px rgba(0, 0, 0, 0.5);
            opacity: 0;
            transition: opacity 0.2s, transform 0.1s ease;
        }
        .progress-wrap:hover .progress-bar::after {
            opacity: 1;
            transform: translateY(-50%) scale(1.1);
        }

        .time-label {
            font-variant-numeric: tabular-nums;
            color: #cbd5e1;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .opts-pill {
            background: #15181f;
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e2e8f0;
            border-radius: 8px;
            padding: 0.35rem 0.75rem;
            font-size: 0.84rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }
        .opts-pill:hover, .opts-pill:focus {
            outline: 0;
            border-color: var(--brand-cyan);
            box-shadow: 0 0 0 2px rgba(25, 211, 197, 0.25);
        }

        /* Ẩn triệt để native subtitle cues mặc định của trình duyệt để chỉ hiển thị 1 sub overlay bên trên */
        video::cue {
            display: none !important;
            opacity: 0 !important;
            visibility: hidden !important;
            font-size: 0 !important;
            background: transparent !important;
            color: transparent !important;
        }
        video::-webkit-media-text-track-display,
        video::-webkit-media-text-track-container {
            display: none !important;
        }

        /* Subtitle Overlay & Menu Styles */
        .subtitle-overlay {
            position: absolute;
            bottom: 24px;
            left: 5%;
            right: 5%;
            text-align: center;
            pointer-events: none;
            z-index: 10; /* Nằm dưới thanh công cụ (.player-controls có z-index: 20) */
            transition: bottom 0.22s ease, opacity 0.2s ease;
        }
        /* Khi thanh điều khiển hiển thị: phụ đề ẩn ở tầng dưới thanh công cụ */
        .player-wrap:not(.hide-ui) .subtitle-overlay,
        #playerBox:hover .subtitle-overlay {
            bottom: 20px;
        }
        /* Khi ẩn thanh điều khiển thì phụ đề hiển thị sát đáy video */
        .player-wrap.hide-ui .subtitle-overlay {
            bottom: 28px;
        }
        .subtitle-text {
            display: inline-block;
            background: rgba(8, 10, 15, 0.88);
            color: #ffffff;
            font-size: clamp(1.05rem, 2.3vw, 1.5rem);
            font-weight: 600;
            line-height: 1.45;
            padding: 7px 18px;
            border-radius: 8px;
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.95), 0 0 3px #000;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
            max-width: 86%;
            word-break: break-word;
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
        }
        .subtitle-menu {
            min-width: 220px;
            background: #17191f !important;
            border: 1px solid rgba(255, 255, 255, 0.14) !important;
            border-radius: 12px !important;
            padding: 8px !important;
            box-shadow: 0 14px 35px rgba(0, 0, 0, 0.75) !important;
            z-index: 1050;
        }
        .subtitle-menu .dropdown-item {
            border-radius: 8px;
            padding: 8px 12px;
            color: #e2e8f0;
            font-size: 0.88rem;
            cursor: pointer;
            transition: all 0.15s ease;
        }
        .subtitle-menu .dropdown-item:hover,
        .subtitle-menu .dropdown-item:focus {
            background: rgba(22, 131, 255, 0.2) !important;
            color: #60a5fa !important;
        }
        .subtitle-menu .dropdown-item.active {
            background: rgba(25, 211, 197, 0.18) !important;
            color: #19d3c5 !important;
            font-weight: 600;
        }
        .control-btn.active-sub {
            color: var(--brand-cyan) !important;
            background: rgba(25, 211, 197, 0.15) !important;
            border: 1px solid rgba(25, 211, 197, 0.45) !important;
        }

        /* Modern Card Panels */
        .tflix-panel {
            background: var(--panel-bg);
            border-radius: 18px;
            border: 1px solid var(--border-subtle);
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
        }
        .tflix-panel-header {
            padding: 1.1rem 1.4rem;
            border-bottom: 1px solid var(--border-subtle);
        }

        .account-info-summary {
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            list-style: none;
        }

        .account-info-summary::-webkit-details-marker {
            display: none;
        }

        .account-info[open] .account-info-chevron {
            transform: rotate(180deg);
        }

        .account-info-chevron {
            transition: transform .2s ease;
        }

        .account-info-avatar {
            width: 52px;
            height: 52px;
            object-fit: cover;
        }

        .account-info-label {
            color: #9fb1bd;
            font-size: .8rem;
        }

        .tflix-panel-body {
            padding: 1.4rem;
        }

        /* Episode List Styles */
        .ep-item {
            background: #161920;
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            padding: 0.75rem 1rem;
            display: flex;
            gap: 0.85rem;
            align-items: center;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .ep-item:hover {
            transform: translateX(4px);
            border-color: var(--brand-cyan);
            background: #1c212a;
        }
        .ep-item.active {
            border-color: var(--brand-cyan);
            background: linear-gradient(135deg, rgba(22, 131, 255, 0.15), rgba(25, 211, 197, 0.08));
            box-shadow: 0 4px 16px rgba(25, 211, 197, 0.12);
        }
        .ep-num {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: grid;
            place-items: center;
            background: rgba(255, 255, 255, 0.06);
            font-weight: 700;
            font-size: 0.9rem;
            color: #f1f5f9;
            flex-shrink: 0;
        }
        .ep-item.active .ep-num {
            background: var(--brand-gradient);
            color: #051017;
        }
        .ep-item.unavailable .episode-source-status {
            color: #fbbf24;
        }

        /* Comment Section */
        .cmt-item {
            background: #161920;
            border: 1px solid var(--border-subtle);
            border-radius: 14px;
            padding: 1.1rem;
            transition: all 0.2s ease;
        }
        .cmt-item:hover {
            border-color: rgba(25, 211, 197, 0.3);
            background: #1b1f28;
        }
        .cmt-item.new-arrival {
            animation: cmtFlash 2.5s ease;
        }
        @@keyframes cmtFlash {
            0% {
                background: rgba(25, 211, 197, 0.25);
                border-color: var(--brand-cyan);
                transform: translateY(-4px);
            }
            100% {
                background: #161920;
                border-color: var(--border-subtle);
                transform: translateY(0);
            }
        }

        .emoji-pill {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 9999px;
            padding: 0.25rem 0.55rem;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.15s;
            user-select: none;
        }
        .emoji-pill:hover {
            transform: scale(1.15);
            background: rgba(25, 211, 197, 0.2);
            border-color: var(--brand-cyan);
        }

        /* SignalR Live Pulse */
        .signalr-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #10b981;
            display: inline-block;
            box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            animation: pulse-green 1.8s infinite;
        }
        @@keyframes pulse-green {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
        }

        /* Quality Toast */
        .quality-toast {
            position: absolute;
            top: 20px;
            right: 20px;
            background: rgba(17, 19, 24, 0.92);
            color: #19d3c5;
            border: 1px solid rgba(25, 211, 197, 0.4);
            backdrop-filter: blur(12px);
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 700;
            z-index: 20;
            transition: opacity 0.3s ease, transform 0.3s ease;
            pointer-events: none;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
        }
        .quality-toast.hide {
            opacity: 0;
            transform: translateY(-10px);
        }

        /* Theater / Focus mode */
        body.theater .player-wrap {
            border-radius: 0;
        }
        body.theater .page-container {
            max-width: 100% !important;
            padding-left: 0;
            padding-right: 0;
        }

        /* Lights off (Focus cinema mode) */
        #lightsOffOverlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.92);
            z-index: 990;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }
        body.lights-off #lightsOffOverlay {
            opacity: 1;
            pointer-events: auto;
        }
        body.lights-off .player-wrap {
            z-index: 1000;
            box-shadow: 0 0 100px rgba(0, 0, 0, 0.9);
        }

        /* Fullscreen styles (Native + Mobile Fallback) */
        :fullscreen #playerBox,
        :-webkit-full-screen #playerBox,
        :-moz-full-screen #playerBox,
        :-ms-fullscreen #playerBox,
        #playerBox:fullscreen,
        #playerBox:-webkit-full-screen,
        #playerBox.mobile-fullscreen-active {
            width: 100vw !important;
            height: 100vh !important;
            max-width: 100vw !important;
            max-height: 100vh !important;
            border-radius: 0 !important;
            background: #000000 !important;
            border: none !important;
        }

        :fullscreen #video,
        :-webkit-full-screen #video,
        :-moz-full-screen #video,
        :-ms-fullscreen #video,
        #playerBox:fullscreen #video,
        #playerBox:-webkit-full-screen #video,
        #playerBox.mobile-fullscreen-active #video {
            width: 100% !important;
            height: 100% !important;
            max-height: 100vh !important;
            aspect-ratio: auto !important;
            object-fit: contain !important;
            background: #000000 !important;
        }

        #playerBox.mobile-fullscreen-active {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            bottom: 0 !important;
            z-index: 999999 !important;
            margin: 0 !important;
        }

        body.has-fullscreen-player {
            overflow: hidden !important;
            touch-action: none;
        }

        /* Star Rating Widget */
        .rating-widget-box {
            background: linear-gradient(135deg, rgba(28, 31, 38, 0.9) 0%, rgba(20, 23, 29, 0.95) 100%);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
            transition: border-color 0.3s ease;
        }
        .rating-widget-box:hover {
            border-color: rgba(245, 158, 11, 0.3);
        }
        .rating-stars-interactive {
            display: inline-flex;
            gap: 4px;
        }
        .star-btn {
            background: transparent;
            border: none;
            padding: 2px 4px;
            font-size: 1.35rem;
            color: #475569;
            cursor: pointer;
            transition: color 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            outline: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .star-btn:hover,
        .star-btn.hovered {
            color: #fbbf24 !important;
            transform: scale(1.22);
        }
        .star-btn.active {
            color: #f59e0b;
        }
        .star-btn:focus-visible {
            outline: 2px solid #fbbf24;
            border-radius: 4px;
        }
    </style>
}

<div id="lightsOffOverlay"></div>

<div class="container page-container my-4">
    @if (TempData["PaymentSuccess"] is string paymentSuccess)
    {
        <div class="alert alert-success alert-dismissible fade show" role="status">
            @paymentSuccess
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }
    <!-- Breadcrumb Navigation -->
    <div class="watch-breadcrumb">
        <a asp-controller="Home" asp-action="Index" class="d-inline-flex align-items-center gap-1">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            Trang chủ
        </a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <a href="/Movies">Kho phim</a>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        <span class="text-white fw-semibold">@movieTitle</span>
    </div>

    <!-- Cinematic Hero Info Header -->
    <div class="watch-hero-banner mb-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                    <span class="badge-brand-pill">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                        @(hasSource ? "ĐANG PHÁT TRỰC TUYẾN" : "THÔNG TIN CHI TIẾT")
                    </span>
                    <span class="meta-tag">@movieYear</span>
                    <span class="meta-tag text-info">4K Ultra HD</span>
                    <span class="meta-tag text-warning d-inline-flex align-items-center gap-1 card-rating-tag" id="watchRatingBadge" data-movie-id="@contentId" title="Nhấn để đánh giá sao">
                        <i class="bi bi-star-fill text-warning"></i>
                        <span id="badgeAvgRating" class="rating-val">@avgRatingText</span>
                        <span class="opacity-75 small">(<span id="badgeRatingCount">@ratingCount</span>)</span>
                    </span>
                    <span class="meta-tag">@countryCode</span>
                    <span class="meta-tag">T16</span>
                </div>

                <h1 class="display-6 fw-bold text-white mb-2">@movieTitle</h1>
                @if (!string.IsNullOrEmpty(originalTitle) && originalTitle != movieTitle)
                {
                    <h5 class="text-muted fw-normal mb-3" style="font-size: 1rem;">@originalTitle</h5>
                }

                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="text-muted small">Thể loại:</span>
                    @foreach (var g in movieGenres.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <span class="badge" style="background: rgba(22, 131, 255, 0.15); color: #60a5fa; border: 1px solid rgba(22, 131, 255, 0.25); font-weight: 500;">@g</span>
                    }
                </div>

                <p class="text-light mb-0 opacity-75" style="max-width: 780px; font-size: 0.95rem; line-height: 1.6;">
                    @description
                </p>

                <!-- Interactive Star Rating Widget -->
                <div class="rating-widget-box mt-3 p-3" style="max-width: 520px;">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rating-score-display text-center px-3 py-1 rounded-3" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.25);">
                                <div class="fw-bold fs-4 text-warning" id="ratingAvgDisplay">@avgRatingText</div>
                                <div class="text-white-50" style="font-size: 0.68rem; letter-spacing: 0.5px; text-transform: uppercase;">Thang điểm 5</div>
                            </div>
                            <div>
                                <div class="rating-stars-interactive" id="starRatingContainer" data-movie-id="@contentId" data-user-rating="@userRatingVal">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        var isFilled = s <= userRatingVal;
                                        <button type="button" class="star-btn @(isFilled ? "active" : "")" data-star="@s" title="@s sao" aria-label="Đánh giá @s sao">
                                            <i class="bi @(isFilled ? "bi-star-fill" : "bi-star")"></i>
                                        </button>
                                    }
                                </div>
                                <div class="small mt-1" id="ratingFeedbackText" style="color: #94a3b8;">
                                    @if (userRatingVal > 0)
                                    {
                                        <span class="text-warning"><i class="bi bi-check-circle-fill me-1"></i>Bạn đã đánh giá @userRatingVal sao</span>
                                    }
                                    else
                                    {
                                        <span>Bấm sao để đánh giá phim</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-end text-muted small">
                            <div><span id="ratingTotalCount" class="text-white fw-bold">@ratingCount</span> đánh giá</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 text-lg-end">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button class="action-pill-btn" id="btnLike" title="Thích bộ phim này">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
                        <span>Thích (1.4K)</span>
                    </button>
                    <button class="action-pill-btn" id="btnSave" title="Thêm vào phim yêu thích">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
                        <span>Yêu thích</span>
                    </button>
                    <button class="action-pill-btn" id="btnShare" title="Chia sẻ liên kết">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                        <span>Chia sẻ</span>
                    </button>
                    <button class="action-pill-btn" id="btnLightsOff" title="Bật/Tắt chế độ rạp chiếu (Tắt đèn)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                        <span>Tắt đèn</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Video Player + Sidebar Layout -->
    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="ambient-glow-wrapper">
                <div class="ambient-glow"></div>
                <div id="playerBox" class="player-wrap">
                    @if (isPremiumLocked)
                    {
                        <!-- Khung video hiển thị thông báo nội dung này dành cho tài khoản Premium và nút thanh toán -->
                        <div class="premium-locked-player-box d-flex flex-column align-items-center justify-content-center text-center p-4 p-md-5 text-white" 
                             style="width: 100%; aspect-ratio: 16 / 9; min-height: 420px; background: radial-gradient(circle at center, #1e2430 0%, #0d1015 100%); border-radius: 18px; border: 1px solid rgba(245, 158, 11, 0.35); box-shadow: 0 16px 48px rgba(0, 0, 0, 0.65);">
                            
                            <div class="mb-3 p-3 rounded-circle d-inline-flex align-items-center justify-content-center" style="background: rgba(245, 158, 11, 0.14); border: 1px solid rgba(245, 158, 11, 0.45); box-shadow: 0 0 35px rgba(245, 158, 11, 0.25);">
                                <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2">
                                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            </div>

                            <span class="badge px-3 py-1.5 rounded-pill mb-2.5 fw-bold" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #081119; letter-spacing: 0.05em; font-size: 0.8rem;">
                                <i class="bi bi-gem me-1"></i> ĐẶC QUYỀN PREMIUM VIP
                            </span>

                            <h3 class="fw-bold text-white mb-2" style="font-size: clamp(1.25rem, 2.8vw, 1.75rem);">Nội dung này dành cho tài khoản Premium</h3>
                            
                            <p class="text-white-50 mx-auto mb-4" style="max-width: 520px; font-size: 0.95rem; line-height: 1.6;">
                                @(isLoggedIn 
                                    ? "Tài khoản của bạn hiện chưa có gói Premium hoặc gói đã hết hạn. Hãy thanh toán nâng cấp ngay để mở khóa toàn bộ phim bản quyền với chất lượng 4K Ultra HD không giới hạn." 
                                    : "Bộ phim này thuộc danh mục đặc quyền Premium của TFlix. Vui lòng thanh toán nâng cấp tài khoản để bắt đầu thưởng thức.")
                            </p>

                            <div class="d-flex flex-wrap gap-2.5 justify-content-center">
                                @if (!isLoggedIn)
                                {
                                    <a href="@Url.Action("Index", "Auth", new { returnUrl = Context.Request.Path + Context.Request.QueryString })" class="btn px-4 py-2.5 rounded-pill fw-bold text-dark d-inline-flex align-items-center gap-2" style="background: #ffffff; text-decoration: none;">
                                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                                    </a>
                                }
                                <a asp-controller="Payment" asp-action="Index" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn px-4 py-2.5 rounded-pill fw-bold d-inline-flex align-items-center gap-2 shadow-lg" style="background: var(--brand-gradient); color: #081119; text-decoration: none; font-size: 0.95rem;">
                                    <i class="bi bi-credit-card-fill"></i> Thanh toán nâng cấp Premium
                                </a>
                            </div>
                        </div>
                    }
                    else if (hasSource)
                    {
                        <video id="video"
                               class="video-el"
                               playsinline
                               crossorigin="anonymous"
                               preload="none"
                               poster="@poster"
                               controlslist="nodownload noremoteplayback"
                               disablepictureinpicture
                               disableremoteplayback></video>

                        <!-- Subtitle Dynamic Text Overlay (Netflix/Disney+ style) -->
                        <div id="subtitleOverlay" class="subtitle-overlay d-none" aria-live="polite">
                            <span class="subtitle-text" id="subtitleText"></span>
                        </div>

                        <div id="playerLoading" class="player-status-overlay d-none" role="status" aria-live="polite" aria-label="Đang tải phim">
                            <div class="text-center text-white">
                                <div class="player-loading-spinner mx-auto" aria-hidden="true"></div>
                                <div class="fw-semibold mt-3">Đang tải phim...</div>
                                <div class="small text-white-50 mt-1">Vui lòng chờ trong giây lát</div>
                            </div>
                        </div>

                        <div id="premiumPlayerGate" class="player-status-overlay premium-player-gate d-none" role="alert" aria-live="assertive">
                            <div class="text-center text-white" style="max-width: 560px;">
                                <div class="mb-3 text-warning" aria-hidden="true"><i class="bi bi-gem fs-1"></i></div>
                                <h3 class="h4 fw-bold mb-2">Nội dung này dành cho tài khoản Premium</h3>
                                <p id="premiumPlayerMessage" class="text-white-50 mb-4">Vui lòng thanh toán nâng cấp tài khoản để xem nội dung này.</p>
                                <div class="d-flex flex-wrap gap-2 justify-content-center">
                                    @if (!isLoggedIn)
                                    {
                                        <a href="@Url.Action("Index", "Auth", new { returnUrl = Context.Request.Path + Context.Request.QueryString })" class="btn px-4 py-2 rounded-pill fw-bold text-dark" style="background: #ffffff; text-decoration: none;">
                                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                                        </a>
                                    }
                                    <a asp-controller="Payment" asp-action="Index" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn px-4 py-2 rounded-pill fw-bold d-inline-flex align-items-center gap-2 shadow" style="background: var(--brand-gradient); color: #081119; text-decoration: none;">
                                        <i class="bi bi-credit-card-fill"></i>Thanh toán nâng cấp Premium
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div id="playerError" class="position-absolute top-50 start-50 translate-middle text-center text-white d-none px-3" role="alert" style="z-index: 15;">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="mb-2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            <div id="playerErrorText" class="mt-2 text-danger fw-semibold">Không thể tải video từ máy chủ lưu trữ.</div>
                        </div>

                        <!-- Quality notification toast on player -->
                        <div id="qualityToast" class="quality-toast hide">
                            <span class="d-inline-flex align-items-center gap-1.5">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg>
                                <span id="qualityToastText">Auto (Adaptive)</span>
                            </span>
                        </div>

                        <!-- Glassmorphism Floating Controls -->
                        <div id="playerControls" class="player-controls">
                            <!-- Scrub / Progress Line -->
                            <div class="mb-2.5">
                                <div id="progress" class="progress-wrap">
                                    <div id="buffered" class="progress-buffer"></div>
                                    <div id="bar" class="progress-bar"></div>
                                </div>
                            </div>

                            <!-- Buttons & Settings Bar -->
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <button class="control-btn" id="btnPlay" title="Phát/Tạm dừng (Space)">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                </button>
                                <button class="control-btn" id="btnBack" title="Tua lùi 10s (←)">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="11 17 6 12 11 7"></polyline><polyline points="18 17 13 12 18 7"></polyline></svg>
                                </button>
                                <button class="control-btn" id="btnFwd" title="Tua tới 10s (→)">
                                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="13 17 18 12 13 7"></polyline><polyline points="6 17 11 12 6 7"></polyline></svg>
                                </button>

                                <!-- Volume Slider -->
                                <div class="d-flex align-items-center ms-2 gap-1.5">
                                    <button class="btn p-0 text-light border-0 d-flex align-items-center" id="btnMute" title="Tắt/Bật tiếng (M)">
                                        <svg id="volIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
                                    </button>
                                    <input type="range" id="vol" min="0" max="1" step="0.01" value="1" class="form-range" style="width: 100px; accent-color: var(--brand-cyan);" />
                                </div>

                                <div class="ms-auto d-flex align-items-center gap-2">
                                    <span class="time-label me-1" id="time">00:00 / 00:00</span>

                                    <!-- Quick Quality Selector inside player -->
                                    <select id="selQualityInPlayer" class="opts-pill" title="Điều chỉnh chất lượng video">
                                        <option value="-1">Auto</option>
                                    </select>

                                    <select id="selSubtitleInPlayer" class="opts-pill" title="Chọn phụ đề" aria-label="Chọn phụ đề">
                                        <option value="off">CC Tắt</option>
                                    </select>

                                    <!-- Speed -->
                                    <select id="selSpeed" class="opts-pill" title="Tốc độ phát">
                                        @foreach (var s in speeds)
                                        {
                                            <option value="@s" selected="@(s == 1.0)">@s x</option>
                                        }
                                    </select>

                                    <!-- Subtitle Selector (CC) -->
                                    <div class="dropdown d-inline-block position-relative">
                                        <button class="control-btn" id="btnSubtitle" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false" title="Chọn phụ đề (Phím C)">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                                <path d="M7 15h3m-3-4h3m4 4h3m-3-4h3"></path>
                                            </svg>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg subtitle-menu" id="subtitleDropdownMenu">
                                            <li class="dropdown-header text-uppercase small text-white-50 px-3 py-1">Tùy chọn phụ đề</li>
                                            <li><a class="dropdown-item active d-flex align-items-center justify-content-between sub-track-item" href="javascript:void(0)" data-lang="off"><span>Tắt phụ đề</span><i class="bi bi-check2 sub-check"></i></a></li>
                                            <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                                            <li class="dropdown-header text-uppercase small text-info px-3 py-1">Phụ đề</li>
                                            <li><a class="dropdown-item d-flex align-items-center justify-content-between sub-track-item" href="javascript:void(0)" data-lang="vi"><span>Tiếng Việt</span><i class="bi bi-check2 sub-check d-none"></i></a></li>
                                            <li><a class="dropdown-item d-flex align-items-center justify-content-between sub-track-item" href="javascript:void(0)" data-lang="en"><span>Tiếng Anh</span><i class="bi bi-check2 sub-check d-none"></i></a></li>
                                        </ul>
                                    </div>

                                    <button class="control-btn" id="btnTheater" title="Chế độ rạp phim (T)">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"></rect><path d="M16 2v5"></path><path d="M8 2v5"></path></svg>
                                    </button>
                                    <button class="control-btn" id="btnFs" title="Toàn màn hình (F)">
                                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- Hiển thị thông báo khi phim chưa có source -->
                        <div class="d-flex flex-column align-items-center justify-content-center text-center p-5 text-white" style="min-height: 420px; background: radial-gradient(circle at center, #1b2029 0%, #0e1115 100%); border-radius: 18px;">
                            <div class="mb-3 p-4 rounded-circle" style="background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.3);">
                                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#fbbf24" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.5"></rect><line x1="2" y1="2" x2="22" y2="22"></line><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line></svg>
                            </div>
                            <h3 class="fw-bold text-white mb-2">Chưa có nguồn phát video</h3>
                            <p class="text-muted max-w-500 mx-auto mb-4" style="max-width: 480px; font-size: 0.95rem;">@(currentEpisode != null ? $"Tập {currentEpisode.EpisodeNo} ({currentEpisode.EpisodeTitle}) của \"{movieTitle}\"" : $"Bộ phim \"{movieTitle}\"") hiện chưa có nguồn phát video hoặc đang được mã hóa transcoder. Chúng tôi sẽ cập nhật sớm nhất.</p>
                            @if (episodes != null && episodes.Any(ep => Model.Sources.Any(s => s.EpisodeId == ep.EpisodeId || (ep.MovieId.HasValue && s.MovieId == ep.MovieId.Value))))
                            {
                                var availableEp = episodes.FirstOrDefault(ep => Model.Sources.Any(s => s.EpisodeId == ep.EpisodeId || (ep.MovieId.HasValue && s.MovieId == ep.MovieId.Value)));
                                if (availableEp != null)
                                {
                                    <a href="@Url.Action("Watch", "Film", new { id = contentId, kind = content.kind, ep = availableEp.EpisodeId })" class="btn px-4 py-2.5 rounded-pill fw-bold d-inline-flex align-items-center gap-2 mb-2" style="background: var(--brand-gradient); color: #081119; text-decoration: none;">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                                        Xem Tập @availableEp.EpisodeNo: @availableEp.EpisodeTitle
                                    </a>
                                }
                            }
                            <a href="/Movies" class="btn btn-outline-light px-4 py-2 rounded-pill fw-semibold d-inline-flex align-items-center gap-2" style="text-decoration: none; font-size: 0.88rem;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                                Khám phá các phim khác
                            </a>
                        </div>
                        }
                    }
                </div>
            </div>

            <!-- Source / Server Switching Toolbar below player -->
            <div class="d-flex flex-wrap gap-3 mt-3 align-items-center justify-content-between p-3 rounded-3" style="background: #15181f; border: 1px solid var(--border-subtle);">
                @if (hasSource)
                {
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small d-flex align-items-center gap-1.5 fw-semibold">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#19d3c5" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                                Máy chủ phát:
                            </span>
                            <select id="selServer" class="opts-pill">
                                @foreach (var (label, url, quality) in sources)
                                {
                                    <option value="@url">@label</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small d-flex align-items-center gap-1.5 fw-semibold">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                Độ phân giải:
                            </span>
                            <select id="selQuality" class="opts-pill">
                                <option value="-1">Tự động (Auto Bitrate)</option>
                            </select>
                        </div>

                        <div class="d-flex align-items-center gap-2">
                            <span class="text-muted small d-flex align-items-center gap-1.5 fw-semibold">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M7 15h3m-3-4h3m4 4h3m-3-4h3"></path></svg>
                                Phụ đề:
                            </span>
                            <select id="selSubtitle" class="opts-pill" title="Lựa chọn phụ đề hiển thị">
                                <option value="off">Tắt phụ đề</option>
                                <option value="vi">Tiếng Việt</option>
                                <option value="en">English</option>
                            </select>
                        </div>
                    </div>
                }
                else if (Model.IsPremiumContent && !Model.HasActiveSubscription)
                {
                    <div class="badge d-inline-flex align-items-center gap-1.5 px-3 py-2 rounded-pill" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                        <i class="bi bi-lock-fill"></i> Nội dung bản quyền VIP - Yêu cầu tài khoản Premium để mở khóa nguồn phát
                    </div>
                }
                else
                {
                    <div class="badge d-inline-flex align-items-center gap-1.5 px-3 py-2 rounded-pill" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        Nguồn phát đang đồng bộ
                    </div>
                }

                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary text-light border-0 d-inline-flex align-items-center gap-1.5 small" data-bs-toggle="modal" data-bs-target="#shortcutsModal">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"></rect><line x1="6" y1="8" x2="6.01" y2="8"></line><line x1="10" y1="8" x2="10.01" y2="8"></line><line x1="14" y1="8" x2="14.01" y2="8"></line><line x1="18" y1="8" x2="18.01" y2="8"></line><line x1="8" y1="16" x2="16" y2="16"></line></svg>
                        Phím tắt
                    </button>
                    <a href="/Movies" class="btn btn-sm btn-outline-light rounded-pill px-3 d-inline-flex align-items-center gap-1">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        Quay lại
                    </a>
                </div>
            </div>

            <!-- Bình luận Realtime với SignalR -->
            <div class="tflix-panel mt-4">
                <div class="tflix-panel-header">
                    <div class="d-flex align-items-center gap-2.5">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#19d3c5" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                        <span class="fw-bold text-white fs-6">Bình luận trực tiếp</span>
                        <span class="badge rounded-pill bg-dark border border-secondary text-info px-2 py-1" id="cmtCount">0</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge d-inline-flex align-items-center gap-2 px-2.5 py-1.5 rounded-pill" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 0.75rem;">
                            <span class="signalr-dot"></span> Realtime SignalR
                        </span>
                    </div>
                </div>

                <div class="tflix-panel-body">
                    @if (!isLoggedIn)
                    {
                        <div class="alert border-0 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 p-3 rounded-3" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.25) !important;">
                            <div class="d-flex align-items-center gap-2.5 text-warning">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                <span>Bạn cần đăng nhập để gửi bình luận và tương tác cùng cộng đồng TFlix.</span>
                            </div>
                            <a asp-controller="Auth" asp-action="Index" class="btn btn-sm fw-bold rounded-pill px-3" style="background: var(--brand-gradient); color: #061219;">
                                Đăng nhập ngay
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-3 mb-4">
                            <img src="@currentUserAvatar" class="rounded-circle" width="46" height="46" style="object-fit:cover; border: 2px solid var(--brand-cyan);" />
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center justify-content-between mb-1.5">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="text-white small fw-bold">@currentUserName</span>
                                        <span class="badge" style="background: rgba(22, 131, 255, 0.2); color: #60a5fa; font-size: 0.68rem;">THÀNH VIÊN VIP</span>
                                    </div>
                                    <span class="text-muted small" id="cmtCharCount">0 / 500</span>
                                </div>
                                <textarea id="cmt" class="form-control mb-2 text-white shadow-none" rows="3" maxlength="500" placeholder="Viết cảm nghĩ của bạn về phim (Ctrl + Enter để gửi nhanh)..." style="background: #14171d; border: 1px solid var(--border-subtle); border-radius: 12px; font-size: 0.92rem;"></textarea>

                                <!-- Quick Reactions Emoji Bar -->
                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div class="d-flex align-items-center gap-1.5">
                                        <span class="text-muted small me-1">Cảm xúc:</span>
                                        <span class="emoji-pill" onclick="insertEmoji('❤️')">❤️</span>
                                        <span class="emoji-pill" onclick="insertEmoji('🔥')">🔥</span>
                                        <span class="emoji-pill" onclick="insertEmoji('🍿')">🍿</span>
                                        <span class="emoji-pill" onclick="insertEmoji('👏')">👏</span>
                                        <span class="emoji-pill" onclick="insertEmoji('⭐')">⭐</span>
                                        <span class="emoji-pill" onclick="insertEmoji('😭')">😭</span>
                                        <span class="emoji-pill" onclick="insertEmoji('😂')">😂</span>
                                    </div>
                                    <button class="btn btn-sm px-4 py-2 rounded-pill fw-bold d-inline-flex align-items-center gap-2" id="btnCmt" style="background: var(--brand-gradient); color: #081119;">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path></svg>
                                        <span>Gửi bình luận</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Danh sách bình luận -->
                    <div id="cmtList" class="vstack gap-3">
                        <div class="text-center py-4 text-muted" id="cmtLoading">
                            <div class="spinner-border spinner-border-sm text-info mb-2" role="status"></div>
                            <div>Đang kết nối luồng bình luận...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar: Episodes for series & Recommended -->
        <div class="col-12 col-lg-4">
            @if (!string.IsNullOrWhiteSpace(Model.EpisodeLoadError))
            {
                <div class="alert alert-warning mb-4" role="status">
                    @Model.EpisodeLoadError
                </div>
            }

            @if (isLoggedIn)
            {
                <details class="tflix-panel account-info mb-4">
                    <summary class="tflix-panel-header account-info-summary text-white">
                        <span><i class="bi bi-person-vcard-fill text-info me-2"></i>Thông tin tài khoản</span>
                        <i class="bi bi-chevron-down account-info-chevron text-secondary" aria-hidden="true"></i>
                    </summary>
                    <div class="tflix-panel-body">
                        @if (currentUser is not null)
                        {
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <img src="@currentUserAvatar"
                                     alt="Ảnh đại diện của @currentUserName"
                                     class="account-info-avatar rounded-circle border border-info border-opacity-50" />
                                <div class="min-w-0">
                                    <div class="text-white fw-semibold text-break">@currentUserName</div>
                                    <div class="text-secondary small text-break">@(string.IsNullOrWhiteSpace(currentUser.email) ? "Chưa cập nhật email" : currentUser.email)</div>
                                </div>
                            </div>

                            <dl class="row g-2 mb-0">
                                <dt class="col-5 account-info-label">Mã tài khoản</dt>
                                <dd class="col-7 text-white small mb-1">@currentUser.userId</dd>

                                <dt class="col-5 account-info-label">Số điện thoại</dt>
                                <dd class="col-7 text-white small mb-1">@(string.IsNullOrWhiteSpace(currentUser.phone) ? "Chưa cập nhật" : currentUser.phone)</dd>

                                <dt class="col-5 account-info-label">Email</dt>
                                <dd class="col-7 text-white small mb-1 text-break">@(string.IsNullOrWhiteSpace(currentUser.email) ? "Chưa cập nhật" : currentUser.email)</dd>

                                <dt class="col-5 account-info-label">Xác minh email</dt>
                                <dd class="col-7 small mb-1">
                                    @if (currentUser.isEmailVerified)
                                    {
                                        <span class="text-success"><i class="bi bi-patch-check-fill me-1"></i>Đã xác minh</span>
                                    }
                                    else
                                    {
                                        <span class="text-warning"><i class="bi bi-exclamation-circle me-1"></i>Chưa xác minh</span>
                                    }
                                </dd>

                                <dt class="col-5 account-info-label">Trạng thái</dt>
                                <dd class="col-7 text-white small mb-1">@(string.IsNullOrWhiteSpace(currentUser.status) ? "Chưa cập nhật" : currentUser.status)</dd>

                                @if (!string.IsNullOrWhiteSpace(currentUser.countryCode))
                                {
                                    <dt class="col-5 account-info-label">Quốc gia</dt>
                                    <dd class="col-7 text-white small mb-1">@currentUser.countryCode</dd>
                                }

                                @if (!string.IsNullOrWhiteSpace(currentUser.languageCode))
                                {
                                    <dt class="col-5 account-info-label">Ngôn ngữ</dt>
                                    <dd class="col-7 text-white small mb-1">@currentUser.languageCode</dd>
                                }
                            </dl>

                            @if (currentUserRoles.Count > 0)
                            {
                                <div class="border-top border-secondary border-opacity-25 mt-3 pt-3">
                                    <div class="account-info-label mb-2">Vai trò</div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var role in currentUserRoles)
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25">@role</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-secondary small" role="status">
                                <i class="bi bi-info-circle me-1"></i>Không tìm thấy thông tin hồ sơ trong phiên đăng nhập hiện tại.
                            </div>
                        }
                    </div>
                </details>
            }

            @if (episodes != null && episodes.Any())
            {
                <div class="tflix-panel mb-4">
                    <div class="tflix-panel-header">
                        <div class="fw-bold text-white d-flex align-items-center gap-2">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1683ff" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2"></rect><polyline points="17 2 12 7 7 2"></polyline></svg>
                            Danh sách tập phim
                        </div>
                        <span class="badge bg-dark border border-secondary text-muted">@episodes.Count() tập</span>
                    </div>
                    <div class="tflix-panel-body p-3">
                        <div class="vstack gap-2" id="epList" style="max-height: 480px; overflow-y: auto;">
                            @foreach (var episode in episodes)
                            {
                                var act = episode.EpisodeId == currentEp ? "active" : "";
                                var isEpPremium = episode.IsPremium || (Model.Content != null && (string.Equals(Model.Content.IsPremium, "Y", StringComparison.OrdinalIgnoreCase) || Model.Content.IsPremium == "1" || string.Equals(Model.Content.IsPremium, "True", StringComparison.OrdinalIgnoreCase)));
                                var canWatchEp = !isEpPremium || Model.HasActiveSubscription;

                                var episodeSource = Model.Sources
                                    .Where(x => x.EpisodeId == episode.EpisodeId || (episode.MovieId.HasValue && x.MovieId == episode.MovieId.Value))
                                    .OrderByDescending(IsHlsSource)
                                    .ThenByDescending(x => x.IsPrimary)
                                    .FirstOrDefault();
                                var hasEpSource = canWatchEp && !string.IsNullOrWhiteSpace(episodeSource?.StreamUrl);
                                <div class="ep-item @act @(!hasEpSource && canWatchEp ? "unavailable" : "")"
                                     data-ep="@episode.EpisodeId"
                                     data-is-premium="@(isEpPremium ? "true" : "false")"
                                     data-can-watch="@(canWatchEp ? "true" : "false")"
                                     data-source-url="@(hasEpSource ? episodeSource!.StreamUrl : "")"
                                     data-has-source="@(hasEpSource ? "true" : "false")"
                                     title="@(isEpPremium && !canWatchEp ? "Tập phim yêu cầu tài khoản Premium" : (hasEpSource ? "Phát tập phim" : "Tập phim chưa có nguồn phát"))">
                                    <div class="ep-num">@episode.EpisodeNo</div>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold text-white small d-flex align-items-center gap-2">
                                            <span>@episode.EpisodeTitle</span>
                                            @if (isEpPremium)
                                            {
                                                <span class="badge" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: #000; font-size: 0.65rem; font-weight: 700;">VIP</span>
                                            }
                                            @if (!hasEpSource && canWatchEp)
                                            {
                                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; font-size: 0.65rem; font-weight: 500;">Đang cập nhật</span>
                                            }
                                        </div>
                                        <div class="text-muted small">Mùa @episode.SeasonNo • @(episode.DurationMin ?? 45) phút</div>
                                    </div>
                                    @if (isEpPremium && !canWatchEp)
                                    {
                                        <span class="text-warning small d-flex align-items-center gap-1" title="Khóa Premium">
                                            <i class="bi bi-lock-fill"></i>
                                        </span>
                                    }
                                    else if (hasEpSource)
                                    {
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"></polygon></svg>
                                    }
                                    else
                                    {
                                        <span class="episode-source-status small text-nowrap" role="status">Chưa có video</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            else if (isSeries && string.IsNullOrWhiteSpace(Model.EpisodeLoadError))
            {
                <div class="tflix-panel mb-4" role="status">
                    <div class="tflix-panel-header fw-bold text-white">Danh sách tập phim</div>
                    <div class="tflix-panel-body text-muted">
                        Series này chưa có tập phim được xuất bản.
                    </div>
                </div>
            }

            <!-- Recommended Movies (Có thể bạn thích) -->
            <div class="tflix-panel">
                <div class="tflix-panel-header">
                    <div class="fw-bold text-white d-flex align-items-center gap-2">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#19d3c5" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                        Phim tương tự đề xuất
                    </div>
                    <a href="/Movies" class="text-info text-decoration-none small">Xem thêm</a>
                </div>
                <div class="tflix-panel-body p-3">
                    <div class="vstack gap-3" id="suggestedMoviesList">
                        <!-- Loaded dynamically or rendered with high-quality presets -->
                        <a href="/Movies" class="d-flex gap-3 text-decoration-none text-light p-2 rounded-3 hover-card" style="border: 1px solid var(--border-subtle); background: #161920;">
                            <img src="https://images.unsplash.com/photo-1563089145-599997674d42?w=300&auto=format&fit=crop" class="rounded-2" width="70" height="95" style="object-fit: cover;" />
                            <div class="d-flex flex-column justify-content-center">
                                <span class="badge mb-1" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; width: fit-content; font-size: 0.68rem;">4K VIP</span>
                                <div class="fw-bold text-white small text-truncate" style="max-width: 190px;">Godzilla x Kong: Đế Chế Mới</div>
                                <span class="text-muted small">2024 • Hành động</span>
                                <div class="text-warning small mt-1">★ 8.9 / 10</div>
                            </div>
                        </a>

                        <a href="/Movies" class="d-flex gap-3 text-decoration-none text-light p-2 rounded-3 hover-card" style="border: 1px solid var(--border-subtle); background: #161920;">
                            <img src="https://images.unsplash.com/photo-1578632767115-351597cf2477?w=300&auto=format&fit=crop" class="rounded-2" width="70" height="95" style="object-fit: cover;" />
                            <div class="d-flex flex-column justify-content-center">
                                <span class="badge mb-1" style="background: rgba(22, 131, 255, 0.15); color: #60a5fa; width: fit-content; font-size: 0.68rem;">FULL HD</span>
                                <div class="fw-bold text-white small text-truncate" style="max-width: 190px;">Suzume Cửa Hàng Khóa Ký Ức</div>
                                <span class="text-muted small">2023 • Hoạt hình</span>
                                <div class="text-warning small mt-1">★ 8.6 / 10</div>
                            </div>
                        </a>

                        <a href="/Movies" class="d-flex gap-3 text-decoration-none text-light p-2 rounded-3 hover-card" style="border: 1px solid var(--border-subtle); background: #161920;">
                            <img src="https://images.unsplash.com/photo-1440404653325-ab127d49abc1?w=300&auto=format&fit=crop" class="rounded-2" width="70" height="95" style="object-fit: cover;" />
                            <div class="d-flex flex-column justify-content-center">
