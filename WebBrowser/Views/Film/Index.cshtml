<form id="favoriteTokenForm" class="d-none">@Html.AntiForgeryToken()</form>

@section Scripts {
    <!-- HLS for m3u8 streaming -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <!-- Microsoft SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const isLoggedIn = @isLoggedIn.ToString().ToLower();
        const hasSource = @hasSource.ToString().ToLower();
        const movieId = @contentId;
        const currentUserId = @currentUserId;
        const currentUserName = @Json.Serialize(currentUserName);
        const currentUserAvatar = @Json.Serialize(currentUserAvatar);
        const allSources = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Sources));
        const subtitlesBySource = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.SubtitlesBySource));

        function sourceValue(source, ...names) {
            for (const name of names) {
                if (source && source[name] !== undefined && source[name] !== null) {
                    return source[name];
                }
            }
            return null;
        }

        let currentEp = @currentEp;
        const movieKey = "movie:" + @Json.Serialize(movieTitle);

        function guardAuth(action) {
            if (!isLoggedIn) {
                const el = document.getElementById('loginRequiredModal');
                const m = bootstrap.Modal.getOrCreateInstance(el);
                m.show();
                return false;
            }
            return typeof action === 'function' ? (action(), true) : true;
        }

        // ==========================================
        // 1. VIDEO PLAYER & HLS STREAMING LOGIC
        // ==========================================
        const video = document.getElementById('video');
        const selQuality = document.getElementById('selQuality');
        const selQualityInPlayer = document.getElementById('selQualityInPlayer');
        const selSubtitleInPlayer = document.getElementById('selSubtitleInPlayer');
        const selServer = document.getElementById('selServer');
        const qualityToast = document.getElementById('qualityToast');
        const qualityToastText = document.getElementById('qualityToastText');
        const playerError = document.getElementById('playerError');
        const playerErrorText = document.getElementById('playerErrorText');
        const playerLoading = document.getElementById('playerLoading');
        const premiumPlayerGate = document.getElementById('premiumPlayerGate');
        const premiumPlayerMessage = document.getElementById('premiumPlayerMessage');
        const playerControls = document.getElementById('playerControls');

        function subtitleValue(item, ...names) {
            for (const name of names) if (item && item[name] !== undefined && item[name] !== null) return item[name];
            return null;
        }



        function showPlayerLoading() {
            if (!playerLoading || !premiumPlayerGate?.classList.contains('d-none')) return;
            playerLoading.classList.remove('d-none');
        }

        function hidePlayerLoading() {
            playerLoading?.classList.add('d-none');
        }

        function showPremiumGate(message) {
            hidePlayerLoading();
            if (video) {
                video.pause();
                if (video.hlsInstance) {
                    video.hlsInstance.destroy();
                    video.hlsInstance = null;
                }
            }
            if (premiumPlayerMessage && message) premiumPlayerMessage.textContent = message;
            premiumPlayerGate?.classList.remove('d-none');
            playerControls?.classList.add('d-none');
        }

        function hidePremiumGate() {
            premiumPlayerGate?.classList.add('d-none');
            playerControls?.classList.remove('d-none');
        }

        let toastTimer = null;
        function showQualityToast(text) {
            if (!qualityToast || !qualityToastText) return;
            qualityToastText.textContent = text;
            qualityToast.classList.remove('hide');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                qualityToast.classList.add('hide');
            }, 2500);
        }

        function populateHlsQualities(hls) {
            const levels = hls.levels || [];
            const qualitySelects = [selQuality, selQualityInPlayer].filter(Boolean);

            qualitySelects.forEach(sel => {
                sel.innerHTML = '';
                const autoOpt = document.createElement('option');
                autoOpt.value = '-1';
                autoOpt.textContent = 'Tự động (Auto)';
                sel.appendChild(autoOpt);

                levels.forEach((lvl, idx) => {
                    const opt = document.createElement('option');
                    opt.value = idx;
                    const res = lvl.height ? `${lvl.height}p` : `Mức ${idx + 1}`;
                    const label = lvl.height >= 1080 ? `${res} Full HD` : (lvl.height >= 720 ? `${res} HD` : res);
                    opt.textContent = label;
                    sel.appendChild(opt);
                });

                sel.value = hls.currentLevel;
            });
        }

        function populateFallbackQualities() {
            const matchingSources = allSources.filter(s => currentEp
                ? sourceValue(s, 'episode_id', 'episodeId', 'EpisodeId', 'episodE_ID') == currentEp
                : sourceValue(s, 'movie_id', 'movieId', 'MovieId', 'moviE_ID') == movieId);
            const qualitySelects = [selQuality, selQualityInPlayer].filter(Boolean);

            const quals = [...new Set(matchingSources.map(s => s.quality).filter(Boolean))];
            if (quals.length > 0) {
                qualitySelects.forEach(sel => {
                    sel.innerHTML = '';
                    const autoOpt = document.createElement('option');
                    autoOpt.value = 'Auto';
                    autoOpt.textContent = 'Tự động (Auto)';
                    sel.appendChild(autoOpt);

                    quals.forEach(q => {
                        const opt = document.createElement('option');
                        opt.value = q;
                        opt.textContent = q;
                        sel.appendChild(opt);
                    });
                });
            }
        }

        function handleQualityChange(newVal) {
            if (video && video.hlsInstance && video.hlsInstance.levels && video.hlsInstance.levels.length > 0) {
                const levelIdx = parseInt(newVal);
                video.hlsInstance.currentLevel = levelIdx;
                let qualityText = 'Tự động (Auto)';
                if (levelIdx >= 0 && video.hlsInstance.levels[levelIdx]) {
                    const lvl = video.hlsInstance.levels[levelIdx];
                    qualityText = (lvl.height ? lvl.height + 'p' : 'Mức ' + (levelIdx + 1));
                }
                showQualityToast('Đang phát: ' + qualityText);
            } else {
                if (newVal !== 'Auto') {
                    const matching = allSources.filter(s => currentEp
                        ? sourceValue(s, 'episode_id', 'episodeId', 'EpisodeId', 'episodE_ID') == currentEp
                        : sourceValue(s, 'movie_id', 'movieId', 'MovieId', 'moviE_ID') == movieId);
                    const target = matching.find(s => s.quality === newVal);
                    const targetUrl = sourceValue(target, 'stream_url', 'streamUrl', 'StreamUrl', 'streaM_URL');
                    if (targetUrl) {
                        const curTime = video.currentTime;
                        const isPaused = video.paused;
                        loadSource(targetUrl);
                        video.currentTime = curTime;
                        if (!isPaused) video.play().catch(()=>{});
                        showQualityToast('Chất lượng: ' + newVal);
                    }
                }
            }

            [selQuality, selQualityInPlayer].forEach(s => {
                if (s) s.value = newVal;
            });
        }

        if (selQuality) selQuality.addEventListener('change', e => handleQualityChange(e.target.value));
        if (selQualityInPlayer) selQualityInPlayer.addEventListener('change', e => handleQualityChange(e.target.value));

        if (hasSource && video) {
            const bar = document.getElementById('bar');
            const buffered = document.getElementById('buffered');
            const progress = document.getElementById('progress');
            const time = document.getElementById('time');
            const btnPlay = document.getElementById('btnPlay');
            const btnBack = document.getElementById('btnBack');
            const btnFwd = document.getElementById('btnFwd');
            const btnFs = document.getElementById('btnFs');
            const btnTheater = document.getElementById('btnTheater');
            const btnMute = document.getElementById('btnMute');
            const selSpeed = document.getElementById('selSpeed');
            const vol = document.getElementById('vol');
            const playerBox = document.getElementById('playerBox');

            function fmt(sec){
                sec = Math.max(sec||0,0);
                const h = Math.floor(sec/3600);
                const m = Math.floor((sec%3600)/60);
                const s = Math.floor(sec%60);
                return (h>0?String(h).padStart(2,'0')+':':'')+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
            }

            function isHlsSource(url){
                if (!url) return false;
                try {
                    return new URL(url, window.location.href).pathname.toLowerCase().endsWith('.m3u8');
                } catch {
                    return url.split(/[?#]/, 1)[0].toLowerCase().endsWith('.m3u8');
                }
            }

            function showPlayerError(message) {
                hidePlayerLoading();
                if (!playerError || !playerErrorText) return;
                playerErrorText.textContent = message || 'Không thể tải video.';
                playerError.classList.remove('d-none');
            }

            function clearPlayerError() {
                playerError?.classList.add('d-none');
            }

            function restorePlaybackPosition() {
                const resume = +localStorage.getItem(`${movieKey}:ep:${currentEp}:t`) || 0;
                if (resume > 0 && Number.isFinite(video.duration)) {
                    video.currentTime = Math.min(Math.max(0, resume - 2), Math.max(0, video.duration - 1));
                }
            }

            function updatePlayBtnIcon() {
                if (!btnPlay) return;
                if (video.paused) {
                    btnPlay.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>';
                } else {
                    btnPlay.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"></rect><rect x="14" y="4" width="4" height="16"></rect></svg>';
                }
            }

            function getPlayableUrl(url, useProxy) {
                if (useProxy && url && !url.includes('/Film/HlsProxy')) {
                    return '/Film/HlsProxy?url=' + encodeURIComponent(url);
                }
                return url;
            }

            // ==========================================
            // SUBTITLE LOGIC (TFlix Subtitles & Dynamic Overlay)
            // ==========================================
            const btnSubtitle = document.getElementById('btnSubtitle');
            const selSubtitle = document.getElementById('selSubtitle');
            const subtitleDropdownMenu = document.getElementById('subtitleDropdownMenu');
            const subtitleOverlay = document.getElementById('subtitleOverlay');
            const subtitleText = document.getElementById('subtitleText');

            function parseWebVtt(vttText) {
                if (!vttText || typeof vttText !== 'string') return [];
                const cues = [];
                const normalized = vttText.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
                const lines = normalized.split('\n');
                let i = 0;
                while (i < lines.length) {
                    let line = lines[i].trim();
                    if (line.includes('-->')) {
                        const timeParts = line.split('-->');
                        const startSec = parseVttTimestamp(timeParts[0].trim());
                        const endPart = timeParts[1].trim().split(/\s+/)[0];
                        const endSec = parseVttTimestamp(endPart);
                        i++;
                        const textLines = [];
                        while (i < lines.length && lines[i].trim() !== '') {
                            textLines.push(lines[i].trim());
                            i++;
                        }
                        if (endSec > startSec && textLines.length > 0) {
                            cues.push({
                                startSeconds: startSec,
                                endSeconds: endSec,
                                text: textLines.join('\n')
                            });
                        }
                    }
                    i++;
                }
                return cues.sort((a, b) => a.startSeconds - b.startSeconds);
            }

            function parseVttTimestamp(ts) {
                if (!ts) return 0;
                const parts = ts.split(':');
                if (parts.length === 3) {
                    return parseFloat(parts[0]) * 3600 + parseFloat(parts[1]) * 60 + parseFloat(parts[2].replace(',', '.'));
                } else if (parts.length === 2) {
                    return parseFloat(parts[0]) * 60 + parseFloat(parts[1].replace(',', '.'));
                }
                return parseFloat(ts.replace(',', '.')) || 0;
            }

            function normalizeTrack(raw) {
                if (!raw) return null;
                const langCode = (raw.languageCode || raw.LanguageCode || '').toLowerCase();
                const langName = raw.languageName || raw.LanguageName || (langCode === 'vi' ? 'Tiếng Việt' : 'English');
                const rawCues = raw.cues || raw.Cues || [];
                const cues = (Array.isArray(rawCues) ? rawCues : []).map(c => ({
                    id: c.id || c.Id || 0,
                    startSeconds: typeof c.startSeconds === 'number' ? c.startSeconds : (c.StartSeconds || 0),
                    endSeconds: typeof c.endSeconds === 'number' ? c.endSeconds : (c.EndSeconds || 0),
                    text: c.text || c.Text || ''
                })).sort((a, b) => a.startSeconds - b.startSeconds);

                return {
                    id: raw.id || raw.Id || 0,
                    movieId: raw.movieId || raw.MovieId || 0,
                    languageCode: langCode,
                    languageName: langName,
                    cues: cues
                };
            }

            let rawInitialSubtitles = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Subtitles ?? new List<CoreLib.Dtos.Subtitle.SubtitleTrackDto>()));
            let subtitlesList = Array.isArray(rawInitialSubtitles) ? rawInitialSubtitles.map(normalizeTrack).filter(Boolean) : [];
            let currentSubtitleLang = 'off';

            function getCurrentSourceSubtitles(rawUrl) {
                const urlToCheck = rawUrl || (selServer ? selServer.value : '') || '';
                const source = allSources.find(item => sourceValue(item, 'stream_url', 'streamUrl', 'StreamUrl', 'streaM_URL') === urlToCheck);
                const sourceId = sourceValue(source, 'source_id', 'sourceId', 'SourceId', 'sourcE_ID');
                const items = (sourceId && (subtitlesBySource[String(sourceId)] || subtitlesBySource[sourceId])) || [];
                return { sourceId, items };
            }

            function syncSubtitleUi(lang) {
                currentSubtitleLang = lang;
                if (selSubtitle) selSubtitle.value = lang;
                if (selSubtitleInPlayer) selSubtitleInPlayer.value = lang;

                if (btnSubtitle) {
                    if (lang === 'off') {
                        btnSubtitle.classList.remove('active-sub');
                    } else {
                        btnSubtitle.classList.add('active-sub');
                    }
                }

                document.querySelectorAll('#subtitleDropdownMenu .sub-track-item').forEach(item => {
                    const itemLang = item.getAttribute('data-lang');
                    const checkIcon = item.querySelector('.sub-check');
                    if (itemLang === lang) {
                        item.classList.add('active');
                        if (checkIcon) checkIcon.classList.remove('d-none');
                    } else {
                        item.classList.remove('active');
                        if (checkIcon) checkIcon.classList.add('d-none');
                    }
                });
            }

            async function setSubtitleTrack(lang, showToast = true) {
                syncSubtitleUi(lang);
                localStorage.setItem(movieKey + ':subtitle', lang);

                if (lang === 'off') {
                    if (subtitleOverlay) subtitleOverlay.classList.add('d-none');
                    if (subtitleText) subtitleText.textContent = '';
                    if (video) {
                        [...video.querySelectorAll('track[data-tflix="sub"]')].forEach(t => t.remove());
                        [...video.textTracks].forEach(t => t.mode = 'disabled');
                    }
                    if (showToast) showQualityToast('Đã tắt phụ đề');
                    return;
                }

                const { sourceId, items } = getCurrentSourceSubtitles();
                const subItem = items.find(item => {
                    const c = String(subtitleValue(item, 'languageCode', 'LanguageCode', 'language_code') || '').toLowerCase();
                    return c === lang.toLowerCase();
                });

                const langLabel = lang === 'vi' ? 'Tiếng Việt' : (lang === 'en' ? 'English' : lang.toUpperCase());

                let track = subtitlesList.find(t => (t.languageCode || '').toLowerCase() === lang.toLowerCase());

                if (!track || !track.cues || track.cues.length === 0) {
                    let vttFetchUrl = '';
                    if (subItem && subItem.url) {
                        vttFetchUrl = `/Film/SubtitleVtt?sourceId=${sourceId || ''}&lang=${lang}&url=${encodeURIComponent(subItem.url)}`;
                    } else if (sourceId) {
                        vttFetchUrl = `/Film/SubtitleVtt?sourceId=${sourceId}&lang=${lang}`;
                    } else {
                        vttFetchUrl = `/Film/SubtitleVtt?id=${movieId}&lang=${lang}${currentEp > 0 ? '&episodeId=' + currentEp : ''}`;
                    }

                    try {
                        if (showToast) showQualityToast(`Đang tải phụ đề ${langLabel}...`);
                        const res = await fetch(vttFetchUrl);
                        if (!res.ok) throw new Error('HTTP ' + res.status);
                        const vttText = await res.text();
                        const parsedCues = parseWebVtt(vttText);
                        if (parsedCues && parsedCues.length > 0) {
                            track = {
                                movieId: movieId,
                                languageCode: lang,
                                languageName: langLabel,
                                cues: parsedCues
                            };
                            subtitlesList = subtitlesList.filter(t => (t.languageCode || '').toLowerCase() !== lang.toLowerCase());
                            subtitlesList.push(track);
                        }
                    } catch (err) {
                        console.error('Lỗi khi tải phụ đề:', err);
                    }
                }

                if (!track || !track.cues || track.cues.length === 0) {
                    syncSubtitleUi('off');
                    showQualityToast(`Nguồn phim chưa có phụ đề ${langLabel}.`);
                    return;
                }

                if (video) {
                    [...video.querySelectorAll('track[data-tflix="sub"]')].forEach(t => t.remove());
                    const trackEl = document.createElement('track');
                    trackEl.setAttribute('data-tflix', 'sub');
                    trackEl.kind = 'subtitles';
                    trackEl.label = langLabel;
                    trackEl.srclang = lang;
                    const trackSrc = `/Film/SubtitleVtt?sourceId=${sourceId || ''}&lang=${lang}${subItem?.url ? '&url=' + encodeURIComponent(subItem.url) : ''}`;
                    trackEl.src = trackSrc;
                    trackEl.default = true;
                    video.appendChild(trackEl);
                    [...video.textTracks].forEach(t => {
                        t.mode = (t.language === lang ? 'hidden' : 'disabled');
                    });
                }

                const now = video ? video.currentTime : 0;
                updateSubtitleDisplay(now);

                if (showToast) {
                    showQualityToast(`Phụ đề: ${langLabel}`);
                }
            }

            function updateSubtitleDisplay(currentTime) {
                if (currentSubtitleLang === 'off' || !subtitleOverlay || !subtitleText) {
                    if (subtitleOverlay && !subtitleOverlay.classList.contains('d-none')) {
                        subtitleOverlay.classList.add('d-none');
                    }
                    return;
                }

                const track = subtitlesList.find(t => (t.languageCode || '').toLowerCase() === currentSubtitleLang.toLowerCase());
                if (!track || !track.cues || track.cues.length === 0) {
                    subtitleOverlay.classList.add('d-none');
                    return;
                }

                let currentCue = track.cues.find(c => (currentTime + 0.15) >= c.startSeconds && currentTime <= (c.endSeconds + 0.15));
                if (!currentCue && currentTime < 0.5 && track.cues.length > 0 && track.cues[0].startSeconds <= 2.0) {
                    currentCue = track.cues[0];
                }

                if (currentCue && currentCue.text) {
                    if (subtitleText.textContent !== currentCue.text) {
                        subtitleText.textContent = currentCue.text;
                    }
                    subtitleOverlay.classList.remove('d-none');
                } else {
                    subtitleOverlay.classList.add('d-none');
                }
            }

            function toggleSubtitleShortcut() {
                if (currentSubtitleLang === 'off') {
                    setSubtitleTrack('vi');
                } else if (currentSubtitleLang === 'vi') {
                    setSubtitleTrack('en');
                } else {
                    setSubtitleTrack('off');
                }
            }

            function updateSubtitlesForSource(rawUrl) {
                if (!video) return;
                const { sourceId, items } = getCurrentSourceSubtitles(rawUrl);

                [...video.querySelectorAll('track[kind="subtitles"]')].forEach(track => track.remove());

                if (selSubtitleInPlayer) {
                    selSubtitleInPlayer.innerHTML = '<option value="off">CC Tắt</option>';
                    items.forEach(item => {
                        const lang = String(subtitleValue(item, 'languageCode', 'LanguageCode', 'language_code') || '').toLowerCase();
                        const label = lang === 'vi' ? 'Tiếng Việt' : (lang === 'en' ? 'English' : lang.toUpperCase());
                        const opt = document.createElement('option');
                        opt.value = lang;
                        opt.textContent = 'CC ' + label;
                        selSubtitleInPlayer.appendChild(opt);
                    });
                    selSubtitleInPlayer.disabled = (items.length === 0);
                    selSubtitleInPlayer.title = items.length ? 'Chọn phụ đề' : 'Nguồn này chưa có phụ đề';
                }

                if (selSubtitle) {
                    selSubtitle.innerHTML = '<option value="off">Tắt phụ đề</option>';
                    items.forEach(item => {
                        const lang = String(subtitleValue(item, 'languageCode', 'LanguageCode', 'language_code') || '').toLowerCase();
                        const label = lang === 'vi' ? 'Tiếng Việt' : (lang === 'en' ? 'English' : lang.toUpperCase());
                        const opt = document.createElement('option');
                        opt.value = lang;
                        opt.textContent = label;
                        selSubtitle.appendChild(opt);
                    });
                }

                if (subtitleDropdownMenu) {
                    let html = `
                        <li class="dropdown-header text-uppercase small text-white-50 px-3 py-1">Tùy chọn phụ đề</li>
                        <li><a class="dropdown-item ${currentSubtitleLang === 'off' ? 'active' : ''} d-flex align-items-center justify-content-between sub-track-item" href="javascript:void(0)" data-lang="off"><span>Tắt phụ đề</span><i class="bi bi-check2 sub-check ${currentSubtitleLang === 'off' ? '' : 'd-none'}"></i></a></li>
                        <li><hr class="dropdown-divider border-secondary opacity-25"></li>
                        <li class="dropdown-header text-uppercase small text-info px-3 py-1">Phụ đề có sẵn</li>
                    `;
                    if (items.length === 0) {
                        html += `<li><span class="dropdown-item-text text-white-50 small px-3">Chưa có phụ đề cho nguồn này</span></li>`;
                    } else {
                        items.forEach(item => {
                            const lang = String(subtitleValue(item, 'languageCode', 'LanguageCode', 'language_code') || '').toLowerCase();
                            const label = lang === 'vi' ? 'Tiếng Việt' : (lang === 'en' ? 'English' : lang.toUpperCase());
                            const isActive = currentSubtitleLang === lang;
                            html += `<li><a class="dropdown-item ${isActive ? 'active' : ''} d-flex align-items-center justify-content-between sub-track-item" href="javascript:void(0)" data-lang="${lang}"><span>${label}</span><i class="bi bi-check2 sub-check ${isActive ? '' : 'd-none'}"></i></a></li>`;
                        });
                    }
                    subtitleDropdownMenu.innerHTML = html;
                    subtitleDropdownMenu.querySelectorAll('.sub-track-item').forEach(el => {
                        el.addEventListener('click', (e) => {
                            e.preventDefault();
                            const targetLang = el.getAttribute('data-lang') || 'off';
                            setSubtitleTrack(targetLang, true);
                        });
                    });
                }

                const savedPref = localStorage.getItem(movieKey + ':subtitle');
                const defaultItem = items.find(it => Boolean(subtitleValue(it, 'isDefault', 'IsDefault', 'is_default')))
                                 || items.find(it => String(subtitleValue(it, 'languageCode', 'LanguageCode') || '').toLowerCase() === 'vi');
                const autoLang = (savedPref && savedPref !== 'off' && items.some(it => String(subtitleValue(it, 'languageCode', 'LanguageCode') || '').toLowerCase() === savedPref))
                    ? savedPref
                    : (defaultItem ? String(subtitleValue(defaultItem, 'languageCode', 'LanguageCode') || 'vi').toLowerCase() : 'off');

                if (autoLang && autoLang !== 'off') {
                    setSubtitleTrack(autoLang, false);
                } else {
                    syncSubtitleUi('off');
                }
            }

            if (selSubtitle) {
                selSubtitle.addEventListener('change', () => {
                    setSubtitleTrack(selSubtitle.value, true);
                });
            }

            if (selSubtitleInPlayer) {
                selSubtitleInPlayer.addEventListener('change', () => {
                    setSubtitleTrack(selSubtitleInPlayer.value, true);
                });
            }

            if (video) {
                video.addEventListener('timeupdate', () => {
                    updateSubtitleDisplay(video.currentTime);
                });
            }

            function loadSource(rawUrl, useProxy = false){
                if (!isLoggedIn) {
                    guardAuth();
                    return;
                }
                if (!rawUrl || typeof rawUrl !== 'string') {
                    showPlayerError('Nguồn video không hợp lệ.');
                    return;
                }

                clearPlayerError();
                hidePremiumGate();
                showPlayerLoading();
                localStorage.setItem(movieKey + ":server", rawUrl);
                updateSubtitlesForSource(rawUrl);

                if (video.hlsInstance) {
                    video.hlsInstance.destroy();
                    video.hlsInstance = null;
                }
                video.pause();
                video.removeAttribute('src');
                video.load();

                const streamToLoad = getPlayableUrl(rawUrl, useProxy);

                if (isHlsSource(rawUrl) && window.Hls && Hls.isSupported()) {
                    const hls = new Hls({
                        enableWorker: true,
                        lowLatencyMode: false,
                        maxBufferLength: 12,
                        maxMaxBufferLength: 24,
                        backBufferLength: 10,
                        maxBufferSize: 32 * 1024 * 1024,
                        maxBufferHole: 0.5,
                        startFragPrefetch: false
                    });
                    let hlsNetworkRetryCount = 0;
                    hls.on(Hls.Events.ERROR, (_event, data) => {
                        if (!data.fatal) return;
                        if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
                            if (!useProxy) {
                                console.warn('HLS trực tiếp gặp lỗi mạng/CORS. Tự động chuyển sang luồng Stream Proxy...');
                                hls.destroy();
                                video.hlsInstance = null;
                                loadSource(rawUrl, true);
                                return;
                            }
                            hlsNetworkRetryCount++;
                            if (hlsNetworkRetryCount <= 2) {
                                showPlayerError('Đang thử kết nối lại luồng HLS...');
                                hls.startLoad();
                            } else {
                                showPlayerError('Không thể kết nối đến nguồn phát video (Lỗi mạng hoặc HTTP 404). Vui lòng chọn tập hoặc máy chủ khác.');
                                hls.destroy();
                                video.hlsInstance = null;
                            }
                        } else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
                            hls.recoverMediaError();
                        } else {
                            showPlayerError('Nguồn phát HLS không khả dụng.');
                            hls.destroy();
                            video.hlsInstance = null;
                        }
                    });
                    hls.loadSource(streamToLoad);
                    hls.attachMedia(video);
                    video.hlsInstance = hls;

                    hls.on(Hls.Events.MANIFEST_PARSED, (event, data) => {
                        clearPlayerError();
                        restorePlaybackPosition();
                        populateHlsQualities(hls);
                        video.play().catch(() => {});
                    });

                    hls.on(Hls.Events.FRAG_BUFFERED, () => {
                        updateBufferedProgress();
                    });

                    hls.on(Hls.Events.LEVEL_SWITCHED, (event, data) => {
                        const lvl = hls.levels[data.level];
                        if (lvl) {
                            const resText = (lvl.height ? lvl.height + 'p' : 'Auto');
                            showQualityToast('Chất lượng: ' + resText);
                        }
                    });
                } else if (isHlsSource(rawUrl) && video.canPlayType('application/vnd.apple.mpegurl')) {
                    video.src = streamToLoad;
                    video.addEventListener('loadedmetadata', restorePlaybackPosition, { once: true });
                    video.load();
                    video.play().catch(() => {});
                } else {
                    video.src = streamToLoad;
                    populateFallbackQualities();
                    video.addEventListener('loadedmetadata', restorePlaybackPosition, { once: true });
                    video.load();
                    video.play().catch(() => {});
                }

                updatePlayBtnIcon();
            }

            video.addEventListener('loadstart', showPlayerLoading);
            video.addEventListener('waiting', showPlayerLoading);
            video.addEventListener('stalled', showPlayerLoading);
            video.addEventListener('seeking', showPlayerLoading);
            video.addEventListener('canplay', () => {
                hidePlayerLoading();
                clearPlayerError();
            });
            video.addEventListener('playing', hidePlayerLoading);
            video.addEventListener('seeked', hidePlayerLoading);
            video.addEventListener('play', () => {
                updatePlayBtnIcon();
                showControls(true);
            });
            video.addEventListener('pause', () => {
                updatePlayBtnIcon();
                showControls(false);
            });

            video.addEventListener('error', () => {
                hidePlayerLoading();
                const code = video.error?.code;
                const message = code === 4
                    ? 'Trình duyệt không hỗ trợ nguồn phát hoặc máy chủ chặn CORS.'
                    : 'Không thể tải video từ máy chủ lưu trữ.';
                showPlayerError(message);
            });

            // Prevent contextmenu
            playerBox.addEventListener('contextmenu', event => event.preventDefault());

            // ==========================================
            // PLAYER CONTROLS AUTO-HIDE & TAP TO TOGGLE (NHẤN 1 LẦN HIỆN, 2 LẦN ẨN)
            // ==========================================
            const playerControls = playerBox ? playerBox.querySelector('.player-controls') : null;
            let controlsHideTimer = null;
            let lastTapTimestamp = 0;

            function showControls(autoHide = true) {
                if (!playerBox) return;
                playerBox.classList.remove('hide-ui');
                clearTimeout(controlsHideTimer);
                if (autoHide && video && !video.paused) {
                    controlsHideTimer = setTimeout(() => {
                        hideControls();
                    }, 3500);
                }
            }

            function hideControls() {
                if (!playerBox) return;
                playerBox.classList.add('hide-ui');
                clearTimeout(controlsHideTimer);
            }

            function toggleControls() {
                if (!playerBox) return;
                const now = Date.now();
                if (now - lastTapTimestamp < 250) return; // Debounce chống double trigger
                lastTapTimestamp = now;

                if (playerBox.classList.contains('hide-ui')) {
                    // Nhấn lần 1: Hiện thanh công cụ lên
                    showControls(true);
                } else {
                    // Nhấn lần 2 (nhấn lại): Ẩn thanh công cụ đi
                    hideControls();
                }
            }

            // Chặn click / touch bên trong cụm controls làm kích hoạt toggle ẩn/hiện
            if (playerControls) {
                playerControls.addEventListener('click', (e) => {
                    e.stopPropagation();
                    if (video && !video.paused) {
                        showControls(true); // reset timer giữ controls hiển thị
                    }
                });
                playerControls.addEventListener('touchstart', (e) => {
                    e.stopPropagation();
                    if (video && !video.paused) {
                        showControls(true);
                    }
                }, { passive: true });
            }

            // Xử lý chạm trên mobile (chống lag 300ms và phân biệt vuốt/chạm)
            let touchStartX = 0;
            let touchStartY = 0;
            let isTouchScrolling = false;

            if (playerBox) {
                playerBox.addEventListener('touchstart', (e) => {
                    if (e.touches && e.touches.length === 1) {
                        touchStartX = e.touches[0].clientX;
                        touchStartY = e.touches[0].clientY;
                        isTouchScrolling = false;
                    }
                }, { passive: true });

                playerBox.addEventListener('touchmove', (e) => {
                    if (e.touches && e.touches.length === 1) {
                        const dx = Math.abs(e.touches[0].clientX - touchStartX);
                        const dy = Math.abs(e.touches[0].clientY - touchStartY);
                        if (dx > 10 || dy > 10) {
                            isTouchScrolling = true;
                        }
                    }
                }, { passive: true });

                playerBox.addEventListener('touchend', (e) => {
                    if (isTouchScrolling) return;
                    if (e.target.closest('.player-controls, .quality-toast, #playerError, .modal, button, select, input, a, .control-btn')) {
                        return;
                    }
                    e.preventDefault();
                    toggleControls();
                });

                // Xử lý click chuột máy tính
                playerBox.addEventListener('click', (e) => {
                    if (e.target.closest('.player-controls, .quality-toast, #playerError, .modal, button, select, input, a, .control-btn')) {
                        return;
                    }
                    toggleControls();
                });

                // Di chuột trên PC thì hiện controls, rời chuột thì tự ẩn nếu đang phát
                playerBox.addEventListener('mousemove', () => {
                    showControls(true);
                });
                playerBox.addEventListener('mouseleave', () => {
                    if (video && !video.paused) {
                        hideControls();
                    }
                });
            }

            if (video) {
                video.addEventListener('click', (e) => {
                    e.stopPropagation();
                    toggleControls();
                });
            }

            (function initSelections(){
                if (selServer) {
                    const last = localStorage.getItem(movieKey + ":server");
                    const hasOption = last && [...selServer.options].some(o => o.value === last);
                    if (hasOption) {
                        selServer.value = last;
                    } else if (last) {
                        localStorage.removeItem(movieKey + ":server");
                    }
                    selServer.addEventListener('change', e => guardAuth(()=> loadSource(e.target.value)));
                }
            })();

            (function autoPlay(){
                const firstUrl = selServer ? selServer.value : @Json.Serialize(currentSource);
                if (isLoggedIn && firstUrl) loadSource(firstUrl);
            })();

            if (btnPlay) {
                btnPlay.addEventListener('click', () => guardAuth(()=>{
                    if (video.paused) { video.play(); }
                    else { video.pause(); }
                }));
            }
            if (btnBack) btnBack.addEventListener('click', () => guardAuth(()=> video.currentTime -= 10));
            if (btnFwd) btnFwd.addEventListener('click', () => guardAuth(()=> video.currentTime += 10));

            if (vol) vol.addEventListener('input', e => {
                video.volume = +e.target.value;
                video.muted = (video.volume === 0);
            });

            if (btnMute) {
                btnMute.addEventListener('click', () => {
                    video.muted = !video.muted;
                    if (vol) vol.value = video.muted ? 0 : (video.volume || 1);
                });
            }

            if (selSpeed) selSpeed.addEventListener('change', e => video.playbackRate = +e.target.value);

            // ==========================================
            // CROSS-DEVICE & MOBILE FULLSCREEN CONTROLLER
            // ==========================================
            function isFullscreenActive() {
                return !!(
                    document.fullscreenElement ||
                    document.webkitFullscreenElement ||
                    document.mozFullScreenElement ||
                    document.msFullscreenElement ||
                    (playerBox && playerBox.classList.contains('mobile-fullscreen-active'))
                );
            }

            function updateFsButtonIcon(isFs) {
                if (!btnFs) return;
                if (isFs) {
                    btnFs.title = "Thu nhỏ màn hình (Esc hoặc F)";
                    btnFs.innerHTML = `
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"></path>
                        </svg>
                    `;
                } else {
                    btnFs.title = "Toàn màn hình (F)";
                    btnFs.innerHTML = `
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path>
                        </svg>
                    `;
                }
            }

            async function toggleFullscreen() {
                const isCurrentlyFs = isFullscreenActive();

                if (isCurrentlyFs) {
                    // Exit fullscreen
                    try {
                        if (document.exitFullscreen) {
                            await document.exitFullscreen();
                        } else if (document.webkitExitFullscreen) {
                            await document.webkitExitFullscreen();
                        } else if (document.mozCancelFullScreen) {
                            await document.mozCancelFullScreen();
                        } else if (document.msExitFullscreen) {
                            await document.msExitFullscreen();
                        }
                    } catch (e) {
                        console.warn('Exit fullscreen error:', e);
                    }

                    if (video && typeof video.webkitExitFullscreen === 'function') {
                        try { video.webkitExitFullscreen(); } catch (e) {}
                    }

                    if (playerBox) playerBox.classList.remove('mobile-fullscreen-active');
                    document.body.classList.remove('has-fullscreen-player');
                    updateFsButtonIcon(false);
                    showControls(false);

                    if (screen.orientation && screen.orientation.unlock) {
                        try { screen.orientation.unlock(); } catch (e) {}
                    }
                } else {
                    // Enter fullscreen
                    // 1. iOS Safari (iPhone / iPod): does not support Element.requestFullscreen() on arbitrary divs.
                    // Video element MUST use webkitEnterFullscreen directly.
                    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
                    if (isIOS && video && typeof video.webkitEnterFullscreen === 'function') {
                        try {
                            video.webkitEnterFullscreen();
                            return;
                        } catch (e) {
                            console.warn('iOS webkitEnterFullscreen failed, trying fallback:', e);
                        }
                    }

                    // 2. Standard HTML5 Fullscreen API on playerBox (wraps video + custom controls)
                    let reqFn = null;
                    if (playerBox) {
                        reqFn = playerBox.requestFullscreen ||
                                playerBox.webkitRequestFullscreen ||
                                playerBox.mozRequestFullScreen ||
                                playerBox.msRequestFullscreen;
                    }

                    if (reqFn && playerBox) {
                        try {
                            const promise = reqFn.call(playerBox);
                            if (promise && typeof promise.then === 'function') {
                                await promise;
                            }
                            updateFsButtonIcon(true);
                            showControls(true);
                        } catch (err) {
                            console.warn('playerBox requestFullscreen failed:', err);
                            // If playerBox failed on Android / WebKit, try video element directly
                            if (video) {
                                try {
                                    if (video.requestFullscreen) await video.requestFullscreen();
                                    else if (video.webkitRequestFullscreen) await video.webkitRequestFullscreen();
                                    else if (typeof video.webkitEnterFullscreen === 'function') video.webkitEnterFullscreen();
                                    updateFsButtonIcon(true);
                                    showControls(true);
                                    return;
                                } catch (vErr) {
                                    console.warn('Video fullscreen also failed:', vErr);
                                }
                            }

                            // 3. Fallback CSS pseudo-fullscreen for in-app webviews (Zalo, FB, Messenger)
                            if (playerBox) playerBox.classList.add('mobile-fullscreen-active');
                            document.body.classList.add('has-fullscreen-player');
                            updateFsButtonIcon(true);
                            showControls(true);
                        }
                    } else if (video && typeof video.webkitEnterFullscreen === 'function') {
                        try {
                            video.webkitEnterFullscreen();
                        } catch (e) {
                            if (playerBox) playerBox.classList.add('mobile-fullscreen-active');
                            document.body.classList.add('has-fullscreen-player');
                            updateFsButtonIcon(true);
                            showControls(true);
                        }
                    } else {
                        // 3. Fallback CSS pseudo-fullscreen
                        if (playerBox) playerBox.classList.add('mobile-fullscreen-active');
                        document.body.classList.add('has-fullscreen-player');
                        updateFsButtonIcon(true);
                        showControls(true);
                    }

                    // Attempt orientation lock to landscape on mobile devices
                    if (screen.orientation && screen.orientation.lock && window.innerWidth < 992) {
                        try { screen.orientation.lock('landscape').catch(() => {}); } catch (e) {}
                    }
                }
            }

            if (btnFs) {
                btnFs.addEventListener('click', (e) => {
                    e.preventDefault();
                    toggleFullscreen();
                });
            }

            // Sync fullscreen change events across all browser engines
            ['fullscreenchange', 'webkitfullscreenchange', 'mozfullscreenchange', 'MSFullscreenChange'].forEach(evt => {
                document.addEventListener(evt, () => {
                    const isFs = isFullscreenActive();
                    if (!isFs && playerBox) {
                        playerBox.classList.remove('mobile-fullscreen-active');
                        document.body.classList.remove('has-fullscreen-player');
                    }
                    updateFsButtonIcon(isFs);
                    if (isFs) {
                        showControls(true);
                    } else {
                        showControls(false);
                    }
                });
            });

            if (video) {
                video.addEventListener('webkitbeginfullscreen', () => updateFsButtonIcon(true));
                video.addEventListener('webkitendfullscreen', () => updateFsButtonIcon(false));
            }
            if (btnTheater) {
                btnTheater.addEventListener('click', () => {
                    document.body.classList.toggle('theater');
                });
            }

            // Progress UI: hiển thị 1 phần video đã phát và 1 phần mờ hơn là phần nội dung đã load
            function updateBufferedProgress() {
                if (!video || !buffered || !video.duration || Number.isNaN(video.duration)) return;
                try {
                    const curTime = video.currentTime;
                    let bufferedEnd = 0;
                    for (let i = 0; i < video.buffered.length; i++) {
                        const start = video.buffered.start(i);
                        const end = video.buffered.end(i);
                        if (curTime >= start && curTime <= end) {
                            bufferedEnd = end;
                            break;
                        } else if (end > bufferedEnd && start <= curTime) {
                            bufferedEnd = end;
                        }
                    }
                    if (bufferedEnd === 0 && video.buffered.length > 0) {
                        bufferedEnd = video.buffered.end(video.buffered.length - 1);
                    }
                    const pct = Math.min(100, Math.max(0, (bufferedEnd / video.duration) * 100));
                    buffered.style.width = pct + '%';
                } catch (e) {}
            }

            video.addEventListener('timeupdate', () => {
                const p = (video.currentTime / (video.duration || 1)) * 100;
                if (bar) bar.style.width = p + '%';
                if (time) time.textContent = `${fmt(video.currentTime)} / ${fmt(video.duration)}`;
                if (Math.floor(video.currentTime) % 2 === 0) {
                    localStorage.setItem(`${movieKey}:ep:${currentEp}:t`, String(Math.floor(video.currentTime)));
                }
                updateBufferedProgress();
                updateSubtitleDisplay(video.currentTime);
            });

            video.addEventListener('progress', updateBufferedProgress);

            if (progress) {
                progress.addEventListener('click', e => guardAuth(() => {
                    const r = progress.getBoundingClientRect();
                    const ratio = (e.clientX - r.left) / r.width;
                    video.currentTime = ratio * (video.duration || 0);
                    updateBufferedProgress();
                }));
            }

            // Phím tắt bàn phím
            window.addEventListener('keydown', (e)=>{
                const tag = (e.target.tagName||'').toLowerCase();
                if (['input','textarea'].includes(tag)) return;
                if (e.code === 'Space'){ e.preventDefault(); btnPlay?.click(); }
                else if (e.code === 'ArrowLeft'){ e.preventDefault(); btnBack?.click(); }
                else if (e.code === 'ArrowRight'){ e.preventDefault(); btnFwd?.click(); }
                else if (e.key.toLowerCase()==='f'){ e.preventDefault(); btnFs?.click(); }
                else if (e.key.toLowerCase()==='t'){ e.preventDefault(); btnTheater?.click(); }
                else if (e.key.toLowerCase()==='c'){ e.preventDefault(); toggleSubtitleShortcut(); }
                else if (e.key.toLowerCase()==='m'){ e.preventDefault(); btnMute?.click(); }
                else if (e.key === 'ArrowUp' && vol){ e.preventDefault(); vol.value = Math.min(1, (+vol.value + .05)).toFixed(2); vol.dispatchEvent(new Event('input')); }
                else if (e.key === 'ArrowDown' && vol){ e.preventDefault(); vol.value = Math.max(0, (+vol.value - .05)).toFixed(2); vol.dispatchEvent(new Event('input')); }
            });
        }

        // Lights off / Focus Mode
        const btnLightsOff = document.getElementById('btnLightsOff');
        const lightsOverlay = document.getElementById('lightsOffOverlay');
        if (btnLightsOff) {
            btnLightsOff.addEventListener('click', () => {
                document.body.classList.toggle('lights-off');
                btnLightsOff.classList.toggle('active', document.body.classList.contains('lights-off'));
            });
        }
        if (lightsOverlay) {
            lightsOverlay.addEventListener('click', () => {
                document.body.classList.remove('lights-off');
                btnLightsOff?.classList.remove('active');
            });
        }

        // ==========================================
        // 2. REALTIME COMMENTS WITH SIGNALR
        // ==========================================
        let signalrConn = null;
        let activeGroupKey = "";

        function getContentGroupKey(ep) {
            if (ep && ep > 0) return "ep_" + ep;
            return "movie_" + movieId;
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function renderCommentItem(cmt, isNew = false) {
            const avatar = cmt.userAvatar || `https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80`;
            const timeAgo = cmt.formattedTime || 'Vừa xong';
            const author = escapeHtml(cmt.userName || 'Người dùng TFlix');
            const text = escapeHtml(cmt.content || '');
            const isMe = cmt.userId && cmt.userId === currentUserId;

            return `
                <div class="cmt-item ${isNew ? 'new-arrival' : ''}" id="cmt-${cmt.commentId || Date.now()}">
                    <div class="d-flex gap-3">
                        <img src="${avatar}" class="rounded-circle" width="42" height="42" style="object-fit:cover; border: 2px solid rgba(25, 211, 197, 0.4);" />
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between mb-1.5">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-white small">${author}</span>
                                    ${isMe ? '<span class="badge" style="background: rgba(25, 211, 197, 0.2); color: #19d3c5; font-size: 0.65rem;">Bạn</span>' : ''}
                                    <span class="text-muted small">• ${timeAgo}</span>
                                </div>
                            </div>
                            <div class="text-light" style="white-space: pre-wrap; font-size: 0.92rem; line-height: 1.55;">${text}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function updateCommentCountBadge(increment = 0, setCount = null) {
            const el = document.getElementById('cmtCount');
            if (!el) return;
            let current = parseInt(el.textContent) || 0;
            if (setCount !== null) {
                current = setCount;
            } else {
                current += increment;
            }
            el.textContent = Math.max(0, current);
        }

        function addCommentToUI(comment, isNew = true) {
            const listEl = document.getElementById('cmtList');
            if (!listEl) return;

            const emptyEl = document.getElementById('cmtEmpty');
            if (emptyEl) emptyEl.remove();

            const cmtHtml = renderCommentItem(comment, isNew);
            listEl.insertAdjacentHTML('afterbegin', cmtHtml);
            updateCommentCountBadge(1);
        }

        function loadComments() {
            const listEl = document.getElementById('cmtList');
            if (!listEl) return;

            const epParam = currentEp > 0 ? currentEp : '';
            fetch(`/Film/GetComments?movieId=${movieId}&episodeId=${epParam}`)
                .then(res => res.json())
                .then(res => {
                    listEl.innerHTML = '';
                    if (res && res.success && Array.isArray(res.data) && res.data.length > 0) {
                        res.data.forEach(item => {
                            listEl.insertAdjacentHTML('beforeend', renderCommentItem(item, false));
                        });
                        updateCommentCountBadge(0, res.data.length);
                    } else {
                        updateCommentCountBadge(0, 0);
                        listEl.innerHTML = `
                            <div class="text-center py-4 text-muted" id="cmtEmpty">
                                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="d-block mx-auto mb-2 opacity-50"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                <span>Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nghĩ về bộ phim!</span>
                            </div>
                        `;
                    }
                })
                .catch(err => {
                    console.error('Lỗi tải bình luận:', err);
                    listEl.innerHTML = `
                        <div class="text-center py-4 text-muted" id="cmtEmpty">
                            <span>Hãy là người đầu tiên bình luận về bộ phim này!</span>
                        </div>
                    `;
                });
        }

        function switchSignalRGroup() {
            if (!signalrConn || signalrConn.state !== signalR.HubConnectionState.Connected) return;

            const newKey = getContentGroupKey(currentEp);
            if (activeGroupKey && activeGroupKey !== newKey) {
                signalrConn.invoke('LeaveContentGroup', activeGroupKey).catch(()=>{});
            }
            activeGroupKey = newKey;
            signalrConn.invoke('JoinContentGroup', activeGroupKey).then(() => {
                console.log('✅ Đã tham gia phòng SignalR:', activeGroupKey);
            }).catch(console.error);
        }

        function initSignalRConnection() {
            if (typeof signalR === 'undefined') return;

            signalrConn = new signalR.HubConnectionBuilder()
                .withUrl('/commentHub')
                .withAutomaticReconnect([0, 2000, 5000, 10000, 20000])
                .build();

            signalrConn.on('ReceiveComment', function (comment) {
                addCommentToUI(comment, true);
            });

            signalrConn.start().then(() => {
                switchSignalRGroup();
            }).catch(err => {
                console.warn('SignalR Hub kết nối:', err);
            });

            signalrConn.onreconnected(() => {
                switchSignalRGroup();
            });
        }

        initSignalRConnection();
        loadComments();

        // Emoji insertion helper
        window.insertEmoji = function(emoji) {
            const textarea = document.getElementById('cmt');
            if (!textarea) return;
            const start = textarea.selectionStart || textarea.value.length;
            const end = textarea.selectionEnd || textarea.value.length;
            textarea.value = textarea.value.substring(0, start) + emoji + textarea.value.substring(end);
            textarea.focus();
            textarea.selectionStart = textarea.selectionEnd = start + emoji.length;
            document.getElementById('cmtCharCount').textContent = `${textarea.value.length} / 500`;
        };

        // Gửi bình luận
        const btnCmt = document.getElementById('btnCmt');
        const cmtTextarea = document.getElementById('cmt');
        const cmtCharCount = document.getElementById('cmtCharCount');

        if (cmtTextarea && cmtCharCount) {
            cmtTextarea.addEventListener('input', () => {
                cmtCharCount.textContent = `${cmtTextarea.value.length} / 500`;
            });
            cmtTextarea.addEventListener('keydown', (e) => {
                if (e.ctrlKey && e.key === 'Enter') {
                    btnCmt?.click();
                }
            });
        }

        if (btnCmt && cmtTextarea) {
            btnCmt.addEventListener('click', async () => {
                if (!isLoggedIn) {
                    guardAuth();
                    return;
                }

                const content = cmtTextarea.value.trim();
                if (!content) {
                    cmtTextarea.focus();
                    return;
                }

                btnCmt.disabled = true;
                const originalHtml = btnCmt.innerHTML;
                btnCmt.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang gửi...';

                const payload = {
                    movieId: movieId,
                    episodeId: currentEp > 0 ? currentEp : null,
                    userId: (currentUserId && currentUserId > 0) ? currentUserId : 1,
                    userName: currentUserName || 'Người dùng TFlix',
                    userAvatar: currentUserAvatar || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=100&auto=format&fit=crop&q=80',
                    content: content
                };

                try {
                    let savedComment = null;
                    if (signalrConn && signalrConn.state === signalR.HubConnectionState.Connected) {
                        try {
                            savedComment = await signalrConn.invoke('SendComment', activeGroupKey, payload);
                        } catch (signalrErr) {
                            console.warn('SignalR invoke SendComment lỗi, fallback sang HTTP:', signalrErr);
                        }
                    }

                    if (!savedComment) {
                        const res = await fetch('/Film/PostComment', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json().catch(() => null);
                        if (res.ok && data?.success && data?.data) {
                            savedComment = data.data;
                        } else if (data?.data) {
                            savedComment = data.data;
                        }
                    }

                    if (!savedComment || !savedComment.commentId) {
                        savedComment = {
                            commentId: Date.now(),
                            ...payload,
                            createdAt: new Date().toISOString(),
                            formattedTime: 'Vừa xong'
                        };
                    }

                    addCommentToUI(savedComment, true);

                    cmtTextarea.value = '';
                    if (cmtCharCount) cmtCharCount.textContent = '0 / 500';
                } catch (err) {
                    console.error('Lỗi khi gửi bình luận:', err);
                    if (typeof window.showTFlixToast === 'function') {
                        window.showTFlixToast(err?.message || 'Gửi bình luận thất bại. Vui lòng thử lại!', 'error', 'Bình luận');
                    } else {
                        alert(err?.message || 'Gửi bình luận thất bại. Vui lòng thử lại!');
                    }
                } finally {
                    btnCmt.disabled = false;
                    btnCmt.innerHTML = originalHtml;
                }
            });
        }

        // ==========================================
        // 3. EPISODE SWITCHING NAVIGATION (100% AJAX - NO RELOAD)
        // ==========================================
        const epList = document.getElementById('epList');
        if (epList) {
            epList.addEventListener('click', async (e) => {
                const item = e.target.closest('.ep-item');
                if (!item) return;
                const ep = +item.dataset.ep;
                if (ep === currentEp) return;

                const isEpPremium = item.dataset.isPremium === 'true';
                const canWatch = item.dataset.canWatch === 'true';

                if (isEpPremium && !canWatch) {
                    showPremiumGate('Nội dung này dành cho tài khoản Premium. Vui lòng thanh toán nâng cấp tài khoản để xem.');
                    return;
                }

                guardAuth(async () => {
                    // Đổi active ngay lập tức trên UI
                    currentEp = ep;
                    document.querySelectorAll('.ep-item').forEach(i => i.classList.toggle('active', i === item));
                    localStorage.setItem(`${movieKey}:last_ep`, String(currentEp));

                    // Cập nhật URL trình duyệt qua history API không làm reload trang, giữ nguyên chatbox
                    const newUrl = new URL(window.location.href);
                    newUrl.searchParams.set('ep', currentEp);
                    newUrl.searchParams.set('episodeId', currentEp);
                    window.history.replaceState({}, '', newUrl);

                    // Gọi AJAX lấy thông tin & nguồn phát tập mới
                    try {
                        const res = await fetch(`/Film/GetEpisodePlayInfo?episodeId=${ep}`);
                        const json = await res.json();

                        if (json && json.isPremium && !json.hasActiveSubscription) {
                            showPremiumGate(json.message || 'Nội dung này dành cho tài khoản Premium. Vui lòng thanh toán nâng cấp tài khoản để xem.');
                            return;
                        }

                        if (json && json.success && json.data) {
                            const epData = json.data;
                            
                            // Cập nhật dropdown Máy chủ phát nếu có
                            if (selServer) {
                                selServer.innerHTML = '';
                                if (epData.sources && epData.sources.length > 0) {
                                    epData.sources.forEach(s => {
                                        const opt = document.createElement('option');
                                        opt.value = s.streamUrl;
                                        opt.textContent = `${s.serverName} • ${s.quality}`;
                                        selServer.appendChild(opt);
                                    });
                                    selServer.value = epData.primaryUrl;
                                }
                            }

                            // Cập nhật video player
                            if (epData.hasSource && epData.primaryUrl) {
                                clearPlayerError();
                                if (typeof loadSource === 'function') {
                                    loadSource(epData.primaryUrl);
                                }
                            } else {
                                if (typeof showPlayerError === 'function') {
                                    showPlayerError(`Tập ${epData.episodeNo} (${epData.episodeTitle}) hiện chưa có nguồn phát video hoặc đang được mã hóa.`);
                                }
                                if (video) {
                                    video.pause();
                                    if (video.hlsInstance) {
                                        video.hlsInstance.destroy();
                                        video.hlsInstance = null;
                                    }
                                }
                            }
                        } else {
                            const fallbackUrl = item.dataset.sourceUrl;
                            if (fallbackUrl && typeof loadSource === 'function') {
                                loadSource(fallbackUrl);
                            }
                        }
                    } catch (err) {
                        console.error('Lỗi khi chuyển tập qua AJAX:', err);
                        const fallbackUrl = item.dataset.sourceUrl;
                        if (fallbackUrl && typeof loadSource === 'function') {
                            loadSource(fallbackUrl);
                        }
                    }

                    // Chuyển nhóm SignalR bình luận và tải comment của tập mới
                    switchSignalRGroup();
                    loadComments();
                });
            });
        }

        // Action buttons: Like, Save, Share
        document.getElementById('btnLike')?.addEventListener('click', function() {
            if (!isLoggedIn) { guardAuth(); return; }
            this.classList.toggle('active');
        });
        document.getElementById('btnSave')?.addEventListener('click', async function() {
            if (!isLoggedIn) { guardAuth(); return; }
            const button = this;
            const label = button.querySelector('span');
            const oldLabel = label?.textContent;
            button.disabled = true;
            if (label) label.textContent = 'Đang lưu...';
            try {
                const token = document.querySelector('#favoriteTokenForm input[name="__RequestVerificationToken"]')?.value || '';
                const body = new URLSearchParams({ movieId, __RequestVerificationToken: token });
                const response = await fetch('@Url.Action("ToggleMovie", "Favorite")', {
                    method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body
                });
                const result = await response.json();
                if (!response.ok || !result.success) throw new Error(result.message || 'Không thể cập nhật yêu thích.');
                const active = result.data?.isFavorite ?? result.data?.IsFavorite ?? false;
                button.classList.toggle('active', active);
                if (label) label.textContent = active ? 'Đã yêu thích' : 'Yêu thích';
                if (typeof window.showTFlixToast === 'function') {
                    window.showTFlixToast(active ? 'Đã thêm phim vào danh sách yêu thích của bạn!' : 'Đã xóa phim khỏi danh sách yêu thích.', active ? 'success' : 'info', 'Yêu thích');
                }
            } catch (error) {
                if (typeof window.showTFlixToast === 'function') {
                    window.showTFlixToast(error.message || 'Không thể cập nhật phim yêu thích.', 'error', 'Yêu thích');
                } else {
                    alert(error.message || 'Không thể cập nhật phim yêu thích.');
                }
                if (label) label.textContent = oldLabel;
            } finally {
                button.disabled = false;
            }
        });

        if (isLoggedIn) {
            fetch('@Url.Action("MovieIds", "Favorite")')
                .then(response => response.ok ? response.json() : null)
                .then(result => {
                    if ((result?.data || []).map(Number).includes(Number(movieId))) {
                        const button = document.getElementById('btnSave');
                        button?.classList.add('active');
                        const label = button?.querySelector('span');
                        if (label) label.textContent = 'Đã yêu thích';
                    }
                }).catch(() => {});
        }
        document.getElementById('btnShare')?.addEventListener('click', function() {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(window.location.href);
                if (typeof window.showTFlixToast === 'function') {
                    window.showTFlixToast('Đã sao chép liên kết chia sẻ phim vào bộ nhớ tạm!', 'success', 'Chia sẻ phim');
                } else {
                    alert('Đã sao chép liên kết chia sẻ phim vào bộ nhớ tạm!');
                }
            } else {
                if (typeof window.showTFlixToast === 'function') {
                    window.showTFlixToast('Liên kết: ' + window.location.href, 'info', 'Chia sẻ phim');
                } else {
                    alert('Liên kết: ' + window.location.href);
                }
            }
        });

        // ==========================================
        // STAR RATING INTERACTION
        // ==========================================
        const starContainer = document.getElementById('starRatingContainer');
        if (starContainer) {
            const stars = starContainer.querySelectorAll('.star-btn');
            const feedbackText = document.getElementById('ratingFeedbackText');
            const avgDisplay = document.getElementById('ratingAvgDisplay');
            const badgeAvg = document.getElementById('badgeAvgRating');
            const totalCount = document.getElementById('ratingTotalCount');
            const badgeCount = document.getElementById('badgeRatingCount');
            const starLabels = {
                1: '1 sao - Rất tệ',
                2: '2 sao - Tệ',
                3: '3 sao - Bình thường',
                4: '4 sao - Hay',
                5: '5 sao - Tuyệt đỉnh!'
            };

            function highlightStars(rating) {
                stars.forEach(btn => {
                    const starVal = parseInt(btn.dataset.star, 10);
                    const icon = btn.querySelector('i');
                    if (starVal <= rating) {
                        btn.classList.add('hovered');
                        if (icon) {
                            icon.classList.remove('bi-star');
                            icon.classList.add('bi-star-fill');
                        }
                    } else {
                        btn.classList.remove('hovered');
                        if (icon && !btn.classList.contains('active')) {
                            icon.classList.remove('bi-star-fill');
                            icon.classList.add('bi-star');
                        }
                    }
                });
            }

            function resetStars() {
                let currentRating = parseInt(starContainer.dataset.userRating, 10) || 0;
                if (currentRating <= 0 && typeof getUserRating === 'function') {
                    const tid = parseInt(starContainer.dataset.movieId, 10) || movieId;
                    currentRating = getUserRating(tid);
                    if (currentRating > 0) starContainer.dataset.userRating = currentRating;
                }
                stars.forEach(btn => {
                    btn.classList.remove('hovered');
                    const starVal = parseInt(btn.dataset.star, 10);
                    const icon = btn.querySelector('i');
                    if (starVal <= currentRating) {
                        btn.classList.add('active');
                        if (icon) {
                            icon.classList.remove('bi-star');
                            icon.classList.add('bi-star-fill');
                        }
                    } else {
                        btn.classList.remove('active');
                        if (icon) {
                            icon.classList.remove('bi-star-fill');
                            icon.classList.add('bi-star');
                        }
                    }
                });
                if (currentRating > 0) {
                    feedbackText.innerHTML = `<span class="text-warning"><i class="bi bi-check-circle-fill me-1"></i>Bạn đã đánh giá ${currentRating} sao</span>`;
                } else {
                    feedbackText.textContent = 'Bấm sao để đánh giá phim';
                }
            }

            // Đồng bộ trạng thái sao ban đầu ngay khi tải trang
            resetStars();

            stars.forEach(btn => {
                btn.addEventListener('mouseenter', () => {
                    const starVal = parseInt(btn.dataset.star, 10);
                    highlightStars(starVal);
                    if (feedbackText) feedbackText.textContent = starLabels[starVal] || `${starVal} sao`;
                });

                btn.addEventListener('click', async () => {
                    if (!isLoggedIn) {
                        guardAuth();
                        return;
                    }

                    const ratingVal = parseInt(btn.dataset.star, 10);
                    const targetMovieId = parseInt(starContainer.dataset.movieId, 10) || movieId;

                    feedbackText.innerHTML = `<span class="text-info"><i class="bi bi-hourglass-split me-1"></i>Đang lưu đánh giá...</span>`;
                    stars.forEach(s => s.disabled = true);

                    try {
                        const resp = await fetch('@Url.Action("RateMovie", "Film")', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ movieId: targetMovieId, rating: ratingVal })
                        });
                        const data = await resp.json();
                        if (!resp.ok || !data.success) {
                            throw new Error(data.message || 'Lỗi khi lưu đánh giá.');
                        }

                        starContainer.dataset.userRating = ratingVal;
                        if (typeof saveUserRating === 'function') {
                            saveUserRating(targetMovieId, ratingVal);
                        }
                        if (data.data) {
                            const newAvg = parseFloat(data.data.averageRating || data.data.AverageRating || 0).toFixed(1);
                            const newCount = data.data.ratingCount || data.data.RatingCount || 0;
                            if (avgDisplay) avgDisplay.textContent = newAvg;
                            if (badgeAvg) badgeAvg.textContent = newAvg;
                            if (totalCount) totalCount.textContent = newCount;
                            if (badgeCount) badgeCount.textContent = newCount;
                        }
                        resetStars();

                        if (typeof window.syncAllCardRatingWidgets === 'function') {
                            window.syncAllCardRatingWidgets();
                        }

                        if (typeof window.showTFlixToast === 'function') {
                            window.showTFlixToast(`Đã đánh giá thành công ${ratingVal} sao cho phim!`, 'bi-star-fill text-warning');
                        } else if (typeof showToast === 'function') {
                            showToast(`Đã đánh giá thành công ${ratingVal} sao cho phim!`, 'success');
                        } else {
                            feedbackText.innerHTML = `<span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã đánh giá thành công ${ratingVal} sao!</span>`;
                        }
                    } catch (err) {
                        feedbackText.innerHTML = `<span class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>${err.message}</span>`;
                        resetStars();
                    } finally {
                        stars.forEach(s => s.disabled = false);
                    }
                });
            });

            starContainer.addEventListener('mouseleave', resetStars);
        }
    </script>
}
