@model CoreLib.Dtos.Movies.MovieCatalogResultDto
@using CoreLib.Dtos.Movies
@using WebBrowser.Models.Genres

@{
    ViewData["Title"] = "Phim Lẻ - TFlix Streaming";
    var filter = ViewBag.Filter as MovieCatalogFilterDto ?? new MovieCatalogFilterDto();
    var genres = ViewBag.Genres as List<GenreItem> ?? new List<GenreItem>();
    var token = Context.Session.GetString("JWToken");
    var isLoggedIn = !string.IsNullOrEmpty(token) || (User?.Identity?.IsAuthenticated ?? false);
    const string fallbackPoster = "https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=500&auto=format&fit=crop";
}

@section Styles {
    <style>
        :root {
            --brand-primary: #00d2c4;
            --brand-secondary: #0084ff;
            --brand-gradient: linear-gradient(135deg, #00d2c4 0%, #0084ff 100%);
            --dark-card: rgba(18, 22, 31, 0.75);
            --dark-border: rgba(255, 255, 255, 0.08);
            --dark-hover: rgba(0, 210, 196, 0.15);
        }

        /* Hero Banner */
        .single-hero {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            background: linear-gradient(135deg, #0d111a 0%, #151a28 100%);
            border: 1px solid var(--dark-border);
            padding: 3rem 2.5rem;
            margin-bottom: 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
        }

        .single-hero::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 60%;
            height: 100%;
            background: radial-gradient(circle at 80% 30%, rgba(0, 210, 196, 0.15) 0%, transparent 60%),
                        radial-gradient(circle at 90% 80%, rgba(0, 132, 255, 0.12) 0%, transparent 50%);
            pointer-events: none;
        }

        .single-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 50px;
            background: rgba(0, 210, 196, 0.12);
            border: 1px solid rgba(0, 210, 196, 0.3);
            color: #00e5d4;
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        /* Filter Panel */
        .single-filter-panel {
            background: var(--dark-card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--dark-border);
            border-radius: 18px;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .filter-input {
            background: rgba(10, 13, 20, 0.7) !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #e2e8f0 !important;
            border-radius: 12px !important;
            font-size: 0.92rem;
            transition: all 0.25s ease;
        }

        .filter-input:focus {
            background: rgba(15, 20, 30, 0.9) !important;
            border-color: var(--brand-primary) !important;
            box-shadow: 0 0 0 3px rgba(0, 210, 196, 0.2) !important;
        }

        .btn-filter-action {
            background: var(--brand-gradient);
            color: #050b14 !important;
            font-weight: 700;
            border: none;
            border-radius: 12px;
            padding: 0.6rem 1.4rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 18px rgba(0, 210, 196, 0.35);
            transition: all 0.25s ease;
        }

        .btn-filter-action:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 24px rgba(0, 210, 196, 0.55);
            color: #000 !important;
        }

        .btn-filter-reset {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #94a3b8;
            border-radius: 12px;
            padding: 0.6rem 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all 0.25s ease;
        }

        .btn-filter-reset:hover {
            background: rgba(255, 255, 255, 0.12);
            color: #fff;
        }

        /* Section Heading */
        .catalog-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 2.2rem 0 1.2rem;
        }

        .catalog-title {
            font-size: 1.45rem;
            font-weight: 800;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 0;
        }

        .catalog-title::before {
            content: '';
            display: inline-block;
            width: 4px;
            height: 24px;
            background: var(--brand-gradient);
            border-radius: 4px;
        }

        /* Movie Card */
        .single-card {
            background: #11141d;
            border: 1px solid var(--dark-border);
            border-radius: 16px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100%;
            transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            cursor: pointer;
        }

        .single-card:hover {
            transform: translateY(-7px);
            border-color: rgba(0, 210, 196, 0.4);
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6), 0 0 20px rgba(0, 210, 196, 0.2);
        }

        .single-poster-box {
            position: relative;
            width: 100%;
            aspect-ratio: 2/3;
            overflow: hidden;
            background: #090b10;
        }

        .single-poster-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.45s ease;
        }

        .single-card:hover .single-poster-img {
            transform: scale(1.08);
        }

        .single-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(10, 14, 23, 0.95) 0%, rgba(10, 14, 23, 0.2) 60%, rgba(0,0,0,0.4) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .single-card:hover .single-overlay {
            opacity: 1;
        }

        .play-circle-btn {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: var(--brand-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #050b14;
            box-shadow: 0 10px 25px rgba(0, 210, 196, 0.5);
            transform: translateY(12px) scale(0.9);
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .single-card:hover .play-circle-btn {
            transform: translateY(0) scale(1);
        }

        .play-circle-btn:hover {
            transform: scale(1.1);
            color: #000;
        }

        /* Top Badges */
        .badge-premium {
            background: linear-gradient(135deg, #ffd700, #ff8c00);
            color: #000;
            font-weight: 800;
            font-size: 0.72rem;
            padding: 4px 8px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            box-shadow: 0 2px 8px rgba(255, 165, 0, 0.4);
        }

        .badge-free {
            background: rgba(16, 185, 129, 0.85);
            color: #fff;
            font-weight: 700;
            font-size: 0.72rem;
            padding: 4px 8px;
            border-radius: 6px;
        }

        .badge-hd {
            background: rgba(0, 0, 0, 0.75);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #e2e8f0;
            font-size: 0.72rem;
            padding: 4px 8px;
            border-radius: 6px;
            backdrop-filter: blur(8px);
        }

        /* Card Content */
        .single-body {
            padding: 1rem;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            justify-content: space-between;
        }

        .single-title {
            color: #fff;
            font-weight: 700;
            font-size: 0.96rem;
            margin-bottom: 4px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            transition: color 0.2s ease;
        }

        .single-card:hover .single-title {
            color: var(--brand-primary);
        }

        .single-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.8rem;
            color: #94a3b8;
            margin-top: 6px;
            padding-top: 8px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .single-genres {
            font-size: 0.76rem;
            color: #00d2c4;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* Custom Pagination */
        .single-pagination .page-link {
            background-color: #11141d;
            border-color: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            padding: 0.55rem 1rem;
            border-radius: 10px;
            margin: 0 3px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .single-pagination .page-link:hover {
            background-color: rgba(0, 210, 196, 0.15);
            border-color: var(--brand-primary);
            color: #00e5d4;
        }

        .single-pagination .page-item.active .page-link {
            background: var(--brand-gradient);
            border-color: transparent;
            color: #050b14;
            box-shadow: 0 4px 16px rgba(0, 210, 196, 0.4);
        }

        .single-pagination .page-item.disabled .page-link {
            background-color: rgba(255, 255, 255, 0.02);
            border-color: rgba(255, 255, 255, 0.04);
            color: #475569;
        }
    </style>
}

<div class="container my-4">
    <!-- Hero Banner -->
    <div class="single-hero">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <span class="single-badge mb-3">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                        <line x1="7" y1="2" x2="7" y2="22"></line>
                        <line x1="17" y1="2" x2="17" y2="22"></line>
                        <line x1="2" y1="12" x2="22" y2="12"></line>
                        <line x1="2" y1="7" x2="7" y2="7"></line>
                        <line x1="2" y1="17" x2="7" y2="17"></line>
                        <line x1="17" y1="17" x2="22" y2="17"></line>
                        <line x1="17" y1="7" x2="22" y2="7"></line>
                    </svg>
                    Siêu Phẩm Điện Ảnh Chọn Lọc
                </span>
                <h1 class="display-6 fw-extrabold text-white mb-2">Thư Viện Phim Lẻ TFlix</h1>
                <p class="lead text-secondary mb-0" style="font-size: 1.05rem; max-width: 620px;">
                    Tuyển tập những siêu phẩm phim điện ảnh bom tấn, phim chiếu rạp hấp dẫn nhất thế giới với chất lượng hình ảnh 4K HDR và âm thanh sống động.
                </p>
            </div>
            <div class="col-lg-4 d-none d-lg-flex justify-content-end">
                <div class="d-flex gap-3 text-center">
                    <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.04); border: 1px solid var(--dark-border); min-width: 100px;">
                        <div class="h3 fw-bold text-white mb-0" style="color: #00d2c4 !important;">@Model.TotalCount+</div>
                        <div class="small text-secondary">Phim Lẻ</div>
                    </div>
                    <div class="p-3 rounded-4" style="background: rgba(255,255,255,0.04); border: 1px solid var(--dark-border); min-width: 100px;">
                        <div class="h3 fw-bold text-white mb-0" style="color: #0084ff !important;">Cinema</div>
                        <div class="small text-secondary">Chuẩn Rạp</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="single-filter-panel mb-4">
        <form method="get" asp-controller="Single" asp-action="Index" class="row g-3 align-items-center">
            <!-- Tìm kiếm -->
            <div class="col-12 col-md-4 col-lg-3">
                <div class="input-group">
                    <input type="text" name="q" value="@filter.Search" class="form-control filter-input" placeholder="Tìm tên phim lẻ..." />
                </div>
            </div>

            <!-- Thể loại -->
            <div class="col-6 col-md-3 col-lg-2">
                <select name="genreId" class="form-select filter-input shadow-none">
                    <option value="">-- Tất cả thể loại --</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g.GenreId" selected="@(filter.GenreId == g.GenreId ? "selected" : null)">@g.GenreName</option>
                    }
                </select>
            </div>

            <!-- Quốc gia -->
            <div class="col-6 col-md-3 col-lg-2">
                <select name="countryCode" class="form-select filter-input shadow-none">
                    <option value="">-- Tất cả quốc gia --</option>
                    <option value="VN" selected="@(filter.CountryCode == "VN" ? "selected" : null)">Việt Nam</option>
                    <option value="US" selected="@(filter.CountryCode == "US" ? "selected" : null)">Mỹ (Hollywood)</option>
                    <option value="KR" selected="@(filter.CountryCode == "KR" ? "selected" : null)">Hàn Quốc</option>
                    <option value="CN" selected="@(filter.CountryCode == "CN" ? "selected" : null)">Trung Quốc</option>
                    <option value="JP" selected="@(filter.CountryCode == "JP" ? "selected" : null)">Nhật Bản</option>
                    <option value="TH" selected="@(filter.CountryCode == "TH" ? "selected" : null)">Thái Lan</option>
                </select>
            </div>

            <!-- Năm -->
            <div class="col-6 col-md-3 col-lg-2">
                <select name="year" class="form-select filter-input shadow-none">
                    <option value="">-- Năm phát hành --</option>
                    @for (int y = DateTime.Now.Year; y >= 2010; y--)
                    {
                        <option value="@y" selected="@(filter.Year == y ? "selected" : null)">@y</option>
                    }
                </select>
            </div>

            <!-- Sắp xếp -->
            <div class="col-6 col-md-3 col-lg-2">
                <select name="sortBy" class="form-select filter-input shadow-none">
                    <option value="newest" selected="@(filter.SortBy == "newest" ? "selected" : null)">Mới nhất</option>
                    <option value="oldest" selected="@(filter.SortBy == "oldest" ? "selected" : null)">Cũ nhất</option>
                    <option value="title" selected="@(filter.SortBy == "title" ? "selected" : null)">Tên A-Z</option>
                </select>
            </div>

            <!-- Nút hành động -->
            <div class="col-12 col-lg-1 d-flex gap-2">
                <button type="submit" class="btn btn-filter-action w-100">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                    </svg>
                    Lọc
                </button>
                @if (!string.IsNullOrEmpty(filter.Search) || filter.GenreId.HasValue || !string.IsNullOrEmpty(filter.CountryCode) || filter.Year.HasValue || filter.SortBy != "newest")
                {
                    <a href="/Single" class="btn btn-filter-reset" title="Đặt lại bộ lọc">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Tiêu đề danh mục -->
    <div class="catalog-header">
        <h2 class="catalog-title">Danh Sách Phim Lẻ</h2>
        <span class="badge" style="background: rgba(255,255,255,0.06); border: 1px solid var(--dark-border); color: #94a3b8; padding: 7px 14px; border-radius: 30px; font-weight: 600;">
            @Model.TotalCount bộ phim
        </span>
    </div>

    <!-- Grid danh sách Phim lẻ -->
    @if (Model.Items != null && Model.Items.Count > 0)
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 g-md-4 mb-4">
            @foreach (var movie in Model.Items)
            {
                long mId = Convert.ToInt64(movie.MovieId);
                string posterSrc = string.IsNullOrWhiteSpace(movie.PosterUrl) ? fallbackPoster : movie.PosterUrl;
                string watchUrl = $"/Film/Watch?id={mId}&kind=movie";

                <div class="col">
                    <div class="single-card" data-id="@mId" data-url="@watchUrl">
                        <div class="single-poster-box">
                            <img class="single-poster-img"
                                 src="@posterSrc"
                                 alt="@movie.Title"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='@fallbackPoster';" />

                            <!-- Top Badges Overlay -->
                            <div class="position-absolute top-0 start-0 p-2 w-100 d-flex justify-content-between align-items-center" style="z-index: 2;">
                                @if (movie.IsPremium)
                                {
                                    <span class="badge-premium">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                                            <path d="M5 16L3 5L8.5 10L12 4L15.5 10L21 5L19 16H5M19 19C19 19.6 18.6 20 18 20H6C5.4 20 5 19.6 5 19V18H19V19Z"></path>
                                        </svg>
                                        VIP
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-free">Miễn phí</span>
                                }

                                <span class="badge-hd">HD</span>
                            </div>

                            <!-- Hover Overlay -->
                            <div class="single-overlay">
                                <a href="@watchUrl" class="play-circle-btn single-link-btn" data-url="@watchUrl" title="Xem phim ngay">
                                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                                        <polygon points="6 4 20 12 6 20 6 4"></polygon>
                                    </svg>
                                </a>
                            </div>
                        </div>

                        <div class="single-body">
                            <div>
                                <h3 class="single-title" title="@movie.Title">
                                    <a href="@watchUrl" class="text-white text-decoration-none single-link-btn" data-url="@watchUrl">
                                        @movie.Title
                                    </a>
                                </h3>
                                @if (!string.IsNullOrWhiteSpace(movie.OriginalTitle) && movie.OriginalTitle != movie.Title)
                                {
                                    <div class="text-secondary small text-truncate mb-1" title="@movie.OriginalTitle">@movie.OriginalTitle</div>
                                }
                                <div class="single-genres" title="@movie.Genres">
                                    @(string.IsNullOrWhiteSpace(movie.Genres) ? "Phim Lẻ" : movie.Genres)
                                </div>
                            </div>

                            <div class="single-meta">
                                <span class="d-flex align-items-center gap-1 text-warning fw-bold card-rating-tag" data-movie-id="@mId" onclick="event.preventDefault(); event.stopPropagation();" title="Nhấn để đánh giá sao">
                                    <i class="bi bi-star-fill text-warning"></i>
                                    <span class="rating-val">8.5</span>
                                </span>
                                <span>@(movie.DurationMin.HasValue ? $"{movie.DurationMin} phút" : (movie.ReleaseDate.HasValue ? movie.ReleaseDate.Value.Year.ToString() : "2024"))</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Page navigation" class="mt-4">
                <ul class="pagination justify-content-center single-pagination">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Single", new { q = filter.Search, genreId = filter.GenreId, countryCode = filter.CountryCode, year = filter.Year, sortBy = filter.SortBy, page = Model.Page - 1 })">
                            &laquo; Trước
                        </a>
                    </li>

                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == 1 || p == Model.TotalPages || (p >= Model.Page - 2 && p <= Model.Page + 2))
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", "Single", new { q = filter.Search, genreId = filter.GenreId, countryCode = filter.CountryCode, year = filter.Year, sortBy = filter.SortBy, page = p })">@p</a>
                            </li>
                        }
                        else if (p == Model.Page - 3 || p == Model.Page + 3)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }
                    }

                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Url.Action("Index", "Single", new { q = filter.Search, genreId = filter.GenreId, countryCode = filter.CountryCode, year = filter.Year, sortBy = filter.SortBy, page = Model.Page + 1 })">
                            Sau &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5 my-4 rounded-4" style="background: var(--dark-card); border: 1px solid var(--dark-border);">
            <div class="mb-3">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                    <line x1="7" y1="2" x2="7" y2="22"></line>
                    <line x1="17" y1="2" x2="17" y2="22"></line>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                </svg>
            </div>
            <h4 class="text-white fw-bold mb-2">Không tìm thấy bộ phim lẻ nào</h4>
            <p class="text-secondary max-w-500 mx-auto mb-4">Không tìm thấy kết quả phù hợp với tìm kiếm của bạn. Hãy thử thay đổi từ khóa hoặc bộ lọc.</p>
            <a href="/Single" class="btn btn-filter-action px-4 py-2 rounded-pill">
                Đặt lại bộ lọc
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script>
        const isLoggedIn = @isLoggedIn.ToString().ToLower();

        $(document).on('click', '.single-card, .single-link-btn', function (e) {
            // Không chuyển trang nếu bấm vào bất kỳ phần tử đánh giá sao hoặc nút hành động nào
            if ($(e.target).closest('.card-rating-tag, .card-quick-rating, .card-stars-widget, .tflix-rating-popover, .btn-card-star, .popover-star-btn, .btn-card-fav, .btn-quick-info').length) {
                return;
            }
            e.preventDefault();
            e.stopPropagation();

            const targetUrl = $(this).data('url') || $(this).attr('href') || $(this).closest('.single-card').data('url');
            if (!targetUrl) return;

            if (!isLoggedIn) {
                window.location.href = '/Auth?returnUrl=' + encodeURIComponent(targetUrl);
            } else {
                window.location.href = targetUrl;
            }
        });
    </script>
}
