@{
    Layout = "/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Quản lý Video Sources · Admin";

    // MVC endpoints (Areas/Admin)
    var urlGetAll = Url.Action("GetAll", "VideoSoure", new { area = "Admin" });
    var urlAdd = Url.Action("Add", "VideoSoure", new { area = "Admin" });
    var urlAddHls = Url.Action("AddHls", "VideoSoure", new { area = "Admin" });
    var urlUploadMp4Chunk = Url.Action("UploadMp4Chunk", "VideoSoure", new { area = "Admin" });
    var urlMp4UploadStatus = Url.Action("GetMp4UploadStatus", "VideoSoure", new { area = "Admin" });
    var urlCompleteMp4Upload = Url.Action("CompleteMp4Upload", "VideoSoure", new { area = "Admin" });
    var urlCancelMp4Upload = Url.Action("CancelMp4Upload", "VideoSoure", new { area = "Admin" });
    var urlUpdate = Url.Action("Update", "VideoSoure", new { area = "Admin" });
    var urlDelete = Url.Action("Delete", "VideoSoure", new { area = "Admin" });

    // Nguồn dữ liệu tham chiếu
    var urlGetAllMovies = Url.Action("GetAll", "Movie", new { area = "Admin" });
    var urlGetAllEpisodes = Url.Action("GetAll", "Esopide", new { area = "Admin" });
}

<style>
    /* Loading + Toast */
    .loading-overlay {
        position: fixed;
        inset: 0;
        display: none;
        z-index: 1100;
      background: rgba(0,0,0,.48);
      backdrop-filter: blur(2px)
    }

        .loading-overlay .spinner-wrap {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%,-50%);
            background: rgba(0,0,0,.35);
            padding: 16px 18px;
            border-radius: 10px
        }

    .spinner {
        width: 52px;
        height: 52px;
        border: 5px solid #eee;
        border-top: 5px solid #27d3c3;
        border-radius: 50%;
        animation: spin 1s linear infinite
    }

      .upload-progress {
        position: absolute;
        top: 50%;
        left: 50%;
        width: min(520px, calc(100vw - 32px));
        padding: 24px;
        transform: translate(-50%, -50%);
        color: var(--bs-body-color);
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 8px;
        box-shadow: 0 16px 48px rgba(0, 0, 0, .24);
      }

      .upload-progress-percent {
        min-width: 76px;
        color: var(--bs-primary);
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      .upload-progress-track {
        height: 10px;
        overflow: hidden;
        background: var(--bs-secondary-bg);
        border-radius: 5px;
      }

      .upload-progress-bar {
        height: 100%;
        width: 0;
        background: var(--bs-primary);
        transition: width .18s ease-out;
      }

      .upload-progress.is-processing .upload-progress-bar {
        width: 100%;
        background: repeating-linear-gradient(45deg, var(--bs-primary), var(--bs-primary) 10px, var(--bs-info) 10px, var(--bs-info) 20px);
        background-size: 28px 28px;
        animation: progress-stripes .8s linear infinite;
      }

      .inline-upload-status {
        margin-top: .75rem;
        padding: .875rem;
        background: rgba(255, 255, 255, .035);
        border: 1px solid rgba(255, 255, 255, .12);
        border-radius: .5rem;
      }

      .inline-upload-status .progress {
        height: 9px;
        background: rgba(255, 255, 255, .1);
      }

      .inline-upload-status .progress-bar {
        min-width: 0;
        transition: width .18s ease-out;
      }

      @@keyframes progress-stripes {
        to { background-position: 28px 0; }
      }

      @@media (prefers-reduced-motion: reduce) {
        .upload-progress-bar { transition: none; }
        .upload-progress.is-processing .upload-progress-bar { animation: none; }
      }

    @@keyframes spin {
        from

    {
        transform: rotate(0)
    }

    to {
        transform: rotate(360deg)
    }

    }

    .toastx {
        position: fixed;
        top: 18px;
        right: 18px;
        min-width: 280px;
        z-index: 1200;
        background: #333;
        color: #fff;
        border-radius: 10px;
        padding: 12px 16px;
        display: none;
        box-shadow: 0 8px 24px rgba(0,0,0,.25)
    }

        .toastx.success {
            background: #28a745
        }

        .toastx.error {
            background: #dc3545
        }

    .video-cell {
        max-width: 260px;
        width: 260px;
    }

        .video-cell video {
            width: 100%;
            max-height: 140px;
            border-radius: .5rem;
            outline: none;
        }

    .text-clip {
        max-width: 360px;
        display: inline-block;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
    }

    /* Select2 & Dropdowns Dark Theme - Không còn nền trắng */
    #MovieId, #EpisodeId,
    #sourceModal .form-select,
    #slType, #pageSize,
    .select2-container--default .select2-selection--single {
        background-color: #171920 !important;
        color: #f1f5f9 !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        border-radius: 8px !important;
    }

    #MovieId option, #EpisodeId option,
    #sourceModal .form-select option,
    #slType option, #pageSize option {
        background-color: #171920 !important;
        color: #f1f5f9 !important;
    }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 40px !important;
        padding: 4px 10px !important;
        display: flex !important;
        align-items: center !important;
    }

    .select2-container--default .select2-selection--single:focus,
    .select2-container--default.select2-container--open .select2-selection--single {
        border-color: #19d3c5 !important;
        box-shadow: 0 0 0 3px rgba(25, 211, 197, 0.25) !important;
        outline: none !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__rendered {
        color: #f1f5f9 !important;
        line-height: 32px !important;
        padding-left: 2px !important;
        padding-right: 20px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__placeholder {
        color: #9aa0aa !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow {
        height: 38px !important;
        right: 8px !important;
    }

    .select2-container--default .select2-selection--single .select2-selection__arrow b {
        border-color: #9aa0aa transparent transparent transparent !important;
    }

    .select2-container--default.select2-container--open .select2-selection--single .select2-selection__arrow b {
        border-color: transparent transparent #19d3c5 transparent !important;
    }

    .select2-dropdown {
        background-color: #171920 !important;
        color: #f1f5f9 !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        border-radius: 8px !important;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6) !important;
        z-index: 1065 !important;
    }

    .select2-container--default .select2-search--dropdown {
        padding: 8px !important;
        background-color: #171920 !important;
    }

    .select2-container--default .select2-search--dropdown .select2-search__field {
        background-color: #111318 !important;
        color: #f1f5f9 !important;
        border: 1px solid rgba(255, 255, 255, 0.15) !important;
        border-radius: 6px !important;
        padding: 6px 10px !important;
    }

    .select2-container--default .select2-search--dropdown .select2-search__field:focus {
        border-color: #19d3c5 !important;
        outline: none !important;
    }

    .select2-container--default .select2-results__option {
        background-color: #171920 !important;
        color: #cbd5e1 !important;
        padding: 8px 12px !important;
        font-size: 0.9rem !important;
    }

    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background: linear-gradient(135deg, rgba(22, 131, 255, 0.35) 0%, rgba(25, 211, 197, 0.35) 100%) !important;
        color: #ffffff !important;
    }

    .select2-container--default .select2-results__option[aria-selected="true"] {
        background-color: rgba(25, 211, 197, 0.18) !important;
        color: #19d3c5 !important;
        font-weight: 600;
    }
</style>

<div class="loading-overlay" id="__loadingOverlay">
    <div class="spinner-wrap"><div class="spinner"></div></div>
  <section class="upload-progress d-none" id="uploadProgressPanel" role="status" aria-live="polite" aria-atomic="true">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
      <div class="min-w-0">
        <div class="fw-semibold" id="uploadProgressTitle">Đang tải MP4</div>
        <div class="small text-secondary mt-1" id="uploadProgressDetail">Chuẩn bị tải lên...</div>
      </div>
      <div class="upload-progress-percent" id="uploadProgressPercent">0%</div>
    </div>
    <div class="upload-progress-track" role="progressbar" aria-label="Tiến độ upload MP4" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="upload-progress-bar" id="uploadProgressBar"></div>
    </div>
    <div class="d-none align-items-center gap-2 small text-secondary mt-3" id="uploadProcessingStatus">
      <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
      <span>Đang xử lý video trên máy chủ...</span>
    </div>
  </section>
</div>
<div class="toastx" id="__toastMessage"></div>

<div class="modal fade" id="uploadResultModal" tabindex="-1" aria-labelledby="uploadResultModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="uploadResultModalTitle">
                    <i class="bi" id="uploadResultModalIcon" aria-hidden="true"></i>
                    <span id="uploadResultModalHeading">Kết quả upload</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="uploadResultModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h4 class="m-0"><i class="bi bi-hdd-network me-2"></i>Quản lý Video Sources</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" id="btnRefresh">
            <i class="bi bi-arrow-clockwise me-1"></i>Nạp lại
        </button>
        <button class="btn btn-primary" id="btnAdd">
            <i class="bi bi-plus-circle me-1"></i>Thêm nguồn
        </button>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-12 col-md-3">
                <input id="txtSearch" class="form-control" placeholder="Tìm Provider/Server/URL/Tên Movie/Tên Episode..." />
            </div>
            <div class="col-6 col-md-2">
                <select id="slType" class="form-select">
                    <option value="">Loại: Tất cả</option>
                    <option value="movie">Movie</option>
                    <option value="episode">Episode</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <input id="txtMovieId" class="form-control" placeholder="Lọc MovieId..." />
            </div>
            <div class="col-6 col-md-2">
                <input id="txtEpisodeId" class="form-control" placeholder="Lọc EpisodeId..." />
            </div>
            <div class="col-6 col-md-3 d-flex gap-2">
                <input id="txtQuality" class="form-control" placeholder="Lọc Quality (720p/1080p...)" />
                <select id="pageSize" class="form-select" style="max-width:140px">
                    <option value="10">10/trang</option>
                    <option value="20" selected>20/trang</option>
                    <option value="50">50/trang</option>
                    <option value="100">100/trang</option>
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="tblSources">
                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th style="width:90px;">MovieId</th>
                        <th style="width:170px;">Movie Title</th>
                        <th style="width:90px;">EpisodeId</th>
                        <th style="width:190px;">Episode Title</th>
                        <th>Provider / Server</th>
                        <th class="video-cell">Video</th>
                        <th>Quality</th>
                        <th>Format</th>
                        <th class="text-nowrap">DRM</th>
                        <th class="text-nowrap">Primary</th>
                        <th class="text-nowrap">Status</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody><!-- render by JS --></tbody>
            </table>
        </div>

        <div id="pagerWrap" class="mt-2"></div>
    </div>
</div>

<!-- Modal Confirm Resume / Delete Incomplete Upload -->
<div class="modal fade" id="resumeConfirmModal" tabindex="-1" aria-labelledby="resumeConfirmModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #171920; border: 1px solid rgba(255,255,255,0.15); border-radius: 14px; box-shadow: 0 16px 48px rgba(0,0,0,0.7);">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <h5 class="modal-title d-flex align-items-center gap-2 text-warning" id="resumeConfirmModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Chưa hoàn tất tải lên file</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng" id="btnResumeDismiss"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-light mb-3" id="resumeModalMessage">
                    File video chưa được gửi hết lên server. Hệ thống phát hiện các phần đã lưu trước đó.
                </p>
                <div class="p-3 rounded-3 mb-3" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>Tiến độ đã nhận trên server:</span>
                        <span class="text-info fw-bold" id="resumeModalProgressText">0 / 0 phần</span>
                    </div>
                    <div class="progress" style="height: 8px; background: rgba(255,255,255,0.1);">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" id="resumeModalProgressBar" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>
                <div class="text-secondary small">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Bạn có muốn tiếp tục tải lên (Resume) không?</strong><br />
                    Nếu <strong>Không</strong>, toàn bộ các file tạm đã lưu trên server sẽ bị xóa bỏ hoàn toàn.
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 pt-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger d-flex align-items-center gap-2" id="btnResumeReject">
                    <i class="bi bi-trash3"></i>
                    <span>Không, xóa hết file cũ ở server</span>
                </button>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2" id="btnResumeAccept" style="background: linear-gradient(135deg, #1683ff 0%, #19d3c5 100%); border: none; color: #0b141e; font-weight: 600;">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Có, tiếp tục Resume</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add/Edit -->
<div class="modal fade" id="sourceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="modalTitle">Thêm nguồn</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <label class="form-label">Kiểu nguồn video *</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="InputMode" id="modeFile" value="file" checked>
                        <label class="form-check-label" for="modeFile">Upload MP4 (tự chuyển HLS)</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="InputMode" id="modeUrl" value="url">
                        <label class="form-check-label" for="modeUrl">Chỉ dùng Stream URL</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="InputMode" id="modeHls" value="hls">
                        <label class="form-check-label" for="modeHls">Upload HLS (m3u8 + segments)</label>
                    </div>
                </div>

                <form id="frmSource" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="SourceId" />
                    <input type="hidden" id="OldStreamUrl" />

                    <div class="col-md-4">
                        <label class="form-label">Loại nguồn *</label>
                        <select id="SourceType" class="form-select" required>
                            <option value="movie">Movie</option>
                            <option value="episode">Episode</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Movie</label>
                        <select id="MovieId" class="form-select">
                            <option value="">-- Chọn Movie --</option>
                        </select>
                        <div class="form-text">Chỉ dùng khi Loại = Movie.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Episode</label>
                        <select id="EpisodeId" class="form-select">
                            <option value="">-- Chọn Episode --</option>
                        </select>
                        <div class="form-text">Chỉ dùng khi Loại = Episode.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Provider *</label>
                        <input id="Provider" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Server Name</label>
                        <input id="ServerName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stream URL</label>
                        <input id="StreamUrl" class="form-control" placeholder="https://... (nếu KHÔNG upload file)" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Quality</label>
                        <input id="Quality" class="form-control" placeholder="720p/1080p/4K..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Format</label>
                        <input id="Format" class="form-control" placeholder="HLS/DASH/MP4..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">DRM Type</label>
                        <input id="DrmType" class="form-control" placeholder="Widevine/FairPlay/..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">DRM License URL</label>
                        <input id="DrmLicenseUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Is Primary</label>
                        <select id="IsPrimary" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select id="Status" class="form-select">
                            <option value="ACTIVE">ACTIVE</option>
                            <option value="DISABLED">DISABLED</option>
                        </select>
                    </div>

                    <!-- block upload 1 file cũ -->
                    <div class="col-12" id="blockFile">
                        <label class="form-label">Upload file video (1 file)</label>
                        <input id="File" type="file" class="form-control" accept=".mp4,video/mp4" />
                        <div class="inline-upload-status" id="resumeUploadPanel" role="status" aria-live="polite">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <div class="min-w-0">
                                    <div class="fw-semibold" id="inlineUploadTitle">
                                        <i class="bi bi-cloud-arrow-up me-1"></i>Tiến trình upload
                                    </div>
                                    <div class="small text-secondary" id="resumeUploadDetail">Chọn file MP4 để bắt đầu hoặc kiểm tra phiên upload trước.</div>
                                </div>
                                <button type="button" class="btn btn-warning" id="btnResumeUpload" disabled>
                                    <i class="bi bi-play-fill me-1"></i>Resume
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" role="progressbar" aria-label="Tiến trình upload video" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                                    <div class="progress-bar progress-bar-striped" id="inlineUploadProgressBar" style="width: 0%"></div>
                                </div>
                                <span class="small fw-semibold text-nowrap" id="inlineUploadProgressText">0%</span>
                            </div>
                        </div>
                    </div>

                    <!-- block upload HLS -->
                    <div class="col-12 d-none" id="blockHls">
                        <label class="form-label">Upload HLS</label>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Playlist (.m3u8) *</label>
                                <input id="HlsPlaylist" type="file" class="form-control" accept=".m3u8" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Segments (.ts/.m4s) *</label>
                                <input id="HlsSegments" type="file" class="form-control" multiple accept=".ts,.m4s,video/*" />
                                <div class="form-text">Chọn nhiều file segments cùng lúc.</div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger d-none" id="btnDeleteCurrentSource">
                    <i class="bi bi-trash me-1"></i>Xóa nguồn này
                </button>
                <div class="d-flex gap-2 ms-auto">
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button class="btn btn-primary" id="btnSave"><i class="bi bi-save me-1"></i>Lưu</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xem lớn video -->
<div class="modal fade" id="videoPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-0">
                <video id="previewPlayer" controls playsinline style="width:100%;max-height:80vh;"></video>
            </div>
            <div class="modal-footer">
                <span id="previewMeta" class="me-auto text-muted small"></span>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>

    <!-- Select2 cho dropdown có tìm kiếm -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        (function(){
          // ===== URLs =====
          const urls = {
            getAll:  '@urlGetAll',
            add:     '@urlAdd',
            addHls:  '@urlAddHls',
            uploadMp4Chunk: '@urlUploadMp4Chunk',
            mp4UploadStatus: '@urlMp4UploadStatus',
            completeMp4Upload: '@urlCompleteMp4Upload',
            cancelMp4Upload: '@urlCancelMp4Upload',
            update:  '@urlUpdate',
            deleteSource: '@urlDelete',
            movies:  '@urlGetAllMovies',
            eps:     '@urlGetAllEpisodes'
          };

          // ===== Elements & State =====
          const $overlay = $("#__loadingOverlay");
          const $loadingSpinner = $overlay.find('.spinner-wrap');
          const $uploadProgress = $('#uploadProgressPanel');
          const $toast   = $("#__toastMessage");
          const $tbody   = $('#tblSources tbody');
          const $pager   = $("#pagerWrap");

          const sourceModalEl  = document.getElementById('sourceModal');
          const sourceModal    = bootstrap.Modal.getOrCreateInstance(sourceModalEl);
          const previewModalEl = document.getElementById('videoPreviewModal');
          const previewModal   = bootstrap.Modal.getOrCreateInstance(previewModalEl);
          const uploadResultModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('uploadResultModal'));

          let cache = [];     // full list
          let filtered = [];  // after filter
          let page = 1;
          let resumeFileState = null;

          // ===== Helpers =====
          function updateInlineUploadProgress(title, detail, percent, processing=false){
            const value = Math.max(0, Math.min(100, Math.round(percent || 0)));
            $('#inlineUploadTitle').html(`<i class="bi ${processing ? 'bi-hourglass-split' : 'bi-cloud-arrow-up'} me-1"></i>${title}`);
            $('#resumeUploadDetail').text(detail);
            $('#inlineUploadProgressText').text(`${value}%`);
            $('#inlineUploadProgressBar')
              .css('width', `${value}%`)
              .toggleClass('progress-bar-animated', processing || (value > 0 && value < 100))
              .parent().attr('aria-valuenow', value);
          }

          function resetInlineUploadProgress(){
            updateInlineUploadProgress('Tiến trình upload', 'Chọn file MP4 để bắt đầu hoặc kiểm tra phiên upload trước.', 0);
            $('#btnResumeUpload').prop('disabled', true);
          }

          function showLoading(){
            $uploadProgress.addClass('d-none').removeClass('is-processing');
            $loadingSpinner.removeClass('d-none');
            $overlay.fadeIn(80);
          }
          function showUploadProgress(title, detail, percent, processing=false){
            const value = Math.max(0, Math.min(100, Math.round(percent)));
            updateInlineUploadProgress(title, detail, value, processing);
            $overlay.stop(true, true).hide();
          }
          function hideLoading(){
            $overlay.fadeOut(120, ()=>{
              $uploadProgress.addClass('d-none').removeClass('is-processing');
              $loadingSpinner.removeClass('d-none');
              $('#uploadProcessingStatus').removeClass('d-flex').addClass('d-none');
            });
          }
          function showToast(msg, ok=true, ms=2600){
            $toast.text(msg||"").removeClass("success error").addClass(ok?"success":"error").fadeIn(120);
            setTimeout(()=> $toast.fadeOut(150), ms);
          }
          function showUploadResultPopup(ok, heading, message){
            $('#uploadResultModalHeading').text(heading || (ok ? 'Upload thành công' : 'Upload thất bại'));
            $('#uploadResultModalMessage').text(message || '');
            $('#uploadResultModalTitle').toggleClass('text-success', ok).toggleClass('text-danger', !ok);
            $('#uploadResultModalIcon')
              .toggleClass('bi-check-circle-fill', ok)
              .toggleClass('bi-exclamation-triangle-fill', !ok);
            uploadResultModal.show();
          }
          function closeSourceAndShowUploadResult(ok, heading, message){
            sourceModalEl.addEventListener('hidden.bs.modal', () => {
              showUploadResultPopup(ok, heading, message);
            }, { once: true });
            sourceModal.hide();
          }
          function pickList(res){
            const d = res?.data ?? res?.Data ?? null;
            if (!d) return [];
            if (Array.isArray(d)) return d;
            if (Array.isArray(d.table)) return d.table;
            if (Array.isArray(d.Table)) return d.Table;
            return [];
          }
          function gv(o, ...keys){
            for (const k of keys){
              if (o?.[k] !== undefined && o?.[k] !== null) return o[k];
            }
            return undefined;
          }

          // Pagination helpers
          function paginate(list, page, size){
            const total = list.length;
            const last = Math.max(1, Math.ceil(total/size));
            const p = Math.min(Math.max(1,page), last);
            const start = (p-1)*size, end = start + size;
            return { page:p, size, total, last, items:list.slice(start,end) };
          }
          function renderPager($wrap, state){
            const { page, last, total } = state;
            const dis = c => c ? "disabled" : "";
            const btn = (label,target,disabled)=>
              `<li class="page-item ${dis(disabled)}"><a class="page-link" href="#" data-page="${target}">${label}</a></li>`;
            const html = `
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small text-secondary">Tổng: <b>${total}</b> bản ghi • Trang <b>${page}</b>/<b>${last}</b></div>
                <nav aria-label="pagination">
                  <ul class="pagination m-0">
                    ${btn("«",1, page<=1)}
                    ${btn("‹",page-1, page<=1)}
                    ${btn(page,page,true)}
                    ${btn("›",page+1, page>=last)}
                    ${btn("»",last, page>=last)}
                  </ul>
                </nav>
              </div>`;
            $wrap.html(html);
            $wrap.find("a.page-link").on("click", function(e){
              e.preventDefault();
              const p = Number($(this).data("page"));
              if(Number.isFinite(p)){ page = p; renderTablePage(); }
            });
          }

          // ---- Select2 init (gắn dropdownParent để không lỗi z-index trong modal)
          function initSelect2(){
            const parent = $('#sourceModal');
            $('#MovieId').select2({
              placeholder: '-- Chọn Movie --', allowClear: true, width: '100%', dropdownParent: parent
            });
            $('#EpisodeId').select2({
              placeholder: '-- Chọn Episode --', allowClear: true, width: '100%', dropdownParent: parent
            });
          }
          initSelect2();

          // ===== Filter + Render =====
          function applyFilter(){
            const q  = ($('#txtSearch').val()||'').trim().toLowerCase();
            const t  = ($('#slType').val()||'').trim();
            const m  = ($('#txtMovieId').val()||'').trim();
            const e  = ($('#txtEpisodeId').val()||'').trim();
            const ql = ($('#txtQuality').val()||'').trim().toLowerCase();

            filtered = cache.filter(x=>{
              const movieId     = gv(x,'movieId','MovieId','moviE_ID');
              const episodeId   = gv(x,'episodeId','EpisodeId','episodE_ID');
              const provider    = (gv(x,'provider','Provider')||'').toString().toLowerCase();
              const server      = (gv(x,'serverName','ServerName','serveR_NAME')||'').toString().toLowerCase();
              const url         = (gv(x,'streamUrl','StreamUrl','streaM_URL')||'').toString().toLowerCase();
              const quality     = (gv(x,'quality','Quality')||'').toString().toLowerCase();
              const movieTitle  = (gv(x,'movieTitle','MovieTitle','moviE_TITLE')||'').toString().toLowerCase();
              const episodeTitle= (gv(x,'episodeTitle','EpisodeTitle','episodE_TITLE')||'').toString().toLowerCase();

              let ok = true;
              if (q)  ok = ok && (provider.includes(q) || server.includes(q) || url.includes(q) || movieTitle.includes(q) || episodeTitle.includes(q));
              if (t === 'movie')   ok = ok && !!movieId && !episodeId;
              if (t === 'episode') ok = ok && !!episodeId && !movieId;
              if (m) ok = ok && String(movieId||'').includes(m);
              if (e) ok = ok && String(episodeId||'').includes(e);
              if (ql) ok = ok && quality.includes(ql);
              return ok;
            });
          }

          function renderTablePage(){
            const size = Number($('#pageSize').val()||20);
            const state = paginate(filtered, page, size);

            const rows = state.items.map(x=>{
              const id          = gv(x,'sourceId','SourceId','sourcE_ID');
              const movieId     = gv(x,'movieId','MovieId','moviE_ID') ?? '';
              const episodeId   = gv(x,'episodeId','EpisodeId','episodE_ID') ?? '';
              const movieTitle  = gv(x,'movieTitle','MovieTitle','moviE_TITLE') ?? '';
              const episodeTitle= gv(x,'episodeTitle','EpisodeTitle','episodE_TITLE') ?? '';
              const provider    = gv(x,'provider','Provider') ?? '';
              const server      = gv(x,'serverName','ServerName','serveR_NAME') ?? '';
              const url         = gv(x,'streamUrl','StreamUrl','streaM_URL') ?? '';
              const quality     = gv(x,'quality','Quality') ?? '';
              const format      = gv(x,'format','Format') ?? '';
              const drmType     = gv(x,'drmType','DrmType','drM_TYPE') ?? '';
              const drmLic      = gv(x,'drmLicenseUrl','DrmLicenseUrl','drM_LICENSE_URL') ?? '';
              const isPrimary   = gv(x,'isPrimary','IsPrimary','iS_PRIMARY');
              const status      = gv(x,'status','Status') ?? '';

              const videoCell = url ? `
                <div class="video-cell">
                  <video src="${url}" controls playsinline preload="metadata"
                         onerror="console.warn('Video load error:', '${url}')"></video>
                  <div class="small mt-1">
                    <a href="${url}" target="_blank" class="text-clip" title="${url}">${url}</a>
                    <button class="btn btn-sm btn-outline-secondary ms-2 btn-preview"
                            data-url="${url}" data-id="${id}" title="Xem lớn">
                      <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                  </div>
                </div>` : `<span class="text-muted">N/A</span>`;

              return `<tr>
                <td class="text-muted">${id??''}</td>
                <td>${movieId || ''}</td>
                <td>${movieTitle ? `<span class="text-clip" title="${movieTitle}">${movieTitle}</span>` : ''}</td>
                <td>${episodeId || ''}</td>
                <td>${episodeTitle ? `<span class="text-clip" title="${episodeTitle}">${episodeTitle}</span>` : ''}</td>
                <td><div class="small">${provider}</div><div class="text-muted small">${server}</div></td>
                <td>${videoCell}</td>
                <td>${quality||''}</td>
                <td>${format||''}</td>
                <td>
                  <div class="small">${drmType||''}</div>
                  ${drmLic ? `<div class="text-muted small text-clip" title="${drmLic}">${drmLic}</div>` : ''}
                </td>
                <td>${(String(isPrimary)==='Y'||String(isPrimary)==='true'||isPrimary===true)?'Yes':'No'}</td>
                <td>${status}</td>
                <td class="text-end">
                  <div class="btn-group">
                    <button class="btn btn-sm btn-outline-secondary btn-edit" data-id="${id}" title="Sửa nguồn">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger btn-delete" data-id="${id}" data-url="${url}" title="Xóa nguồn">
                      <i class="bi bi-trash"></i>
                    </button>
                  </div>
                </td>
              </tr>`;
            }).join('');

            $tbody.html(rows || `<tr><td colspan="13" class="text-center text-secondary">Không có dữ liệu</td></tr>`);
            renderPager($pager, state);
          }

          function render(){ applyFilter(); page = 1; renderTablePage(); }

          // ===== Data =====
          function loadAll(){
            showLoading();
            $.get(urls.getAll, function(res){
              cache = pickList(res);
              render();
              showToast("Đã tải danh sách nguồn", true);
            }).fail(xhr=>{
              const text = xhr?.responseJSON?.message || xhr?.responseText || "Lỗi tải danh sách.";
              showToast(text, false);
            }).always(hideLoading);
          }

          // ===== Dropdown Movies / Episodes (Select2, có selectedId) =====
          function fillMovies(selectedId){
            const $ddl = $('#MovieId');
            $ddl.empty().append(new Option('-- Chọn Movie --', '', false, false)).trigger('change');
            if (!urls.movies) return;

            $.get(urls.movies, res=>{
              pickList(res).forEach(m=>{
                const id = gv(m,'movieId','MovieId','moviE_ID');
                const title = gv(m,'title','Title') || `Movie #${id}`;
                if (id!=null) $ddl.append(new Option(title, id, false, false));
              });
              if (selectedId){ $ddl.val(String(selectedId)).trigger('change'); }
            });
          }
          function fillEpisodes(selectedId){
            const $ddl = $('#EpisodeId');
            $ddl.empty().append(new Option('-- Chọn Episode --', '', false, false)).trigger('change');
            if (!urls.eps) return;

            $.get(urls.eps, res=>{
              pickList(res).forEach(ep=>{
                const id   = gv(ep,'episodeId','EpisodeId','episodE_ID');
                const epNo = gv(ep,'episodeNo','EpisodeNo','episodE_NO');
                const title= gv(ep,'episodeTitle','EpisodeTitle','title','Title') || `Episode #${id}`;
                if (id!=null) $ddl.append(new Option(`E${epNo ?? ''} - ${title}`, id, false, false));
              });
              if (selectedId){ $ddl.val(String(selectedId)).trigger('change'); }
            });
          }

          function toggleTypeUI(){
            const type = $('#SourceType').val();
            if (type === 'movie'){
              $('#MovieId').prop('disabled', false);
              $('#EpisodeId').prop('disabled', true).val('').trigger('change');
            } else {
              $('#MovieId').prop('disabled', true).val('').trigger('change');
              $('#EpisodeId').prop('disabled', false);
            }
          }

          // ===== Modal: Add/Edit =====
          function openAdd(){
            $('#modalTitle').text('Thêm nguồn');
            $('#frmSource')[0].reset();
            $('#SourceId').val('');
            $('#OldStreamUrl').val('');
            $('#File').prop('disabled', false);
            resumeFileState = null;
            resetInlineUploadProgress();
            $('#modeFile').prop('checked', true);
            toggleInputMode();

            $('#btnDeleteCurrentSource').addClass('d-none').data('id', '').data('url', '');

            $('#SourceType').val('movie');
            toggleTypeUI();

            fillMovies();
            fillEpisodes();

            sourceModal.show();
          }

          function openEdit(id){
            const it = cache.find(x=> String(gv(x,'sourceId','SourceId','sourcE_ID')) === String(id));
            if (!it){ showToast("Không tìm thấy nguồn.", false); return; }

            $('#modalTitle').text('Sửa nguồn');
            $('#frmSource')[0].reset();
            $('#SourceId').val(gv(it,'sourceId','SourceId','sourcE_ID')||'');

            const movieId     = gv(it,'movieId','MovieId','moviE_ID');
            const episodeId   = gv(it,'episodeId','EpisodeId','episodE_ID');
            const isMovie     = !!movieId && !episodeId;

            $('#SourceType').val(isMovie?'movie':'episode');
            toggleTypeUI();

            // nạp list + chọn đúng item
            fillMovies(isMovie ? movieId : null);
            fillEpisodes(!isMovie ? episodeId : null);

            $('#Provider').val(gv(it,'provider','Provider')||'');
            $('#ServerName').val(gv(it,'serverName','ServerName','serveR_NAME')||'');
            const streamUrl = gv(it,'streamUrl','StreamUrl','streaM_URL')||'';
            $('#StreamUrl').val(streamUrl);
            $('#OldStreamUrl').val(streamUrl);
            $('#Quality').val(gv(it,'quality','Quality')||'');
            $('#Format').val(gv(it,'format','Format')||'');
            $('#DrmType').val(gv(it,'drmType','DrmType','drM_TYPE')||'');
            $('#DrmLicenseUrl').val(gv(it,'drmLicenseUrl','DrmLicenseUrl','drM_LICENSE_URL')||'');
            $('#IsPrimary').val( (String(gv(it,'isPrimary','IsPrimary','iS_PRIMARY'))==='Y'||String(gv(it,'isPrimary','IsPrimary','iS_PRIMARY'))==='true'||gv(it,'isPrimary')===true) ? 'true':'false' );
            $('#Status').val(gv(it,'status','Status')||'ACTIVE');

            $('#btnDeleteCurrentSource').removeClass('d-none').data('id', id).data('url', streamUrl);

            $('#File').val('').prop('disabled', false);
            resumeFileState = null;
            resetInlineUploadProgress();
            $('#modeFile').prop('checked', true);
            toggleInputMode();
            $('#fileNote').removeClass('text-muted').addClass('text-warning')
              .text('Chọn MP4 để tự chuyển HLS hoặc chọn bộ playlist và segments HLS mới.');

            sourceModal.show();
          }

          async function createMp4Fingerprint(file){
            const sampleSize = 1024 * 1024;
            const headEnd = Math.min(sampleSize, file.size);
            const tailStart = Math.max(headEnd, file.size - sampleSize);
            const [head, tail] = await Promise.all([
              file.slice(0, headEnd).arrayBuffer(),
              file.slice(tailStart).arrayBuffer()
            ]);
            const metadata = new TextEncoder().encode(`${file.name}\n${file.size}\n${file.lastModified}\n`);
            const combined = new Uint8Array(metadata.length + head.byteLength + tail.byteLength);
            combined.set(metadata, 0);
            combined.set(new Uint8Array(head), metadata.length);
            combined.set(new Uint8Array(tail), metadata.length + head.byteLength);
            const digest = await crypto.subtle.digest('SHA-256', combined);
            return Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('');
          }

          async function detectResumeUpload(file){
            resumeFileState = null;
            resetInlineUploadProgress();
            if (!file) return;

            updateInlineUploadProgress('Đang kiểm tra phiên upload', `Đang kiểm tra ${file.name}...`, 0, true);

            try {
              const fingerprint = await createMp4Fingerprint(file);
              const sessionKey = `tflix:mp4-upload:${fingerprint}`;
              const uploadId = localStorage.getItem(sessionKey);
              if (!uploadId){
                updateInlineUploadProgress('Sẵn sàng upload', `${file.name} · ${(file.size / (1024 * 1024)).toFixed(1)} MiB`, 0);
                return;
              }

              const status = await $.ajax({
                url: `${urls.mp4UploadStatus}?uploadId=${encodeURIComponent(uploadId)}&fileFingerprint=${encodeURIComponent(fingerprint)}`,
                type: 'GET'
              });
              const resumeAvailable = status.resumeAvailable ?? status.ResumeAvailable ?? false;
              const uploadedChunks = status.uploadedChunks ?? status.UploadedChunks ?? [];
              const totalChunks = status.totalChunks ?? status.TotalChunks ?? 0;
              if (!resumeAvailable || uploadedChunks.length === 0 || totalChunks <= 0){
                updateInlineUploadProgress('Sẵn sàng upload', 'Không có phiên upload dang dở cho file này.', 0);
                return;
              }

              const percent = Math.floor(uploadedChunks.length * 100 / totalChunks);
              resumeFileState = { uploadId, fingerprint, sessionKey, uploadedChunks, totalChunks };
              updateInlineUploadProgress('Có phiên upload chưa hoàn tất', `Server đã nhận ${uploadedChunks.length}/${totalChunks} phần. Còn lại ${100 - percent}%.`, percent);
              $('#btnResumeUpload').prop('disabled', false);
            } catch {
              resumeFileState = null;
              updateInlineUploadProgress('Không kiểm tra được phiên upload', 'Bạn vẫn có thể bấm Lưu để bắt đầu upload mới.', 0);
            }
          }

          async function cancelAndCleanupServerUpload(currentUploadId, token, storageKey){
            if (!currentUploadId) return;
            try {
              await $.ajax({
                url: `${urls.cancelMp4Upload}?uploadId=${encodeURIComponent(currentUploadId)}`,
                type: 'POST',
                data: { uploadId: currentUploadId },
                headers: token ? { 'RequestVerificationToken': token } : {}
              });
            } catch (err){
              console.warn('Lỗi khi xóa file tạm trên server:', err);
            }
            if (storageKey){
              localStorage.removeItem(storageKey);
            }
          }

          function promptResumeDecision(uploadedCount, totalChunks, sentBytes, totalBytes, customMessage){
            return new Promise((resolve) => {
              const $modalEl = $('#resumeConfirmModal');
              const modal = new bootstrap.Modal($modalEl[0], { backdrop: 'static', keyboard: false });

              const percent = totalChunks > 0 ? Math.round(uploadedCount * 100 / totalChunks) : 0;
              const sentMb = (sentBytes / (1024 * 1024)).toFixed(1);
              const totalMb = (totalBytes / (1024 * 1024)).toFixed(1);

              if (customMessage){
                $('#resumeModalMessage').text(customMessage);
              } else {
                $('#resumeModalMessage').text(`Quá trình tải lên MP4 chưa gửi hết lên server. Đã nhận được ${uploadedCount}/${totalChunks} phần (${sentMb} / ${totalMb} MiB).`);
              }

              $('#resumeModalProgressText').text(`${uploadedCount}/${totalChunks} phần (${percent}%)`);
              $('#resumeModalProgressBar').css('width', `${percent}%`);

              let resolved = false;
              const cleanup = () => {
                $('#btnResumeAccept').off('click');
                $('#btnResumeReject').off('click');
                $('#btnResumeDismiss').off('click');
                $modalEl.off('hidden.bs.modal');
              };

              $('#btnResumeAccept').on('click', () => {
                if (resolved) return;
                resolved = true;
                cleanup();
                modal.hide();
                resolve(true);
              });

              $('#btnResumeReject').on('click', () => {
                if (resolved) return;
                resolved = true;
                cleanup();
                modal.hide();
                resolve(false);
              });

              $('#btnResumeDismiss').on('click', () => {
                if (resolved) return;
                resolved = true;
                cleanup();
                modal.hide();
                resolve(true);
              });

              $modalEl.on('hidden.bs.modal', () => {
                if (!resolved){
                  resolved = true;
                  cleanup();
                  resolve(true);
                }
              });

              modal.show();
            });
          }

          async function uploadMp4AsHls(file, payload, antiForgeryToken, sourceId=null, oldStreamUrl=null){
            const chunkSize = 8 * 1024 * 1024;
            const totalChunks = Math.ceil(file.size / chunkSize);
            const $button = $('#btnSave');
            $button.prop('disabled', true);
            let uploadId = null;
            let sessionKey = null;
            let uploadedChunks = new Set();
            let stopProgressPolling = false;
            let progressPollTask = null;

            try {
              const fileFingerprint = await createMp4Fingerprint(file);
              sessionKey = `tflix:mp4-upload:${fileFingerprint}`;
              uploadId = localStorage.getItem(sessionKey) || crypto.randomUUID();
              localStorage.setItem(sessionKey, uploadId);

              const getStatus = async currentUploadId => $.ajax({
                url: `${urls.mp4UploadStatus}?uploadId=${encodeURIComponent(currentUploadId)}&fileFingerprint=${encodeURIComponent(fileFingerprint)}`,
                type: 'GET'
              });

              let uploadStatus;
              try {
                uploadStatus = await getStatus(uploadId);
              } catch (xhr){
                if (xhr?.status !== 409) throw xhr;
                await cancelAndCleanupServerUpload(uploadId, antiForgeryToken, sessionKey);
                uploadId = crypto.randomUUID();
                localStorage.setItem(sessionKey, uploadId);
                uploadStatus = await getStatus(uploadId);
              }

              if (uploadStatus.resumeAvailable || uploadStatus.ResumeAvailable){
                const savedTotal = uploadStatus.totalChunks ?? uploadStatus.TotalChunks;
                if (savedTotal !== totalChunks){
                  await cancelAndCleanupServerUpload(uploadId, antiForgeryToken, sessionKey);
                  uploadId = crypto.randomUUID();
                  localStorage.setItem(sessionKey, uploadId);
                  uploadStatus = await getStatus(uploadId);
                } else {
                  const savedChunks = uploadStatus.uploadedChunks ?? uploadStatus.UploadedChunks ?? [];
                  if (savedChunks.length > 0 && savedChunks.length < totalChunks){
                    uploadedChunks = new Set(savedChunks);
                    showToast(`Đang tiếp tục phiên cũ từ ${savedChunks.length}/${totalChunks} phần.`, true, 5000);
                  } else if (savedChunks.length >= totalChunks){
                    uploadedChunks = new Set(savedChunks);
                  }
                }
              }

              const updateChunkProgress = () => {
                const sentBytes = Array.from(uploadedChunks).reduce((total, chunkIndex) =>
                  total + Math.max(0, Math.min(chunkSize, file.size - chunkIndex * chunkSize)), 0);
                const stagePercent = totalChunks === 0 ? 0 : Math.floor(uploadedChunks.size * 100 / totalChunks);
                const percent = Math.floor(stagePercent * 0.30);
                showUploadProgress(
                  'Đang upload qua API',
                  `API ${stagePercent}% • tổng ${percent}% • còn lại ${100 - percent}% • ${uploadedChunks.size}/${totalChunks} phần (${(sentBytes / (1024 * 1024)).toFixed(1)} / ${(file.size / (1024 * 1024)).toFixed(1)} MiB)`,
                  percent);
                $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Tổng ${percent}% (còn ${100 - percent}%)`);
              };

              updateChunkProgress();
              for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++){
                if (uploadedChunks.has(chunkIndex)) continue;

                const start = chunkIndex * chunkSize;
                const chunk = file.slice(start, Math.min(start + chunkSize, file.size));
                const formData = new FormData();
                formData.append('Chunk', chunk, file.name + '.part');
                formData.append('fileFingerprint', fileFingerprint);

                const chunkUrl = `${urls.uploadMp4Chunk}?uploadId=${encodeURIComponent(uploadId)}&chunkIndex=${chunkIndex}&totalChunks=${totalChunks}`;
                await $.ajax({
                  url: chunkUrl,
                  type: 'POST',
                  data: formData,
                  processData: false,
                  contentType: false,
                  headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {}
                });

                uploadedChunks.add(chunkIndex);
                updateChunkProgress();
              }

              showUploadProgress('Đang xử lý HLS', 'Đang ghép MP4 và tạo playlist/segments.', 0, true);
              $button.html('<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo HLS...');
              progressPollTask = (async () => {
                while (!stopProgressPolling){
                  try {
                    const status = await getStatus(uploadId);
                    const progress = status.progress ?? status.Progress ?? {};
                    const stage = progress.stage ?? progress.Stage ?? '';
                    const message = progress.message ?? progress.Message ?? '';
                    const segmentsUploaded = progress.segmentsUploaded ?? progress.SegmentsUploaded ?? 0;
                    const totalSegments = progress.totalSegments ?? progress.TotalSegments ?? 0;
                    const percent = progress.percent ?? progress.Percent ?? 0;
                    const stagePercent = progress.stagePercent ?? progress.StagePercent ?? 0;
                    const storagePercent = progress.storagePercent ?? progress.StoragePercent ?? 0;
                    const remainingPercent = progress.remainingPercent ?? progress.RemainingPercent ?? Math.max(0, 100 - percent);
                    const bytesUploaded = progress.bytesUploaded ?? progress.BytesUploaded ?? 0;
                    const totalBytes = progress.totalBytes ?? progress.TotalBytes ?? 0;
                    const uploadedMiB = (bytesUploaded / (1024 * 1024)).toFixed(1);
                    const totalMiB = (totalBytes / (1024 * 1024)).toFixed(1);

                    if (stage === 'uploading-segments' && totalSegments > 0){
                      showUploadProgress(
                        'Đang upload HLS segments',
                        `Storage ${storagePercent}% • tổng ${percent}% • còn lại ${remainingPercent}% • ${segmentsUploaded}/${totalSegments} segments (${uploadedMiB}/${totalMiB} MiB)`,
                        percent);
                      $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Storage ${storagePercent}% • tổng ${percent}%`);
                    } else if (stage === 'saving'){
                      showUploadProgress('Đang lưu nguồn HLS', message || `Đã tải đủ ${segmentsUploaded}/${totalSegments} segments`, percent, true);
                      $button.html('<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu nguồn HLS...');
                    } else if (stage === 'packaging'){
                      showUploadProgress('Đang tạo HLS', `${message || 'FFmpeg đang đóng gói video'} • tổng ${percent}% • còn lại ${remainingPercent}%`, percent);
                      $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Tạo HLS ${stagePercent}% • tổng ${percent}%`);
                    } else if (stage === 'assembling'){
                      showUploadProgress('Đang ghép MP4', `${message || 'Đang ghép các phần MP4'} • tổng ${percent}% • còn lại ${remainingPercent}%`, percent, true);
                    }
                  } catch {
                    // Keep polling through brief network interruptions.
                  }
                  await new Promise(resolve => setTimeout(resolve, 1000));
                }
              })();

              const completeUrl = `${urls.completeMp4Upload}?uploadId=${encodeURIComponent(uploadId)}`;
              const completePayload = { ...payload, FileName: file.name, TotalChunks: totalChunks };
              if (sourceId) completePayload.SourceId = sourceId;
              if (oldStreamUrl) completePayload.OldStreamUrl = oldStreamUrl;
              const result = await $.ajax({
                url: completeUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(completePayload),
                headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {}
              });

              const ok = result && (result.success === true || result.code === '200' || result.Success === true);
              if (!ok){
                throw new Error(result?.message || result?.Message || 'Chuyển MP4 sang HLS thất bại.');
              }

              localStorage.removeItem(sessionKey);
              showUploadProgress('Hoàn tất', `Đã upload ${result.segmentsCount ?? result.SegmentsCount ?? 0} HLS segments`, 100);
              const successMessage = sourceId
                ? 'Đã thay nguồn bằng HLS mới và lưu thành công.'
                : 'Đã upload MP4, chuyển đổi HLS và lưu nguồn video thành công.';
              loadAll();
              closeSourceAndShowUploadResult(true, 'Upload thành công', successMessage);
            } catch (xhr){
              const detail = xhr?.responseJSON?.message || xhr?.responseText || xhr?.message || 'Mạng bị ngắt hoặc server gặp lỗi.';
              const sessionExpired = xhr?.status === 401 || xhr?.status === 403;
              const canResume = xhr?.status === 0 && uploadId && uploadedChunks.size > 0 && uploadedChunks.size < totalChunks;
              let cleanupMessage = canResume
                ? `Đã giữ ${uploadedChunks.size}/${totalChunks} phần trên server. Chọn lại đúng file để Resume.`
                : 'Toàn bộ file tạm và các phần đã upload đã được xóa.';
              if (uploadId && !canResume){
                try {
                  await cancelAndCleanupServerUpload(uploadId, antiForgeryToken, sessionKey);
                } catch {
                  cleanupMessage = 'Không thể xác nhận việc dọn dẹp do kết nối mạng đang gián đoạn. Server sẽ tự dọn dữ liệu khi nhận được lỗi hoặc khi phiên upload hết hạn.';
                }
              }
              if (sessionExpired){
                if (sessionKey) localStorage.removeItem(sessionKey);
                showToast('Phiên đăng nhập Admin đã hết hạn. Dữ liệu upload đang được dọn dẹp.', false, 4000);
                window.location.href = `/Admin/Auth?returnUrl=${encodeURIComponent('/Admin/VideoSoure')}`;
                return;
              }
              showToast(detail, false, 8000);
              showUploadResultPopup(false, canResume ? 'Upload bị gián đoạn' : 'Upload thất bại', `${detail} ${cleanupMessage}`);
            } finally {
              stopProgressPolling = true;
              if (progressPollTask) await progressPollTask;
              hideLoading();
              $button.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Lưu');
            }
          }

          function uploadHlsForUpdate(playlist, segments, payload, antiForgeryToken, sourceId, oldStreamUrl){
            const formData = new FormData();
            formData.append('Playlist', playlist);
            segments.forEach(segment => formData.append('Segments', segment));
            formData.append('SourceId', String(sourceId));
            if (oldStreamUrl) formData.append('OldStreamUrl', oldStreamUrl);
            Object.entries(payload).forEach(([key, value]) => {
              if (value !== null && value !== undefined && value !== '')
                formData.append(key, String(value));
            });

            const totalBytes = playlist.size + segments.reduce((total, segment) => total + segment.size, 0);
            const $button = $('#btnSave');
            $button.prop('disabled', true);
            showUploadProgress('Đang tải HLS', 'Đang gửi playlist và segments...', 0);

            $.ajax({
              url: urls.addHls,
              type: 'POST',
              data: formData,
              processData: false,
              contentType: false,
              headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {},
              xhr(){
                const xhr = $.ajaxSettings.xhr();
                if (xhr.upload){
                  xhr.upload.addEventListener('progress', event => {
                    if (!event.lengthComputable) return;
                    const percent = Math.round(event.loaded * 100 / event.total);
                    if (percent >= 100){
                      showUploadProgress('Đang lưu HLS', 'Đã nhận file; đang tải playlist và segments lên storage.', 100, true);
                    } else {
                      showUploadProgress(
                        'Đang tải HLS',
                        `${(event.loaded / (1024 * 1024)).toFixed(1)} / ${(totalBytes / (1024 * 1024)).toFixed(1)} MiB`,
                        percent);
                    }
                    $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Đang tải ${percent}%`);
                  });
                }
                return xhr;
              },
              success(response){
                const ok = response && (response.success === true || response.Success === true || response.code === '200');
                if (!ok){
                  const message = response?.message || response?.Message || 'Cập nhật HLS thất bại.';
                  showToast(message, false, 6000);
                  showUploadResultPopup(false, 'Upload thất bại', `${message} Các phần upload chưa hoàn tất đã được server thu hồi.`);
                  return;
                }
                showUploadProgress('Hoàn tất', 'Đã thay playlist và HLS segments.', 100);
                loadAll();
                closeSourceAndShowUploadResult(true, 'Upload thành công', 'Đã cập nhật playlist và toàn bộ HLS segments thành công.');
              },
              error(xhr){
                const message = xhr?.responseJSON?.message || xhr?.responseText || 'Lỗi upload HLS.';
                showToast(message, false, 9000);
                showUploadResultPopup(false, 'Upload thất bại', `${message} Các phần upload chưa hoàn tất đã được server thu hồi.`);
              },
              complete(){
                hideLoading();
                $button.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Lưu');
              }
            });
          }

          // ===== Save (Add/Update) =====
          function save(){
            const anti = $('input[name="__RequestVerificationToken"]').val();
            const id = ($('#SourceId').val()||'').trim();
            const isEdit = !!id;

            const type      = $('#SourceType').val();
            const movieId   = $('#MovieId').val();
            const episodeId = $('#EpisodeId').val();

            const payload = {
              Provider:     ($('#Provider').val()||'').trim(),
              ServerName:   ($('#ServerName').val()||'').trim() || null,
              StreamUrl:    ($('#StreamUrl').val()||'').trim() || '',
              Quality:      ($('#Quality').val()||'').trim() || null,
              Format:       ($('#Format').val()||'').trim() || null,
              DrmType:      ($('#DrmType').val()||'').trim() || null,
              DrmLicenseUrl:($('#DrmLicenseUrl').val()||'').trim() || null,
              IsPrimary:    ($('#IsPrimary').val()==='true'),
              Status:       ($('#Status').val()||'ACTIVE').trim()
            };

            if (type==='movie'){
              if (!movieId){ showToast("Vui lòng chọn Movie.", false); return; }
              payload.MovieId = Number(movieId);
              payload.EpisodeId = null;
            } else {
              if (!episodeId){ showToast("Vui lòng chọn Episode.", false); return; }
              payload.MovieId = null;
              payload.EpisodeId = Number(episodeId);
            }

            if (!payload.Provider){ showToast("Provider là bắt buộc.", false); return; }

            if (!isEdit){
              // ADD
              const fd = new FormData();
              const inputMode = $('input[name="InputMode"]:checked').val();
              const fileObj = document.getElementById('File').files?.[0] || null;
              let addUrl = urls.add;

              if (inputMode === 'file'){
                if (!fileObj){
                  showToast('Vui lòng chọn file MP4.', false);
                  return;
                }
                uploadMp4AsHls(fileObj, payload, anti);
                return;
              }

              if (inputMode === 'hls'){
                const playlist = document.getElementById('HlsPlaylist').files?.[0] || null;
                const segments = Array.from(document.getElementById('HlsSegments').files || []);
                if (!playlist || segments.length === 0){
                  showToast("HLS cần playlist và ít nhất một segment.", false);
                  return;
                }
                addUrl = urls.addHls;
                fd.append('Playlist', playlist);
                segments.forEach(segment => fd.append('Segments', segment));
              } else if (inputMode === 'url'){
                if (!payload.StreamUrl){
                  showToast("Vui lòng nhập Stream URL.", false);
                  return;
                }
              } else {
                if (!fileObj){
                  showToast("Vui lòng chọn file video.", false);
                  return;
                }
                fd.append('File', fileObj);
              }

              Object.entries(payload).forEach(([k,v])=>{
                if (v === null || v === undefined || v === '') return;
                fd.append(k, String(v));
              });

              showLoading();
              $.ajax({
                url: addUrl, type: 'POST',
                data: fd, processData: false, contentType: false,
                headers: anti ? { "RequestVerificationToken": anti } : {},
                success(res){
                  const ok = res && (res.success===true || res.code==="200" || res.Success===true);
                  if (ok){
                    loadAll();
                    closeSourceAndShowUploadResult(true, 'Upload thành công', 'Nguồn video đã được upload và lưu thành công.');
                  } else {
                    const message = res?.message || res?.Message || "Thêm thất bại.";
                    showToast(message, false);
                    showUploadResultPopup(false, 'Upload thất bại', message);
                  }
                },
                error(xhr){
                  const message = xhr?.responseJSON?.message || xhr?.responseText || "Lỗi thêm nguồn.";
                  showToast(message, false);
                  showUploadResultPopup(false, 'Upload thất bại', message);
                },
                complete(){ hideLoading(); }
              });

            } else {
              // UPDATE existing source as HLS
              const fileObj = document.getElementById('File').files?.[0] || null;
              const inputMode = $('input[name="InputMode"]:checked').val();
              const oldStreamUrl = ($('#OldStreamUrl').val() || '').trim();

              if (inputMode === 'file'){
                if (!fileObj){ showToast('Vui lòng chọn file MP4 mới.', false); return; }
                uploadMp4AsHls(fileObj, payload, anti, Number(id), oldStreamUrl);
                return;
              }

              if (inputMode === 'hls'){
                const playlist = document.getElementById('HlsPlaylist').files?.[0] || null;
                const segments = Array.from(document.getElementById('HlsSegments').files || []);
                if (!playlist || segments.length === 0){
                  showToast('HLS cần playlist và ít nhất một segment.', false);
                  return;
                }
                uploadHlsForUpdate(playlist, segments, payload, anti, Number(id), oldStreamUrl);
                return;
              }

              showToast('Chọn MP4 hoặc bộ playlist và segments HLS để thay nguồn.', false);
            }
          }

          // ===== Preview modal =====
          $tbody.on('click', '.btn-preview', function(){
            const url = $(this).data('url');
            const id  = $(this).data('id');
            const video = document.getElementById('previewPlayer');
            video.pause(); video.src = url; video.load();
            $('#previewMeta').text(`Source #${id} — ${url}`);
            previewModal.show();
            setTimeout(()=> video.play().catch(()=>{}), 200);
          });
          previewModalEl.addEventListener('hidden.bs.modal', ()=>{
            const video = document.getElementById('previewPlayer');
            video.pause(); video.removeAttribute('src'); video.load();
          });

            function toggleInputMode() {
            const mode = $('input[name="InputMode"]:checked').val();
            if (mode === 'file') {
                $('#blockFile').removeClass('d-none');
                $('#blockHls').addClass('d-none');
                $('#StreamUrl').prop('disabled', false);
            } else if (mode === 'url') {
                $('#blockFile').addClass('d-none');
                $('#blockHls').addClass('d-none');
                $('#StreamUrl').prop('disabled', false);
            } else if (mode === 'hls') {
                $('#blockFile').addClass('d-none');
                $('#blockHls').removeClass('d-none');
                $('#StreamUrl').prop('disabled', true); // HLS thì URL sẽ là m3u8 sau khi upload
            }
        }

        // gắn event change
        $('input[name="InputMode"]').on('change', toggleInputMode);

        // gọi 1 lần để set đúng state ban đầu
        toggleInputMode();


          // ===== Events =====
          $('#btnRefresh').on('click', ()=> loadAll());
          $('#btnAdd').on('click', ()=> { openAdd(); });
          $('#btnSave').on('click', save);
          $('#File').on('change', function(){
            detectResumeUpload(this.files?.[0] || null);
          });
          $('#btnResumeUpload').on('click', function(){
            if (!resumeFileState){
              showToast('Không còn phiên upload có thể tiếp tục.', false);
              return;
            }
            save();
          });

          // Lọc + phân trang
          $('#txtSearch, #txtMovieId, #txtEpisodeId, #txtQuality').on('input', ()=> { applyFilter(); page=1; renderTablePage(); });
          $('#slType').on('change', ()=> { applyFilter(); page=1; renderTablePage(); });
          $('#pageSize').on('change', ()=> { page=1; renderTablePage(); });

          function confirmAndDeleteSource(sourceId, streamUrl){
            if (!sourceId){ showToast("Không tìm thấy ID nguồn để xóa.", false); return; }
            if (!confirm(`Bạn có chắc chắn muốn xóa nguồn video #${sourceId} này không? Thao tác này không thể hoàn tác.`)) {
              return;
            }
            showLoading();
            const anti = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
              url: urls.deleteSource,
              type: 'POST',
              data: JSON.stringify({ sourceId: Number(sourceId), streamUrl: streamUrl || '' }),
              contentType: 'application/json',
              headers: anti ? { "RequestVerificationToken": anti } : {},
              success(res){
                const ok = res && (res.success === true || res.code === "200" || res.Success === true);
                if (ok){
                  showToast("Đã xóa nguồn video thành công.", true);
                  sourceModal.hide();
                  loadAll();
                } else {
                  showToast(res?.message || res?.Message || "Xóa nguồn video thất bại.", false);
                }
              },
              error(xhr){
                showToast(xhr?.responseJSON?.message || xhr?.responseText || "Lỗi khi xóa nguồn video.", false);
              },
              complete(){
                hideLoading();
              }
            });
          }

          // CRUD row buttons
          $tbody.on('click', '.btn-edit', function(){ openEdit($(this).data('id')); });
          $tbody.on('click', '.btn-delete', function(){
            const id = $(this).data('id');
            const url = $(this).data('url');
            confirmAndDeleteSource(id, url);
          });
          $('#btnDeleteCurrentSource').on('click', function(){
            const id = $(this).data('id');
            const url = $(this).data('url');
            confirmAndDeleteSource(id, url);
          });

          // Modal UI
          $('#SourceType').on('change', toggleTypeUI);

          // First load
          (function firstLoad(){
            // nạp dropdown cho modal ngay từ đầu giúp nhanh thao tác
            // (cũng không ảnh hưởng đến loadAll phân trang)
            $('#MovieId').html('<option value="">-- Chọn Movie --</option>').trigger('change');
            $('#EpisodeId').html('<option value="">-- Chọn Episode --</option>').trigger('change');

            // Nạp dữ liệu dropdown (không chặn UI)
            $.get(urls.movies, res=>{
              const $ddl = $('#MovieId');
              pickList(res).forEach(m=>{
                const id = gv(m,'movieId','MovieId','moviE_ID');
                const title = gv(m,'title','Title') || `Movie #${id}`;
                if (id!=null) $ddl.append(new Option(title, id, false, false));
              });
              $ddl.trigger('change');
            });
            $.get(urls.eps, res=>{
              const $ddl = $('#EpisodeId');
              pickList(res).forEach(ep=>{
                const id   = gv(ep,'episodeId','EpisodeId','episodE_ID');
                const epNo = gv(ep,'episodeNo','EpisodeNo','episodE_NO');
                const title= gv(ep,'episodeTitle','EpisodeTitle','title','Title') || `Episode #${id}`;
                if (id!=null) $ddl.append(new Option(`E${epNo ?? ''} - ${title}`, id, false, false));
              });
              $ddl.trigger('change');
            });

            loadAll();
          })();
        })();
    </script>
}
