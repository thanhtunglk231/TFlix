<!-- Modal Confirm Resume / Delete Incomplete Upload -->
<div class="modal fade" id="resumeConfirmModal" tabindex="-1" aria-labelledby="resumeConfirmModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background: #171920; border: 1px solid rgba(255,255,255,0.15); border-radius: 14px; box-shadow: 0 16px 48px rgba(0,0,0,0.7);">
            <div class="modal-header border-bottom border-secondary border-opacity-25 pb-3">
                <h5 class="modal-title d-flex align-items-center gap-2 text-warning" id="resumeConfirmModalLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>Chưa hoàn tất tải lên file</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng" id="btnResumeDismiss"></button>
            </div>
            <div class="modal-body py-4">
                <p class="text-light mb-3" id="resumeModalMessage">
                    File video chưa được gửi hết lên server. Hệ thống phát hiện các phần đã lưu trước đó.
                </p>
                <div class="p-3 rounded-3 mb-3" style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08);">
                    <div class="d-flex justify-content-between mb-1 small text-muted">
                        <span>Tiến độ đã nhận trên server:</span>
                        <span class="text-info fw-bold" id="resumeModalProgressText">0 / 0 phần</span>
                    </div>
                    <div class="progress" style="height: 8px; background: rgba(255,255,255,0.1);">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" id="resumeModalProgressBar" role="progressbar" style="width: 0%"></div>
                    </div>
                </div>
                <div class="text-secondary small">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Bạn có muốn tiếp tục tải lên (Resume) không?</strong><br />
                    Nếu <strong>Không</strong>, toàn bộ các file tạm đã lưu trên server sẽ bị xóa bỏ hoàn toàn.
                </div>
            </div>
            <div class="modal-footer border-top border-secondary border-opacity-25 pt-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger d-flex align-items-center gap-2" id="btnResumeReject">
                    <i class="bi bi-trash3"></i>
                    <span>Không, xóa hết file cũ ở server</span>
                </button>
                <button type="button" class="btn btn-primary d-flex align-items-center gap-2" id="btnResumeAccept" style="background: linear-gradient(135deg, #1683ff 0%, #19d3c5 100%); border: none; color: #0b141e; font-weight: 600;">
                    <i class="bi bi-arrow-repeat"></i>
                    <span>Có, tiếp tục Resume</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Add/Edit -->
<div class="modal fade" id="sourceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span id="modalTitle">Thêm nguồn</span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="col-12">
                    <label class="form-label">Kiểu nguồn video *</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="InputMode" id="modeFile" value="file" checked>
                        <label class="form-check-label" for="modeFile">MP4 → HLS trên máy người dùng</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="InputMode" id="modeUrl" value="url">
                        <label class="form-check-label" for="modeUrl">Chỉ dùng Stream URL</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="InputMode" id="modeHls" value="hls">
                        <label class="form-check-label" for="modeHls">Upload HLS (m3u8 + segments)</label>
                    </div>
                </div>

                <form id="frmSource" class="row g-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="SourceId" />
                    <input type="hidden" id="OldStreamUrl" />

                    <div class="col-md-4">
                        <label class="form-label">Loại nguồn *</label>
                        <select id="SourceType" class="form-select" required>
                            <option value="movie">Movie</option>
                            <option value="episode">Episode</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Movie</label>
                        <select id="MovieId" class="form-select">
                            <option value="">-- Chọn Movie --</option>
                        </select>
                        <div class="form-text">Chỉ dùng khi Loại = Movie.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Episode</label>
                        <select id="EpisodeId" class="form-select">
                            <option value="">-- Chọn Episode --</option>
                        </select>
                        <div class="form-text">Chỉ dùng khi Loại = Episode.</div>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Provider *</label>
                        <input id="Provider" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Server Name</label>
                        <input id="ServerName" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Stream URL</label>
                        <input id="StreamUrl" class="form-control" placeholder="https://... (nếu KHÔNG upload file)" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Quality</label>
                        <input id="Quality" class="form-control" placeholder="720p/1080p/4K..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Format</label>
                        <input id="Format" class="form-control" placeholder="HLS/DASH/MP4..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">DRM Type</label>
                        <input id="DrmType" class="form-control" placeholder="Widevine/FairPlay/..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">DRM License URL</label>
                        <input id="DrmLicenseUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Is Primary</label>
                        <select id="IsPrimary" class="form-select">
                            <option value="false">No</option>
                            <option value="true">Yes</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Status</label>
                        <select id="Status" class="form-select">
                            <option value="ACTIVE">ACTIVE</option>
                            <option value="DISABLED">DISABLED</option>
                        </select>
                    </div>

                    <!-- block upload 1 file cũ -->
                    <div class="col-12" id="blockFile">
                        <label class="form-label">Upload file video (1 file)</label>
                        <input id="File" type="file" class="form-control" accept=".mp4,video/mp4" />
                        <div class="inline-upload-status" id="resumeUploadPanel" role="status" aria-live="polite">
                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                                <div class="min-w-0">
                                    <div class="fw-semibold" id="inlineUploadTitle">
                                        <i class="bi bi-cloud-arrow-up me-1"></i>Tiến trình upload
                                    </div>
                                    <div class="small text-secondary" id="resumeUploadDetail">Chọn MP4 để tạo HLS trực tiếp bằng CPU và RAM của trình duyệt.</div>
                                </div>
                                <button type="button" class="btn btn-warning d-none" id="btnResumeUpload" disabled>
                                    <i class="bi bi-play-fill me-1"></i>Resume
                                </button>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" role="progressbar" aria-label="Tiến trình upload video" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                                    <div class="progress-bar progress-bar-striped" id="inlineUploadProgressBar" style="width: 0%"></div>
                                </div>
                                <span class="small fw-semibold text-nowrap" id="inlineUploadProgressText">0%</span>
                            </div>
                        </div>
                    </div>

                    <!-- block upload HLS -->
                    <div class="col-12 d-none" id="blockHls">
                        <label class="form-label">Upload HLS</label>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Playlist (.m3u8) *</label>
                                <input id="HlsPlaylist" type="file" class="form-control" accept=".m3u8" />
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Segments (.ts/.m4s) *</label>
                                <input id="HlsSegments" type="file" class="form-control" multiple accept=".ts,.m4s,video/*" />
                                <div class="form-text">Chọn nhiều file segments cùng lúc.</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 mt-3">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" role="switch" id="AutoGenerateVietnameseSubtitle" />
                            <label class="form-check-label" for="AutoGenerateVietnameseSubtitle">
                                Tự động tạo phụ đề Tiếng Việt và Tiếng Anh sau khi lưu nguồn HLS
                            </label>
                        </div>
                        <div class="form-text">Âm thanh được tách bằng FFmpeg trong trình duyệt, chia từng đoạn và gửi Gemini để dịch.</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-outline-danger d-none" id="btnDeleteCurrentSource">
                    <i class="bi bi-trash me-1"></i>Xóa nguồn này
                </button>
                <div class="d-flex gap-2 ms-auto">
                    <button type="button" class="btn btn-outline-info d-none" id="btnGenerateSubtitle">
                        <i class="bi bi-badge-cc me-1"></i>Tạo phụ đề VI/EN bằng Gemini
                    </button>
                    <button type="button" class="btn btn-outline-warning d-none" id="btnGenerateHighlight">
                        <i class="bi bi-stars me-1"></i>Tạo 3 highlight bằng Gemini
                    </button>
                    <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button class="btn btn-primary" id="btnSave"><i class="bi bi-save me-1"></i>Lưu</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xem lớn video -->
<div class="modal fade" id="videoPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body p-0">
                <video id="previewPlayer" controls playsinline style="width:100%;max-height:80vh;"></video>
            </div>
            <div class="modal-footer">
                <span id="previewMeta" class="me-auto text-muted small"></span>
                <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@1.5.18/dist/hls.min.js"></script>

    <!-- Select2 cho dropdown có tìm kiếm -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        (function(){
          // ===== URLs =====
          const urls = {
            getAll:  '@urlGetAll',
            add:     '@urlAdd',
            addHls:  '@urlAddHls',
            uploadBrowserHlsChunk: '@urlUploadBrowserHlsChunk',
            browserHlsUploadStatus: '@urlBrowserHlsUploadStatus',
            completeBrowserHlsUpload: '@urlCompleteBrowserHlsUpload',
            getBrowserHlsCompletionStatus: '@urlGetBrowserHlsCompletionStatus',
            cancelBrowserHlsUpload: '@urlCancelBrowserHlsUpload',
            uploadMp4Chunk: '@urlUploadMp4Chunk',
            mp4UploadStatus: '@urlMp4UploadStatus',
            completeMp4Upload: '@urlCompleteMp4Upload',
            cancelMp4Upload: '@urlCancelMp4Upload',
            clientLog: '@urlClientLog',
            update:  '@urlUpdate',
            deleteSource: '@urlDelete',
            generateHighlight: '@urlGenerateHighlight',
            generateSubtitle: '@urlGenerateSubtitle',
            startSubtitleJob: '@urlStartSubtitleJob',
            getSubtitleJob: '@urlGetSubtitleJob',
            uploadSubtitleChunk: '@urlUploadSubtitleChunk',
            completeSubtitleJob: '@urlCompleteSubtitleJob',
            proxySubtitleHls: '@urlProxySubtitleHls',
            subtitleRequestToken: '@urlSubtitleRequestToken',
            getSubtitleDraft: '@urlGetSubtitleDraft',
            updateSubtitleDraft: '@urlUpdateSubtitleDraft',
            approveSubtitle: '@urlApproveSubtitle',
            movies:  '@urlGetAllMovies',
            eps:     '@urlGetAllEpisodes'
          };

          // ===== Elements & State =====
          const $overlay = $("#__loadingOverlay");
          const $loadingSpinner = $overlay.find('.spinner-wrap');
          const $uploadProgress = $('#uploadProgressPanel');
          const $toast   = $("#__toastMessage");
          const $tbody   = $('#tblSources tbody');
          const $pager   = $("#pagerWrap");

          const sourceModalEl  = document.getElementById('sourceModal');
          const sourceModal    = bootstrap.Modal.getOrCreateInstance(sourceModalEl);
          const previewModalEl = document.getElementById('videoPreviewModal');
          const previewModal   = bootstrap.Modal.getOrCreateInstance(previewModalEl);
          const uploadResultModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('uploadResultModal'));
          const highlightConfirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('highlightConfirmModal'));
          const subtitleConfirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('subtitleConfirmModal'));

          document.getElementById('highlightConfirmModal').addEventListener('show.bs.modal', () => {
            setTimeout(() => document.querySelector('.modal-backdrop:last-of-type')?.classList.add('highlight-popup-backdrop'));
          });
          document.getElementById('subtitleConfirmModal').addEventListener('show.bs.modal', () => {
            setTimeout(() => document.querySelector('.modal-backdrop:last-of-type')?.classList.add('highlight-popup-backdrop'));
          });
          document.getElementById('uploadResultModal').addEventListener('show.bs.modal', () => {
            setTimeout(() => document.querySelector('.modal-backdrop:last-of-type')?.classList.add('highlight-popup-backdrop'));
          });

          let cache = [];     // current server page
          let movieLookupRequest = null;
          let episodeLookupRequest = null;
          let page = 1;
          let totalCount = 0;
          let totalPages = 1;
          let filterTimer = null;
          let resumeFileState = null;
          let browserFfmpeg = null;
          let browserFfmpegLoaded = false;
          let browserHlsUploadPaused = false;
          let browserHlsUploadActive = false;
          let pendingHighlightSourceId = 0;
          let highlightProgressTimer = null;
          let subtitleProgressTimer = null;
          let currentSubtitleDraftJobId = null;
          let currentSubtitleDraft = [];
          let subtitlePreviewLanguage = 'vi';
          let subtitlePreviewHls = null;

          function reportVideoSourceClientError(eventName, detail){
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').first().val();
            const payload = {
              Event: String(eventName || 'UnknownClientError'),
              Detail: String(detail || ''),
              PageUrl: window.location.href,
              UserAgent: navigator.userAgent
            };
            console.error('[VideoSoure]', payload.Event, payload.Detail);
            return $.ajax({
              url: urls.clientLog,
              type: 'POST',
              contentType: 'application/json; charset=utf-8',
              headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {},
              data: JSON.stringify(payload)
            }).catch(() => null);
          }

          async function loadExternalScript(libraryName, candidates, isReady){
            if(isReady()) return;
            const failures = [];
            for(const scriptUrl of candidates){
              try {
                await new Promise((resolve, reject) => {
                  const script = document.createElement('script');
                  script.src = scriptUrl;
                  script.crossOrigin = 'anonymous';
                  script.async = true;
                  script.onload = () => isReady()
                    ? resolve()
                    : reject(new Error('Script tải xong nhưng không tạo global object.'));
                  script.onerror = () => reject(new Error('Trình duyệt từ chối hoặc không kết nối được CDN.'));
                  document.head.appendChild(script);
                });
                return;
              } catch(error){
                const failure = `${scriptUrl}: ${error?.message || error}`;
                failures.push(failure);
                await reportVideoSourceClientError(`FFmpegScriptLoadFailed:${libraryName}`, failure);
              }
            }
            throw new Error(`Không tải được ${libraryName}. ${failures.join(' | ')}`);
          }

          // ===== Helpers =====
          function updateInlineUploadProgress(title, detail, percent, processing=false){
            const value = Math.max(0, Math.min(100, Math.round(percent || 0)));
            $('#inlineUploadTitle').html(`<i class="bi ${processing ? 'bi-hourglass-split' : 'bi-cloud-arrow-up'} me-1"></i>${title}`);
            $('#resumeUploadDetail').text(detail);
            $('#inlineUploadProgressText').text(`${value}%`);
            $('#inlineUploadProgressBar')
              .css('width', `${value}%`)
              .toggleClass('progress-bar-striped', value > 0 && value < 100)
              .toggleClass('progress-bar-animated', processing || (value > 0 && value < 100))
              .parent().attr('aria-valuenow', value);
          }

          function updateSubtitleProgress(detail, percent, processing=true){
            const value = Math.max(0, Math.min(100, Math.round(percent || 0)));
            $('#subtitleProgressPanel').removeClass('d-none');
            $('#subtitleProgressDetail').text(detail || 'Đang xử lý...');
            $('#subtitleProgressText').text(`${value}%`);
            $('#subtitleProgressBar')
              .css('width', `${value}%`)
              .toggleClass('progress-bar-striped progress-bar-animated', processing && value < 100)
              .toggleClass('bg-info', processing && value < 100)
              .toggleClass('bg-success', !processing && value === 100)
              .toggleClass('bg-danger', !processing && value < 100)
              .parent().attr('aria-valuenow', value);
          }

          function resetSubtitleProgress(){
            $('#subtitleProgressPanel').addClass('d-none');
            $('#subtitleProgressBar').css('width', '0%').removeClass('bg-success bg-danger').addClass('bg-info progress-bar-striped progress-bar-animated');
            $('#subtitleProgressText').text('0%');
            $('#subtitleProgressDetail').text('Đang chuẩn bị...');
            $('#btnCancelSubtitle').prop('disabled', false);
            $('#subtitleDraftPanel,#btnSaveSubtitleDraft,#btnApproveSubtitle').addClass('d-none');
            $('#btnConfirmGenerateSubtitle').removeClass('d-none');
            currentSubtitleDraftJobId = null;
            currentSubtitleDraft = [];
          }

          function renderSubtitleDraft(){
            const body = $('#subtitleCueEditor').empty();
            currentSubtitleDraft.forEach((cue, index) => {
              body.append(`<tr data-index="${index}">
                <td><button type="button" class="btn btn-sm btn-link text-info p-0 subtitle-seek" data-time="${Number(cue.startSeconds)||0}">${index + 1}</button></td>
                <td><input type="number" min="0" step="0.001" class="form-control form-control-sm cue-start" value="${Number(cue.startSeconds||0).toFixed(3)}"></td>
                <td><input type="number" min="0" step="0.001" class="form-control form-control-sm cue-end" value="${Number(cue.endSeconds||0).toFixed(3)}"></td>
                <td><textarea class="form-control form-control-sm cue-vi" rows="2"></textarea></td>
                <td><textarea class="form-control form-control-sm cue-en" rows="2"></textarea></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger cue-delete" title="Xóa đoạn"><i class="bi bi-trash"></i></button></td>
              </tr>`);
              const row = body.children().last();
              row.find('.cue-vi').val(cue.vi || '');
              row.find('.cue-en').val(cue.en || '');
            });
          }

          function collectSubtitleDraft(){
            return $('#subtitleCueEditor tr').map(function(){
              return {
                startSeconds: Number($(this).find('.cue-start').val()),
                endSeconds: Number($(this).find('.cue-end').val()),
                vi: $(this).find('.cue-vi').val().trim(),
                en: $(this).find('.cue-en').val().trim()
              };
            }).get();
          }

          function setupSubtitlePreview(streamUrl, sourceId){
            const video = document.getElementById('subtitlePreviewVideo');
            const proxied = subtitleHlsProxyUrl(sourceId, streamUrl);
            subtitlePreviewHls?.destroy(); subtitlePreviewHls = null;
            if(window.Hls?.isSupported()){
              subtitlePreviewHls = new Hls();
              subtitlePreviewHls.loadSource(proxied);
              subtitlePreviewHls.attachMedia(video);
            } else { video.src = proxied; }
            video.ontimeupdate = () => {
              const cue = currentSubtitleDraft.find(item => video.currentTime >= item.startSeconds && video.currentTime <= item.endSeconds);
              $('#subtitlePreviewText').text(cue ? (subtitlePreviewLanguage === 'en' ? cue.en : cue.vi) : '');
            };
          }

          async function showSubtitleDraft(jobId){
            const draft = await $.get(urls.getSubtitleDraft, { jobId });
            currentSubtitleDraftJobId = jobId;
            currentSubtitleDraft = draft.cues || draft.Cues || [];
            renderSubtitleDraft();
            setupSubtitlePreview(draft.streamUrl || draft.StreamUrl, draft.sourceId || draft.SourceId);
            $('#subtitleDraftPanel,#btnSaveSubtitleDraft,#btnApproveSubtitle').removeClass('d-none');
            $('#btnConfirmGenerateSubtitle').addClass('d-none');
            $('#btnCancelSubtitle').prop('disabled', false).text('Đóng');
            $('#subtitleApprovalStatus').removeClass('alert-success').addClass('alert-warning').text('Chưa duyệt — phụ đề chưa hiển thị ở trang xem phim.');
          }

          function resetInlineUploadProgress(){
            updateInlineUploadProgress('Tiến trình upload', 'Chọn file MP4 để bắt đầu hoặc kiểm tra phiên upload trước.', 0);
            $('#btnResumeUpload').prop('disabled', true);
          }

          function showLoading(){
            $uploadProgress.addClass('d-none').removeClass('is-processing');
            $loadingSpinner.removeClass('d-none');
            $overlay.fadeIn(80);
          }
          function showUploadProgress(title, detail, percent, processing=false){
            const value = Math.max(0, Math.min(100, Math.round(percent)));
            updateInlineUploadProgress(title, detail, value, processing);
            $overlay.stop(true, true).hide();
          }
          function hideLoading(){
            $overlay.fadeOut(120, ()=>{
              $uploadProgress.addClass('d-none').removeClass('is-processing');
              $loadingSpinner.removeClass('d-none');
              $('#uploadProcessingStatus').removeClass('d-flex').addClass('d-none');
            });
          }
          function showToast(msg, ok=true, ms=2600){
            $toast.text(msg||"").removeClass("success error").addClass(ok?"success":"error").fadeIn(120);
            setTimeout(()=> $toast.fadeOut(150), ms);
          }
          function showUploadResultPopup(ok, heading, message){
            $('#uploadResultModalHeading').text(heading || (ok ? 'Upload thành công' : 'Upload thất bại'));
            $('#uploadResultModalMessage').text(message || '');
            $('#uploadResultModalTitle').toggleClass('text-success', ok).toggleClass('text-danger', !ok);
            $('#uploadResultModalIcon')
              .toggleClass('bi-check-circle-fill', ok)
              .toggleClass('bi-exclamation-triangle-fill', !ok);
            uploadResultModal.show();
          }
          function closeSourceAndShowUploadResult(ok, heading, message){
            sourceModalEl.addEventListener('hidden.bs.modal', () => {
              showUploadResultPopup(ok, heading, message);
            }, { once: true });
            sourceModal.hide();
          }
          function pickList(res){
            const d = res?.data ?? res?.Data ?? null;
            if (!d) return [];
            if (Array.isArray(d)) return d;
            if (Array.isArray(d.table)) return d.table;
            if (Array.isArray(d.Table)) return d.Table;
            return [];
          }
          function gv(o, ...keys){
            for (const k of keys){
              if (o?.[k] !== undefined && o?.[k] !== null) return o[k];
            }
            return undefined;
          }
          function uniqueById(list, idSelector){
            const seen = new Set();
            return (Array.isArray(list) ? list : []).filter(item=>{
              const id = idSelector(item);
              if (id === undefined || id === null || String(id).trim() === '') return false;
              const key = String(id);
              if (seen.has(key)) return false;
              seen.add(key);
              return true;
            });
          }

          function renderPager($wrap, state){
            const { page, last, total } = state;
            const dis = c => c ? "disabled" : "";
            const btn = (label,target,disabled=false,active=false)=>
              `<li class="page-item ${dis(disabled)} ${active ? 'active' : ''}"><a class="page-link" href="#" data-page="${target}" ${active ? 'aria-current="page"' : ''}>${label}</a></li>`;
            const start = Math.max(1, Math.min(page - 2, last - 4));
            const end = Math.min(last, start + 4);
            let pageButtons = '';
            for(let pageNumber = start; pageNumber <= end; pageNumber++){
              pageButtons += btn(pageNumber, pageNumber, false, pageNumber === page);
            }
            const html = `
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small text-secondary">Tổng: <b>${total}</b> bản ghi • Trang <b>${page}</b>/<b>${last}</b></div>
                <nav aria-label="pagination">
                  <ul class="pagination m-0">
                    ${btn("«",1, page<=1)}
                    ${btn("‹",page-1, page<=1)}
                    ${pageButtons}
                    ${btn("›",page+1, page>=last)}
                    ${btn("»",last, page>=last)}
                  </ul>
                </nav>
              </div>`;
            $wrap.html(html);
            $wrap.find("a.page-link").on("click", function(e){
              e.preventDefault();
              const p = Number($(this).data("page"));
              if(Number.isFinite(p) && p >= 1 && p <= totalPages){ loadAll(p); }
            });
          }

          // ---- Select2 init (gắn dropdownParent để không lỗi z-index trong modal)
          function initSelect2(){
            const parent = $('#sourceModal');
            $('#MovieId').select2({
              placeholder: '-- Chọn Movie --', allowClear: true, width: '100%', dropdownParent: parent
            });
            $('#EpisodeId').select2({
              placeholder: '-- Chọn Episode --', allowClear: true, width: '100%', dropdownParent: parent
            });
          }
          initSelect2();

          // ===== Filter + Render =====
          function renderTablePage(){
            const size = 10;
            const state = { page, size, total: totalCount, last: totalPages, items: cache };

            const rows = state.items.map(x=>{
              const id          = gv(x,'sourceId','SourceId','sourcE_ID');
              const movieId     = gv(x,'movieId','MovieId','moviE_ID') ?? '';
              const episodeId   = gv(x,'episodeId','EpisodeId','episodE_ID') ?? '';
              const movieTitle  = gv(x,'movieTitle','MovieTitle','moviE_TITLE') ?? '';
              const episodeTitle= gv(x,'episodeTitle','EpisodeTitle','episodE_TITLE') ?? '';
              const provider    = gv(x,'provider','Provider') ?? '';
              const server      = gv(x,'serverName','ServerName','serveR_NAME') ?? '';
              const url         = gv(x,'streamUrl','StreamUrl','streaM_URL') ?? '';
              const quality     = gv(x,'quality','Quality') ?? '';
              const format      = gv(x,'format','Format') ?? '';
              const drmType     = gv(x,'drmType','DrmType','drM_TYPE') ?? '';
              const drmLic      = gv(x,'drmLicenseUrl','DrmLicenseUrl','drM_LICENSE_URL') ?? '';
              const isPrimary   = gv(x,'isPrimary','IsPrimary','iS_PRIMARY');
              const status      = gv(x,'status','Status') ?? '';

              const videoCell = url ? `
                <div class="video-cell">
                  <video src="${url}" controls playsinline preload="metadata"
                         onerror="console.warn('Video load error:', '${url}')"></video>
                  <div class="small mt-1">
                    <a href="${url}" target="_blank" class="text-clip" title="${url}">${url}</a>
                    <button class="btn btn-sm btn-outline-secondary ms-2 btn-preview"
                            data-url="${url}" data-id="${id}" title="Xem lớn">
                      <i class="bi bi-arrows-fullscreen"></i>
                    </button>
                  </div>
