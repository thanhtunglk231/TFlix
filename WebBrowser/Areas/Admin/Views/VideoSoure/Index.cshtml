          async function createBrowserBlobUrl(url, mimeType){
            const response = await fetch(url, { cache: 'force-cache' });
            if(!response.ok){
              throw new Error(`HTTP ${response.status} ${response.statusText} khi tải ${url}`);
            }

            const content = await response.arrayBuffer();
            return URL.createObjectURL(new Blob([content], { type: mimeType }));
          }

          async function fetchBrowserText(url){
            const response = await fetch(url, { cache: 'force-cache' });
            if(!response.ok){
              throw new Error(`HTTP ${response.status} ${response.statusText} khi tải ${url}`);
            }
            return response.text();
          }

          async function importBrowserModule(libraryName, candidates){
            const failures = [];
            for(const moduleUrl of candidates){
              try {
                return await import(moduleUrl);
              } catch(error){
                const detail = `${moduleUrl}: ${error?.stack || error?.message || error}`;
                failures.push(detail);
                await reportVideoSourceClientError(`FFmpegModuleLoadFailed:${libraryName}`, detail);
              }
            }
            throw new Error(`Không tải được ${libraryName}. ${failures.join(' | ')}`);
          }

          async function createFfmpegEsmWorkerUrl(baseUrl){
            const [workerSource, constantsSource, errorsSource] = await Promise.all([
              fetchBrowserText(`${baseUrl}/worker.js`),
              fetchBrowserText(`${baseUrl}/const.js`),
              fetchBrowserText(`${baseUrl}/errors.js`)
            ]);
            const constantsUrl = URL.createObjectURL(new Blob([constantsSource], { type: 'text/javascript' }));
            const errorsUrl = URL.createObjectURL(new Blob([errorsSource], { type: 'text/javascript' }));
            const resolvedWorkerSource = workerSource
              .replace('"./const.js"', JSON.stringify(constantsUrl))
              .replace('"./errors.js"', JSON.stringify(errorsUrl));
            return URL.createObjectURL(new Blob([resolvedWorkerSource], { type: 'text/javascript' }));
          }

          async function ensureBrowserFfmpeg(){
            if(browserFfmpegLoaded && browserFfmpeg) return browserFfmpeg;

            const { FFmpeg } = await importBrowserModule('FFmpegWASM', [
              'https://cdn.jsdelivr.net/npm/@@ffmpeg/ffmpeg@@0.12.15/dist/esm/index.js',
              'https://unpkg.com/@@ffmpeg/ffmpeg@@0.12.15/dist/esm/index.js'
            ]);
            browserFfmpeg = new FFmpeg();
            browserFfmpeg.on('progress', ({ progress }) => {
              const packagingPercent = Math.max(0, Math.min(100, Math.round((progress || 0) * 100)));
              const totalPercent = Math.round(packagingPercent * 0.65);
              showUploadProgress(
                'Đang tạo HLS trên máy của bạn',
                `Xử lý tại trình duyệt ${packagingPercent}% • tổng ${totalPercent}% • không dùng CPU/ổ đĩa server`,
                totalPercent);
              $('#btnSave').html(`<span class="spinner-border spinner-border-sm me-2"></span>Tạo HLS ${packagingPercent}%`);
            });

            showUploadProgress('Đang tải bộ xử lý HLS', 'Tải FFmpeg WebAssembly vào trình duyệt (chỉ tải lại khi làm mới trang).', 0, true);
            const coreCandidates = [
              'https://cdn.jsdelivr.net/npm/@@ffmpeg/core@@0.12.10/dist/esm',
              'https://unpkg.com/@@ffmpeg/core@@0.12.10/dist/esm'
            ];
            const failures = [];
            const classWorkerBaseCandidates = [
              'https://cdn.jsdelivr.net/npm/@@ffmpeg/ffmpeg@@0.12.15/dist/esm',
              'https://unpkg.com/@@ffmpeg/ffmpeg@@0.12.15/dist/esm'
            ];
            let classWorkerURL = null;
            for(const classWorkerBaseUrl of classWorkerBaseCandidates){
              try {
                classWorkerURL = await createFfmpegEsmWorkerUrl(classWorkerBaseUrl);
                break;
              } catch(error){
                const detail = `${classWorkerBaseUrl}: ${error?.stack || error?.message || error}`;
                failures.push(detail);
                await reportVideoSourceClientError('FFmpegClassWorkerLoadFailed', detail);
              }
            }
            if(!classWorkerURL){
              throw new Error(`Không tải được FFmpeg class worker. ${failures.join(' | ')}`);
            }

            for(const coreBaseUrl of coreCandidates){
              try {
                await browserFfmpeg.load({
                  classWorkerURL,
                  coreURL: await createBrowserBlobUrl(`${coreBaseUrl}/ffmpeg-core.js`, 'text/javascript'),
                  wasmURL: await createBrowserBlobUrl(`${coreBaseUrl}/ffmpeg-core.wasm`, 'application/wasm')
                });
                browserFfmpegLoaded = true;
                return browserFfmpeg;
              } catch(error){
                const detail = `${coreBaseUrl}: ${error?.stack || error?.message || error}`;
                failures.push(detail);
                await reportVideoSourceClientError('FFmpegCoreLoadFailed', detail);
                browserFfmpeg = new FFmpeg();
              }
            }
            throw new Error(`Không tải được FFmpeg WebAssembly. Chi tiết đã ghi vào log server. ${failures.join(' | ')}`);
          }

          async function sha256Hex(blob){
            const hash = await crypto.subtle.digest('SHA-256', await blob.arrayBuffer());
            return Array.from(new Uint8Array(hash), value => value.toString(16).padStart(2, '0')).join('');
          }

          function delay(milliseconds){
            return new Promise(resolve => setTimeout(resolve, milliseconds));
          }

          async function waitForBrowserHlsResume(){
            while(browserHlsUploadPaused) await delay(250);
          }

          async function uploadBrowserGeneratedHls(playlist, segments, payload, antiForgeryToken, sourceId, oldStreamUrl){
            const chunkSize = 8 * 1024 * 1024;
            const uploadId = crypto.randomUUID();
            const files = [playlist, ...segments].map(file => ({
              file,
              fileId: crypto.randomUUID(),
              totalChunks: Math.ceil(file.size / chunkSize)
            }));
            const totalBytes = files.reduce((sum, item) => sum + item.file.size, 0);
            let uploadedBytes = 0;
            const tasks = [];
            files.forEach(item => {
              for(let chunkIndex = 0; chunkIndex < item.totalChunks; chunkIndex++){
                const start = chunkIndex * chunkSize;
                const end = Math.min(start + chunkSize, item.file.size);
                tasks.push({ item, chunkIndex, start, end });
              }
            });

            browserHlsUploadActive = true;
            browserHlsUploadPaused = false;
            $('#btnResumeUpload').removeClass('d-none').prop('disabled', false)
              .html('<i class="bi bi-pause-fill me-1"></i>Tạm dừng');

            let nextTask = 0;
            const uploadTask = async task => {
              await waitForBrowserHlsResume();
              const chunk = task.item.file.slice(task.start, task.end);
              const checksum = await sha256Hex(chunk);
              const createFormData = () => {
                const formData = new FormData();
                formData.append('Chunk', chunk, `${task.item.file.name}.part`);
                formData.append('fileName', task.item.file.name);
                formData.append('fileSize', String(task.item.file.size));
                formData.append('totalChunks', String(task.item.totalChunks));
                formData.append('checksum', checksum);
                return formData;
              };

              let lastError;
              for(let attempt = 0; attempt < 4; attempt++){
                try {
                  await $.ajax({
                    url: `${urls.uploadBrowserHlsChunk}?uploadId=${encodeURIComponent(uploadId)}&fileId=${encodeURIComponent(task.item.fileId)}&chunkIndex=${task.chunkIndex}`,
                    type: 'PUT',
                    data: createFormData(),
                    processData: false,
                    contentType: false,
                    headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {}
                  });
                  uploadedBytes += chunk.size;
                  const uploadPercent = Math.min(100, Math.round(uploadedBytes * 100 / totalBytes));
                  const totalPercent = 65 + Math.round(uploadPercent * 0.34);
                  showUploadProgress('Đang upload HLS theo từng phần', `Upload ${uploadPercent}% • mỗi request tối đa 8 MiB • ${segments.length} segments`, totalPercent);
                  $('#btnSave').html(`<span class="spinner-border spinner-border-sm me-2"></span>Upload ${uploadPercent}%`);
                  return;
                } catch(error){
                  lastError = error;
                  if(attempt < 3) await delay(1000 * (2 ** attempt));
                }
              }
              throw lastError;
            };

            const worker = async () => {
              while(true){
                const taskIndex = nextTask++;
                if(taskIndex >= tasks.length) return;
                await uploadTask(tasks[taskIndex]);
              }
            };

            try {
              await Promise.all(Array.from({ length: Math.min(3, tasks.length) }, worker));
              const completePayload = {
                ...payload,
                sourceId,
                oldStreamUrl,
                playlistFileId: files[0].fileId,
                files: files.map(item => ({
                  fileId: item.fileId,
                  fileName: item.file.name,
                  fileSize: item.file.size,
                  totalChunks: item.totalChunks
                }))
              };
              await $.ajax({
                url: `${urls.completeBrowserHlsUpload}?uploadId=${encodeURIComponent(uploadId)}`,
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {},
                data: JSON.stringify(completePayload)
              });
              while(true){
                await delay(2000);
                const response = await fetch(`${urls.getBrowserHlsCompletionStatus}?uploadId=${encodeURIComponent(uploadId)}`, {
                  method: 'GET',
                  credentials: 'same-origin'
                });
                const result = await response.json();
                if(response.status === 202) continue;
                if(!response.ok) throw new Error(result?.message || 'Không thể hoàn tất HLS.');
                return result;
              }
            } catch(error){
              if(error?.status !== 409){ try {
                await $.ajax({
                  url: `${urls.cancelBrowserHlsUpload}?uploadId=${encodeURIComponent(uploadId)}`,
                  type: 'POST',
                  headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {}
                });
              } catch { } }
              throw error;
            } finally {
              browserHlsUploadActive = false;
              browserHlsUploadPaused = false;
              $('#btnResumeUpload').addClass('d-none').prop('disabled', true);
            }
          }

          async function uploadMp4AsHlsInBrowser(file, payload, antiForgeryToken, sourceId=null, oldStreamUrl=null){
            const $button = $('#btnSave');
            $button.prop('disabled', true);
            showLoading();

            const jobId = crypto.randomUUID().replaceAll('-', '');
            const inputName = `input-${jobId}.mp4`;
            const playlistName = `index-${jobId}.m3u8`;
            const segmentPrefix = `segment-${jobId}-`;
            const createdFiles = [];

            try {
              const ffmpeg = await ensureBrowserFfmpeg();
              showUploadProgress(
                'Đang đọc MP4 trên máy của bạn',
                `${(file.size / (1024 * 1024)).toFixed(1)} MiB • dữ liệu chưa được gửi lên server`,
                1,
                true);
              await ffmpeg.writeFile(inputName, await readLocalFile(file));
              createdFiles.push(inputName);

              const exitCode = await ffmpeg.exec([
                '-i', inputName,
                '-map', '0:v:0', '-map', '0:a?',
                '-c', 'copy',
                '-f', 'hls',
                '-hls_time', '6',
                '-hls_playlist_type', 'vod',
                '-hls_list_size', '0',
                '-hls_segment_filename', `${segmentPrefix}%05d.ts`,
                playlistName
              ]);
              if(exitCode !== 0) throw new Error(`FFmpeg WebAssembly kết thúc với mã lỗi ${exitCode}.`);

              const entries = await ffmpeg.listDir('/');
              const segmentNames = entries
                .filter(entry => !entry.isDir && entry.name.startsWith(segmentPrefix) && entry.name.endsWith('.ts'))
                .map(entry => entry.name)
                .sort((a, b) => a.localeCompare(b));
              if(segmentNames.length === 0) throw new Error('Trình duyệt không tạo được HLS segment. Video có thể dùng codec không tương thích.');

              const playlistData = await ffmpeg.readFile(playlistName);
              createdFiles.push(playlistName, ...segmentNames);
              const playlist = new File([playlistData.buffer], 'index.m3u8', { type: 'application/vnd.apple.mpegurl' });
              const segments = [];
              for(const segmentName of segmentNames){
                const data = await ffmpeg.readFile(segmentName);
                segments.push(new File([data.buffer], segmentName, { type: 'video/mp2t' }));
              }

              const result = await uploadBrowserGeneratedHls(
                playlist,
                segments,
                payload,
                antiForgeryToken,
                sourceId,
                oldStreamUrl);
              const ok = result && (result.success === true || result.Success === true || String(result.code ?? result.Code) === '200');
              if(!ok) throw new Error(result?.message || result?.Message || 'Server không lưu được bộ HLS.');

              showUploadProgress('Hoàn tất', `Đã tạo và upload ${segments.length} HLS segments.`, 100);
              loadAll();
              closeSourceAndShowUploadResult(
                true,
                'Upload thành công',
                sourceId
                  ? 'Đã chuyển HLS trên máy người dùng và thay nguồn video thành công.'
                  : 'Đã chuyển MP4 sang HLS trên máy người dùng và lưu nguồn video thành công.');
            } catch(xhr) {
              const message = xhr?.responseJSON?.message || xhr?.responseText || xhr?.message || 'Không thể tạo hoặc upload HLS trên trình duyệt.';
              await reportVideoSourceClientError('BrowserHlsProcessingFailed', xhr?.stack || message);
              showToast(message, false, 9000);
              showUploadResultPopup(false, 'Xử lý HLS thất bại', message);
            } finally {
              if(browserFfmpeg){
                for(const fileName of [...new Set(createdFiles)]){
                  try { await browserFfmpeg.deleteFile(fileName); } catch { }
                }
              }
              hideLoading();
              $button.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Lưu');
            }
          }

          // Luồng cũ được giữ lại để tương thích các phiên upload server đã tồn tại.
          async function uploadMp4AsHls(file, payload, antiForgeryToken, sourceId=null, oldStreamUrl=null){
            const chunkSize = 8 * 1024 * 1024;
            const totalChunks = Math.ceil(file.size / chunkSize);
            const $button = $('#btnSave');
            $button.prop('disabled', true);
            let uploadId = null;
            let sessionKey = null;
            let uploadedChunks = new Set();
            let stopProgressPolling = false;
            let progressPollTask = null;
            let completionStarted = false;
            let getStatus = null;

            try {
              const fileFingerprint = await createMp4Fingerprint(file);
              sessionKey = `tflix:mp4-upload:${fileFingerprint}`;
              uploadId = localStorage.getItem(sessionKey) || crypto.randomUUID();
              localStorage.setItem(sessionKey, uploadId);

              getStatus = async currentUploadId => $.ajax({
                url: `${urls.mp4UploadStatus}?uploadId=${encodeURIComponent(currentUploadId)}&fileFingerprint=${encodeURIComponent(fileFingerprint)}`,
                type: 'GET'
              });

              let uploadStatus;
              try {
                uploadStatus = await getStatus(uploadId);
              } catch (xhr){
                if (xhr?.status !== 409) throw xhr;
                await cancelAndCleanupServerUpload(uploadId, antiForgeryToken, sessionKey);
                uploadId = crypto.randomUUID();
                localStorage.setItem(sessionKey, uploadId);
                uploadStatus = await getStatus(uploadId);
              }

              if (uploadStatus.resumeAvailable || uploadStatus.ResumeAvailable){
                const savedTotal = uploadStatus.totalChunks ?? uploadStatus.TotalChunks;
                if (savedTotal !== totalChunks){
                  await cancelAndCleanupServerUpload(uploadId, antiForgeryToken, sessionKey);
                  uploadId = crypto.randomUUID();
                  localStorage.setItem(sessionKey, uploadId);
                  uploadStatus = await getStatus(uploadId);
                } else {
                  const savedChunks = uploadStatus.uploadedChunks ?? uploadStatus.UploadedChunks ?? [];
                  if (savedChunks.length > 0 && savedChunks.length < totalChunks){
                    uploadedChunks = new Set(savedChunks);
                    showToast(`Đang tiếp tục phiên cũ từ ${savedChunks.length}/${totalChunks} phần.`, true, 5000);
                  } else if (savedChunks.length >= totalChunks){
                    uploadedChunks = new Set(savedChunks);
                  }
                }
              }

              const updateChunkProgress = () => {
                const sentBytes = Array.from(uploadedChunks).reduce((total, chunkIndex) =>
                  total + Math.max(0, Math.min(chunkSize, file.size - chunkIndex * chunkSize)), 0);
                const stagePercent = totalChunks === 0 ? 0 : Math.floor(uploadedChunks.size * 100 / totalChunks);
                const percent = Math.floor(stagePercent * 0.30);
                showUploadProgress(
                  'Đang upload qua API',
                  `API ${stagePercent}% • tổng ${percent}% • còn lại ${100 - percent}% • ${uploadedChunks.size}/${totalChunks} phần (${(sentBytes / (1024 * 1024)).toFixed(1)} / ${(file.size / (1024 * 1024)).toFixed(1)} MiB)`,
                  percent);
                $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Tổng ${percent}% (còn ${100 - percent}%)`);
              };

              updateChunkProgress();
              for (let chunkIndex = 0; chunkIndex < totalChunks; chunkIndex++){
                if (uploadedChunks.has(chunkIndex)) continue;

                const start = chunkIndex * chunkSize;
                const chunk = file.slice(start, Math.min(start + chunkSize, file.size));
                const formData = new FormData();
                formData.append('Chunk', chunk, file.name + '.part');
                formData.append('fileFingerprint', fileFingerprint);

                const chunkUrl = `${urls.uploadMp4Chunk}?uploadId=${encodeURIComponent(uploadId)}&chunkIndex=${chunkIndex}&totalChunks=${totalChunks}`;
                await $.ajax({
                  url: chunkUrl,
                  type: 'POST',
                  data: formData,
                  processData: false,
                  contentType: false,
                  headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {}
                });

                uploadedChunks.add(chunkIndex);
                updateChunkProgress();
              }

              showUploadProgress('Đang xử lý HLS', 'Đang ghép MP4 và tạo playlist/segments.', 0, true);
              $button.html('<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo HLS...');
              progressPollTask = (async () => {
                while (!stopProgressPolling){
                  try {
                    const status = await getStatus(uploadId);
                    const progress = status.progress ?? status.Progress ?? {};
                    const stage = progress.stage ?? progress.Stage ?? '';
                    const message = progress.message ?? progress.Message ?? '';
                    const segmentsUploaded = progress.segmentsUploaded ?? progress.SegmentsUploaded ?? 0;
                    const totalSegments = progress.totalSegments ?? progress.TotalSegments ?? 0;
                    const percent = progress.percent ?? progress.Percent ?? 0;
                    const stagePercent = progress.stagePercent ?? progress.StagePercent ?? 0;
                    const storagePercent = progress.storagePercent ?? progress.StoragePercent ?? 0;
                    const remainingPercent = progress.remainingPercent ?? progress.RemainingPercent ?? Math.max(0, 100 - percent);
                    const bytesUploaded = progress.bytesUploaded ?? progress.BytesUploaded ?? 0;
                    const totalBytes = progress.totalBytes ?? progress.TotalBytes ?? 0;
                    const uploadedMiB = (bytesUploaded / (1024 * 1024)).toFixed(1);
                    const totalMiB = (totalBytes / (1024 * 1024)).toFixed(1);

                    if (stage === 'uploading-segments' && totalSegments > 0){
                      showUploadProgress(
                        'Đang upload HLS segments',
                        `Storage ${storagePercent}% • tổng ${percent}% • còn lại ${remainingPercent}% • ${segmentsUploaded}/${totalSegments} segments (${uploadedMiB}/${totalMiB} MiB)`,
                        percent);
                      $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Storage ${storagePercent}% • tổng ${percent}%`);
                    } else if (stage === 'saving'){
                      showUploadProgress('Đang lưu nguồn HLS', message || `Đã tải đủ ${segmentsUploaded}/${totalSegments} segments`, percent, true);
                      $button.html('<span class="spinner-border spinner-border-sm me-2"></span>Đang lưu nguồn HLS...');
                    } else if (stage === 'packaging'){
                      showUploadProgress('Đang tạo HLS', `${message || 'FFmpeg đang đóng gói video'} • tổng ${percent}% • còn lại ${remainingPercent}%`, percent);
                      $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Tạo HLS ${stagePercent}% • tổng ${percent}%`);
                    } else if (stage === 'assembling'){
                      showUploadProgress('Đang ghép MP4', `${message || 'Đang ghép các phần MP4'} • tổng ${percent}% • còn lại ${remainingPercent}%`, percent, true);
                    }
                  } catch {
                    // Keep polling through brief network interruptions.
                  }
                  await new Promise(resolve => setTimeout(resolve, 1000));
                }
              })();

              const completeUrl = `${urls.completeMp4Upload}?uploadId=${encodeURIComponent(uploadId)}`;
              const completePayload = { ...payload, FileName: file.name, TotalChunks: totalChunks };
              if (sourceId) completePayload.SourceId = sourceId;
              if (oldStreamUrl) completePayload.OldStreamUrl = oldStreamUrl;
              completionStarted = true;
              const result = await $.ajax({
                url: completeUrl,
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(completePayload),
                timeout: 0,
                headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {}
              });

              const ok = result && (result.success === true || result.code === '200' || result.Success === true);
              if (!ok){
                throw new Error(result?.message || result?.Message || 'Chuyển MP4 sang HLS thất bại.');
              }

              localStorage.removeItem(sessionKey);
              const segmentsCount = result.segmentsCount ?? result.SegmentsCount ?? result.data?.segmentsCount ?? result.Data?.segmentsCount ?? result.data?.SegmentsCount ?? result.Data?.SegmentsCount ?? 0;
              showUploadProgress('Hoàn tất', `Đã upload ${segmentsCount} HLS segments`, 100);
              const successMessage = sourceId
                ? 'Đã thay nguồn bằng HLS mới và lưu thành công.'
                : 'Đã upload MP4, chuyển đổi HLS và lưu nguồn video thành công.';
              loadAll();
              closeSourceAndShowUploadResult(true, 'Upload thành công', successMessage);
            } catch (xhr){
              const detail = xhr?.responseJSON?.message || xhr?.responseText || xhr?.message || 'Mạng bị ngắt hoặc server gặp lỗi.';
              const sessionExpired = xhr?.status === 401 || xhr?.status === 403;
              if (completionStarted && !sessionExpired && uploadId){
                stopProgressPolling = true;
                if (progressPollTask) await progressPollTask;
                progressPollTask = null;

                showUploadProgress(
                  'Server đang hoàn tất HLS',
                  'Kết nối qua Cloudflare đã hết thời gian chờ. Đang kiểm tra kết quả từ server...',
                  95,
                  true);

                let finalProgress = null;
                for (let attempt = 0; attempt < 300; attempt++){
                  try {
                    const status = await getStatus(uploadId);
                    const progress = status.progress ?? status.Progress ?? {};
                    const stage = String(progress.stage ?? progress.Stage ?? '').toLowerCase();
                    if (stage === 'complete'){
                      finalProgress = { complete: true };
                      break;
                    }
                    if (stage === 'failed'){
                      finalProgress = {
                        complete: false,
                        failed: true,
                        message: progress.message ?? progress.Message
                      };
                      break;
                    }
                  } catch {
                    // Keep checking through temporary Cloudflare/network interruptions.
                  }
                  await new Promise(resolve => setTimeout(resolve, 2000));
                }

                if (finalProgress?.complete){
                  if (sessionKey) localStorage.removeItem(sessionKey);
                  showUploadProgress('Hoàn tất', 'Server đã chuyển đổi và lưu HLS thành công.', 100);
                  loadAll();
                  closeSourceAndShowUploadResult(
                    true,
                    'Upload thành công',
                    sourceId
                      ? 'Đã thay nguồn bằng HLS mới và lưu thành công.'
                      : 'Đã upload MP4, chuyển đổi HLS và lưu nguồn video thành công.');
                  return;
                }

                if (finalProgress?.failed){
                  if (sessionKey) localStorage.removeItem(sessionKey);
                  const serverMessage = finalProgress.message || 'Server không thể hoàn tất quá trình chuyển đổi HLS.';
                  showToast(serverMessage, false, 8000);
                  showUploadResultPopup(false, 'Xử lý HLS thất bại', serverMessage);
                  return;
                }

                showToast('Server vẫn đang xử lý HLS. Không hủy phiên để tránh xóa video đã upload.', false, 9000);
                showUploadResultPopup(
                  false,
                  'HLS vẫn đang được xử lý',
                  'Cloudflare đã hết thời gian chờ nhưng server chưa báo lỗi. Tài nguyên được giữ nguyên; vui lòng tải lại danh sách sau ít phút.');
                return;
              }
              const canResume = xhr?.status === 0 && uploadId && uploadedChunks.size > 0 && uploadedChunks.size < totalChunks;
              let cleanupMessage = canResume
                ? `Đã giữ ${uploadedChunks.size}/${totalChunks} phần trên server. Chọn lại đúng file để Resume.`
                : 'Toàn bộ file tạm và các phần đã upload đã được xóa.';
              if (uploadId && !canResume){
                try {
                  await cancelAndCleanupServerUpload(uploadId, antiForgeryToken, sessionKey);
                } catch {
                  cleanupMessage = 'Không thể xác nhận việc dọn dẹp do kết nối mạng đang gián đoạn. Server sẽ tự dọn dữ liệu khi nhận được lỗi hoặc khi phiên upload hết hạn.';
                }
              }
              if (sessionExpired){
                if (sessionKey) localStorage.removeItem(sessionKey);
                showToast('Phiên đăng nhập Admin đã hết hạn. Dữ liệu upload đang được dọn dẹp.', false, 4000);
                window.location.href = `/Admin/Auth?returnUrl=${encodeURIComponent('/Admin/VideoSoure')}`;
                return;
              }
              showToast(detail, false, 8000);
              showUploadResultPopup(false, canResume ? 'Upload bị gián đoạn' : 'Upload thất bại', `${detail} ${cleanupMessage}`);
            } finally {
              stopProgressPolling = true;
              if (progressPollTask) await progressPollTask;
              hideLoading();
              $button.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Lưu');
            }
          }

          function uploadHlsForUpdate(playlist, segments, payload, antiForgeryToken, sourceId, oldStreamUrl){
            const formData = new FormData();
            formData.append('Playlist', playlist);
            segments.forEach(segment => formData.append('Segments', segment));
            formData.append('SourceId', String(sourceId));
            if (oldStreamUrl) formData.append('OldStreamUrl', oldStreamUrl);
            Object.entries(payload).forEach(([key, value]) => {
              if (value !== null && value !== undefined && value !== '')
                formData.append(key, String(value));
            });

            const totalBytes = playlist.size + segments.reduce((total, segment) => total + segment.size, 0);
            const $button = $('#btnSave');
            $button.prop('disabled', true);
            showUploadProgress('Đang tải HLS', 'Đang gửi playlist và segments...', 0);

            $.ajax({
              url: urls.addHls,
              type: 'POST',
              data: formData,
              processData: false,
              contentType: false,
              headers: antiForgeryToken ? { 'RequestVerificationToken': antiForgeryToken } : {},
              xhr(){
                const xhr = $.ajaxSettings.xhr();
                if (xhr.upload){
                  xhr.upload.addEventListener('progress', event => {
                    if (!event.lengthComputable) return;
                    const percent = Math.round(event.loaded * 100 / event.total);
                    if (percent >= 100){
                      showUploadProgress('Đang lưu HLS', 'Đã nhận file; đang tải playlist và segments lên storage.', 100, true);
                    } else {
                      showUploadProgress(
                        'Đang tải HLS',
                        `${(event.loaded / (1024 * 1024)).toFixed(1)} / ${(totalBytes / (1024 * 1024)).toFixed(1)} MiB`,
                        percent);
                    }
                    $button.html(`<span class="spinner-border spinner-border-sm me-2"></span>Đang tải ${percent}%`);
                  });
                }
                return xhr;
              },
              success(response){
                const ok = response && (response.success === true || response.Success === true || response.code === '200');
                if (!ok){
                  const message = response?.message || response?.Message || 'Cập nhật HLS thất bại.';
                  showToast(message, false, 6000);
                  showUploadResultPopup(false, 'Upload thất bại', `${message} Các phần upload chưa hoàn tất đã được server thu hồi.`);
                  return;
                }
                showUploadProgress('Hoàn tất', 'Đã thay playlist và HLS segments.', 100);
                loadAll();
                closeSourceAndShowUploadResult(true, 'Upload thành công', 'Đã cập nhật playlist và toàn bộ HLS segments thành công.');
              },
              error(xhr){
                const message = xhr?.responseJSON?.message || xhr?.responseText || 'Lỗi upload HLS.';
                showToast(message, false, 9000);
                showUploadResultPopup(false, 'Upload thất bại', `${message} Các phần upload chưa hoàn tất đã được server thu hồi.`);
              },
              complete(){
                hideLoading();
                $button.prop('disabled', false).html('<i class="bi bi-save me-1"></i>Lưu');
              }
            });
          }

          function subtitleRequestError(xhr, fallback){
            return xhr?.responseJSON?.message || xhr?.responseJSON?.Message || xhr?.responseText || fallback;
          }

          async function getFreshSubtitleRequestToken(){
            const response = await fetch(urls.subtitleRequestToken, {
              method: 'GET', credentials: 'same-origin', cache: 'no-store'
            });
            if(!response.ok) throw new Error('Phiên đăng nhập Admin đã hết hạn. Vui lòng đăng nhập lại.');
            const data = await response.json();
            if(!data?.requestToken) throw new Error('Không tạo được mã bảo vệ cho yêu cầu phụ đề.');
            return data.requestToken;
          }

          function resolveHlsUri(value, baseUrl){
            return new URL(value.trim().replace(/^['"]|['"]$/g, ''), baseUrl).toString();
          }

          function subtitleHlsProxyUrl(sourceId, fileUrl){
            return `${urls.proxySubtitleHls}?sourceId=${encodeURIComponent(sourceId)}&url=${encodeURIComponent(fileUrl)}`;
          }

          async function fetchHlsResource(url, sourceId){
            const response = await fetch(subtitleHlsProxyUrl(sourceId, url), { credentials: 'same-origin' });
            if(!response.ok) throw new Error(`Không tải được HLS (${response.status}): ${url}`);
            return response;
          }

          async function fetchHlsText(url, sourceId){
            const response = await fetchHlsResource(url, sourceId);
            return await response.text();
          }

          async function readHlsMediaPlaylist(streamUrl, sourceId){
            let playlistUrl = streamUrl;
            let text = await fetchHlsText(playlistUrl, sourceId);
            if(!text.trimStart().startsWith('#EXTM3U')) throw new Error('Nguồn đã lưu không phải playlist HLS hợp lệ.');
            if(text.includes('#EXT-X-STREAM-INF')){
              const lines = text.split(/\r?\n/);
              const variants = [];
              for(let index=0; index<lines.length; index++){
                if(!lines[index].startsWith('#EXT-X-STREAM-INF')) continue;
                const bandwidth = Number(lines[index].match(/BANDWIDTH=(\d+)/)?.[1] || 0);
                const uri = lines.slice(index + 1).find(line => line.trim() && !line.trim().startsWith('#'));
                if(uri) variants.push({ bandwidth, url: resolveHlsUri(uri, playlistUrl) });
              }
              if(!variants.length) throw new Error('Master playlist không có rendition hợp lệ.');
              variants.sort((a,b) => b.bandwidth - a.bandwidth);
              playlistUrl = variants[0].url;
              text = await fetchHlsText(playlistUrl, sourceId);
            }
            if(text.includes('#EXT-X-KEY') && !text.includes('METHOD=NONE'))
              throw new Error('Playlist HLS đang mã hóa. Trình duyệt chưa thể trích âm thanh từ nguồn này.');

            const lines = text.split(/\r?\n/);
            const mapMatch = text.match(/#EXT-X-MAP:.*URI="([^"]+)"/);
            const mapUrl = mapMatch ? resolveHlsUri(mapMatch[1], playlistUrl) : null;
            const segments = [];
            let pendingDuration = 0;
            for(const rawLine of lines){
              const line = rawLine.trim();
              if(line.startsWith('#EXTINF:')) pendingDuration = Number.parseFloat(line.slice(8)) || 0;
              else if(line && !line.startsWith('#') && pendingDuration > 0){
                segments.push({ url: resolveHlsUri(line, playlistUrl), duration: pendingDuration });
                pendingDuration = 0;
              }
            }
            if(!segments.length) throw new Error('Media playlist không có segment âm thanh/video.');
            const chunks = [];
            let offset = 0, current = [], duration = 0;
            for(const segment of segments){
              if(current.length && duration + segment.duration > 180){
                chunks.push({ offset, duration, segments: current, mapUrl, sourceId });
                offset += duration; current = []; duration = 0;
              }
              current.push(segment); duration += segment.duration;
            }
            if(current.length) chunks.push({ offset, duration, segments: current, mapUrl, sourceId });
            return chunks;
          }

          async function downloadSubtitleChunkBytes(chunk){
            const urlsToFetch = [...(chunk.mapUrl ? [chunk.mapUrl] : []), ...chunk.segments.map(item => item.url)];
            const parts = [];
            let total = 0;
            for(const url of urlsToFetch){
              const response = await fetchHlsResource(url, chunk.sourceId);
              const bytes = new Uint8Array(await response.arrayBuffer());
              parts.push(bytes); total += bytes.length;
            }
            const combined = new Uint8Array(total);
            let position = 0;
            for(const part of parts){ combined.set(part, position); position += part.length; }
            return combined;
          }

          async function extractSubtitleAudio(ffmpeg, chunk, chunkIndex){
            const inputName = `subtitle-input-${chunkIndex}.${chunk.mapUrl ? 'mp4' : 'ts'}`;
            const outputName = `subtitle-audio-${chunkIndex}.mp3`;
            try {
              await ffmpeg.writeFile(inputName, await downloadSubtitleChunkBytes(chunk));
              const exitCode = await ffmpeg.exec(['-i', inputName, '-vn', '-ac', '1', '-ar', '16000', '-b:a', '32k', '-f', 'mp3', outputName]);
              if(exitCode !== 0) throw new Error(`FFmpeg không thể trích âm thanh (mã ${exitCode}).`);
              const audio = await ffmpeg.readFile(outputName);
              return new File([audio.buffer], outputName, { type: 'audio/mpeg' });
            } finally {
              try { await ffmpeg.deleteFile(inputName); } catch {}
              try { await ffmpeg.deleteFile(outputName); } catch {}
            }
          }

          async function generateVietnameseSubtitleInBrowser(sourceId, forceRegenerate=false){
            const streamUrl = ($('#StreamUrl').val() || '').trim();
            if(!sourceId || !streamUrl.toLowerCase().includes('.m3u8')){
              throw new Error('Cần lưu một Stream URL HLS (.m3u8) trước khi tạo phụ đề.');
            }
            let anti = await getFreshSubtitleRequestToken();
            updateInlineUploadProgress('Đang đọc HLS', 'Đang tải playlist và chia video thành các đoạn khoảng 3 phút...', 2, true);
            updateSubtitleProgress('Đang đọc playlist HLS...', 2);
            const chunks = await readHlsMediaPlaylist(streamUrl, sourceId);
            updateSubtitleProgress(`Đã chia video thành ${chunks.length} đoạn. Đang khởi tạo tác vụ...`, 4);
            const job = await $.ajax({
              url: urls.startSubtitleJob, type: 'POST', contentType: 'application/json',
              data: JSON.stringify({ sourceId, totalChunks: chunks.length, forceRegenerate }),
              headers: anti ? { 'RequestVerificationToken': anti } : {}
            });
            const jobId = job.jobId || job.JobId;
            const completed = new Set(job.completedChunks || job.CompletedChunks || []);
            if(completed.size) updateSubtitleProgress(`Tiếp tục tác vụ: đã hoàn thành ${completed.size}/${chunks.length} đoạn.`, Math.round((completed.size / chunks.length) * 90));
            const ffmpeg = await ensureBrowserFfmpeg();
            for(let index=0; index<chunks.length; index++){
              if(completed.has(index)) continue;
              const percent = Math.max(3, Math.round((index / chunks.length) * 90));
              updateInlineUploadProgress('Đang tạo phụ đề Tiếng Việt', `Đoạn ${index + 1}/${chunks.length}: tách âm thanh trong trình duyệt...`, percent, true);
              updateSubtitleProgress(`Đoạn ${index + 1}/${chunks.length}: đang tách âm thanh...`, percent);
              const audio = await extractSubtitleAudio(ffmpeg, chunks[index], index);
              const form = new FormData();
              form.append('audio', audio);
              form.append('offsetSeconds', String(chunks[index].offset));
              form.append('durationSeconds', String(chunks[index].duration));
              anti = await getFreshSubtitleRequestToken();
              await $.ajax({
                url: `${urls.uploadSubtitleChunk}?jobId=${encodeURIComponent(jobId)}&chunkIndex=${index}`,
                type: 'POST', data: form, processData: false, contentType: false,
                headers: anti ? { 'RequestVerificationToken': anti } : {}
              });
              updateInlineUploadProgress('Đang tạo phụ đề Tiếng Việt', `Gemini đã xử lý đoạn ${index + 1}/${chunks.length}.`, Math.round(((index + 1) / chunks.length) * 90), true);
              updateSubtitleProgress(`Gemini đã xử lý đoạn ${index + 1}/${chunks.length}.`, Math.round(((index + 1) / chunks.length) * 90));
            }
            updateSubtitleProgress('Đang ghép WebVTT và lưu phụ đề...', 95);
            anti = await getFreshSubtitleRequestToken();
            const result = await $.ajax({
              url: `${urls.completeSubtitleJob}?jobId=${encodeURIComponent(jobId)}`, type: 'POST',
              headers: anti ? { 'RequestVerificationToken': anti } : {}
            });
            updateInlineUploadProgress('Hoàn tất', result.message || result.Message || 'Đã tạo thành công phụ đề Tiếng Việt và Tiếng Anh.', 100, false);
            updateSubtitleProgress(result.message || result.Message || 'Đã tạo thành công phụ đề Tiếng Việt và Tiếng Anh.', 100, false);
            return result;
          }

          function responseSourceId(response, fallback){
            const data = response?.data || response?.Data || response;
            return Number(data?.sourceId || data?.SourceId || data?.id || data?.Id || fallback || 0);
          }

          function autoGenerateSubtitleAfterSave(response, fallbackId){
            if(!$('#AutoGenerateVietnameseSubtitle').is(':checked')) return;
            const sourceId = responseSourceId(response, fallbackId);
            if(!sourceId){ showToast('Đã lưu nguồn nhưng không đọc được SourceId để tạo phụ đề.', false); return; }
            generateVietnameseSubtitleInBrowser(sourceId).then(async result => {
              await showSubtitleDraft(result.jobId || result.JobId);
              subtitleConfirmModal.show();
              showToast('Đã tạo bản nháp. Vui lòng kiểm tra và nhấn Duyệt phụ đề.', true, 6000);
            }).catch(error => {
              const message = error?.responseJSON?.message || error?.message || 'Không thể tạo phụ đề.';
              updateInlineUploadProgress('Tạo phụ đề thất bại', message, 0, false);
              showUploadResultPopup(false, 'Tạo phụ đề thất bại', message);
            });
          }

          // ===== Save (Add/Update) =====
          function save(){
            const anti = $('input[name="__RequestVerificationToken"]').val();
            const id = ($('#SourceId').val()||'').trim();
            const isEdit = !!id;

            const type      = $('#SourceType').val();
            const movieId   = $('#MovieId').val();
            const episodeId = $('#EpisodeId').val();

            const payload = {
              Provider:     ($('#Provider').val()||'').trim(),
              ServerName:   ($('#ServerName').val()||'').trim() || null,
              StreamUrl:    ($('#StreamUrl').val()||'').trim() || '',
              Quality:      ($('#Quality').val()||'').trim() || null,
              Format:       ($('#Format').val()||'').trim() || null,
              DrmType:      ($('#DrmType').val()||'').trim() || null,
              DrmLicenseUrl:($('#DrmLicenseUrl').val()||'').trim() || null,
              IsPrimary:    ($('#IsPrimary').val()==='true'),
              Status:       ($('#Status').val()||'ACTIVE').trim()
            };

            if (type==='movie'){
              if (!movieId){ showToast("Vui lòng chọn Movie.", false); return; }
              payload.MovieId = Number(movieId);
              payload.EpisodeId = null;
            } else {
              if (!episodeId){ showToast("Vui lòng chọn Episode.", false); return; }
              payload.MovieId = null;
              payload.EpisodeId = Number(episodeId);
            }

            if (!payload.Provider){ showToast("Provider là bắt buộc.", false); return; }

            if (!isEdit){
              // ADD
              const fd = new FormData();
              const inputMode = $('input[name="InputMode"]:checked').val();
              const fileObj = document.getElementById('File').files?.[0] || null;
              let addUrl = urls.add;

              if (inputMode === 'file'){
                if (!fileObj){
                  showToast('Vui lòng chọn file MP4.', false);
                  return;
                }
                uploadMp4AsHls(fileObj, payload, anti);
                return;
              }

              if (inputMode === 'hls'){
                const playlist = document.getElementById('HlsPlaylist').files?.[0] || null;
                const segments = Array.from(document.getElementById('HlsSegments').files || []);
                if (!playlist || segments.length === 0){
                  showToast("HLS cần playlist và ít nhất một segment.", false);
                  return;
                }
                addUrl = urls.addHls;
                fd.append('Playlist', playlist);
                segments.forEach(segment => fd.append('Segments', segment));
              } else if (inputMode === 'url'){
                if (!payload.StreamUrl){
                  showToast("Vui lòng nhập Stream URL.", false);
                  return;
                }
              } else {
                if (!fileObj){
                  showToast("Vui lòng chọn file video.", false);
                  return;
                }
                fd.append('File', fileObj);
              }

              Object.entries(payload).forEach(([k,v])=>{
                if (v === null || v === undefined || v === '') return;
                fd.append(k, String(v));
              });

              showLoading();
              $.ajax({
                url: addUrl, type: 'POST',
                data: fd, processData: false, contentType: false,
                headers: anti ? { "RequestVerificationToken": anti } : {},
                success(res){
                  const ok = res && (res.success===true || res.code==="200" || res.Success===true);
                  if (ok){
                    autoGenerateSubtitleAfterSave(res, null);
                    loadAll();
                    closeSourceAndShowUploadResult(true, 'Upload thành công', 'Nguồn video đã được upload và lưu thành công.');
                  } else {
                    const message = res?.message || res?.Message || "Thêm thất bại.";
                    showToast(message, false);
                    showUploadResultPopup(false, 'Upload thất bại', message);
                  }
                },
                error(xhr){
                  const message = xhr?.responseJSON?.message || xhr?.responseText || "Lỗi thêm nguồn.";
                  showToast(message, false);
                  showUploadResultPopup(false, 'Upload thất bại', message);
                },
                complete(){ hideLoading(); }
              });

            } else {
              // UPDATE existing source
              const fileObj = document.getElementById('File').files?.[0] || null;
              const inputMode = $('input[name="InputMode"]:checked').val();
              const oldStreamUrl = ($('#OldStreamUrl').val() || '').trim();

              if (inputMode === 'file'){
                if (!fileObj){ showToast('Vui lòng chọn file MP4 mới.', false); return; }
                uploadMp4AsHls(fileObj, payload, anti, Number(id), oldStreamUrl);
                return;
              }

              if (inputMode === 'hls'){
                const playlist = document.getElementById('HlsPlaylist').files?.[0] || null;
                const segments = Array.from(document.getElementById('HlsSegments').files || []);
                if (!playlist || segments.length === 0){
                  showToast('HLS cần playlist và ít nhất một segment.', false);
                  return;
                }
                uploadHlsForUpdate(playlist, segments, payload, anti, Number(id), oldStreamUrl);
                return;
              }

              // Update metadata / StreamUrl
              showLoading();
              const updateData = new FormData();
              if (fileObj) updateData.append('File', fileObj);
              Object.entries(payload).forEach(([k,v])=>{
                if (v !== null && v !== undefined && v !== '') updateData.append(`meta.${k}`, String(v));
              });
              updateData.append('sourceId', id);
              if (oldStreamUrl) updateData.append('meta.OldStreamUrl', oldStreamUrl);

              $.ajax({
                url: urls.update,
                type: 'POST',
                data: updateData,
                processData: false,
                contentType: false,
                headers: anti ? { "RequestVerificationToken": anti } : {},
                success(res){
                  const ok = res && (res.success===true || res.code==="200" || res.Success===true);
                  if (ok){
                    autoGenerateSubtitleAfterSave(res, Number(id));
                    loadAll();
                    closeSourceAndShowUploadResult(true, 'Cập nhật thành công', 'Nguồn video đã được cập nhật thành công.');
                  } else {
                    const message = res?.message || res?.Message || "Cập nhật thất bại.";
                    showToast(message, false);
                  }
                },
                error(xhr){
                  showToast(xhr?.responseJSON?.message || xhr?.responseText || "Lỗi khi cập nhật.", false);
                },
                complete(){ hideLoading(); }
              });
            }
          }

          // ===== Preview modal =====
          $tbody.on('click', '.btn-preview', function(){
            const url = $(this).data('url');
            const id  = $(this).data('id');
            const video = document.getElementById('previewPlayer');
            video.pause(); video.src = url; video.load();
            $('#previewMeta').text(`Source #${id} — ${url}`);
            previewModal.show();
            setTimeout(()=> video.play().catch(()=>{}), 200);
          });
          previewModalEl.addEventListener('hidden.bs.modal', ()=>{
            const video = document.getElementById('previewPlayer');
            video.pause(); video.removeAttribute('src'); video.load();
          });

            function toggleInputMode() {
            const mode = $('input[name="InputMode"]:checked').val();
            if (mode === 'file') {
                $('#blockFile').removeClass('d-none');
                $('#blockHls').addClass('d-none');
                $('#StreamUrl').prop('disabled', false);
            } else if (mode === 'url') {
                $('#blockFile').addClass('d-none');
                $('#blockHls').addClass('d-none');
                $('#StreamUrl').prop('disabled', false);
            } else if (mode === 'hls') {
                $('#blockFile').addClass('d-none');
                $('#blockHls').removeClass('d-none');
                $('#StreamUrl').prop('disabled', true); // HLS thì URL sẽ là m3u8 sau khi upload
            }
        }

        // gắn event change
        $('input[name="InputMode"]').on('change', toggleInputMode);

        // gọi 1 lần để set đúng state ban đầu
        toggleInputMode();


          // ===== Events =====
          $('#btnRefresh').on('click', ()=> loadAll());
          $('#btnAdd').on('click', ()=> { openAdd(); });
          $('#btnSave').on('click', save);
          $('#btnGenerateHighlight').on('click', function(){
            pendingHighlightSourceId = Number($(this).data('id'));
            if(!pendingHighlightSourceId){
              showToast('Không tìm thấy Video Source để tạo highlight.', false);
              return;
            }
            highlightConfirmModal.show();
          });
          $('#btnGenerateSubtitle').on('click', function(){
            const sourceId = Number($(this).data('id'));
            if(!sourceId){ showToast('Không tìm thấy Video Source để tạo phụ đề.', false); return; }
            resetSubtitleProgress();
            $('#btnConfirmGenerateSubtitle').data('id', sourceId);
            subtitleConfirmModal.show();
          });
          $('#btnConfirmGenerateSubtitle').on('click', function(){
            const sourceId = Number($(this).data('id'));
            const button = $('#btnGenerateSubtitle');
            if(!sourceId) return;
            $('#btnConfirmGenerateSubtitle').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang xử lý...');
            $('#btnCancelSubtitle').prop('disabled', true);
            updateSubtitleProgress('Đang chuẩn bị playlist HLS...', 1);
            button.prop('disabled',true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang tạo phụ đề...');
            generateVietnameseSubtitleInBrowser(sourceId, true)
              .then(async res=>{
                const message=res?.message||res?.Message||'Đã tạo thành công phụ đề Tiếng Việt và Tiếng Anh.';
                updateSubtitleProgress(message, 100, false);
                await showSubtitleDraft(res.jobId || res.JobId);
              })
              .catch(error=>{
                const message=error?.responseJSON?.message||error?.message||'Không tạo được phụ đề.';
                updateInlineUploadProgress('Không thể tạo phụ đề',message,0,false);
                updateSubtitleProgress(message, 0, false);
                $('#btnCancelSubtitle').prop('disabled', false).text('Đóng');
              })
              .finally(()=> {
                $('#btnConfirmGenerateSubtitle').prop('disabled', false).html('<i class="bi bi-arrow-clockwise me-1"></i>Thử lại');
                button.prop('disabled',false).html('<i class="bi bi-badge-cc me-1"></i>Tạo phụ đề Tiếng Việt và Tiếng Anh bằng Gemini');
              });
          });

          $('#subtitleCueEditor').on('click', '.subtitle-seek', function(){
            const video = document.getElementById('subtitlePreviewVideo');
            video.currentTime = Number($(this).data('time')) || 0;
            video.play().catch(()=>{});
          }).on('click', '.cue-delete', function(){
            $(this).closest('tr').remove();
          });

          $('.subtitle-preview-lang').on('click', function(){
            subtitlePreviewLanguage = $(this).data('lang');
            $('.subtitle-preview-lang').removeClass('active');
            $(this).addClass('active');
            document.getElementById('subtitlePreviewVideo')?.dispatchEvent(new Event('timeupdate'));
          });

          $('#btnSaveSubtitleDraft').on('click', async function(){
            if(!currentSubtitleDraftJobId) return;
            try {
              const anti = await getFreshSubtitleRequestToken();
              const result = await $.ajax({
                url: `${urls.updateSubtitleDraft}?jobId=${encodeURIComponent(currentSubtitleDraftJobId)}`,
                type: 'POST', contentType: 'application/json', data: JSON.stringify({ cues: collectSubtitleDraft() }),
                headers: { 'RequestVerificationToken': anti }
              });
              currentSubtitleDraft = result.cues || result.Cues || [];
              renderSubtitleDraft();
              showToast('Đã lưu chỉnh sửa. Phụ đề vẫn chưa được duyệt.', true);
            } catch(error){ showToast(error?.responseJSON?.message || error?.message || 'Không lưu được bản nháp.', false, 7000); }
          });

          $('#btnApproveSubtitle').on('click', async function(){
            if(!currentSubtitleDraftJobId) return;
            const button = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang duyệt...');
            try {
              const anti = await getFreshSubtitleRequestToken();
              await $.ajax({
                url: `${urls.updateSubtitleDraft}?jobId=${encodeURIComponent(currentSubtitleDraftJobId)}`,
                type: 'POST', contentType: 'application/json', data: JSON.stringify({ cues: collectSubtitleDraft() }),
                headers: { 'RequestVerificationToken': anti }
              });
              const approveToken = await getFreshSubtitleRequestToken();
              const result = await $.ajax({
                url: `${urls.approveSubtitle}?jobId=${encodeURIComponent(currentSubtitleDraftJobId)}`,
                type: 'POST', headers: { 'RequestVerificationToken': approveToken }
              });
              const message = result.message || result.Message || 'Đã duyệt và xuất bản phụ đề.';
              $('#subtitleApprovalStatus').removeClass('alert-warning').addClass('alert-success').text(message);
              updateSubtitleProgress(message, 100, false);
              button.addClass('d-none'); $('#btnSaveSubtitleDraft').addClass('d-none');
              showToast(message, true, 5000);
            } catch(error){ showToast(error?.responseJSON?.message || error?.message || 'Không duyệt được phụ đề.', false, 7000); }
            finally { button.prop('disabled', false).html('<i class="bi bi-check-circle me-1"></i>Duyệt phụ đề'); }
          });
          $('#btnConfirmGenerateHighlight').on('click', function(){
            const sourceId = pendingHighlightSourceId;
            const button = $('#btnGenerateHighlight');
            if(!sourceId) return;
            highlightConfirmModal.hide();
            const anti=$('input[name="__RequestVerificationToken"]').first().val();
            button.prop('disabled',true).html('<span class="spinner-border spinner-border-sm me-1"></span>Đang tạo highlight...');
            updateInlineUploadProgress('Đang chuẩn bị video', 'Đọc nguồn phát và thời lượng video...', 8, true);
            let progress = 8;
            clearInterval(highlightProgressTimer);
            highlightProgressTimer = setInterval(() => {
              progress = Math.min(92, progress + (progress < 35 ? 5 : progress < 70 ? 3 : 1));
              const detail = progress < 35
                ? 'Đang trích xuất các khung hình đại diện...'
                : progress < 60
                  ? 'Gemini đang phân tích và chọn các đoạn nổi bật...'
                  : progress < 82
                    ? 'FFmpeg đang cắt 3 video highlight...'
                    : 'Đang tải video và thumbnail lên bộ nhớ...';
              updateInlineUploadProgress('Đang tạo video highlight', detail, progress, true);
            }, 1800);
            $.ajax({url:urls.generateHighlight,type:'POST',data:{sourceId},headers:anti?{'RequestVerificationToken':anti}:{}})
              .done(res=>{
                const ok=res?.success===true||res?.Success===true||String(res?.code)==='200';
                const message=res?.message||res?.Message||(ok?'Đã tạo highlight.':'Tạo highlight thất bại.');
                updateInlineUploadProgress(ok?'Hoàn tất':'Không thể tạo highlight', message, ok?100:progress, false);
                closeSourceAndShowUploadResult(ok, ok?'Tạo highlight thành công':'Tạo highlight thất bại', message);
              })
              .fail(xhr=>{
                const message=xhr?.responseJSON?.message||'Không tạo được highlight.';
                updateInlineUploadProgress('Không thể tạo highlight', message, progress, false);
                closeSourceAndShowUploadResult(false, 'Tạo highlight thất bại', message);
              })
              .always(()=>{
                clearInterval(highlightProgressTimer);
                highlightProgressTimer=null;
                pendingHighlightSourceId=0;
                button.prop('disabled',false).html('<i class="bi bi-stars me-1"></i>Tạo 3 highlight bằng Gemini');
              });
          });
          $('#File').on('change', function(){
            const file = this.files?.[0] || null;
            resumeFileState = null;
            resetInlineUploadProgress();
            if(file){
              updateInlineUploadProgress(
                'Sẵn sàng xử lý trên máy người dùng',
                `${file.name} · ${(file.size / (1024 * 1024)).toFixed(1)} MiB · nhấn Lưu để tạo HLS`,
                0);
            }
          });
          $('#btnResumeUpload').on('click', function(){
            if(browserHlsUploadActive){
              browserHlsUploadPaused = !browserHlsUploadPaused;
              $(this).html(browserHlsUploadPaused
                ? '<i class="bi bi-play-fill me-1"></i>Tiếp tục'
                : '<i class="bi bi-pause-fill me-1"></i>Tạm dừng');
              updateInlineUploadProgress(
                browserHlsUploadPaused ? 'Đã tạm dừng upload HLS' : 'Đang tiếp tục upload HLS',
                'Các chunk đã hoàn tất được giữ nguyên; không cần gửi lại.',
                Number($('#inlineUploadProgressBar').attr('aria-valuenow') || 0));
              return;
            }
            if (!resumeFileState){
              showToast('Không còn phiên upload có thể tiếp tục.', false);
              return;
            }
            save();
          });

          // Lọc + phân trang
          $('#txtSearch, #txtMovieId, #txtEpisodeId, #txtQuality').on('input', ()=> {
            clearTimeout(filterTimer);
            filterTimer = setTimeout(()=> loadAll(1), 350);
          });
          $('#slType').on('change', ()=> loadAll(1));

          function confirmAndDeleteSource(sourceId, streamUrl){
            if (!sourceId){ showToast("Không tìm thấy ID nguồn để xóa.", false); return; }
            if (!confirm(`Bạn có chắc chắn muốn xóa nguồn video #${sourceId} này không? Thao tác này không thể hoàn tác.`)) {
              return;
            }
            showLoading();
            const anti = $('input[name="__RequestVerificationToken"]').val();
            $.ajax({
              url: urls.deleteSource,
              type: 'POST',
              data: JSON.stringify({ sourceId: Number(sourceId), streamUrl: streamUrl || '' }),
              contentType: 'application/json',
              headers: anti ? { "RequestVerificationToken": anti } : {},
              success(res){
                const ok = res && (res.success === true || res.code === "200" || res.Success === true);
                if (ok){
                  showToast("Đã xóa nguồn video thành công.", true);
                  sourceModal.hide();
                  loadAll();
                } else {
                  showToast(res?.message || res?.Message || "Xóa nguồn video thất bại.", false);
                }
              },
              error(xhr){
                showToast(xhr?.responseJSON?.message || xhr?.responseText || "Lỗi khi xóa nguồn video.", false);
              },
              complete(){
                hideLoading();
              }
            });
          }

          // CRUD row buttons
          $tbody.on('click', '.btn-edit', function(){ openEdit($(this).data('id')); });
          $tbody.on('click', '.btn-delete', function(){
            const id = $(this).data('id');
            const url = $(this).data('url');
            confirmAndDeleteSource(id, url);
          });
          $('#btnDeleteCurrentSource').on('click', function(){
            const id = $(this).data('id');
            const url = $(this).data('url');
            confirmAndDeleteSource(id, url);
          });

          // Modal UI
          $('#SourceType').on('change', toggleTypeUI);

          // First load
          (function firstLoad(){
            // nạp dropdown cho modal ngay từ đầu giúp nhanh thao tác
            // (cũng không ảnh hưởng đến loadAll phân trang)
            $('#MovieId').html('<option value="">-- Chọn Movie --</option>').trigger('change');
            $('#EpisodeId').html('<option value="">-- Chọn Episode --</option>').trigger('change');

            // Nạp dữ liệu dropdown (không chặn UI)
            loadAll();
          })();
        })();
    </script>
}
