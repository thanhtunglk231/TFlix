@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập Quản trị - TFlix Admin";
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --brand: #27d3c3;
            --brand2: #19b3a5;
            --bg-dark: #0a0d10;
            --panel-bg: #12161a;
        }
        body {
            background: var(--bg-dark) radial-gradient(circle at 50% 20%, rgba(39, 211, 195, 0.15) 0%, transparent 60%);
            color: #eaf3f9;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }
        .admin-login-card {
            background: rgba(18, 22, 26, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 440px;
            padding: 2.5rem;
        }
        @@media (max-width: 575.98px) {
            .admin-login-card {
                padding: 1.5rem 1.25rem;
                border-radius: 18px;
                margin: 0.75rem;
            }
        }
        .brand-badge {
            background: linear-gradient(135deg, var(--brand), var(--brand2));
            color: #001014;
            font-weight: 800;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            font-size: 0.85rem;
        }
        .form-control-custom {
            background-color: #181d23 !important;
            border: 1px solid rgba(255, 255, 255, 0.12) !important;
            color: #fff !important;
            padding: 0.75rem 1rem;
            border-radius: 12px;
        }
        .form-control-custom:focus {
            border-color: var(--brand) !important;
            box-shadow: 0 0 0 0.25rem rgba(39, 211, 195, 0.2) !important;
        }
        .btn-brand {
            background: linear-gradient(135deg, var(--brand), var(--brand2));
            color: #001014;
            font-weight: 700;
            border: none;
            padding: 0.8rem;
            border-radius: 12px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-brand:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(39, 211, 195, 0.3);
            color: #001014;
        }
        .auth-tabs { padding: 5px; background: rgba(255,255,255,.05); border-radius: 12px; }
        .auth-tabs .nav-link { color: #9aa0aa; border-radius: 9px; font-weight: 700; }
        .auth-tabs .nav-link.active { color: #001014; background: var(--brand); }
        #passwordPane > .d-flex { display: none !important; }

        /* Premium Glassmorphism Admin Alert */
        .admin-alert-box {
            background: rgba(255, 77, 109, 0.12);
            border: 1px solid rgba(255, 77, 109, 0.35);
            box-shadow: 0 8px 24px rgba(255, 77, 109, 0.15);
            border-radius: 14px;
            padding: 0.85rem 1rem;
            color: #ffd6dc;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.88rem;
            line-height: 1.4;
            animation: alertSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .admin-alert-box.alert-success {
            background: rgba(39, 211, 195, 0.12);
            border-color: rgba(39, 211, 195, 0.35);
            box-shadow: 0 8px 24px rgba(39, 211, 195, 0.15);
            color: #c7fbf5;
        }
        @@keyframes alertSlideIn {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }
        @@keyframes shakeCard {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-8px); }
            40%, 80% { transform: translateX(8px); }
        }
        .shake {
            animation: shakeCard 0.4s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }
    </style>
</head>
<body>
    <div class="admin-login-card text-center">
        <div class="mb-4">
            <span class="brand-badge d-inline-block mb-3">
                <i class="bi bi-shield-lock-fill me-1"></i> ADMIN PORTAL
            </span>
            <h2 class="fw-bold text-white mb-1">TFlix Management</h2>
            <p class="text-secondary small">Đăng nhập tài khoản Quản trị viên hệ thống</p>
        </div>

        <div id="alertBox" class="admin-alert-box d-none text-start mb-3" role="alert"></div>

        <ul class="nav nav-pills nav-fill auth-tabs mb-4" role="tablist" aria-label="Chọn hình thức đăng nhập Admin">
            <li class="nav-item"><button class="nav-link active" id="password-tab" data-bs-toggle="pill" data-bs-target="#passwordPane" type="button" role="tab" aria-controls="passwordPane" aria-selected="true"><i class="bi bi-key me-1"></i>Mật khẩu</button></li>
            <li class="nav-item"><button class="nav-link" id="otp-tab" data-bs-toggle="pill" data-bs-target="#otpPane" type="button" role="tab" aria-controls="otpPane" aria-selected="false"><i class="bi bi-shield-check me-1"></i>OTP</button></li>
        </ul>
        <input type="hidden" id="returnUrl" value="@returnUrl" />
        <div class="tab-content">
        <div class="tab-pane fade show active" id="passwordPane" role="tabpanel" aria-labelledby="password-tab">
        <form id="adminLoginForm">
            <div class="mb-3 text-start">
                <label class="form-label text-secondary small fw-bold">Tên đăng nhập / Email</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary">
                        <i class="bi bi-person"></i>
                    </span>
                    <input type="text" id="username" class="form-control form-control-custom shadow-none" placeholder="Nhập username admin..." required autofocus />
                </div>
            </div>

            <div class="mb-4 text-start">
                <label class="form-label text-secondary small fw-bold">Mật khẩu</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-secondary border-opacity-25 text-secondary">
                        <i class="bi bi-key"></i>
                    </span>
                    <input type="password" id="password" class="form-control form-control-custom shadow-none" placeholder="Nhập mật khẩu..." required />
                </div>
            </div>

            <button type="submit" class="btn btn-brand w-100 mb-3" id="btnLogin">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Quản Trị
            </button>
        </form>

        <div class="d-flex align-items-center gap-2 my-3 text-secondary"><hr class="flex-grow-1" /><span class="small">hoặc đăng nhập OTP</span><hr class="flex-grow-1" /></div>
        </div>
        <div class="tab-pane fade" id="otpPane" role="tabpanel" aria-labelledby="otp-tab">
        <form id="adminOtpForm">
            <div class="mb-3 text-start">
                <label for="otpEmail" class="form-label text-secondary small fw-bold">Email quản trị</label>
                <div class="input-group">
                    <input type="email" id="otpEmail" class="form-control form-control-custom" placeholder="admin@example.com" required />
                    <button type="button" id="btnSendOtp" class="btn btn-outline-info">Gửi OTP</button>
                </div>
            </div>
            <div class="mb-3 text-start">
                <label for="adminOtp" class="form-label text-secondary small fw-bold">Mã OTP</label>
                <input type="text" inputmode="numeric" id="adminOtp" class="form-control form-control-custom" maxlength="6" placeholder="Nhập 6 chữ số" required />
            </div>
            <button type="submit" id="btnOtpLogin" class="btn btn-outline-info w-100">Đăng nhập bằng OTP</button>
        </form>
        </div>
        </div>

        <div class="text-secondary fs-8 mt-3">
            <a href="/" class="text-secondary text-decoration-none hover-white">
                <i class="bi bi-arrow-left me-1"></i> Trở về trang người dùng
            </a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function decodeUnicodeString(str) {
            if (!str || typeof str !== 'string') return str || '';
            try {
                const txt = document.createElement('textarea');
                txt.innerHTML = str;
                return txt.value;
            } catch (e) {
                return str;
            }
        }

        function showAdminAlert(message, type = 'danger') {
            const box = $('#alertBox');
            const isSuccess = type === 'success';
            const iconClass = isSuccess ? 'bi-shield-check text-info' : 'bi-shield-exclamation text-danger';
            const cleanMsg = decodeUnicodeString(message);

            box.removeClass('d-none alert-success alert-danger')
               .addClass(isSuccess ? 'admin-alert-box alert-success' : 'admin-alert-box alert-danger')
               .html(`<i class="bi ${iconClass} fs-5 flex-shrink-0"></i><div>${cleanMsg}</div>`);

            if (!isSuccess) {
                const card = $('.admin-login-card');
                card.removeClass('shake');
                void card[0].offsetWidth; // trigger reflow
                card.addClass('shake');
            }
        }

        const showOtpSending = button => {
            button.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>Đang gửi...');
        };

        const startOtpCountdown = (button, seconds = 60) => {
            clearInterval(button.data('otpTimer'));
            let remaining = seconds;
            button.prop('disabled', true).text(`Gửi lại OTP (${remaining}s)`);
            const timer = setInterval(() => {
                remaining -= 1;
                if (remaining <= 0) {
                    clearInterval(timer);
                    button.removeData('otpTimer').prop('disabled', false).text('Gửi lại OTP');
                    return;
                }
                button.text(`Gửi lại OTP (${remaining}s)`);
            }, 1000);
            button.data('otpTimer', timer);
        };

        $('#adminLoginForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $('#btnLogin');
            $('#alertBox').addClass('d-none').empty();

            const username = $('#username').val().trim();
            const password = $('#password').val();
            const returnUrl = $('#returnUrl').val();

            if (!username || !password) {
                showAdminAlert('Vui lòng nhập tên đăng nhập và mật khẩu Quản trị.', 'danger');
                return;
            }

            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Đang xác thực...');

            $.ajax({
                url: '/Admin/Auth/Login?returnUrl=' + encodeURIComponent(returnUrl),
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ username: username, password: password }),
                success: function (res) {
                    btn.html('<i class="bi bi-check-lg me-1"></i> Thành công!');
                    showAdminAlert(res.message || 'Đăng nhập thành công! Đang chuyển hướng...', 'success');
                    setTimeout(() => {
                        window.location.href = res.redirectUrl || '/Admin';
                    }, 400);
                },
                error: function (xhr) {
                    btn.prop('disabled', false).html('<i class="bi bi-box-arrow-in-right me-1"></i> Đăng Nhập Quản Trị');
                    let msg = 'Đăng nhập thất bại. Vui lòng kiểm tra lại thông tin tài khoản admin.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    } else if (xhr.status === 401) {
                        msg = 'Tên đăng nhập hoặc mật khẩu không chính xác.';
                    } else if (xhr.status === 403) {
                        msg = 'Tài khoản này không có quyền truy cập trang Quản trị.';
                    } else if (xhr.status >= 500) {
                        msg = 'Máy chủ quản trị tạm thời gián đoạn. Vui lòng thử lại sau.';
                    }
                    showAdminAlert(msg, 'danger');
                }
            });
        });

        $('#btnSendOtp').on('click', function () {
            const email = $('#otpEmail').val().trim();
            if (!email) {
                showAdminAlert('Vui lòng nhập email quản trị trước khi gửi mã OTP.', 'danger');
                return;
            }
            const btn = $(this);
            let sent = false;
            showOtpSending(btn);
            $.ajax({
                url: '/Admin/Auth/RequestOtp',
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ email }),
                success: res => {
                    sent = true;
                    showAdminAlert(res.message || 'Đã gửi mã xác thực OTP về email quản trị.', 'success');
                    startOtpCountdown(btn);
                },
                error: xhr => {
                    const msg = xhr.responseJSON?.message || 'Không thể gửi mã OTP lúc này. Vui lòng thử lại sau.';
                    showAdminAlert(msg, 'danger');
                },
                complete: () => { if (!sent) btn.prop('disabled', false).text('Gửi OTP'); }
            });
        });

        $('#adminOtpForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $('#btnOtpLogin').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2"></span> Đang xác thực...');
            $.ajax({
                url: '/Admin/Auth/LoginWithOtp?returnUrl=' + encodeURIComponent($('#returnUrl').val()),
                type: 'POST',
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify({ email: $('#otpEmail').val().trim(), otp: $('#adminOtp').val().trim() }),
                success: res => {
                    showAdminAlert(res.message || 'Xác thực OTP thành công! Đang chuyển hướng...', 'success');
                    setTimeout(() => {
                        window.location.href = res.redirectUrl || '/Admin';
                    }, 400);
                },
                error: xhr => {
                    const msg = xhr.responseJSON?.message || 'Mã OTP không hợp lệ hoặc đã hết hạn.';
                    showAdminAlert(msg, 'danger');
                },
                complete: () => btn.prop('disabled', false).text('Đăng nhập bằng OTP')
            });
        });
    </script>
</body>
</html>
