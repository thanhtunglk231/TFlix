@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string, bool> isActive = (c, a) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (string.IsNullOrEmpty(a) || string.Equals(act, a, StringComparison.OrdinalIgnoreCase));
}
<!doctype html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>@(ViewData["Title"] ?? "Quản trị hệ thống · TFlix Admin")</title>
    
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons (CSS) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 270px;
            --bg-main: #111318;
            --bg-surface: #17191f;
            --bg-card: #1c1f26;
            --bg-card-hover: #222630;
            --bg-sidebar: #14171d;
            
            --primary-blue: #1683ff;
            --primary-cyan: #19d3c5;
            --accent-gradient: linear-gradient(135deg, #1683ff 0%, #19d3c5 100%);
            --accent-gradient-hover: linear-gradient(135deg, #2f94ff 0%, #30dfd2 100%);
            --accent-gradient-subtle: linear-gradient(135deg, rgba(22, 131, 255, 0.15) 0%, rgba(25, 211, 197, 0.15) 100%);
            
            --text-main: #ffffff;
            --text-muted: #9aa0aa;
            --text-subtle: #6e7683;
            
            --border-subtle: rgba(255, 255, 255, 0.08);
            --border-card: rgba(255, 255, 255, 0.09);
            --border-glow: rgba(22, 131, 255, 0.4);
            
            --card-radius: 14px;
            --font-family-base: 'Plus Jakarta Sans', 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            font-family: var(--font-family-base);
            background-color: var(--bg-main);
            color: var(--text-main);
            color-scheme: dark;
            -webkit-font-smoothing: antialiased;
        }

        body {
            overflow: hidden;
        }

        .app {
            display: grid;
            grid-template-rows: auto 1fr;
            height: 100%;
        }

        .app-main {
            display: grid;
            grid-template-columns: var(--sidebar-width) 1fr;
            min-height: 0;
            height: 100%;
        }

        /* Sidebar Styling */
        .sidebar {
            overflow-y: auto;
            background-color: var(--bg-sidebar);
            border-right: 1px solid var(--border-subtle);
            display: flex;
            flex-direction: column;
            padding: 1.25rem 1rem;
        }

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background: #252a35;
            border-radius: 4px;
        }

        .sidebar-brand-box {
            display: flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.25rem 0.5rem 1.25rem;
            margin-bottom: 0.75rem;
            border-bottom: 1px solid var(--border-subtle);
            text-decoration: none;
        }

        .sidebar-brand-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: var(--accent-gradient);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #0b141e;
            font-size: 1.1rem;
            box-shadow: 0 4px 14px rgba(25, 211, 197, 0.4);
            flex-shrink: 0;
        }

        .sidebar-brand-text {
            font-size: 1.35rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.02em;
        }

        .sidebar-brand-text span {
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .sidebar-section-label {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-subtle);
            margin: 1.25rem 0.6rem 0.45rem;
        }

        .sidebar-nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.95rem;
            margin-bottom: 0.25rem;
            border-radius: 10px;
            color: var(--text-muted);
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }

        .sidebar-nav-link i,
        .sidebar-nav-link .nav-icon {
            width: 20px;
            height: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            color: var(--text-muted);
            transition: all 0.2s ease;
        }

        .sidebar-nav-link:hover {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
            transform: translateX(3px);
        }

        .sidebar-nav-link:hover i,
        .sidebar-nav-link:hover .nav-icon {
            color: var(--primary-cyan);
            transform: scale(1.1);
        }

        .sidebar-nav-link.active {
            color: #ffffff;
            background: var(--accent-gradient-subtle);
            font-weight: 600;
            border: 1px solid rgba(22, 131, 255, 0.3);
            box-shadow: 0 4px 14px rgba(22, 131, 255, 0.15);
        }

        .sidebar-nav-link.active i,
        .sidebar-nav-link.active .nav-icon {
            color: var(--primary-cyan);
        }

        .sidebar-nav-link.active::before {
            content: "";
            position: absolute;
            left: 0;
            top: 20%;
            bottom: 20%;
            width: 3.5px;
            border-radius: 0 4px 4px 0;
            background: var(--accent-gradient);
        }

        /* SVG Icon Utilities */
        .svg-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            vertical-align: middle;
            flex-shrink: 0;
        }

        .stat-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform 0.2s ease;
        }

        .card:hover .stat-icon-wrapper {
            transform: scale(1.08);
        }

        /* Content Area */
        .content {
            overflow-y: auto;
            background-color: var(--bg-main);
            padding: 1.5rem;
        }

        .content::-webkit-scrollbar {
            width: 8px;
        }
        .content::-webkit-scrollbar-thumb {
            background: #252a35;
            border-radius: 4px;
        }

        /* Topbar */
        .admin-topbar {
            background-color: var(--bg-surface);
            border-bottom: 1px solid var(--border-subtle);
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            z-index: 1020;
        }

        /* Global Cards & Tables in Admin */
        .card, .admin-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-card);
            border-radius: var(--card-radius);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
            color: #ffffff;
        }

        .card-header {
            background-color: rgba(255, 255, 255, 0.02);
            border-bottom: 1px solid var(--border-subtle);
            padding: 1rem 1.25rem;
        }

        .table-responsive {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid var(--border-subtle);
        }

        .table {
            color: #ffffff;
            margin-bottom: 0;
            --bs-table-bg: var(--bg-card);
            --bs-table-border-color: rgba(255, 255, 255, 0.06);
        }

        .table thead th {
            position: sticky;
            top: 0;
            background: #15181e;
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.85rem 1rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            z-index: 1;
        }

        .table tbody td {
            padding: 0.85rem 1rem;
            vertical-align: middle;
            font-size: 0.9rem;
            background: var(--bg-card);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: background-color 0.2s;
        }

        .table tbody tr:hover td {
            background-color: rgba(25, 211, 197, 0.05);
        }

        /* Buttons */
        .btn-tflix-primary {
            background: var(--accent-gradient);
            border: none;
            color: #0c151f;
            font-weight: 700;
            font-size: 0.88rem;
            padding: 0.5rem 1.2rem;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            box-shadow: 0 4px 14px rgba(22, 131, 255, 0.35);
            transition: all 0.25s ease;
            text-decoration: none;
        }

        .btn-tflix-primary:hover {
            background: var(--accent-gradient-hover);
            color: #050d17;
            transform: translateY(-2px);
            box-shadow: 0 6px 18px rgba(25, 211, 197, 0.5);
        }

        .btn-tflix-glass {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #ffffff;
            font-weight: 600;
            font-size: 0.88rem;
            padding: 0.5rem 1.15rem;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            transition: all 0.25s ease;
            text-decoration: none;
        }

        .btn-tflix-glass:hover {
            background: rgba(255, 255, 255, 0.15);
            border-color: rgba(255, 255, 255, 0.3);
            color: #ffffff;
            transform: translateY(-2px);
        }

        /* Form controls */
        .form-control, .form-select {
            background-color: #15181e;
            border: 1px solid var(--border-card);
            color: #ffffff;
            border-radius: 8px;
            padding: 0.55rem 0.85rem;
        }

        .form-control:focus, .form-select:focus {
            background-color: #1a1e26;
            border-color: var(--primary-cyan);
            box-shadow: 0 0 0 3px rgba(25, 211, 197, 0.2);
            color: #ffffff;
        }

        /* ========================================================
           ADMIN MOBILE RESPONSIVE SYSTEM (< 992px, < 768px, < 576px)
           ======================================================== */
        
        /* 1. Màn hình máy tính bảng và điện thoại (< 992px) */
        @@media (max-width: 991.98px) {
            .app {
                height: 100vh;
                height: 100dvh;
                display: flex !important;
                flex-direction: column !important;
                overflow: hidden !important;
            }

            .app-main {
                display: block !important;
                flex: 1 1 auto;
                min-height: 0;
                height: 100%;
                width: 100%;
                position: relative;
                overflow: hidden;
            }

            .sidebar {
                position: fixed !important;
                top: 0 !important;
                bottom: 0 !important;
                left: 0 !important;
                width: min(300px, 86vw) !important;
                height: 100vh !important;
                height: 100dvh !important;
                z-index: 1060 !important;
                transform: translateX(-100%) !important;
                transition: transform 0.3s cubic-bezier(0.2, 0.9, 0.3, 1) !important;
                box-shadow: 12px 0 40px rgba(0, 0, 0, 0.75);
                overscroll-behavior: contain;
                -webkit-overflow-scrolling: touch;
                padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
            }

            .sidebar.show {
                transform: translateX(0) !important;
            }

            .content {
                width: 100% !important;
                height: 100% !important;
                min-height: 100% !important;
                display: block !important;
                overflow-y: auto !important;
                -webkit-overflow-scrolling: touch;
                padding: 1rem 0.75rem;
            }

            body.sidebar-open {
                overflow: hidden !important;
                touch-action: none;
            }

            .sidebar-close-btn {
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 8px;
                background: rgba(255, 255, 255, 0.08);
                color: #ffffff;
                transition: all 0.2s ease;
            }

            .sidebar-close-btn:active {
                background: rgba(255, 255, 255, 0.2);
                transform: scale(0.95);
            }
        }

        /* 2. Màn hình điện thoại (< 768px) */
        @@media (max-width: 767.98px) {
            .content {
                padding: 0.85rem 0.65rem;
                overflow-x: hidden;
            }

            .admin-topbar {
                padding: 0.55rem 0.75rem;
            }

            /* Tránh hiện tượng Safari iOS và Chrome Mobile tự động zoom vào form */
            .form-control, .form-select {
                font-size: 16px !important;
            }

            /* Tối ưu bảng dữ liệu hiển thị trên màn hình hẹp */
            .table-responsive {
                -webkit-overflow-scrolling: touch;
                border-radius: 10px;
                margin-bottom: 0.75rem;
                border: 1px solid var(--border-subtle);
                position: relative;
            }

            .table-responsive::-webkit-scrollbar {
                height: 5px;
            }

            .table-responsive::-webkit-scrollbar-thumb {
                background: rgba(25, 211, 197, 0.35);
                border-radius: 10px;
            }

            .table thead th {
                font-size: 0.75rem;
                padding: 0.65rem 0.6rem;
                white-space: nowrap;
                letter-spacing: 0.03em;
            }

            .table tbody td {
                font-size: 0.82rem;
                padding: 0.65rem 0.6rem;
                white-space: nowrap;
            }

            /* Cột thao tác luôn giữ nút không bị gãy dòng */
            .table td:last-child,
            .table th:last-child {
                white-space: nowrap !important;
            }

            .table td .btn-group,
            .table td .d-flex {
                flex-wrap: nowrap;
            }

            .table td .btn-sm {
                padding: 0.3rem 0.55rem;
                font-size: 0.78rem;
            }

            /* Video preview trong bảng trên mobile */
            .video-cell {
                max-width: 170px !important;
                width: 170px !important;
            }

            .video-cell video {
                max-height: 100px !important;
            }

            /* Hàng filter tìm kiếm: dàn xếp linh hoạt trên mobile */
            .card .row.g-2.mb-3 > [class*="col-"] {
                margin-bottom: 0.15rem;
            }

            /* Nav-tabs cuộn ngang mượt mà trên mobile */
            .nav-tabs {
                flex-wrap: nowrap !important;
                overflow-x: auto !important;
                overflow-y: hidden !important;
                -webkit-overflow-scrolling: touch;
                padding-bottom: 4px;
                border-bottom: 1px solid var(--border-subtle);
            }

            .nav-tabs .nav-link {
                white-space: nowrap !important;
                font-size: 0.82rem;
                padding: 0.5rem 0.85rem;
            }

            /* Phân trang căn giữa đẹp mắt */
            .pagination {
                justify-content: center;
                flex-wrap: wrap;
                gap: 2px;
            }

            .pagination .page-link {
                padding: 0.35rem 0.65rem;
                font-size: 0.82rem;
            }
        }

        /* 3. Màn hình điện thoại nhỏ và chuẩn (< 576px) */
        @@media (max-width: 575.98px) {
            .content {
                padding: 0.65rem 0.45rem;
            }

            /* Topbar dropdowns (chuông thông báo, menu profile) tự căn vừa màn hình tránh tràn viền */
            .admin-topbar .dropdown-menu {
                position: fixed !important;
                top: 54px !important;
                left: 10px !important;
                right: 10px !important;
                width: auto !important;
                min-width: 0 !important;
                max-width: none !important;
                border-radius: 14px !important;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7) !important;
            }

            /* Header trang: tiêu đề nằm trên, cụm nút bấm kéo rộng full-width */
            .d-flex.flex-wrap.justify-content-between.align-items-center,
            .admin-page-header {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 0.75rem !important;
            }

            .d-flex.flex-wrap.justify-content-between.align-items-center h1,
            .d-flex.flex-wrap.justify-content-between.align-items-center h2,
            .d-flex.flex-wrap.justify-content-between.align-items-center h3,
            .d-flex.flex-wrap.justify-content-between.align-items-center h4 {
                font-size: 1.25rem !important;
                margin-bottom: 0.15rem !important;
            }

            .d-flex.flex-wrap.justify-content-between.align-items-center .d-flex.gap-2,
            .d-flex.flex-wrap.justify-content-between.align-items-center .d-flex.gap-3 {
                width: 100% !important;
                display: flex !important;
                justify-content: stretch !important;
            }

            .d-flex.flex-wrap.justify-content-between.align-items-center .d-flex.gap-2 .btn,
            .d-flex.flex-wrap.justify-content-between.align-items-center .d-flex.gap-3 .btn,
            .d-flex.flex-wrap.justify-content-between.align-items-center > .btn {
                flex: 1 1 0 !important;
                display: inline-flex !important;
                justify-content: center !important;
                align-items: center !important;
                padding: 0.55rem 0.75rem !important;
                font-size: 0.85rem !important;
                white-space: nowrap !important;
            }

            /* Modal tối ưu không gian hiển thị trên mobile */
            .modal-dialog {
                margin: 0.45rem auto;
                max-width: calc(100% - 0.9rem);
            }

            .modal-content {
                border-radius: 14px;
                border: 1px solid var(--border-card);
                max-height: calc(100dvh - 1.5rem);
                display: flex;
                flex-direction: column;
            }

            .modal-header {
                padding: 0.75rem 1rem;
                border-bottom: 1px solid var(--border-subtle);
                flex-shrink: 0;
            }

            .modal-title {
                font-size: 1.05rem;
            }

            .modal-body {
                padding: 0.9rem 0.8rem;
                overflow-y: auto;
                -webkit-overflow-scrolling: touch;
            }

            .modal-footer {
                padding: 0.65rem 0.8rem;
                border-top: 1px solid var(--border-subtle);
                display: flex;
                gap: 0.5rem;
                flex-shrink: 0;
            }

            .modal-footer .btn {
                flex: 1 1 0;
                margin: 0 !important;
                display: inline-flex;
                justify-content: center;
                align-items: center;
                padding: 0.55rem 0.85rem;
                font-size: 0.88rem;
            }

            /* Các trường form trong modal xếp dọc hợp lý */
            .modal-body .row.g-3 > [class*="col-"] {
                margin-bottom: 0.25rem;
            }

            /* Sticky cột đầu tiên cho bảng ma trận quyền trên mobile */
            #tblUserPermissions th:first-child,
            #tblUserPermissions td:first-child,
            #tblPermissions th:first-child,
            #tblPermissions td:first-child {
                position: sticky;
                left: 0;
                background: #17191f;
                z-index: 2;
                box-shadow: 2px 0 8px rgba(0,0,0,0.4);
            }

            /* Tối ưu Dashboard Banner & Stat Cards */
            .card.mb-4.border-0.overflow-hidden .display-6 {
                font-size: 1.35rem !important;
            }

            .card.mb-4.border-0.overflow-hidden .card-body {
                padding: 1.1rem !important;
            }

            .card h2 {
                font-size: 1.45rem !important;
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <div class="app">
        @await Html.PartialAsync("_Topbar")
        <div class="app-main">
            @await Html.PartialAsync("_Sidebar", new ViewDataDictionary(ViewData) { { "isActive", isActive } })
            <main class="content" id="mainContent">
                <div class="container-fluid px-0">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    @await Html.PartialAsync("_Toast")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
