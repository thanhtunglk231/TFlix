    <!-- Server Status Mini Card at bottom of sidebar -->
    <div class="mt-auto pt-3 border-top border-secondary border-opacity-25">
        <div class="p-2 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.06); font-size: 0.76rem;">
            <div class="d-flex align-items-center justify-content-between mb-1">
                <span class="text-muted d-flex align-items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"></rect><rect x="2" y="14" width="20" height="8" rx="2"></rect><line x1="6" y1="6" x2="6.01" y2="6"></line><line x1="6" y1="18" x2="6.01" y2="18"></line></svg>
                    API Server:
                </span>
                <span class="text-success fw-bold d-flex align-items-center gap-1">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 6px; height: 6px;" role="status"></span>
                    5036 Online
                </span>
            </div>
            <div class="d-flex align-items-center justify-content-between">
                <span class="text-muted d-flex align-items-center gap-1">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
                    Web MVC:
                </span>
                <span class="text-success fw-bold d-flex align-items-center gap-1">
                    <span class="spinner-grow spinner-grow-sm text-success" style="width: 6px; height: 6px;" role="status"></span>
                    5122 Online
                </span>
            </div>
        </div>
    </div>
</aside>

<!-- JS toggle cho sidebar mobile -->
<script>
    (function () {
      const sidebar = document.getElementById('sidebar');
      if (!sidebar || sidebar.dataset.tglInit === '1') return;
      sidebar.dataset.tglInit = '1';

      const btnOpen  = document.getElementById('sidebarToggle');
      const btnClose = document.getElementById('sidebarClose');

      let overlay = document.getElementById('sidebarOverlay');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.id = 'sidebarOverlay';
        overlay.style.position = 'fixed';
        overlay.style.inset = '0';
        overlay.style.zIndex = '1049';
        overlay.style.background = 'rgba(0,0,0,.6)';
        overlay.style.backdropFilter = 'blur(4px)';
        overlay.style.display = 'none';
        document.body.appendChild(overlay);
      }

      const openSidebar = () => {
        sidebar.classList.add('show');
        document.body.classList.add('sidebar-open');
        overlay.style.display = 'block';
        btnOpen?.setAttribute('aria-expanded', 'true');
      };

      const closeSidebar = () => {
        sidebar.classList.remove('show');
        document.body.classList.remove('sidebar-open');
        overlay.style.display = 'none';
        btnOpen?.setAttribute('aria-expanded', 'false');
      };

      btnOpen?.addEventListener('click', function (e) {
        e.preventDefault();
        openSidebar();
      });

      btnClose?.addEventListener('click', function (e) {
        e.preventDefault();
        closeSidebar();
      });

      overlay.addEventListener('click', closeSidebar);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSidebar();
      });

      sidebar.addEventListener('click', function (e) {
        const isMobile = window.matchMedia('(max-width: 991.98px)').matches;
        if (isMobile && e.target.closest('.sidebar-nav-link')) closeSidebar();
      });
    })();
</script>
