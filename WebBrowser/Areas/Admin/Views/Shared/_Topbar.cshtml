@using Newtonsoft.Json
@{
    var adminUserJson = Context.Session.GetString("AdminCurrentUser");
    string adminName = "Quản trị viên";
    string adminEmail = "admin@tflix.com";
    if (!string.IsNullOrEmpty(adminUserJson))
    {
        try
        {
            dynamic u = JsonConvert.DeserializeObject(adminUserJson);
            adminName = u?.fullName ?? u?.FullName ?? u?.username ?? u?.Username ?? "Quản trị viên";
            adminEmail = u?.email ?? u?.Email ?? "admin@tflix.com";
        }
        catch { }
    }
}

<nav class="admin-topbar" id="topbar">
    <div class="d-flex align-items-center gap-2">
        <!-- Toggle mở sidebar (mobile) -->
        <button class="btn btn-outline-secondary d-lg-none p-2 border-0 text-white" id="sidebarToggle" aria-label="Mở menu quản trị">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <a class="sidebar-brand-box border-0 mb-0 py-0 d-lg-none" asp-area="Admin" asp-controller="Home" asp-action="Index">
            <div class="sidebar-brand-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M5 3.5L19 12L5 20.5V3.5Z" fill="currentColor"/>
                </svg>
            </div>
            <span class="sidebar-brand-text">T<span>Flix</span></span>
        </a>

        <div class="d-none d-md-flex align-items-center ms-2">
            <span class="badge d-inline-flex align-items-center gap-1.5" style="background: rgba(22, 131, 255, 0.15); border: 1px solid rgba(22, 131, 255, 0.35); color: #60a5fa; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.05em; padding: 0.4rem 0.75rem; border-radius: 9999px;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-info">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                </svg>
                ADMIN PORTAL
            </span>
        </div>
    </div>

    <!-- Quick search -->
    <div class="d-none d-md-flex align-items-center position-relative mx-3" style="max-width: 320px; width: 100%;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="position-absolute text-muted" style="left: 0.9rem;">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text"
               class="form-control ps-5"
               placeholder="Tìm phim, series, diễn viên..."
               style="border-radius: 9999px; font-size: 0.85rem; background: #14171d;"
               onkeydown="if(event.key === 'Enter') { window.location.href='/Admin/Movie?q=' + encodeURIComponent(this.value); }" />
    </div>

    <div class="ms-auto d-flex align-items-center gap-3">
        <!-- Link to user-facing site -->
        <a href="/" target="_blank" class="btn btn-sm btn-tflix-glass d-none d-sm-inline-flex align-items-center gap-1.5" title="Mở trang chủ người dùng trong tab mới">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                <polyline points="15 3 21 3 21 9"></polyline>
                <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
            Xem Website
        </a>

        <!-- Notifications -->
        <div class="dropdown">
            <button class="btn btn-outline-secondary btn-sm position-relative rounded-circle p-2 text-white border-0 d-flex align-items-center justify-content-center"
                    style="background: rgba(255, 255, 255, 0.06); width: 38px; height: 38px;"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="Thông báo hệ thống">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-dark rounded-circle">
                    <span class="visually-hidden">Thông báo mới</span>
                </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark bg-dark border-secondary shadow-lg mt-2" style="min-width: 280px;">
                <li class="px-3 py-2 border-bottom border-secondary small fw-bold text-muted">THÔNG BÁO HỆ THỐNG</li>
                <li>
                    <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="#">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Máy chủ API hoạt động ổn định
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="#">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-info"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                        CSDL SQL Server đã kết nối
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 small d-flex align-items-center gap-2" href="#">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning"><rect x="2" y="2" width="20" height="20" rx="2.5"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line></svg>
                        Đã cập nhật hệ thống SVG mới
                    </a>
                </li>
            </ul>
        </div>

        <!-- Admin user profile dropdown -->
        <div class="dropdown">
            <button class="btn d-flex align-items-center gap-2 p-1 border-0" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80"
                     alt="Admin Avatar"
                     class="rounded-circle"
                     style="width: 36px; height: 36px; object-fit: cover; border: 2px solid #19d3c5; box-shadow: 0 0 10px rgba(25, 211, 197, 0.4);" />
                <div class="text-start d-none d-md-block" style="line-height: 1.2;">
                    <div class="fw-bold text-white small">@adminName</div>
                    <span class="badge p-0 text-info fw-normal" style="font-size: 0.72rem;">Super Admin</span>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted ms-1">
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </button>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark bg-dark border-secondary shadow-lg mt-2">
                <li class="px-3 py-2 border-bottom border-secondary">
                    <div class="fw-bold text-white small">@adminName</div>
                    <div class="text-muted" style="font-size: 0.75rem;">@adminEmail</div>
                </li>
                <li>
                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Home" asp-action="Index">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-info"><rect x="3" y="3" width="7" height="9" rx="1.5"></rect><rect x="14" y="3" width="7" height="5" rx="1.5"></rect><rect x="14" y="12" width="7" height="9" rx="1.5"></rect><rect x="3" y="16" width="7" height="5" rx="1.5"></rect></svg>
                        Dashboard
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Movie" asp-action="Index">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-primary"><rect x="2" y="2" width="20" height="20" rx="2.5"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line></svg>
                        Quản lý phim
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Permission" asp-action="Index">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-warning"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                        Phân quyền
                    </a>
                </li>
                <li><hr class="dropdown-divider border-secondary" /></li>
                <li>
                    <a class="dropdown-item text-danger py-2 d-flex align-items-center gap-2" href="/Admin/Auth/Logout">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                        Đăng xuất Admin
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>
